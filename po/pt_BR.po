msgstr "Favoritos do navegador (Chrome / Brave / Edge / DuckDuckGo / Firefox)"

#: config/includes.chroot/usr/bin/dagric-migrate:223
msgid "Browser tabs you had open"
msgstr "Abas do navegador que você tinha abertas"

#: config/includes.chroot/usr/bin/dagric-migrate:224
msgid "Saved passwords (Firefox + Chromium CSV export)"
msgstr "Senhas salvas (exportação CSV do Firefox + Chromium)"

#: config/includes.chroot/usr/bin/dagric-migrate:225
msgid "Gaming continuity (save games, Steam screenshots, game inventory)"
msgstr ""
"Continuidade de jogos (salvamentos de jogos, capturas de tela do Steam, "
