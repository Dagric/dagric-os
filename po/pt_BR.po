msgstr "Coral"

#: config/includes.chroot/usr/bin/dagric-firstrun:382
msgid "Violet"
msgstr "Violeta"

#: config/includes.chroot/usr/bin/dagric-firstrun:383
msgid "Pink"
msgstr "Rosa"

#: config/includes.chroot/usr/bin/dagric-firstrun:384
msgid "Slate"
msgstr "Ardósia"

#: config/includes.chroot/usr/bin/dagric-firstrun:577
msgid ""
"The text size could not be changed here. Open System Settings ▸ Display & "
