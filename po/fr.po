"Ollama was not installed. Any previous working installation was restored."
msgstr ""
"Ollama n'a pas été installé. Toute installation fonctionnelle précédente a "
"été restaurée."

#: config/includes.chroot/usr/bin/dagric-ai:93
msgid "Done. Try:  ollama run llama3.2"
msgstr "Terminé. Essayez :  ollama run llama3.2"

