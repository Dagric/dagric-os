#!/bin/sh
# Freehold OS — live-build configuration
# This is the single source of truth for how the ISO is assembled.
# FREEHOLD_EDITION selects the flavor: "free" (default) or "pro".
set -e

case "${FREEHOLD_EDITION:-free}" in
    pro)
        FH_APP="Freehold OS Pro"
        FH_VOLUME="FREEHOLD_PRO_1_0"
        ;;
    *)
        FH_APP="Freehold OS"
        FH_VOLUME="FREEHOLD_1_0"
        ;;
esac

# non-free is enabled so Pro's driver helper can install NVIDIA drivers
# from the standard repos post-install; nothing from non-free is
# preinstalled on either edition.
lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --debian-installer none \
    --apt-recommends false \
    --bootappend-live "boot=live components quiet splash hostname=freehold username=live" \
    --iso-application "$FH_APP" \
    --iso-publisher "Freehold OS Project" \
    --iso-volume "$FH_VOLUME" \
    --memtest none \
    --firmware-chroot true \
    --firmware-binary true \
    "${@}"
