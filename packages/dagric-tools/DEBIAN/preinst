#!/bin/sh
# Dagric OS — preserve a paying customer's paid appearance set across the
# upgrade that stops shipping it.
#
# WHY THIS EXISTS. Until 1.1.4, dagric-tools packed the whole of
# share/dagric/looks and share/dagric/styles, including the four layouts and
# three colour styles marked EDITION=pro. That put the paid appearance set on
# the public update channel, where it could be fetched and unpacked by anyone
# without buying it. 1.1.5 strips them (packages/stage-packages.sh).
#
# But dpkg deletes the files a new version no longer owns. On a machine
# installed from a Pro ISO those seven files ARE owned by dagric-tools 1.1.4, so
# the upgrade that closes the leak would also delete the layouts the owner paid
# for — the update channel taking a feature away, which is worse than the
# channel not existing.
#
# So: stash them here, put them back in postinst. The machine's own copy, no
# network, no payload in the package. Afterwards they are unowned files under
# /usr/share, which is exactly the state a free-to-Pro upgraded machine is
# already in (dagric-upgrade-to-pro cp's them out of the licence-gated bundle),
# so both kinds of Pro machine end up alike.
#
# ON A FREE MACHINE THIS DOES NOTHING, and that is the point. The files are not
# on disk — build.sh deletes them from the free image and dagric-app-names
# deletes them again after every dpkg run — so the stash is empty and postinst
# restores nothing. The gate cannot be widened by this script; it can only give
# back what the machine already had.
#
# Not conditional on /etc/dagric-edition. Reading the edition here would mean a
# machine with an unreadable or missing edition file loses its layouts with no
# way back; stashing unconditionally costs a few kilobytes and postinst is where
# the edition decides. Never fails the upgrade: a stash that cannot be written
# is a lost customisation, not a broken package manager.
set -e

STASH=/var/lib/dagric/pro-appearance
LOOKS=/usr/share/dagric/looks
STYLES=/usr/share/dagric/styles
THUMBS=/usr/share/dagric/appearance/thumbs

case "$1" in
upgrade)
    # NEVER DESTROY THE OLD STASH BEFORE THE NEW ONE EXISTS.
    #
    # This used to open with `rm -rf "$STASH"`, and there is a window in which
    # that stash is the ONLY copy of the customer's paid files: between
    # `dpkg --unpack` and `dpkg --configure`, the layouts have already been
    # removed from /usr/share (dpkg deletes what the new version no longer owns)
    # and postinst has not yet put them back. A second preinst in that window —
    # an interrupted apt run, then another upgrade — deleted the stash, found
    # nothing left in /usr/share to re-stash, and the four paid layouts, three
    # styles and seven thumbnails were gone for good.
    #
    # So: build the new stash beside the old one, and only replace the old one
    # if the new one actually caught something. An upgrade that finds nothing to
    # stash now leaves the previous rescue intact instead of erasing it.
    STASH_FINAL=$STASH
    NEW=$STASH.new
    rm -rf "$NEW"
    # Not `|| exit 0`. That silently abandoned the stash on ANY failure — and a
    # stash that does not happen is a Pro machine that loses its paid layouts,
    # which is the one outcome this script exists to prevent. If it cannot be
    # written, say so on stderr where the upgrade log will keep it.
    if ! mkdir -p "$NEW/looks" "$NEW/styles" "$NEW/thumbs"; then
        echo "dagric-tools: cannot write $NEW — the Pro appearance set may be" >&2
        echo "  removed by this upgrade. Re-run dagric-upgrade-to-pro to restore it." >&2
        exit 0
    fi
    STASH=$NEW
    n=0
    for f in $(grep -rlx 'EDITION=pro' "$LOOKS" "$STYLES" 2>/dev/null); do
        base=${f##*/}
        case "$f" in
            "$LOOKS"/*)  cp -p "$f" "$STASH/looks/"  2>/dev/null && n=$((n + 1)) ;;
            "$STYLES"/*) cp -p "$f" "$STASH/styles/" 2>/dev/null && n=$((n + 1)) ;;
        esac
        [ -f "$THUMBS/${base%.*}.png" ] && \
            cp -p "$THUMBS/${base%.*}.png" "$STASH/thumbs/" 2>/dev/null || true
    done
    # A marker so postinst can tell "nothing was there" (a free machine, the
    # normal case) apart from "the stash failed" — only the second is worth a
    # word in the log.
    printf '%s\n' "$n" > "$STASH/count" 2>/dev/null || true

    # THE SWAP, and the reason the whole dance exists. Promote the new stash
    # only if it actually caught something; otherwise keep whatever the last run
    # rescued. On a free machine n is 0 every time and there is nothing to keep,
    # so this is a no-op there. On a Pro machine mid-way through an interrupted
    # upgrade, this is what stops the second preinst from erasing the only
    # surviving copy of the paid set.
    if [ "$n" -gt 0 ]; then
        rm -rf "$STASH_FINAL"
        mv "$NEW" "$STASH_FINAL" 2>/dev/null || true
    else
        rm -rf "$NEW"
    fi
    ;;
esac

exit 0
