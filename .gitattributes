# Shell scripts and live-build files MUST keep LF endings —
# a hook with CRLF endings breaks inside the Debian chroot ("/bin/sh^M").
* text=auto
*.sh text eol=lf
*.chroot text eol=lf
auto/* text eol=lf
*.desc text eol=lf
*.qml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
packages/**/DEBIAN/* text eol=lf
config/includes.chroot/usr/bin/* text eol=lf
config/includes.chroot/usr/lib/live/config/* text eol=lf
# Linux-side config that CRLF would break (KConfig, .desktop, skel dotfiles)
config/includes.chroot/etc/skel/** text eol=lf
*.desktop text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf

# Binaries
*.png binary
*.iso binary
