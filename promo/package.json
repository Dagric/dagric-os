{
  "name": "dagric-promo",
  "version": "1.0.0",
  "description": "Dagric OS promo video (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render DagricPromo out/dagric-promo.mp4",
    "render:walkthrough": "remotion render InstallWalkthrough out/dagric-install-walkthrough.mp4",
    "render:short": "remotion render DagricShort out/dagric-short.mp4",
    "render:looks": "remotion render DagricLooks out/dagric-looks.mp4",
    "render:all": "npm run render && npm run render:walkthrough && npm run render:short && npm run render:looks",
    "still": "remotion still DagricPromo out/poster.png --frame=90",
    "still:walkthrough": "remotion still InstallWalkthrough out/walkthrough-poster.png --frame=620",
    "still:looks": "remotion still DagricLooks out/looks-poster.png --frame=840"
  },
  "dependencies": {
    "@remotion/cli": "4.0.286",
    "react": "19.2.8",
    "react-dom": "19.0.0",
    "remotion": "4.0.286"
  }
}
