# Dagric OS — Installer
# Calamares: the same friendly graphical installer Debian Live itself ships.
calamares
calamares-settings-debian
# Password-quality dictionary — without it Calamares' password check errors
# out with "error loading dictionary" and blocks EVERY password.
# (Found by the QEMU install run-through test.)
cracklib-runtime
# unsquashfs — Calamares' unpackfs module needs it to copy the live
# filesystem onto the target disk. (Found by the install run-through:
# "Failed to find unsquashfs".)
squashfs-tools
# The installed system's bootloader — BIOS *and* EFI.
# The -bin packages coexist (the grub-pc/grub-efi-amd64 metapackages
# conflict, so we use the underlying pieces): grub2-common provides
# grub-install, the -bin packages provide the i386-pc and x86_64-efi
# targets, and shim-signed + grub-efi-amd64-signed give Secure Boot.
grub2-common
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-signed
shim-signed
efibootmgr
os-prober
# GPT partitioning tools — Calamares' partition backend (KPMcore) needs
# gdisk/sgdisk to create the GPT table an EFI install requires. Without
# these the EFI install fails at "sfdisk --force --append".
# (Found by the UEFI install run-through test.) parted is the general
# fallback backend.
gdisk
parted
# btrfs is the default install filesystem (instant Timeshift/rollback
# snapshots); the installed system needs the tools
btrfs-progs
