# Dagric OS — User applications
# The rule: ship what a normal person needs on day one, nothing else.
# Everything beyond this comes from Discover (Flatpak), chosen BY the user.

# Web
firefox-esr

# Office — the three components people actually use, not the full suite
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-kf6

# Media — one player that plays everything
mpv

# Music library — mpv plays files, but a switcher expects a real music app
# with a library, playlists, and album art. Elisa is KDE's own: small, no
# accounts, no cloud. (Audit: free had no music library at all.)
elisa
