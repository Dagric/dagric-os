# Dagric OS Pro — Developer toolchain
# "Zero-friction setup out of the box."

# Containers
docker.io
docker-compose
podman

# Any distro in a terminal: run Ubuntu/Fedora/Arch toolchains inside
# containers with full host integration (audio, GPU, home dir) —
# legacy tools without polluting the host
distrobox

# Core toolchain
build-essential
git
python3-pip
python3-venv

# SSH — client for reaching servers, server present but DISABLED by
# default (enable with: sudo systemctl enable --now ssh)
openssh-client
openssh-server
