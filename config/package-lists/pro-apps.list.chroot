# Freehold OS Pro — Creator suite
# (These lists are removed for free-edition builds; the free ISO stays lean.)

# Second browser: open-source Chromium alongside Firefox ESR
chromium

# Email, calendar, contacts
thunderbird

# The FULL office suite (free edition ships Writer/Calc/Impress only)
libreoffice

# Creative tools
inkscape
gimp
blender
krita

# Video: recording and editing
obs-studio
kdenlive

# Backup: local + any cloud (Borg with a friendly GUI, rclone for
# Drive/Dropbox/S3/OneDrive and 70+ other providers)
borgbackup
vorta
rclone

# System restore points — roll the OS back if an update or driver
# ever goes sideways (rsync mode works on the default ext4 install;
# btrfs snapshot mode lights up automatically on btrfs installs)
timeshift

# Mobile integration — notifications, file transfer, remote input,
# clipboard sync with Android/iOS via the KDE Connect app
kdeconnect

# A more colorful, modern icon set for the Pro look
papirus-icon-theme
