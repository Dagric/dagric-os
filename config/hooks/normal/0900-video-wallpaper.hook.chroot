#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS Pro — video wallpapers.
#
# Vendors "Smart Video Wallpaper Reborn" (GPL-2.0-or-later, pure QML) as a
# normal Plasma wallpaper plugin. Plasma discovers anything under
# /usr/share/plasma/wallpapers/<id>/ with no registration step, so this needs
# no compilation, no kpackagetool6, and no KDE Store / GHNS network calls at
# runtime — the owner just picks it in Configure Desktop and Wallpaper.
#
# WHY NOT the alternatives: linux-wallpaperengine is GPL code that is useless
# without Wallpaper Engine's PROPRIETARY, non-redistributable Steam assets, so
# Dagric will not ship or "helpfully" install it. Hidamari is GNOME/X11-shaped
# and behaves poorly on Plasma Wayland.
#
# Pinned to a release + sha256, mirroring the grub-btrfs vendoring in 0800:
# a moving branch is a supply-chain hole. Failure is never fatal — the build
# continues without the feature rather than shipping a broken image.
#
# Pro only: video wallpapers are a "complete", not a "correct", feature, and
# decoding video continuously costs battery. Free keeps Plasma's own
# Slideshow / Picture-of-the-Day plugins, which cost nothing.
EDITION=$(cat /etc/dagric-edition 2>/dev/null || echo free)
[ "$EDITION" = "pro" ] || exit 0

VER=2.13.0
SHA=00b405e2ad7d4e777c6a257487e27fb9aa7c9a5ab88ea06ff944c8954944f4e0
ID=luisbocanegra.smart.video.wallpaper.reborn
URL="https://github.com/luisbocanegra/plasma-smart-video-wallpaper-reborn/releases/download/v${VER}/plasma-smart-video-wallpaper-reborn-v${VER}.tar.gz"
DEST="/usr/share/plasma/wallpapers/$ID"

TMP=/tmp/videowall
mkdir -p "$TMP"

if ! curl -fsSL -o "$TMP/p.tar.gz" "$URL" 2>/dev/null; then
    echo "WARNING: video wallpaper download failed — feature skipped"
    rm -rf "$TMP"; exit 0
fi

GOT=$(sha256sum "$TMP/p.tar.gz" | cut -d' ' -f1)
if [ "$GOT" != "$SHA" ]; then
    echo "WARNING: video wallpaper CHECKSUM MISMATCH — refusing to install"
    echo "  expected $SHA"
    echo "  got      $GOT"
    rm -rf "$TMP"; exit 0
fi

mkdir -p "$TMP/x"
# Checked by hand rather than with `set -e`. This is the only hook in
# config/hooks/normal without it, and deliberately so: the policy at the top of
# this file is that failure is never fatal, and `set -e` would abort the whole
# build instead of skipping one Pro extra. What was wrong was leaving tar and cp
# unchecked at all — a truncated archive fell straight through to the copy below
# and the hook still printed "installed".
if ! tar xzf "$TMP/p.tar.gz" -C "$TMP/x"; then
    echo "WARNING: video wallpaper archive did not unpack — feature skipped"
    rm -rf "$TMP"; exit 0
fi

# The archive unpacks with metadata.json + contents/ at its root.
SRC=$(dirname "$(find "$TMP/x" -name metadata.json | head -1)")
if [ -z "$SRC" ] || [ ! -d "$SRC/contents" ]; then
    echo "WARNING: unexpected video wallpaper archive layout — skipped"
    rm -rf "$TMP"; exit 0
fi

mkdir -p "$DEST"
# A half-copied plugin is worse than no plugin. Plasma discovers ANY directory
# under wallpapers/ that holds a metadata.json, so a $DEST left with the
# metadata and an incomplete contents/ shows up in Configure Desktop and
# Wallpaper on a Pro machine and fails the moment the owner picks it. Take the
# partial install back out rather than ship it.
if ! cp -r "$SRC/metadata.json" "$SRC/contents" "$DEST/"; then
    echo "WARNING: video wallpaper files did not copy — removing the partial plugin"
    rm -rf "$DEST" "$TMP"; exit 0
fi

# Upstream's installer marks this helper executable; git/tar preserve it, but
# be explicit so the pause-on-fullscreen detection works either way.
[ -f "$DEST/contents/ui/tools/gdbus_get_signal.sh" ] && \
    chmod 755 "$DEST/contents/ui/tools/gdbus_get_signal.sh"

# Ship the licence alongside, as with every other vendored component.
#
# GPL-2.0 section 1 requires us to "give any other recipients of the Program a
# copy of this License along with the Program". A line naming the licence is not
# a copy of it, and that line was the branch that actually ran: $SRC is the
# directory holding metadata.json, and the upstream RELEASE asset is a packaged
# Plasma addon (metadata.json + contents/) rather than the git tree, so
# $SRC/LICENSE usually does not exist. Look for it anywhere in the unpacked
# archive, and when there genuinely is none, point at the verbatim GPL-2 that
# base-files already puts on every Debian machine.
mkdir -p /usr/share/doc/dagric-video-wallpaper
VWLIC=$(find "$TMP/x" -maxdepth 3 \( -iname 'LICENSE*' -o -iname 'COPYING*' \) -type f 2>/dev/null | head -1)
if [ -n "$VWLIC" ]; then
    cp "$VWLIC" /usr/share/doc/dagric-video-wallpaper/LICENSE
else
    printf 'Smart Video Wallpaper Reborn v%s\nCopyright (C) Luis Bocanegra and contributors\nGNU General Public License, version 2 or (at your option) any later version.\nThe verbatim licence text is on this machine at /usr/share/common-licenses/GPL-2.\nCorresponding source: %s\n' \
        "$VER" \
        "https://github.com/luisbocanegra/plasma-smart-video-wallpaper-reborn" \
        > /usr/share/doc/dagric-video-wallpaper/LICENSE
fi
chmod 0644 /usr/share/doc/dagric-video-wallpaper/LICENSE

rm -rf "$TMP"
echo "Video wallpaper plugin installed ($ID v$VER)"
