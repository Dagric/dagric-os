#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS Pro — edition-specific configuration.
# No-op on free-edition builds (checks /etc/dagric-edition).
set -e

EDITION=$(cat /etc/dagric-edition 2>/dev/null || echo free)
[ "$EDITION" = "pro" ] || exit 0

echo "Applying Dagric Pro configuration..."

# Identity: mark the OS as Pro
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Dagric OS Pro 1.0 (Foundation)"/' /usr/lib/os-release
printf 'VARIANT="Pro"\nVARIANT_ID=pro\n' >> /usr/lib/os-release

# The login screen says so too. The dagric SDDM theme draws one quiet line
# under the logo, fed from theme.conf's editionBadge key, which ships EMPTY —
# free renders nothing there. This is the first thing an owner sees on every
# boot, and on a household with one Pro and one free machine it is the
# at-a-glance difference.
#
# GUARDED, because this is the silent-sed shape this tree keeps getting burned
# by: if the key is ever renamed or dropped from theme.conf, the sed matches
# nothing, exits 0, and Pro quietly ships a login screen identical to free's.
SDDMCONF=/usr/share/sddm/themes/dagric/theme.conf
if [ ! -f "$SDDMCONF" ]; then
    echo "ERROR: $SDDMCONF missing — is the dagric SDDM theme still shipped?" >&2
    exit 1
fi
sed -i 's/^editionBadge=.*/editionBadge=PRO EDITION/' "$SDDMCONF"
if ! grep -q '^editionBadge=PRO EDITION$' "$SDDMCONF"; then
    echo "ERROR: editionBadge did not take in $SDDMCONF — the key the sed" >&2
    echo "       targets is gone, and the Pro login screen would be" >&2
    echo "       indistinguishable from free's." >&2
    exit 1
fi
echo "pro-edition: login screen badge set"

# SSH server: installed but off until the owner turns it on. Ship a hardened
# drop-in so that IF it's ever enabled, it starts locked down rather than at
# stock Debian defaults. Root login is disabled (users have sudo) and retries
# are capped; password auth stays on so enabling SSH doesn't lock out an owner
# who hasn't set up keys yet (they can switch to keys-only when ready).
systemctl disable ssh.service 2>/dev/null || true
mkdir -p /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/50-dagric.conf << 'EOF'
# Dagric OS hardened SSH defaults (only apply if the owner enables sshd).
PermitRootLogin no
MaxAuthTries 3
X11Forwarding no
# For a keys-only posture, also set: PasswordAuthentication no
EOF

# 32-bit land: classic Windows .exe installers (wine32) and 32-bit Vulkan
# (DXVK/Proton) need i386 multiarch, so they install here, after it's enabled.
# NOTE: Steam is deliberately NOT installed here. steam-installer lives in
# Debian non-free and carries Valve's EULA; per the owner's mandate, Steam is
# NEVER bundled — it's a one-click, user-consented install via `dagric-get-steam`
# (surfaced in the Dagric Hub). We only preinstall the open-source 32-bit deps
# so that when the owner does opt into Steam, everything it needs is ready.
#
# TWO apt CALLS, NOT ONE, AND THE SPLIT IS THE POINT. wine32 and the 32-bit
# Vulkan driver are what make a classic .exe installer run at all; the overlay
# and profiler halves below are quality-of-life. A single combined call fails as
# a unit, so one unavailable overlay package would take 32-bit Wine down with
# it — and the `|| echo WARNING` would let the build carry on and ship a Pro ISO
# that cannot run the software its own sales page leads with. Keep the first
# call load-bearing and let only the second be tolerant.
if dpkg --add-architecture i386 && apt-get update -qq; then
    apt-get install -y wine32:i386 mesa-vulkan-drivers:i386 || \
        echo "WARNING: wine32/vulkan32 install failed — 64-bit Wine only"

    # THE HALVES --apt-recommends false DROPPED. gamemode's Recommends line is
    # ENTIRELY "libgamemode0:i386, libgamemodeauto0:i386" — so with Recommends
    # off, `gamemoderun` did nothing whatsoever on a 32-bit title, which is most
    # of the classic games this edition exists to run, and precisely the command
    # manual/app-gameperf.html teaches by name. mangohud:i386 is the overlay's
    # matching half. dxvk-wine32 is architecture i386 only and therefore cannot
    # come through a package list at all, which is why it is here: without it,
    # `dxvk-setup install` gives a 32-bit prefix the slow WineD3D path while
    # reporting success.
    #
    # mangohud:i386 pulls libspdlog1.15:i386. Note for anyone auditing this
    # later: libspdlog1.15-fmt10 is NOT a package name in the i386 index, which
    # looks like a missing dependency and is not — libspdlog1.15 PROVIDES it.
    # Do not "fix" this by removing mangohud:i386.
    apt-get install -y libgamemode0:i386 libgamemodeauto0:i386 mangohud:i386 \
                       dxvk-wine32:i386 || \
        echo "WARNING: 32-bit overlay/profiler install failed — 64-bit only"
else
    echo "WARNING: could not enable i386 multiarch"
fi

# NOTE: we deliberately do NOT ship ttf-mscorefonts-installer — it fetches
# Microsoft's proprietary fonts under a EULA (not open source). The
# open-source Carlito (Calibri-metric) + Caladea (Cambria-metric) + Liberation
# fonts in the base system give the same document layout fidelity, fully free.

# KDE Connect needs its ports open (firewalld ships a service preset). Bind it
# to the HOME zone, not public: 1714-1764 is a phone-pairing surface that has no
# business being reachable on café/airport Wi-Fi. Pairing works once the owner
# sets the connection's zone to home. dagric-setup does NOT offer this — its
# checklist is the NVIDIA driver, HP printers and Flathub and nothing else (see
# /usr/bin/dagric-setup) — so guide/index.html and manual/app-kdeconnect.html
# are the only places that tell an owner to do it. This line used to credit the
# wizard with a step it never had.
# KDE Connect's ports are opened in 0300-hardening.hook.chroot now, not here.
# The package moved to the free edition and this line did not move with it,
# which would have shipped a free image with KDE Connect installed and ports
# 1714-1764 shut — presenting to the owner as "pairing spins forever" and to us
# as nothing whatsoever, on the edition whose own package-list comment promises
# it reads as leaner and never as broken.

# Security Suite (Pro): OpenSnitch runs in monitor mode (permissive default
# config shipped in includes.chroot) so it never breaks connectivity out of
# the box; the owner opts into blocking from the GUI. USBGuard is installed
# but its service stays DISABLED — enabling it would block an unknown USB
# keyboard; it's surfaced as an opt-in toggle instead.
# USBGuard: MUST stay fully inert until the owner opts in through
# dagric-usb-protect. Disabling usbguard.service alone is NOT enough — Debian's
# preset enables usbguard-dbus.service, which declares Requires=usbguard.service
# and therefore starts the blocking daemon on every boot. With the shipped
# rules.conf empty and ImplicitPolicyTarget=block, that deauthorizes every USB
# device: the owner's keyboard and mouse go dead, and on a live-USB boot the
# stick backing the session can be cut off. (QEMU tests miss this — emulated
# input is PS/2.) Mask both units so nothing can pull them in; the opt-in
# helper unmasks, generates an allow-list from the currently attached devices,
# and only then starts them.
systemctl disable usbguard.service usbguard-dbus.service 2>/dev/null || true
systemctl mask usbguard.service usbguard-dbus.service 2>/dev/null || true
# The per-user notifier is globally enabled by the package; it is useless while
# the daemon is masked and only produces confusing popups.
systemctl --global disable usbguard-notifier.service 2>/dev/null || true

# KNOWN WEAKNESS, WRITTEN DOWN BECAUSE IT CANNOT BE FIXED FROM HERE.
#
# /etc/opensnitchd/default-config.json points the daemon at
# unix:///tmp/osui.sock — upstream's default, and JSON takes no comments, which
# is why this note lives in the hook that turns the daemon on.
#
# In OpenSnitch the UI is the gRPC SERVER and the root daemon is the client that
# dials it. So the socket is bound by an unprivileged desktop process in a
# world-writable directory. A second local user who binds that path before the
# real UI does receives every connection event on the machine (privacy) and
# answers the prompts that a ROOT daemon then enforces (rule injection). The
# sticky bit stops them deleting someone else's socket; it does not stop them
# getting there first.
#
# On a single-user home machine there is no second unprivileged user and this is
# close to unexploitable. Pro is now sold into schools and libraries, where a
# shared machine is the normal case, so it is worth stating plainly rather than
# leaving for someone to find.
#
# WHY IT IS NOT CHANGED HERE. Fixing it means moving BOTH ends. This file sets
# only the daemon's address; the UI picks its own at runtime. Move one and the
# root daemon never reaches a UI at all — and with DefaultAction "allow" above,
# that failure is silent: Pro's headline security feature becomes a no-op that
# still appears installed and running. Worse than the weakness.
#
# Two obvious fixes are not fixes. An abstract socket (unix-abstract://) is
# strictly worse — abstract names carry no filesystem permissions at all, so any
# user can bind one. A shared directory under /run only narrows the squatting
# set to desktop users, which on a school machine is exactly the threat.
#
# The real fix is a per-user path under /run/user/<uid>, which a static config
# cannot express, or upstream's UI authentication. Both need a booted Pro image
# to verify, and an unverified change here fails silently in the direction that
# costs a paying customer their firewall. Do not "tidy" this line without one.
#
# 2026-08-29, narrowing it for whoever does the booted test: the shipped daemon
# is opensnitch 1.6.9-3 and its binary carries both "Authentication" and
# "AuthType", so Server.Authentication IS expressible in this static config —
# which is the half of "upstream's UI authentication" that was unknown when the
# paragraph above was written. What is still missing is the certificate story:
# the useful modes are TLS, and per-machine key material has to be generated
# somewhere that is neither the ISO (identical keys on every machine, the exact
# defect a shipped ssh_host_key would be) nor first boot without a verified
# generator. So the shape of the fix is now: generate on first boot beside
# dagric-ssh-hostkeys.service, point both ends at it, and PROVE in a booted Pro
# VM that a prompt still appears — not "it looks right in the config".
#
# Disclosed rather than hidden while it stands: site/security.html lists it, so
# a buyer evaluating a shared machine reads it from us instead of finding it.
systemctl enable opensnitch.service 2>/dev/null || true

# CONTAINERD DOES NOT RUN ON A DESKTOP NOBODY ASKED TO RUN CONTAINERS ON.
#
# docker.io's postinst enables containerd.service, and nothing here turned it
# off — so every Pro machine booted with a root daemon holding a full container
# runtime API on /run/containerd/containerd.sock, with modprobe overlay,
# TasksMax=infinity, LimitNOFILE=infinity and OOMScoreAdjust=-999, whether or
# not the owner has ever touched a container. Verified in the shipped Pro
# squashfs: multi-user.target.wants/containerd.service was present.
#
# That contradicts the position stated forty lines above and in the manual: the
# heavy daemons ship OFF and start when the owner opts in. docker.service is
# correctly not enabled, so the intent was already right — containerd was simply
# missed, because it is enabled by a different package's postinst.
#
# Nothing breaks. docker.service declares Wants=containerd.service and
# After=containerd.service (verified in the shipped unit), so the first
# `systemctl start docker` pulls containerd up with it. podman does not use it
# at all. Not masked, only disabled — masking would make Docker fail to start
# instead of starting cleanly.
systemctl disable containerd.service 2>/dev/null || true
if [ -e /etc/systemd/system/multi-user.target.wants/containerd.service ]; then
    echo "0600: containerd.service is still enabled after disable — a Pro" >&2
    echo "      machine would run a root container runtime at every boot." >&2
    exit 1
fi

# THE INSTALL-TIME PROMPT. Enabling the service above also starts it in the LIVE
# session, which is where Calamares runs — and a real Pro install stopped at 42%
# on a modal OpenSnitch dialog about /usr/lib/apt/methods/http running from
# /tmp/calamares-root-fax7dcdx, with the Deny button counting down. Two shipped
# files stop that, and each is silent when it breaks, so both are asserted here
# rather than trusted:
#
#   * the drop-in skips the daemon when boot=live is on the kernel command line
#   * /etc/skel seeds global/default_action=1, so a prompt that nobody answers
#     ALLOWS instead of denying — matching default-config.json's DefaultAction
#     and what app-opensnitch.html has always told the owner
#
# Neither can be checked by booting quickly (the failure is a dialog that only
# appears mid-install), so the build checks the artefacts instead.
osfail=0
OSDROPIN=/etc/systemd/system/opensnitch.service.d/10-dagric-not-in-live.conf
if ! grep -q '^ConditionKernelCommandLine=!boot=live$' "$OSDROPIN" 2>/dev/null; then
    echo "ERROR: $OSDROPIN does not carry ConditionKernelCommandLine=!boot=live." >&2
    echo "       Without it opensnitchd runs in the live session and can" >&2
    echo "       interrupt an install with a prompt that defaults to Deny." >&2
    osfail=1
fi
OSSKEL=/etc/skel/.config/opensnitch/settings.conf
if ! grep -q '^default_action=1$' "$OSSKEL" 2>/dev/null; then
    echo "ERROR: $OSSKEL does not set default_action=1 (ACTION_ALLOW_IDX)." >&2
    echo "       Unset, the OpenSnitch UI seeds ACTION_DENY_IDX and every" >&2
    echo "       unanswered prompt blocks the program it asked about." >&2
    osfail=1
fi
if ! grep -q '^\[global\]$' "$OSSKEL" 2>/dev/null; then
    echo "ERROR: $OSSKEL has no [global] group, so QSettings will never read" >&2
    echo "       default_action out of it." >&2
    osfail=1
fi
# The tray UI is hidden in the live session to match the daemon being off.
OSLIVE=/usr/lib/live/config/2020-dagric-opensnitch-live
if [ ! -x "$OSLIVE" ]; then
    echo "ERROR: $OSLIVE is missing or not executable — live-config runs it by" >&2
    echo "       exec, so a lost mode bit leaves a disconnected firewall panel" >&2
    echo "       in the live session's tray." >&2
    osfail=1
fi
# A pre-answer naming a binary this image does not have is a rule that can never
# match. Every one of them has to point at something real.
for _r in /etc/opensnitchd/rules/*.json; do
    [ -f "$_r" ] || continue
    _p=$(sed -n 's/.*"data"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_r" | head -1)
    case "$_p" in
        /*) [ -e "$_p" ] || {
                echo "ERROR: ${_r##*/} pre-answers $_p, which is not in this image." >&2
                osfail=1
            } ;;
    esac
done
[ "$osfail" = 0 ] || exit 1

# Virtual machines: installed, but OFF until the owner asks for them.
# libvirt-daemon-system's postinst enables libvirtd (plus virtlogd and
# libvirt-guests) at boot — so without this, every Pro owner who never touches
# a VM would still run the VM daemons AND get a virbr0 NAT bridge with its own
# dnsmasq listening. That is exactly the surface a private, lean OS should not
# create uninvited, and it contradicts dagric-vm, which tells the owner it is
# turning the VM service on. Same lesson as USBGuard: a package's own postinst
# will happily enable things we intend to be opt-in.
# dagric-vm re-enables these (with the group setup) after the owner consents.
#
# virtlogd-admin.socket is in this list because it was missing from it. The
# libvirtd side names all three sockets (plain, -ro, -admin) and the virtlogd
# side named only two — and a still-enabled .socket starts its service on first
# connect, which is the precise mechanism spelled out for usbguard-dbus twenty
# lines above. Disabling virtlogd.service while leaving one of its sockets
# enabled is the same half-measure in a different package.
systemctl disable libvirtd.service libvirtd.socket libvirtd-ro.socket \
    libvirtd-admin.socket virtlogd.service virtlogd.socket \
    virtlogd-admin.socket libvirt-guests.service 2>/dev/null || true
# The default NAT network autostarts when libvirtd first runs; drop the
# autostart link so even enabling the daemon doesn't silently add a bridge.
rm -f /etc/libvirt/qemu/networks/autostart/default.xml 2>/dev/null || true

# Docker: installed, but OFF until the owner asks for it. THIRD INSTANCE of the
# pattern this hook already documents twice, and the one that was left running.
#
# docker.io is in pro-dev.list.chroot and its postinst enables docker.service
# and docker.socket, exactly as usbguard-dbus and libvirtd did. So every Pro
# machine — including the school and library machines this tier is now sold into
# — booted a root container daemon nobody had asked for. That is not free: it
# creates the docker0 bridge, sets net.ipv4.ip_forward=1 for the whole system,
# and inserts Docker's own DOCKER and DOCKER-USER chains, which are famous for
# taking published container ports straight past firewalld's zones. This image
# spends a lot of effort closing ssh in six zones; leaving a daemon running that
# can route around those zones on request is not consistent with that.
#
# Nothing is exposed on a machine with no containers, so this is surface rather
# than a hole — which is why it is a plain disable and not an alarm.
#
# The socket must go too, or this achieves nothing: socket activation starts the
# daemon on the first connection to /var/run/docker.sock regardless of whether
# the service is enabled. Same lesson as usbguard-dbus.
#
# containerd.service is deliberately LEFT ALONE. It is a root daemon, but it
# opens no bridge, sets no sysctl and touches no firewall rule, and Debian's
# docker.service declares a dependency on it — disabling it here risks docker
# refusing to start for the owner who turns it on, to remove surface that is not
# actually the problem. The problem is the networking, and that comes with
# dockerd.
#
# Turning it on is one command, and app-docker.html says so on the page where
# somebody would look: sudo systemctl enable --now docker
systemctl disable docker.service docker.socket 2>/dev/null || true

# Whether that actually took is checked at the end of this hook, together with
# every other unit Pro intends to ship switched off.

# Pro look: Papirus icons by default for new users.
#
# Papirus-LIGHT, and the variant is the entire point of these lines. Upstream
# ships three and they differ only in the colour of the panel/status icons:
#   Papirus-Dark   for a dark panel and dark scheme  — all icons LIGHT
#   Papirus        for a dark panel, light scheme    — panel icons LIGHT
#   Papirus-Light  for a light panel and light scheme — all icons DARK
#
# This wrote Papirus-Dark. Nothing on either edition selects a dark scheme:
# 0500-desktop-defaults keys the Breeze look-and-feel defaults to DagricLight,
# a LIGHT scheme, so Plasma paints a light panel — and the first icons a Windows
# switcher looks for, the tray's volume, network, battery, Bluetooth and
# clipboard, were the pale-grey set drawn on top of it. Low contrast on the
# edition somebody paid for, and the opposite of the 7:1 floor
# 0530-accessibility.hook.chroot fails the build over.
#
# Plain "Papirus" is NOT the neutral choice it looks like — its panel icons are
# the light ones too. If the shipped default scheme ever becomes dark, this line
# has to move to Papirus-Dark with it.
if [ ! -d /usr/share/icons/Papirus-Light ]; then
    # Loud rather than silent: an icon theme that is not there does not fail,
    # it falls back to hicolor and the Pro desktop quietly looks unbranded.
    echo "WARNING: /usr/share/icons/Papirus-Light missing — Pro icon default will not apply." >&2
fi
# WRITTEN TO /etc/xdg, NOT APPENDED TO THE SKEL CONFFILE. This used to be
#
#     printf '\n[Icons]\nTheme=Papirus-Light\n' >> /etc/skel/.config/kdeglobals
#
# and that file is a CONFFILE of dagric-desktop-defaults. Hooks run after the
# packages are installed, so the append happened after dpkg had already recorded
# the file's md5 — leaving every Pro machine with a conffile dpkg considers
# locally modified before the owner has touched anything. Verified in the
# shipped Pro ISO: dpkg records c25df7e92d6908a6b63f0b9a2c77c9e1 while the file
# on disk hashes 60ac08cfcbcc05677f51691e093a7241. The free image's copy matches
# its record exactly, so this was Pro-only.
#
# The bill comes due on the first channel update that changes kdeglobals: dpkg
# raises the conffile prompt on every Pro machine at once. Under Discover, or
# any noninteractive apt, that is "EOF on stdin at conffile prompt" and a failed
# upgrade — the same trap dagric-upgrade-to-pro's own comments document. Answer
# "keep the old one" and Pro machines silently stop receiving kdeglobals fixes
# that free machines get.
#
# /etc/xdg/kdeglobals is read by every KDE application as the system-wide
# fallback beneath ~/.config/kdeglobals, it is owned by no package (so it can
# never prompt), and it is strictly better than skel besides: skel only reaches
# accounts created AFTER it is written, while this applies to the account the
# installer just made and to every account added later. Verified absent from
# both shipped images, so nothing is being overwritten.
#
# dagric-upgrade-to-pro writes the same file for the same reason — a machine
# upgraded from free and a machine installed from the Pro ISO must not look
# different.
mkdir -p /etc/xdg
if ! grep -q '^Theme=Papirus-Light' /etc/xdg/kdeglobals 2>/dev/null; then
    printf '[Icons]\nTheme=Papirus-Light\n' >> /etc/xdg/kdeglobals
fi
grep -q '^Theme=Papirus-Light' /etc/xdg/kdeglobals || {
    echo "0600: failed to set the Pro icon default in /etc/xdg/kdeglobals" >&2
    exit 1
}
# And undo the old append if a previous build of this tree left it behind, so
# the conffile goes back to matching the md5 dpkg recorded for it. includes.chroot
# is copied in before hooks run, so on a clean build there is nothing to undo;
# this is for a rebuild over a cached chroot. The trailing-blank-line trim is
# what actually restores the recorded md5 — deleting the section alone leaves
# the separator line the append had added, and the hash still would not match.
if grep -q '^\[Icons\]' /etc/skel/.config/kdeglobals 2>/dev/null; then
    sed -i '/^\[Icons\]$/,/^Theme=Papirus-Light$/d' /etc/skel/.config/kdeglobals
    awk '{ l[NR] = $0 }
         END { last = NR
               while (last > 0 && l[last] ~ /^[ \t]*$/) last--
               for (i = 1; i <= last; i++) print l[i] }' \
        /etc/skel/.config/kdeglobals > /tmp/kdeglobals.trim &&
        mv /tmp/kdeglobals.trim /etc/skel/.config/kdeglobals
fi

# NOTE — the launcher entries used to be written here, and that was a bug.
#
# This hook rewrote fourteen /usr/share/applications/dagric-*.desktop files with
# plain here-docs. includes.chroot is copied in BEFORE hooks run (0800 documents
# the same ordering), so on every Pro build those here-docs overwrote the files
# tools/i18n-desktop.py had already filled with Name[de]/GenericName[xx]/
# Comment[xx]/Keywords[xx] — and reverted the English copy to older wording at
# the same time. A Pro owner in German got an English launcher; a free owner did
# not, because this hook exits at line 9. Nothing caught it: i18n-desktop.py
# --check grades config/includes.chroot, not the image.
#
# Every one of those entries now lives in config/includes.chroot as a reviewable
# file with its translations attached, dagric-gaming.desktop included. The two
# that are genuinely Pro-only (dagric-usb-protect, dagric-vm) carry
# X-Dagric-Edition=pro and are deleted from free by 0510-app-names, which runs
# before this hook — so there is nothing left for this hook to write.
#
# dagric-gaming.desktop carried that flag too, and that was a transcription of
# an accident rather than a decision: this hook exits on free (line 9), so an
# entry written HERE had always been Pro-only, and flagging the moved file kept
# that side effect alive. Free's own manual page for the helper is marked
# data-avail="free" and tells the owner to open launcher -> Gaming Setup, and
# the Hub offers the row on both editions. The flag is gone and the entry now
# ships on both; the reasoning is repeated in the .desktop file itself so it is
# not "restored" by the next reader.

# PhotoGIMP (Diolinux): familiar Photoshop-style layout for GIMP.
# Best-effort download at build time; the build continues without it
# if the network or upstream is unavailable.
#
# SUPPLY-CHAIN NOTE, and it is still not good enough. This fetches a MOVING
# BRANCH — no tag, no checksum, no signature — so whatever is on master at the
# minute the ISO is built is what ships into every Pro owner's home directory.
# Two Pro ISOs built a week apart under the same version number can carry
# different third-party payloads with nothing recording which.
#
# This comment used to claim that "no pinned tag/checksum is possible in this
# offline build environment". That was false, and provably so from this very
# build: 0800-snapshot-recovery pins grub-btrfs 4.14 and runs sha256sum -c, and
# 0900-video-wallpaper pins a release tarball and compares its sha256 — both
# succeeded in the same container in the same run. The build has network. The
# excuse was wrong and it is deleted.
#
# NOW PINNED. PG_VER is an upstream RELEASE TAG and PG_SHA256 is that tag
# archive's real hash, both taken from GitHub on 2026-08-29:
#
#     https://api.github.com/repos/Diolinux/PhotoGIMP/releases/latest -> "3.1"
#     tags/3.1.zip = 3662002 bytes, sha256 05ca5693...cadebbb
#
# so two Pro ISOs carrying the same version number now carry the same third-party
# payload, and "which PhotoGIMP is in this image" is answerable from the image.
#
# THE MISMATCH PATH IS A WARNING, NOT A BUILD FAILURE, matching the policy
# 0900-video-wallpaper states for the same class of vendored extra: a Pro extra
# that cannot be verified is skipped, not shipped unverified, and the build goes
# on. That is the opposite of silent — it prints both hashes. The paragraph this
# replaces worried that a wrong checksum would make the feature "silently never
# install"; the fix for that is to be loud, not to stay unpinned.
#
# The blast radius stays bounded twice over besides: the allow-list copies only
# the GIMP profile directory — never a blanket `cp -r *`, which stops an injected
# .config/autostart/*.desktop from auto-executing at first login — AND every
# executable surface inside that profile is stripped after the copy, below.
PG_VER=3.1
PG_SHA256=05ca56937dbe9aa5ea6b6a18b4cb530f4e508e61ce69afd58caba0414cadebbb
PG_URL="https://github.com/Diolinux/PhotoGIMP/archive/refs/tags/${PG_VER}.zip"
PG_TMP=/tmp/photogimp
mkdir -p "$PG_TMP"
if curl -fsSL -o "$PG_TMP/pg.zip" "$PG_URL" 2>/dev/null; then
    PG_GOT=$(sha256sum "$PG_TMP/pg.zip" | cut -d' ' -f1)
    if [ "$PG_GOT" != "$PG_SHA256" ]; then
        echo "WARNING: PhotoGIMP $PG_VER CHECKSUM MISMATCH — refusing to install"
        echo "  expected $PG_SHA256"
        echo "  got      $PG_GOT"
        rm -rf "$PG_TMP"
        PG_TMP=""
    fi
fi
if [ -n "$PG_TMP" ] && [ -f "$PG_TMP/pg.zip" ]; then
    if command -v unzip >/dev/null 2>&1 || apt-get install -y -qq unzip >/dev/null 2>&1; then
        unzip -q "$PG_TMP/pg.zip" -d "$PG_TMP"
        SRC=$(find "$PG_TMP" -maxdepth 2 -type d -name ".config" | head -1)
        # Only proceed if the payload actually looks like PhotoGIMP (a GIMP
        # profile dir present) — a sanity gate against a garbage/hostile zip.
        if [ -n "$SRC" ] && [ -d "$SRC/GIMP" ]; then
            mkdir -p /etc/skel/.config
            # Allow-list: copy ONLY the GIMP profile (and MyPaint brushes if
            # present). Never a blanket `cp -r *` — that was the injection path.
            cp -r "$SRC/GIMP" /etc/skel/.config/
            [ -d "$SRC/MyPaint" ] && cp -r "$SRC/MyPaint" /etc/skel/.config/

            # Now strip everything GIMP would EXECUTE out of that profile.
            #
            # Stopping the allow-list at "only the GIMP directory" was not
            # actually enough: GIMP loads and RUNS scripts/*.scm (Script-Fu),
            # plug-ins/, modules/ and interpreters/ from the USER profile at
            # startup. So an unpinned archive still reached code execution on
            # every new Pro user's first launch of GIMP — a narrower path than
            # .config/autostart, but the same outcome.
            #
            # Nothing of value is lost. PhotoGIMP is a LAYOUT: menurc, sessionrc,
            # toolrc, themes, icons, brushes, splashes. None of that is
            # executable, and all of it survives this.
            for X in scripts plug-ins modules interpreters; do
                rm -rf "/etc/skel/.config/GIMP"/*/"$X"
            done

            # SHIP THE LICENCE, as 0800 and 0900 already do for the other two
            # vendored components. PhotoGIMP is GPL-3.0 — its repository root
            # carries the full GPLv3 text in LICENSE — and section 4 requires
            # every copy conveyed to "keep intact all notices stating that this
            # License ... applies to the code". Pro was putting PhotoGIMP's
            # files into every new user's home with no notice anywhere on the
            # machine, while site/licenses.html names PhotoGIMP by name as an
            # extra that keeps its upstream licence. $SRC is the .config
            # directory, so the archive root — where LICENSE lives — is its
            # parent.
            mkdir -p /usr/share/doc/dagric-photogimp
            PG_ROOT=$(dirname "$SRC")
            if [ -f "$PG_ROOT/LICENSE" ]; then
                cp "$PG_ROOT/LICENSE" /usr/share/doc/dagric-photogimp/LICENSE
            else
                printf 'PhotoGIMP (Diolinux) — GNU General Public License v3.0.\nThe verbatim licence text is on this machine at /usr/share/common-licenses/GPL-3.\nCorresponding source: %s\n' \
                    "https://github.com/Diolinux/PhotoGIMP" \
                    > /usr/share/doc/dagric-photogimp/LICENSE
            fi
            chmod 0644 /usr/share/doc/dagric-photogimp/LICENSE

            # PROVENANCE, so a shipped image can be audited without the build
            # host. Until this existed, /usr/share/doc/dagric-photogimp held one
            # file — the verbatim GPLv3 text, which identifies nothing — and
            # there was no way, from an ISO in a customer's hands, to say which
            # PhotoGIMP tree had seeded every new user's home. That is the half
            # of the supply-chain problem a pin alone does not solve: the pin
            # makes the build reproducible, this makes it auditable.
            cat > /usr/share/doc/dagric-photogimp/PROVENANCE <<PROV
PhotoGIMP, as vendored into Dagric OS Pro.

Upstream:  https://github.com/Diolinux/PhotoGIMP
Release:   $PG_VER
Archive:   $PG_URL
sha256:    $PG_SHA256
Verified:  yes — the build refuses to install this layout on a hash mismatch.
Installed: /etc/skel/.config/GIMP (profile only)

Scripts, plug-ins, modules and interpreters are removed from the profile
before it ships: GIMP executes those from the user profile at startup, and
nothing in a layout needs them. What remains is configuration and artwork.
PROV
            chmod 0644 /usr/share/doc/dagric-photogimp/PROVENANCE

            echo "PhotoGIMP $PG_VER installed for new users (profile only, no executables, sha256 verified)"
        else
            echo "WARNING: PhotoGIMP archive missing a GIMP profile — skipped"
        fi
    else
        # This branch did not exist, and its absence was the one silent path
        # left in the hook: with unzip missing and unable to be installed, the
        # inner `if` simply fell through and PhotoGIMP was skipped with no
        # output at all, unlike every other failure here.
        echo "WARNING: unzip unavailable — PhotoGIMP skipped, GIMP ships stock"
    fi
else
    echo "WARNING: PhotoGIMP $PG_VER not installed (download failed or hash mismatch)"
fi
[ -n "$PG_TMP" ] && rm -rf "$PG_TMP"

# --- DID THE OPT-IN POLICY ACTUALLY TAKE? -----------------------------------
#
# Everything above that switches something off does it with
# `systemctl disable ... 2>/dev/null || true`, which is silent in both
# directions. The postinsts they are undoing are not. The Pro build log reads,
# in full:
#
#     Setting up docker.io (26.1.5+dfsg1-9+b13) ...
#     Created symlink '/etc/systemd/system/multi-user.target.wants/docker.service'
#     Created symlink '/etc/systemd/system/sockets.target.wants/docker.socket'
#
# ...and then nothing whatsoever about them being removed. So the only evidence
# in the log points the wrong way, and a disable that quietly failed would look
# exactly like a disable that worked. This hook already carries three long
# comments about postinsts enabling things behind our backs; not one line
# anywhere confirmed we had won any of those arguments.
#
# The .wants symlink IS what "enabled" means for these units, so its absence is
# the answer. Checked rather than assumed, and printed either way — Pro is the
# paid edition and "nothing is listening until you say so" is a claim the
# product makes on its own website.
#
# A warning, not an exit: a twenty-minute build that has otherwise succeeded
# must not be destroyed at the very end, and this is visible in CI either way.
# THE PATHS BELOW ARE COPIED FROM A REAL BUILD LOG, NOT GUESSED, and writing
# them from memory got two of them wrong. Every "Created symlink" line the
# postinsts emit was extracted from Pro run 30743351874 and the list matched
# against it. usbguard.service is wanted by basic.target, NOT multi-user like
# every other unit here — checking the obvious path would have meant this loop
# silently never looked at usbguard at all, which is the exact failure it exists
# to catch. libvirtd-ro, libvirtd-admin and virtlogd.service were simply absent.
# libvirt-guests.service was NOT absent: the disable above names it and
# out/pro-release-build.log:14088 shows the postinst creating its
# multi-user.target.wants symlink, yet it was missing from this loop. The list
# was matched against the log, but not against all of it — so the line that
# certifies "nothing is listening until you say so" was printing success for
# libvirt after checking three of the four libvirt units this hook turns off.
#
# A check written from an assumption about the system is worth nothing; the
# postinsts name their own paths and that is the source used.
#
# ssh.socket is listed although this Debian does not enable it — the postinst
# only creates multi-user.target.wants/ssh.service. A path that never exists
# costs nothing, and socket activation appearing in a later Debian is precisely
# the change that would otherwise reopen "nothing is listening until you say so"
# without a word in the log.
_bad=""
for _u in multi-user.target.wants/docker.service \
          sockets.target.wants/docker.socket \
          multi-user.target.wants/ssh.service \
          sockets.target.wants/ssh.socket \
          multi-user.target.wants/libvirtd.service \
          multi-user.target.wants/libvirt-guests.service \
          sockets.target.wants/libvirtd.socket \
          sockets.target.wants/libvirtd-ro.socket \
          sockets.target.wants/libvirtd-admin.socket \
          multi-user.target.wants/virtlogd.service \
          sockets.target.wants/virtlogd.socket \
          sockets.target.wants/virtlogd-admin.socket \
          basic.target.wants/usbguard.service \
          multi-user.target.wants/usbguard-dbus.service; do
    [ -e "/etc/systemd/system/$_u" ] && _bad="$_bad ${_u##*/}"
done
if [ -n "$_bad" ]; then
    echo "WARNING: these should ship DISABLED on Pro and are still enabled:" >&2
    echo "        $_bad" >&2
    echo "         Each one is something the owner is supposed to opt into." >&2
else
    echo "pro: opt-in policy verified — docker, ssh, libvirt, virtlogd and usbguard all disabled"
fi
unset _bad _u
