#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS Pro — edition-specific configuration.
# No-op on free-edition builds (checks /etc/dagric-edition).
set -e

EDITION=$(cat /etc/dagric-edition 2>/dev/null || echo free)
[ "$EDITION" = "pro" ] || exit 0

echo "Applying Dagric Pro configuration..."

# Identity: mark the OS as Pro
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Dagric OS Pro 1.0 (Foundation)"/' /usr/lib/os-release
printf 'VARIANT="Pro"\nVARIANT_ID=pro\n' >> /usr/lib/os-release

# SSH server: installed but off until the owner turns it on. Ship a hardened
# drop-in so that IF it's ever enabled, it starts locked down rather than at
# stock Debian defaults. Root login is disabled (users have sudo) and retries
# are capped; password auth stays on so enabling SSH doesn't lock out an owner
# who hasn't set up keys yet (they can switch to keys-only when ready).
systemctl disable ssh.service 2>/dev/null || true
mkdir -p /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/50-dagric.conf << 'EOF'
# Dagric OS hardened SSH defaults (only apply if the owner enables sshd).
PermitRootLogin no
MaxAuthTries 3
X11Forwarding no
# For a keys-only posture, also set: PasswordAuthentication no
EOF

# 32-bit land: classic Windows .exe installers (wine32) and 32-bit Vulkan
# (DXVK/Proton) need i386 multiarch, so they install here, after it's enabled.
# NOTE: Steam is deliberately NOT installed here. steam-installer lives in
# Debian non-free and carries Valve's EULA; per the owner's mandate, Steam is
# NEVER bundled — it's a one-click, user-consented install via `dagric-get-steam`
# (surfaced in the Dagric Hub). We only preinstall the open-source 32-bit deps
# so that when the owner does opt into Steam, everything it needs is ready.
if dpkg --add-architecture i386 && apt-get update -qq; then
    apt-get install -y wine32:i386 mesa-vulkan-drivers:i386 || \
        echo "WARNING: wine32/vulkan32 install failed — 64-bit Wine only"
else
    echo "WARNING: could not enable i386 multiarch"
fi

# NOTE: we deliberately do NOT ship ttf-mscorefonts-installer — it fetches
# Microsoft's proprietary fonts under a EULA (not open source). The
# open-source Carlito (Calibri-metric) + Caladea (Cambria-metric) + Liberation
# fonts in the base system give the same document layout fidelity, fully free.

# KDE Connect needs its ports open (firewalld ships a service preset). Bind it
# to the HOME zone, not public: 1714-1764 is a phone-pairing surface that has no
# business being reachable on café/airport Wi-Fi. Pairing works once the owner
# marks the network as trusted (dagric-setup offers this; the guide explains it).
firewall-offline-cmd --zone=home --add-service=kdeconnect 2>/dev/null || \
    echo "WARNING: could not preopen KDE Connect ports"

# Security Suite (Pro): OpenSnitch runs in monitor mode (permissive default
# config shipped in includes.chroot) so it never breaks connectivity out of
# the box; the owner opts into blocking from the GUI. USBGuard is installed
# but its service stays DISABLED — enabling it would block an unknown USB
# keyboard; it's surfaced as an opt-in toggle instead.
# USBGuard: MUST stay fully inert until the owner opts in through
# dagric-usb-protect. Disabling usbguard.service alone is NOT enough — Debian's
# preset enables usbguard-dbus.service, which declares Requires=usbguard.service
# and therefore starts the blocking daemon on every boot. With the shipped
# rules.conf empty and ImplicitPolicyTarget=block, that deauthorizes every USB
# device: the owner's keyboard and mouse go dead, and on a live-USB boot the
# stick backing the session can be cut off. (QEMU tests miss this — emulated
# input is PS/2.) Mask both units so nothing can pull them in; the opt-in
# helper unmasks, generates an allow-list from the currently attached devices,
# and only then starts them.
systemctl disable usbguard.service usbguard-dbus.service 2>/dev/null || true
systemctl mask usbguard.service usbguard-dbus.service 2>/dev/null || true
# The per-user notifier is globally enabled by the package; it is useless while
# the daemon is masked and only produces confusing popups.
systemctl --global disable usbguard-notifier.service 2>/dev/null || true
systemctl enable opensnitch.service 2>/dev/null || true

# Virtual machines: installed, but OFF until the owner asks for them.
# libvirt-daemon-system's postinst enables libvirtd (plus virtlogd and
# libvirt-guests) at boot — so without this, every Pro owner who never touches
# a VM would still run the VM daemons AND get a virbr0 NAT bridge with its own
# dnsmasq listening. That is exactly the surface a private, lean OS should not
# create uninvited, and it contradicts dagric-vm, which tells the owner it is
# turning the VM service on. Same lesson as USBGuard: a package's own postinst
# will happily enable things we intend to be opt-in.
# dagric-vm re-enables these (with the group setup) after the owner consents.
systemctl disable libvirtd.service libvirtd.socket libvirtd-ro.socket \
    libvirtd-admin.socket virtlogd.service virtlogd.socket \
    libvirt-guests.service 2>/dev/null || true
# The default NAT network autostarts when libvirtd first runs; drop the
# autostart link so even enabling the daemon doesn't silently add a bridge.
rm -f /etc/libvirt/qemu/networks/autostart/default.xml 2>/dev/null || true

# Pro look: Papirus icons by default for new users
if ! grep -q '^\[Icons\]' /etc/skel/.config/kdeglobals 2>/dev/null; then
    printf '\n[Icons]\nTheme=Papirus-Dark\n' >> /etc/skel/.config/kdeglobals
fi

# NOTE — the launcher entries used to be written here, and that was a bug.
#
# This hook rewrote fourteen /usr/share/applications/dagric-*.desktop files with
# plain here-docs. includes.chroot is copied in BEFORE hooks run (0800 documents
# the same ordering), so on every Pro build those here-docs overwrote the files
# tools/i18n-desktop.py had already filled with Name[de]/GenericName[xx]/
# Comment[xx]/Keywords[xx] — and reverted the English copy to older wording at
# the same time. A Pro owner in German got an English launcher; a free owner did
# not, because this hook exits at line 9. Nothing caught it: i18n-desktop.py
# --check grades config/includes.chroot, not the image.
#
# Every one of those entries now lives in config/includes.chroot as a reviewable
# file with its translations attached, dagric-gaming.desktop included. The two
# that are genuinely Pro-only (dagric-usb-protect, dagric-vm) plus dagric-gaming
# carry X-Dagric-Edition=pro and are deleted from free by 0510-app-names, which
# runs before this hook — so the edition split is unchanged and there is nothing
# left for this hook to write.

# PhotoGIMP (Diolinux): familiar Photoshop-style layout for GIMP.
# Best-effort download at build time; the build continues without it
# if the network or upstream is unavailable.
#
# SUPPLY-CHAIN NOTE: this fetches a moving branch (no pinned tag/checksum is
# possible in this offline build environment). To bound the blast radius of a
# compromised/malicious archive we do NOT copy the payload wholesale — we
# ALLOW-LIST only the GIMP profile directories. This specifically prevents an
# injected .config/autostart/*.desktop (or any other unexpected file) from
# landing in every new user's session and auto-executing on first login.
# TODO(when network is available at build): pin to a release tag + sha256 -c,
# mirroring the grub-btrfs vendoring in 0800-snapshot-recovery.
PG_TMP=/tmp/photogimp
mkdir -p "$PG_TMP"
if curl -fsSL -o "$PG_TMP/pg.zip" \
    "https://github.com/Diolinux/PhotoGIMP/archive/refs/heads/master.zip" 2>/dev/null; then
    if command -v unzip >/dev/null 2>&1 || apt-get install -y -qq unzip >/dev/null 2>&1; then
        unzip -q "$PG_TMP/pg.zip" -d "$PG_TMP"
        SRC=$(find "$PG_TMP" -maxdepth 2 -type d -name ".config" | head -1)
        # Only proceed if the payload actually looks like PhotoGIMP (a GIMP
        # profile dir present) — a sanity gate against a garbage/hostile zip.
        if [ -n "$SRC" ] && [ -d "$SRC/GIMP" ]; then
            mkdir -p /etc/skel/.config
            # Allow-list: copy ONLY the GIMP profile (and MyPaint brushes if
            # present). Never a blanket `cp -r *` — that was the injection path.
            cp -r "$SRC/GIMP" /etc/skel/.config/
            [ -d "$SRC/MyPaint" ] && cp -r "$SRC/MyPaint" /etc/skel/.config/
            echo "PhotoGIMP layout installed for new users (GIMP profile only)"
        else
            echo "WARNING: PhotoGIMP archive missing a GIMP profile — skipped"
        fi
    fi
else
    echo "WARNING: PhotoGIMP download failed — GIMP ships with stock layout"
fi
rm -rf "$PG_TMP"
