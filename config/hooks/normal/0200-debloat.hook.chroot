#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — debloat pass
# Runs inside the chroot after all packages are installed.
# Removes anything that phones home, nags, or duplicates functionality.
set -e

# Packages we never want, even if something dragged them in.
# popularity-contest = Debian's (opt-in) usage reporting. We don't ship it at all.
for pkg in popularity-contest reportbug debian-faq doc-debian installation-report; do
    if dpkg -s "$pkg" >/dev/null 2>&1; then
        apt-get purge -y "$pkg"
    fi
done

apt-get autoremove --purge -y
apt-get clean

# Trim apt lists from the image (regenerated on first 'apt update').
#
# THIS LINE ALONE DOES NOT SHIP. It reclaims the space for the rest of the
# chroot stage and nothing more, because live-build runs `Apt chroot update`
# again in its own binary pass — after every hook here has finished — and only
# deletes what that produced when LB_APT_INDICES is false. It is not, by
# default. So the debloat happened, the build log said so, and the shipped
# squashfs still carried 169 MB of uncompressed index (39 files: Sources lists
# and dep11 icon tarballs a desktop never opens) on a 2.19 GB free ISO.
#
# `--apt-indices false` in auto/config is the half that survives; this is the
# half that keeps the build's own working tree small. Both are needed, and
# neither is redundant.
#
# It reports its size now. A cleanup that prints nothing is a cleanup nobody
# can tell has stopped working — which is exactly how this went unnoticed.
_lists=$(du -sh /var/lib/apt/lists 2>/dev/null | cut -f1)
rm -rf /var/lib/apt/lists/*
echo "debloat: dropped ${_lists:-0} of apt indices (live-build's --apt-indices false keeps them out of the image)"

# No pre-seeded MOTD ads/news
rm -f /etc/update-motd.d/* 2>/dev/null || true

# Disable services that serve no purpose on a desktop.
#
# openvpn.service was FOUND BY BOOTING THE PRO IMAGE AND READING THE BOOT
# PROFILE, not by reading this tree. systemd-analyze blame listed it starting on
# every boot, and `systemctl is-enabled openvpn` said enabled, while
# /etc/openvpn/ held only the stock empty client/ and server/ directories — a
# daemon starting on every boot to manage nothing.
#
# It arrives as a dependency of network-manager-openvpn, which is the package
# actually wanted and is a NetworkManager PLUGIN: it runs the openvpn binary
# itself when the owner connects a VPN, and never consults this unit. So
# disabling the service costs no functionality at all.
#
# It also sat oddly against the rest of the product. Pro deliberately ships
# docker, libvirt, usbguard and sshd installed-and-off so that nothing listens
# until the owner opts in, and 0600-pro-edition verifies that at build time.
# openvpn being enabled by default was the one service that had escaped that
# rule, on the edition sold hardest on not running things you did not ask for.
#
# ModemManager is the same shape and was already here: the package ships so a
# plugged-in 4G dongle works, and the service stays off until there is one.
for svc in ModemManager.service openvpn.service; do
    systemctl disable "$svc" 2>/dev/null || true
done
