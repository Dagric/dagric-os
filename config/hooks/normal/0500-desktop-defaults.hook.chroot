#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — desktop and installer defaults.
set -e

# Default wallpaper: point the Breeze look-and-feel at Dagric Obsidian Pulse.
#
# THIS FILE BELONGS TO plasma-workspace, AND THAT IS NO LONGER "FINE".
#
# The line here used to end "...which is fine for the live/installed image built
# here", and it was true when it was written: nothing updated the image after it
# left. Then Dagric shipped an update channel. This file is an ordinary package
# file, not a conffile, so the next plasma-workspace upgrade replaces it — no
# prompt, no .dpkg-old — and every value sed'd in below goes back to stock
# Breeze on a machine somebody paid for.
#
# What that actually costs, stated carefully rather than dramatised, because the
# difference decides how urgently it needs fixing and I could not test it here:
# these defaults SEED a user's config at first login. An account that has
# already logged in has its own ~/.config and is unaffected. So the loss lands
# on accounts created AFTER the upgrade, and on every "Defaults" button in
# System Settings, which would restore KDE's look rather than Dagric's.
#
# THE REAL FIX is for Dagric's branding not to live inside another package's
# file at all: ship an org.dagric.desktop look-and-feel package with its own
# contents/defaults, and set LookAndFeelPackage to it. That is a restructure of
# the first-login seeding path, it cannot be verified without building and
# booting, and this is exactly the code path where guessing has hurt this
# project before — so it is written down here and left for a session that can
# boot the result, rather than half-done tonight.
#
# NOT worth trying: seeding /etc/skel/.config/kdeglobals with just
# ColorScheme=DagricDark. The name is not the colours — every tool in this tree
# applies a scheme with plasma-apply-colorscheme, which EXPANDS the .colors file
# into kdeglobals. Writing the name alone would label the desktop DagricLight
# while it painted Breeze, which is worse than the bug it was meant to fix.
LNF=/usr/share/plasma/look-and-feel/org.kde.breeze.desktop/contents/defaults
if [ -f "$LNF" ]; then
    # Match by KEY, not by the stock value: upstream renames the default
    # wallpaper per release (it happened to be "Next"), and an exact
    # `Image=Next` match would silently no-op on drift, shipping the stock
    # wallpaper with no build warning. Rewrite whatever the value is.
    sed -i -E 's/^(Image=).*/\1DagricObsidianPulse/; s/^(defaultWallpaperTheme=).*/\1DagricObsidianPulse/' "$LNF"
    if ! grep -q '^Image=DagricObsidianPulse' "$LNF"; then
        echo "WARNING: Breeze defaults had no Image= key — wallpaper branding may not apply" >&2
    fi

    # ...and the colour scheme with it. Dagric Dark is the Obsidian Flow
    # palette: a near-black neutral field with red reserved for decisions,
    # focus and progress. Key the shipped default to it so first boot and
    # "Reset" agree.
    sed -i -E 's/^(ColorScheme=).*/\1DagricDark/' "$LNF"
    if ! grep -q '^ColorScheme=DagricDark' "$LNF"; then
        echo "WARNING: Breeze defaults had no ColorScheme= key — brand colours may not apply" >&2
    fi
fi

# Calamares: use the Dagric branding component instead of Debian's.
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: dagric/' /etc/calamares/settings.conf
fi

# The desktop/menu entry should say Dagric, not Debian.
#
# AND THE LOCALISED KEYS TOO, WHICH IS THE HALF THAT WAS MISSING. A .desktop
# file carries Name[de], Name[fr], Name[en_GB] and so on, and a localised key
# BEATS the plain Name= for anybody whose session matches it. `sed 's/^Name=.*/'`
# does not match `Name[de]=`, so every one of upstream's translations survived:
# a German owner opened the launcher on the live session and the entry that
# installs this product still said Debian, on the single most important icon on
# the desktop.
#
# 0510-app-names already knows this trap — it fails the build if an English
# locale variant survives in [Desktop Entry], with a comment explaining that
# Name[en_GB] would beat ours for anyone who picked English (UK/AU/CA). The
# Calamares rename never got the same treatment.
#
# So: strip every localised Name/GenericName/Comment, then put back the five
# languages Dagric actually ships. Anything else falls back to the English
# above, which is correct branding even when it is not the owner's language.
#
# awk rather than sed, and scoped to [Desktop Entry], because Desktop Actions
# have their own Name= lines — 0510 documents what happens when a rewriter
# leaks past that boundary: nine identical rows in a right-click menu.
for d in /usr/share/applications/calamares-install-debian.desktop \
         /etc/xdg/autostart/calamares-desktop-icon.desktop; do
    [ -f "$d" ] || continue

    sed -i 's/^Name=.*/Name=Install Dagric OS/;
            s/^GenericName=.*/GenericName=Dagric OS Installer/;
            s/^Comment=.*/Comment=Install Dagric OS on this computer/;
            s|^Icon=.*|Icon=/usr/share/dagric/logo/dagric-logo.png|' "$d"

    awk '
        /^\[/ { entry = ($0 == "[Desktop Entry]") }
        entry && /^(Name|GenericName|Comment)\[/ { next }
        { print }
    ' "$d" > "$d.dagric" && mv "$d.dagric" "$d"

    # Appended at the end of the file, which is still inside [Desktop Entry]
    # for both of these files — neither declares a Desktop Action. Verified
    # below rather than assumed.
    if grep -q '^\[Desktop Action' "$d"; then
        echo "WARNING: $d now has Desktop Actions; the translations below" >&2
        echo "         would land in the wrong section. Skipped." >&2
    else
        cat >> "$d" << 'EOF'
Name[de]=Dagric OS installieren
Name[fr]=Installer Dagric OS
Name[es]=Instalar Dagric OS
Name[pt_BR]=Instalar o Dagric OS
Name[it]=Installa Dagric OS
GenericName[de]=Dagric-OS-Installationsprogramm
GenericName[fr]=Programme d'installation de Dagric OS
GenericName[es]=Instalador de Dagric OS
GenericName[pt_BR]=Instalador do Dagric OS
GenericName[it]=Programma di installazione di Dagric OS
Comment[de]=Dagric OS auf diesem Computer installieren
Comment[fr]=Installer Dagric OS sur cet ordinateur
Comment[es]=Instalar Dagric OS en este equipo
Comment[pt_BR]=Instalar o Dagric OS neste computador
Comment[it]=Installa Dagric OS su questo computer
EOF
    fi

    # A leftover Debian string here is invisible until somebody boots the live
    # session in that language, which is exactly why it lasted this long.
    #
    # SCOPED TO THE KEYS AN OWNER READS, because unscoped it cried wolf on every
    # single build. It matched two lines that must not change:
    #
    #     Exec=calamares-install-debian
    #     Keywords=calamares;system;install;debian;installer
    #
    # Exec is the BINARY NAME — renaming it breaks the installer outright — and
    # Keywords are search terms, where "debian" genuinely helps somebody who
    # types what they think they installed. Neither is displayed as a label.
    #
    # So the warning fired on a correct file, forever, on a build that passed.
    # That is not a cosmetic problem: a permanent warning is how a reader learns
    # to skim the log, and the SAME green build carried a real one seven lines
    # away — firewalld reporting that ssh was still allowed in every zone. The
    # noise is what let it sit there. Narrow checks or no checks.
    #
    # Name/GenericName/Comment, with or without a [locale] suffix, are exactly
    # the keys a person sees, which is what "rebranding" means here.
    if grep -qiE '^(Name|GenericName|Comment)(\[[^]]*\])?=.*debian' "$d"; then
        echo "WARNING: $d still shows Debian in a user-visible label:" >&2
        grep -inE '^(Name|GenericName|Comment)(\[[^]]*\])?=.*debian' "$d" \
            | sed 's/^/         /' >&2
    fi
done

# The desktop-shortcut trust watcher needs the execute bit, for the same reason
# 0520 and 0530 chmod their Exec= targets: this tree is developed on Windows, so
# git records these files 100644 and a Linux CI checkout hands the build a
# script the autostart entry cannot run. 0995-file-modes only REMOVES the bit —
# nothing adds it — so it has to happen here.
#
# What it does and, more importantly, the security line it draws, is written out
# in the script's own header. Read that before changing either file.
TRUST=/usr/lib/dagric/desktop-shortcut-trust
if [ -f "$TRUST" ]; then
    chmod 0755 "$TRUST"
    echo "desktop-defaults: desktop-shortcut-trust is executable"
else
    # Loud, because the autostart entry in /etc/skel would otherwise ship
    # pointing at a file that is not there, and fail silently at every login.
    echo "WARNING: $TRUST missing — desktop shortcuts will not self-trust" >&2
fi
