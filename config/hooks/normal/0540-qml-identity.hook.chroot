#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# The application itself sets desktopFileName before creating any windows.
# Unlike qml6 aliases alone, this supplies a unique Wayland app_id as well as
# X11 desktop matching. Do not relabel unrelated Qt applications as Dagric.
set -eu
QML=/usr/lib/dagric/ui_runner.py
test -x "$QML"
python3 -c 'from PySide6.QtQuick import QQuickWindow'
mkdir -p /usr/lib/dagric/wm
for app in dagric-firstrun dagric-appearance dagric-family dagric-rewind dagric-desktop-settings; do
    ln -sf "$QML" "/usr/lib/dagric/wm/$app"
done
for app in dagric-firstrun dagric-appearance dagric-family dagric-rewind dagric-desktop-settings; do
    test -x "/usr/lib/dagric/wm/$app"
done
echo '0540-qml-identity: five native Qt application identities installed'
