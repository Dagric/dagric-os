#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — snapshot recovery: vendor grub-btrfs (GPL-3.0) from its pinned
# upstream release and install its files. We do NOT copy its code into this
# repo — we install the upstream release verbatim (its LICENSE ships with it),
# which is GPL-compliant (source at https://github.com/Antynea/grub-btrfs).
#
# snapper config + GRUB regeneration happen on FIRST BOOT of the installed
# system (via dagric-snapshot-setup.service) because the build chroot isn't
# btrfs — snapper needs the real btrfs root to create a config.
set -e

GB_VER="4.14"
GB_SHA="4fe2f8a49b39e3e561fc51bbc5a0f81a7222c1e9ef8672e014e0ba3bedad20c6"

cd /tmp
if curl -fsSL -o gb.tar.gz \
    "https://codeload.github.com/Antynea/grub-btrfs/tar.gz/refs/tags/v${GB_VER}"; then
    if echo "${GB_SHA}  gb.tar.gz" | sha256sum -c - >/dev/null 2>&1; then
        mkdir gb && tar xzf gb.tar.gz -C gb --strip-components=1
        cd gb
        # Exactly what upstream's `make install` does (minus manpages), without
        # needing `make` in the chroot:
        install -Dm755 41_snapshots-btrfs      /etc/grub.d/41_snapshots-btrfs
        install -Dm644 config                  /etc/default/grub-btrfs/config
        install -Dm744 grub-btrfsd             /usr/bin/grub-btrfsd
        install -Dm644 grub-btrfsd.service     /usr/lib/systemd/system/grub-btrfsd.service
        install -Dm644 LICENSE                 /usr/share/doc/grub-btrfs/LICENSE

        # MAKE THE RECOVERY MENU READABLE BY THE PERSON IT EXISTS FOR.
        #
        # Upstream's defaults render every snapshot entry as
        #     2026-08-02 14:03 | @/.snapshots/7/snapshot | post | apt (post)
        # The widest column is a btrfs subvolume path — precisely the field an
        # owner staring at a machine that will not boot cannot use, in a menu
        # whose only audience is that owner on that day. Description first,
        # date second, path dropped: "apt (pre) 2026-08-02 14:03" is something
        # a person can pick "the one before it broke" from.
        #
        # GRUB_BTRFS_TITLE_FORMAT takes a subset of the four documented keys
        # (date, snapshot, type, description) — using fewer than all four is
        # supported. The submenu title changes from the technical default for
        # the same reason: "Dagric snapshots — start the system as it was" says
        # what the menu DOES, which is the one thing its reader needs to know.
        cat >> /etc/default/grub-btrfs/config << 'GBCFG'

# Dagric: human-readable entries. See 0800-snapshot-recovery.hook.chroot.
GRUB_BTRFS_TITLE_FORMAT=("description" "date")
GRUB_BTRFS_SUBMENUNAME="Dagric snapshots — start the system as it was earlier"
GBCFG
        echo "grub-btrfs ${GB_VER} installed"
    else
        echo "WARNING: grub-btrfs checksum mismatch — snapshot recovery skipped"
    fi
    cd / && rm -rf /tmp/gb /tmp/gb.tar.gz
else
    echo "WARNING: grub-btrfs download failed — snapshot recovery unavailable"
fi

# Enable the first-boot setup service.
#
# CORRECTION, because this comment used to say the opposite and someone will
# design around it again: includes.chroot lands BEFORE hooks, not after.
# `lb chroot` runs `lb chroot_includes_after_packages` on line 51 and
# `lb chroot_hooks` on line 52, and select_includes_chroot maps
# config/includes.chroot to that after-packages stage. So the unit file IS
# already at /etc/systemd/system/dagric-snapshot-setup.service by the time any
# hook runs, and a plain `systemctl enable` would work here.
#
# The hand-made wants-symlink below is kept anyway: it is exactly what
# `systemctl enable` writes for a WantedBy=multi-user.target unit, it has
# shipped and been verified on an installed system, and swapping proven code
# for equivalent code buys nothing. What was wrong was the reason, not the line.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/dagric-snapshot-setup.service \
    /etc/systemd/system/multi-user.target.wants/dagric-snapshot-setup.service
