#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# One continuous installer in Free and Pro, including desktop preferences.
set -eu

ENTRY=/usr/share/applications/calamares-install-debian.desktop
SETUP=/usr/share/applications/dagric-firstrun.desktop
if [ -f "$ENTRY" ]; then
    test -s "$SETUP"
    cp "$SETUP" "$ENTRY"
    # The launcher already contains dagric-firstrun; this compatibility entry
    # is copied to the live desktop by add-calamares-desktop-icon only.
    printf '\nNoDisplay=true\n' >> "$ENTRY"
    grep -qx 'Exec=dagric-firstrun' "$ENTRY"
fi

# Do not skip the installer's final destructive-action confirmation. User
# creation and the summary must remain before the partition execution phase.
python3 - <<'PY'
from pathlib import Path
import re
import sys
import yaml
sys.path.insert(0, '/usr/lib/dagric')
from install_profile import chooser_config

path = Path('/etc/calamares/settings.conf')
text = path.read_text()
settings = yaml.safe_load(text)
steps = settings['sequence']
show = steps[0]['show']
assert all(module in show for module in ('partition', 'users', 'summary'))
assert show.index('users') < show.index('summary')
assert 'users' in steps[1]['exec']
assert 'unpackfs' in steps[1]['exec']
assert 'umount' in steps[1]['exec']
assert steps[1]['exec'].index('unpackfs') < steps[1]['exec'].index('users') < steps[1]['exec'].index('umount')
assert settings.get('dont-chroot') is False
# Use the packaged QML chooser's single-selection legacy/custom interface.
# The allowlisted profile is handled by Dagric; it installs no extra packages.
# A separate Python job validates the choice before ANY partition execution.
instances = settings.setdefault('instances', [])
names = {'dagricdesktop', 'dagricprofilecheck', 'dagricprofileapply'}
instances[:] = [item for item in instances if item.get('id') not in names]
instances.extend([
    {'id': 'dagricdesktop', 'module': 'packagechooserq', 'config': 'dagricdesktop.conf'},
    {'id': 'dagricprofilecheck', 'module': 'dagricpersonalize', 'config': 'dagricprofile-check.conf'},
    {'id': 'dagricprofileapply', 'module': 'dagricpersonalize', 'config': 'dagricprofile-apply.conf'},
])
show[:] = [item for item in show if item != 'packagechooserq@dagricdesktop']
show.insert(show.index('users'), 'packagechooserq@dagricdesktop')
execute = steps[1]['exec']
execute[:] = [item for item in execute if item not in
             ('dagricpersonalize@dagricprofilecheck', 'dagricpersonalize@dagricprofileapply')]
execute.insert(0, 'dagricpersonalize@dagricprofilecheck')
execute.insert(execute.index('users') + 1, 'dagricpersonalize@dagricprofileapply')
settings['prompt-install'] = True
path.write_text(yaml.safe_dump(settings, sort_keys=False))
Path('/etc/calamares/modules/dagricdesktop.conf').write_text(yaml.safe_dump(chooser_config(), sort_keys=False))
PY
test -f "/usr/lib/x86_64-linux-gnu/calamares/modules/packagechooserq/module.desc"
test -f "/usr/lib/calamares/modules/dagricpersonalize/module.desc"
echo 'unified-setup: one installer includes disk, desktop preferences, account and confirmation'
