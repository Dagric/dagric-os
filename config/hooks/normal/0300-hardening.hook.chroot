#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — security baseline
# Updates are automatic and silent. They never reboot the machine for you.
# (The exact opposite of a certain other operating system.)
set -e

# Automatic security updates — download and apply, never auto-reboot
cat > /etc/apt/apt.conf.d/20auto-upgrades << 'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOF

cat > /etc/apt/apt.conf.d/52dagric-unattended << 'EOF'
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// CRITICAL — do not remove. Stock 50unattended-upgrades matches origins with
// ${distro_codename}, which unattended-upgrade resolves via lsb_release, i.e.
// from VERSION_CODENAME in os-release. Hook 0100 rebrands that to "foundation"
// (and ID to "dagric"), so EVERY stock pattern misses and nothing is ever
// upgraded — silently voiding the product's central "silent security updates"
// promise. Origins-Pattern is an apt LIST option, so these entries are
// APPENDED to the stock ones; the real Debian codename is hardcoded on
// purpose. Bump these when rebasing onto a newer Debian release.
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=trixie,label=Debian";
    "origin=Debian,codename=trixie,label=Debian-Security";
    "origin=Debian,codename=trixie-security,label=Debian-Security";
    "origin=Debian,codename=trixie-updates,label=Debian";
};
EOF

# Firewall on by default
systemctl enable firewalld.service 2>/dev/null || true

# SSH is NOT reachable by default. openssh-server ships on Pro (off until the
# owner enables it), but firewalld's stock zones allow the ssh service, which
# would expose a password-auth sshd the moment it's switched on. Close it;
# enabling SSH is then a deliberate two-step, on the zone actually in use:
#   sudo firewall-cmd --permanent --zone=home --add-service=ssh
#   sudo firewall-cmd --reload
#
# THIS USED TO CLOSE public AND NOTHING ELSE, which closed the front door and
# left the side door open — because Dagric itself steers owners out of public.
# 0600-pro-edition runs `--zone=home --add-service=kdeconnect`, and the setup
# wizard and guide both tell owners to mark their home network trusted so KDE
# Connect works. Follow Dagric's own instructions and you land in `home`, where
# firewalld's stock ruleset allows ssh. The hardening was one documented click
# away from being undone, and the warning below would have said nothing.
#
# So: every stock zone that ships ssh enabled. public, home, internal and work
# are the ones an owner reaches through the KDE applet; external and dmz ship it
# too and cost nothing to close. `trusted` is deliberately absent — it accepts
# everything by design and has no service list to remove from, so a machine put
# there is exposed no matter what this hook does. That is a property of choosing
# "trusted", not a gap here.
#
# The removal itself is quiet: on a zone where ssh is already absent,
# firewall-offline-cmd exits non-zero saying so, and that is the outcome we
# want, not an error worth printing. --query-service is the authority, and it
# runs per zone below.
#
# The existence check is not ceremony. Without it, a chroot with no
# firewall-offline-cmd runs the removal into `|| true`, then fails
# --query-service because the command is missing rather than because ssh is
# closed, takes the else branch, and prints "ssh closed in the public zone" six
# times. A hook that reports success it did not achieve is the exact fault this
# block was rewritten to stop doing — it would have been introduced by the
# rewrite that fixed it.
if ! command -v firewall-offline-cmd >/dev/null 2>&1; then
    echo "WARNING: firewall-offline-cmd not found — ssh was NOT closed in any" >&2
    echo "         firewalld zone. Any sshd the owner enables will be reachable." >&2
else
    for _zone in public home internal work external dmz; do
        firewall-offline-cmd --zone="$_zone" --remove-service=ssh >/dev/null 2>&1 || true

        # --query-service exits 0 when the service is STILL allowed, so a zero
        # here is the bad case. Deliberately a loud warning rather than an exit:
        # a broken firewall rule must not silently ship, but it also must not
        # destroy a twenty-minute build at the very end when all else succeeded.
        if firewall-offline-cmd --zone="$_zone" --query-service=ssh >/dev/null 2>&1; then
            echo "WARNING: firewalld's $_zone zone STILL allows ssh after removal." >&2
            echo "         Any sshd the owner later enables would be reachable from" >&2
            echo "         every network they join on that zone." >&2
        else
            echo "hardening: ssh closed in the $_zone zone"
        fi
    done
fi
unset _zone

# EVERY PRO MACHINE WAS SHIPPING THE SAME SSH HOST KEY.
#
# openssh-server is in pro-dev.list.chroot. Its postinst runs `ssh-keygen -A`,
# and a postinst runs during the BUILD, inside this chroot — so the host keys
# were generated once, here, and then copied into the ISO. Every Pro customer
# got the same /etc/ssh/ssh_host_*_key, and the private halves are inside a
# product anyone can buy for $39.
#
# That is not a hardening nicety. A host key is the only thing that tells an SSH
# client it is talking to the machine it dialled. With the private key in
# everyone's hands, anyone on the path can impersonate any Dagric Pro box and
# the client shows no warning at all, because the key it is offered is the key
# it trusted the first time. The one protection SSH gives over a hostile
# network is exactly the one that stops working.
#
# So: delete them at the end of the build, and let each machine make its own on
# first boot (dagric-ssh-hostkeys.service, enabled below).
#
# The count is printed rather than assumed. This hook cannot boot the image, so
# the deletion IS the verification: a build log saying it removed 5 files proves
# the keys were being baked in, and a log saying it removed 0 proves they were
# not and this block can go. Either way the answer is in CI output instead of in
# somebody's head.
_removed=0
for _k in /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub \
         /etc/ssh/ssh_host_*_key-cert.pub; do
    [ -e "$_k" ] || continue
    rm -f "$_k" && _removed=$((_removed + 1))
done
if [ "$_removed" -gt 0 ]; then
    echo "hardening: removed $_removed baked-in SSH host key file(s) — each machine now generates its own"
else
    echo "hardening: no SSH host keys were baked into the image"
fi
unset _removed _k

# Enable the first-boot regenerator. Hand-made wants-symlink for the reason
# 0800-snapshot-recovery documents: it is exactly what `systemctl enable` writes
# for a WantedBy=multi-user.target unit, and it does not depend on systemctl
# being willing to run inside the chroot.
if [ -f /usr/lib/systemd/system/dagric-ssh-hostkeys.service ]; then
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sf /usr/lib/systemd/system/dagric-ssh-hostkeys.service \
        /etc/systemd/system/multi-user.target.wants/dagric-ssh-hostkeys.service
    echo "hardening: dagric-ssh-hostkeys.service enabled"
else
    # Loud: without this unit, an image whose keys were just deleted has no way
    # to make new ones, and sshd would refuse to start for the owner who enables
    # it. The two halves of this fix must never ship apart.
    echo "WARNING: dagric-ssh-hostkeys.service missing — host keys were deleted" >&2
    echo "         with nothing to regenerate them. sshd will not start." >&2
fi

# Fingerprint login: fprintd + libpam-fprintd are installed, but Debian's PAM
# profile ships "Default: no", so /etc/pam.d/common-auth never consults the
# reader — a user could enroll a finger and have it silently ignored at the
# login screen, lockscreen and sudo. Enable the profile non-interactively.
# pam_fprintd returns "ignore" when no reader or no enrollment exists, so
# password login is unaffected on hardware without a sensor.
DEBIAN_FRONTEND=noninteractive pam-auth-update --enable fprintd 2>/dev/null || \
    echo "WARNING: could not enable the fprintd PAM profile"

# AppArmor confinement on by default
systemctl enable apparmor.service 2>/dev/null || true

# WHAT "APPARMOR" ACTUALLY MEANS ON THIS IMAGE — counted, not believed.
#
# Three pages of the website said "AppArmor confinement enforced". Debian's own
# apparmor-profiles description says the opposite in as many words: "These
# profiles are not mature enough to be shipped in enforce mode by default on
# Debian. They are shipped in complain mode so that users can test them."
# Complain mode writes the violation to the log and then allows it. It is a
# useful thing to ship — it is how a profile earns enforcement — but it is not
# confinement, and selling it as "enforced" was a claim the image did not
# support. The site now says "active" and the manual explains both modes and how
# to promote a profile with aa-enforce.
#
# Nothing was flipped to enforce to make the old wording true. Upstream declined
# to do that for a reason, and a profile that blocks something a customer needs
# fails in the least diagnosable way there is: an application that half-works,
# with the explanation in a log nobody thinks to read.
#
# The counts go in the build log so this stays a number rather than a memory.
if [ -d /etc/apparmor.d ]; then
    _total=0
    _complain=0
    for _p in /etc/apparmor.d/*; do
        # Top-level files only — abstractions/, tunables/ and local/ are include
        # fragments, not profiles, and counting them would inflate both numbers.
        [ -f "$_p" ] || continue
        _total=$((_total + 1))
        if grep -qE 'flags=\([^)]*complain' "$_p" 2>/dev/null; then
            _complain=$((_complain + 1))
        fi
    done
    echo "apparmor: $_total profile(s) installed, $_complain of them in complain mode"
    unset _total _complain _p
fi

# zram swap on by default
systemctl enable zramswap.service 2>/dev/null || true

# Boot the kernel with AppArmor as the active LSM (Debian ships it available
# but this makes it explicit and enforced from first boot).
if [ -f /etc/default/grub.d/50-dagric.cfg ]; then
    if ! grep -q "apparmor=1" /etc/default/grub.d/50-dagric.cfg; then
        echo 'GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX apparmor=1 security=apparmor"' \
            >> /etc/default/grub.d/50-dagric.cfg
    fi
fi

# New home directories are 0750, not Debian's world-readable 0755, so users
# can't read each other's files by default. login.defs actually governs this
# (unlike chmod'ing /etc/skel). Strip any existing HOME_MODE lines (commented
# or not) then set one clean value — avoids duplicate/conflicting entries.
if [ -f /etc/login.defs ]; then
    sed -i '/^#*[[:space:]]*HOME_MODE/d' /etc/login.defs
    printf 'HOME_MODE\t0750\n' >> /etc/login.defs
fi
