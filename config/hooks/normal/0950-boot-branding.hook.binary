#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — the boot menu, on both firmware paths.
#
# live-build labels every image "Live system (amd64)" under a generic
# "Boot menu" title, so the free and Pro ISOs were indistinguishable at the
# moment of booting. Anyone holding both — or booting a multi-ISO USB — had no
# way to tell which one they were starting until the desktop appeared.
#
# It also ships a UEFI menu that is barely a menu: live-build's live-theme sets
# an item colour and a selected-item colour and nothing else, so booted in QEMU
# you cannot tell which of the four entries is highlighted; the resolution is
# hard-wired to 800x600 and scaled up on every modern panel; the only countdown
# is a white brick reading "The highlighted entry will be executed automatically
# in 3s."; the handoff to the kernel punches a black rectangle through the
# splash and leaves it there for the whole squashfs load; and GRUB beeps twice
# on the way in. This hook fixes all of that.
#
# This is a BINARY hook: it runs on the assembled ISO tree, after the boot
# loaders are in place, and rewrites both firmware paths:
#   isolinux/  -> legacy BIOS
#   boot/grub/ -> UEFI (incl. Secure Boot)
set -e

EDITION="${DAGRIC_EDITION:-}"
# Fall back to the marker baked into the chroot if the variable didn't survive.
if [ -z "$EDITION" ]; then
    for c in chroot/etc/dagric-edition ../chroot/etc/dagric-edition; do
        [ -f "$c" ] && { EDITION=$(cat "$c"); break; }
    done
fi
[ -n "$EDITION" ] || EDITION=free

if [ "$EDITION" = "pro" ]; then
    LIVE="Dagric OS Pro 1.0"
else
    LIVE="Dagric OS 1.0  -  Free edition"
fi
SAFE="$LIVE  (safe graphics mode)"
# The BIOS menu needs its own copy of that string for the same reason the
# accessible entry does further down: syslinux marks a hotkey with a caret
# inside the label, and the sed below replaces the whole label — carrying away
# the "^" that live-build's own "^Live system (amd64 fail-safe mode)" had. The
# branded fail-safe entry therefore shipped with no hotkey, confirmed in
# out/dagric-os-1.0-amd64.iso: "menu label Dagric OS 1.0  -  Free edition
# (safe graphics mode)", no caret. $SAFE stays as it is for the GRUB rewrite
# below, where a caret would print as a literal character. "g" is free: this
# menu uses ^D and ^U at the top level and ^B and ^H inside Utilities.
SAFE_BIOS="$LIVE  (safe ^graphics mode)"

esc() { printf '%s' "$1" | sed -e 's/[\/&]/\\&/g'; }
L=$(esc "$LIVE"); S=$(esc "$SAFE"); SB=$(esc "$SAFE_BIOS")

# Where the pre-rendered menu art, fonts and theme live inside the chroot.
# Binary hooks run with the cwd set to binary/, so the chroot is one level up;
# the bare path is kept as a fallback in case that ever changes.
ART=
for c in ../chroot/usr/share/dagric/boot chroot/usr/share/dagric/boot; do
    [ -d "$c/grub-theme" ] && { ART=$c; break; }
done

# How long the menu waits before booting the default entry, in seconds.
# It used to wait FOREVER on both paths — isolinux shipped "timeout 0", which
# in syslinux means "no timeout, ever", and live-build's grub.cfg sets no
# timeout at all, which GRUB also treats as wait-forever. Booted in QEMU, the
# menu sat unchanged for the full run.
#
# For this audience that is close to the worst possible default. Someone boots
# the USB, sees a menu they were not expecting, does not know that Enter is
# required, waits, decides the machine has hung, and power-cycles back into
# Windows. The OS never gets to make a first impression at all. Ten seconds is
# long enough to read three entries and pick one, short enough that walking
# away still ends up at a desktop.
WAIT=10

# --- legacy BIOS (isolinux/syslinux) ---------------------------------------
for f in isolinux/live.cfg isolinux/menu.cfg isolinux/stdmenu.cfg isolinux/isolinux.cfg; do
    [ -f "$f" ] || continue
    # Order matters: rewrite the fail-safe entry first, otherwise the plain
    # "Live system (amd64)" pattern would match and mangle it too.
    sed -i "s/menu label .*Live system (amd64 fail-safe mode).*/menu label $SB/" "$f"
    sed -i "s/menu label \^Live system (amd64)/menu label ^$L/" "$f"
    # The top-level title is REMOVED, not branded, for the same reason the GRUB
    # theme's title is blanked further down: splash.png already carries the
    # DAGRIC wordmark and the tagline, and syslinux prints its title in the same
    # band. This used to read "Dagric OS 1.0 (Foundation) - Free edition" set
    # over art that already says DAGRIC. The edition is named on every entry,
    # which is where someone actually looks. "menu title" with no argument
    # suppresses the row; the Utilities submenu keeps its own title, because
    # that one is not sitting on top of a logo.
    sed -i "s/^\([[:space:]]*\)menu title Boot menu.*$/\1menu title/" "$f"
    # syslinux counts in tenths of a second, so 10s is 100.
    sed -i "s/^\([[:space:]]*\)timeout[[:space:]]\+0[[:space:]]*$/\1timeout $((WAIT * 10))/" "$f"
done

# vesamenu does not scale its background by so much as a pixel — the menu comes
# out at whatever size the PNG is. live-build rasterises splash.svg at a
# hard-coded 640x480 (the size is a literal in binary_bootloader_splash, there
# is no config knob), so the BIOS menu has been rendering at 640x480 on machines
# that offer 1024x768. Swap in the render authored at the resolution
# config/bootloaders/isolinux/stdmenu.cfg actually asks for.
if [ -n "$ART" ] && [ -f "$ART/isolinux/splash.png" ] && [ -d isolinux ]; then
    cp "$ART/isolinux/splash.png" isolinux/splash.png
elif [ -n "$ART" ] && [ -d isolinux ]; then
    # SAY SO, because the verification further down cannot.
    #
    # That check is `[ -f isolinux/splash.png ]`, and live-build has already put
    # a splash.png there itself — the 640x480 render described above. So it
    # passes whether or not this copy happened, which makes it the one entry in
    # the MISS list that asserts nothing about a change this hook made. Every
    # other entry tests text that exists only because the hook wrote it.
    #
    # The gap is narrow: $ART is chosen by probing for grub-theme/, so a wholly
    # missing art tree is already caught as boot-art-missing, and both files come
    # from one run of config/bootloaders/make-boot-art.sh. It takes a hand
    # deletion of a single tracked binary to land here. But the consequence is
    # invisible and belongs to the audience this product is for: stdmenu.cfg
    # sets `menu resolution 1024 768` and computes its rows and offsets for that,
    # vesamenu scales a background by not one pixel, and legacy BIOS is the old
    # hardware Dagric exists to rescue. The menu would sit off its own artwork
    # on exactly those machines, and the build would have reported success.
    echo "WARNING: $ART/isolinux/splash.png missing — the BIOS menu keeps" >&2
    echo "         live-build's 640x480 splash while stdmenu.cfg lays out for" >&2
    echo "         1024x768. Re-run config/bootloaders/make-boot-art.sh." >&2
fi

# --- UEFI (GRUB) ------------------------------------------------------------
for f in boot/grub/grub.cfg boot/grub/config.cfg; do
    [ -f "$f" ] || continue
    sed -i "s/menuentry \"Live system (amd64 fail-safe mode)\"/menuentry \"$S\"/" "$f"
    sed -i "s/menuentry \"Live system (amd64)\"/menuentry \"$L\"/" "$f"
done

# --- the accessible boot entry ----------------------------------------------
#
# A second live entry that appends `dagric.a11y=1` to the kernel command line.
# /usr/lib/dagric/a11y-live (installed by 0530-accessibility.hook.chroot) runs
# at every login, greps /proc/cmdline for that flag, and starts Orca if it is
# there. Until this entry existed that responder was inert.
#
# WHY IT HAS TO BE A BOOT ENTRY. The installed system's login screen cannot
# host a screen reader — SDDM has no way to publish an AT-SPI bus its Qt
# greeter would join, and the whole dead-end analysis is written into
# /etc/sddm.conf.d/20-accessibility.conf. The live ISO is different because it
# autologs in: there is no password prompt to be locked out of. So the boot
# menu is the ONE place a blind person can get into this OS unaided, and it is
# also the moment that decides everything — it is where they find out whether
# the product is usable by them at all, before anyone has paid anybody. This
# is the same pattern as Debian Installer's "Install with speech synthesis".
#
# NOTHING GOES IN auto/config. The obvious-looking move is to add the flag to
# --bootappend-live, and that would switch the screen reader on for every owner
# of every machine. The flag has to be on ONE entry, which means editing the
# assembled menu, which means here.
#
# The entry is built by COPYING the normal live block rather than by writing a
# new one, because the copy inherits whatever live-build put on the kernel line
# (boot=live, the username, the hostname, the persistence options) and cannot
# drift from it. `menu default` is dropped from the copy — a bug here would
# make the screen reader the default boot for everybody. If the block cannot be
# found the file is left exactly as it was and the check at the bottom warns.
A11Y="$LIVE  (with screen reader)"

# AND THE SAME KEY ON THE OTHER FIRMWARE PATH, which is where it matters most.
# The GRUB copy below gets --hotkey=s for the reason argued there; syslinux has
# no --hotkey option at all — it marks the key with a caret inside the label —
# and the awk below substitutes this string for the WHOLE `menu label`, carrying
# away the "^" the source line had. So the BIOS copy shipped with no hotkey
# whatsoever. Confirmed in out/dagric-os-1.0-amd64.iso: the sighted entry keeps
# "menu label ^Dagric OS 1.0  -  Free edition" and the copy reads "menu label
# Dagric OS 1.0  -  Free edition  (with screen reader)", no caret anywhere.
#
# Legacy BIOS is the decade-old hardware this product exists to rescue, and the
# firmware most likely to be in front of somebody trying to use a machine
# unaided. The argument fifteen lines below — that the boot menu is the ONE
# place a blind person can get into this OS without help — was implemented on
# exactly one of the two menus; on the other they were left counting arrow
# presses in silence and hoping the highlight started where they thought.
#
# "s" matches the GRUB copy's --hotkey=s so the two menus agree, and it is free:
# this menu uses ^D and ^U at the top level and ^B and ^H inside Utilities.
A11Y_BIOS="$LIVE  (with ^screen reader)"

for f in isolinux/live.cfg; do
    [ -f "$f" ] || continue
    grep -q 'dagric\.a11y' "$f" && continue
    rc=0
    awk -v lbl="$A11Y_BIOS" '
    { L[NR] = $0 }
    END {
        n = NR; start = 0
        for (i = 1; i <= n; i++) {
            if (L[i] !~ /^[[:space:]]*label[[:space:]]/) continue
            e = n
            for (j = i + 1; j <= n; j++)
                if (L[j] ~ /^[[:space:]]*label[[:space:]]/) { e = j - 1; break }
            ok = 0; bad = 0
            for (j = i; j <= e; j++) {
                if (L[j] ~ /boot=live/) ok = 1
                if (L[j] ~ /nomodeset/ || L[j] ~ /fail-safe/) bad = 1
            }
            if (ok && !bad) { start = i; end = e; break }
        }
        if (start == 0) { for (i = 1; i <= n; i++) print L[i]; exit 3 }
        for (i = 1; i <= n; i++) {
            print L[i]
            if (i != end) continue
            print ""
            for (j = start; j <= end; j++) {
                s = L[j]
                sub(/[[:space:]]+$/, "", s)
                if (s ~ /^[[:space:]]*label[[:space:]]/)        { print s "-a11y"; continue }
                if (s ~ /^[[:space:]]*menu[[:space:]]+default/) continue
                p = index(s, "menu label")
                if (p > 0)                                     { print substr(s, 1, p - 1) "menu label " lbl; continue }
                if (s ~ /^[[:space:]]*append[[:space:]]/)       { print s " dagric.a11y=1"; continue }
                print s
            }
        }
        exit 0
    }' "$f" > "$f.a11y" || rc=$?
    if [ "$rc" -eq 0 ] && [ -s "$f.a11y" ]; then mv "$f.a11y" "$f"; else rm -f "$f.a11y"; fi
done

for f in boot/grub/grub.cfg boot/grub/config.cfg; do
    [ -f "$f" ] || continue
    grep -q 'dagric\.a11y' "$f" && continue
    rc=0
    awk -v lbl="$A11Y" '
    { L[NR] = $0 }
    END {
        n = NR; start = 0
        for (i = 1; i <= n; i++) {
            if (L[i] !~ /^[[:space:]]*menuentry[[:space:]]/) continue
            e = 0
            for (j = i; j <= n; j++)
                if (L[j] ~ /^[[:space:]]*}[[:space:]]*$/) { e = j; break }
            if (e == 0) continue
            ok = 0; bad = 0
            for (j = i; j <= e; j++) {
                if (L[j] ~ /boot=live/) ok = 1
                if (L[j] ~ /nomodeset/ || L[j] ~ /fail-safe/) bad = 1
            }
            if (ok && !bad) { start = i; end = e; break }
            i = e
        }
        if (start == 0) { for (i = 1; i <= n; i++) print L[i]; exit 3 }
        for (i = 1; i <= n; i++) {
            print L[i]
            if (i != end) continue
            print ""
            for (j = start; j <= end; j++) {
                s = L[j]
                sub(/[[:space:]]+$/, "", s)
                if (j == start) {
                    # Retitle in place so any --class/--id options survive.
                    q1 = index(s, "\"")
                    if (q1 == 0) { print s; continue }
                    rest = substr(s, q1 + 1)
                    q2 = index(rest, "\"")
                    if (q2 == 0) { print s; continue }
                    tail = substr(rest, q2)
                    # AND GIVE IT ITS OWN HOTKEY.
                    #
                    # This copy inherited --hotkey=l from the entry it was copied
                    # from, so the shipped grub.cfg carried the key twice:
                    #   menuentry "... Free edition" --hotkey=l
                    #   menuentry "... Free edition  (with screen reader)" --hotkey=l
                    # (both confirmed in out/dagric-os-1.0-amd64.iso). GRUB fires
                    # the FIRST entry matching a hotkey, and the copy is inserted
                    # after the original — so pressing "l" always booted the
                    # SIGHTED entry. The one menu item that exists solely for a
                    # blind owner had no keypress that reached it, at the exact
                    # moment they are deciding whether this OS is usable at all.
                    #
                    # "s" for screen reader, and it is free: the generated menu
                    # uses l (live), f (firmware settings) and v (verify medium).
                    if (tail ~ /--hotkey=/) { sub(/--hotkey=[^ ]+/, "--hotkey=s", tail) }
                    else { tail = substr(tail, 1, 1) " --hotkey=s" substr(tail, 2) }
                    print substr(s, 1, q1) lbl tail
                    continue
                }
                if (s ~ /^[[:space:]]*linux/) { print s " dagric.a11y=1"; continue }
                print s
            }
        }
        exit 0
    }' "$f" > "$f.a11y" || rc=$?
    if [ "$rc" -eq 0 ] && [ -s "$f.a11y" ]; then mv "$f.a11y" "$f"; else rm -f "$f.a11y"; fi
done

# ---------------------------------------------------------------------------
# A LANGUAGE SUBMENU, BECAUSE THE TRIAL WAS ENGLISH-ONLY ON A SIX-LANGUAGE
# PRODUCT.
#
# Found by booting the image and looking at the menu: four entries, none of them
# a language, none passing a locale. So the guide, the welcome page, the Hub,
# the launcher entries and KDE are all translated into five languages besides
# English — and a German visitor evaluating the USB stick never saw any of it.
# The installed system was always fine, because Calamares carries its own
# language page; it was the shop window that was English.
#
# ONE LINE, NOT FIVE. Five extra top-level entries would take the menu from four
# items to nine and make the common case worse to serve the uncommon one. A
# submenu costs the English-speaking majority a single row and matches the
# Utilities > entry already sitting beside it.
#
# THE LABEL CARRIES ITS OWN TRANSLATION, which is the whole point: a reader who
# cannot read "Language" is exactly the reader this row exists for. Sprache,
# Idioma, Langue, Lingua covers all five, because Portuguese and Spanish share
# Idioma. No word here is invented — they are the same words the guide's own
# language bar uses.
#
# The locale strings MUST match 0150-locales.hook.chroot's DAGRIC_LOCALES, or
# the boot parameter names a locale that was never generated and the session
# silently falls back to English — the exact failure this is meant to remove.
LANGROW="Language / Sprache / Idioma / Langue / Lingua"
LANGS="de_DE.UTF-8:Deutsch
en_US.UTF-8:English
es_ES.UTF-8:Español
fr_FR.UTF-8:Français
it_IT.UTF-8:Italiano
pt_BR.UTF-8:Português (Brasil)"

# --- GRUB (UEFI) -----------------------------------------------------------
# Cloned from the primary entry rather than written from scratch, so the kernel
# path, findiso= and every other parameter stay whatever live-build decided.
if [ -f boot/grub/grub.cfg ] && ! grep -q 'dagric-langmenu' boot/grub/grub.cfg; then
    _lin=$(awk '/^menuentry /{i++} i==1 && /^[[:space:]]*linux/{print; exit}' boot/grub/grub.cfg)
    _ini=$(awk '/^menuentry /{i++} i==1 && /^[[:space:]]*initrd/{print; exit}' boot/grub/grub.cfg)
    if [ -n "$_lin" ] && [ -n "$_ini" ]; then
        {
            printf '\n# dagric-langmenu\n'
            printf 'submenu "%s" {\n' "$LANGROW"
            printf '%s\n' "$LANGS" | while IFS=: read -r _loc _name; do
                [ -n "$_loc" ] || continue
                printf '  menuentry "%s" {\n' "$_name"
                printf '  %s locales=%s\n' "$_lin" "$_loc"
                printf '  %s\n' "$_ini"
                printf '  }\n'
            done
            printf '}\n'
        } >> boot/grub/grub.cfg
        echo "boot-branding: GRUB language submenu added"
    else
        echo "WARNING: could not read the primary GRUB entry — no language submenu" >&2
    fi
fi

# --- isolinux (BIOS) -------------------------------------------------------
# The machines this OS is sold for are old, and plenty of them boot BIOS rather
# than UEFI. A language row on only one of the two firmwares would be worse than
# none, because which one you get is invisible to the owner.
if [ -f isolinux/live.cfg ] && ! grep -q 'dagric-langmenu' isolinux/live.cfg; then
    # Leading whitespace is stripped: the source line carries a tab, and pasting
    # it after eight spaces produces mixed indentation that syslinux ignores and
    # a human reading live.cfg does not.
    _app=$(awk '/^label live-amd64$/{f=1} f && /^[[:space:]]*append/{sub(/^[[:space:]]+/,""); print; exit}' isolinux/live.cfg)
    if [ -n "$_app" ]; then
        {
            printf '\n# dagric-langmenu\n'
            printf 'menu begin dagric-lang\n'
            printf '    menu label %s\n' "$LANGROW"
            printf '    menu title %s\n' "$LANGROW"
            printf '%s\n' "$LANGS" | while IFS=: read -r _loc _name; do
                [ -n "$_loc" ] || continue
                printf '    label lang-%s\n' "${_loc%%.*}"
                printf '        menu label %s\n' "$_name"
                printf '        linux /live/vmlinuz\n'
                printf '        initrd /live/initrd.img\n'
                printf '        %s locales=%s\n' "$_app" "$_loc"
            done
            printf '    menu separator\n'
            printf '    label lang-back\n'
            printf '        menu label ^Back\n'
            printf '        menu exit\n'
            printf 'menu end\n'
        } >> isolinux/live.cfg
        echo "boot-branding: isolinux language submenu added"
    else
        echo "WARNING: could not read the primary isolinux entry — no language submenu" >&2
    fi
fi

# GRUB has no timeout line to rewrite — live-build never writes one — so add it
# rather than sed it. Prepended, because a menuentry block must not be split and
# the first line is the only position guaranteed to be outside one.
if [ -f boot/grub/grub.cfg ] && ! grep -q '^set timeout=' boot/grub/grub.cfg; then
    printf 'set default=0\nset timeout=%s\n%s\n' "$WAIT" "$(cat boot/grub/grub.cfg)" \
        > boot/grub/grub.cfg.new && mv boot/grub/grub.cfg.new boot/grub/grub.cfg
fi

# --- the GRUB theme ---------------------------------------------------------
#
# Installed from the chroot rather than generated here. The assets are PNGs and
# bitmap .pf2 fonts, and this hook runs inside the build container where there
# is no ImageMagick, no rsvg-convert and no TTFs — generating them at this point
# would mean generating them on every build machine, and the first one missing a
# tool ships a menu with no theme at all. config/bootloaders/make-boot-art.sh
# builds them by hand into config/includes.chroot/usr/share/dagric/boot/.
if [ -n "$ART" ] && [ -d boot/grub ]; then
    rm -rf boot/grub/themes/dagric
    mkdir -p boot/grub/themes
    cp -a "$ART/grub-theme" boot/grub/themes/dagric

    # theme.cfg is what selects a theme, and it is sourced again inside every
    # submenu so the submenus are themed too. live-build's version keyed off
    # splash.png and pointed at live-theme; this keys off the Dagric theme and
    # keeps live-theme as the fallback, so a failed copy degrades to the old
    # menu instead of to no menu.
    #
    # The loadfont lines are not optional. theme.txt matches fonts by NAME among
    # fonts that are ALREADY LOADED; a name that matches nothing silently falls
    # back to the built-in 16px Unifont and the theme looks like it was ignored.
    #
    # The directory is `f`, not `fonts`, and that is not cosmetic either. These
    # lines only exist on the ISO; an installed machine has no hook to write
    # them, and grub-mkconfig's 00_header auto-loads a theme's fonts with
    # exactly two non-recursive globs — "$themedir"/*.pf2 and "$themedir"/f/*.pf2,
    # the theme root and a directory literally named f, the name upstream's
    # starfield theme established. The faces sat under fonts/, matched neither,
    # and the installed menu drew in gfxterm's 16px unicode.pf2 while the USB it
    # was installed from drew the designed 24px faces — the exact regression
    # GRUB_THEME in 50-dagric.cfg was added to end, still live one layer down.
    # The directory was renamed; these paths follow it and must keep following.
    cat > boot/grub/theme.cfg <<'THEMECFG'
set color_normal=light-gray/black
set color_highlight=white/dark-gray

if [ -e $prefix/themes/dagric/theme.txt ]; then
    loadfont $prefix/themes/dagric/f/body.pf2
    loadfont $prefix/themes/dagric/f/sel.pf2
    loadfont $prefix/themes/dagric/f/small.pf2
    set theme=$prefix/themes/dagric/theme.txt
elif [ -e $prefix/splash.png ]; then
    set theme=$prefix/live-theme/theme.txt
else
    set menu_color_normal=cyan/blue
    set menu_color_highlight=white/blue
fi
THEMECFG

    if [ -f boot/grub/config.cfg ]; then
        # 800x600 is live-build's copy-from-netinst default, and it is why the
        # UEFI menu looks soft: on a 1080p laptop the entire GRUB screen is a
        # 4:3 image scaled up. A preference list gets the real panel resolution
        # where the firmware offers it, with auto last so nothing can be left
        # without a mode. gfxpayload=keep is already there and is correct — it
        # hands the kernel the framebuffer GRUB is using, so there is no mode
        # change between the menu and Plymouth.
        #
        # A BARE `auto` WAS PROPOSED AND IS NOT WHAT THIS SHIPS. The case for it
        # is real and measured: `auto` takes the mode the firmware is already
        # in, so there is no firmware->GRUB mode change at all, and the list
        # does cost one — booted under OVMF the firmware sits at 1280x800, GRUB
        # takes 1920x1080 off the front of this list, and the frame in between
        # is black.
        #
        # It is one black frame, and the alternative is worse. Everything in
        # this theme is a fixed pixel size, because GRUB cannot scale a font: it
        # renders pre-generated .pf2 bitmaps, so the panel is 340 px and the
        # type is 24 px whatever the screen is. On a 4K laptop — whose firmware
        # does run its GOP at native — `auto` produces a menu occupying a
        # quarter of the screen's width in unreadable type. Capping the
        # preference at 1920x1080 bounds that, and one black frame at the very
        # start of the boot is a cheaper thing to spend than legibility on the
        # newest hardware the product runs on. Revisit if the theme ever gains
        # a HiDPI font set.
        sed -i 's|^\([[:space:]]*\)set gfxmode=800x600[[:space:]]*$|\1set gfxmode=1920x1080,1280x800,1024x768,auto|' \
            boot/grub/config.cfg

        # Two 440 Hz tones at every boot, from live-build's default config.
        # Nothing Windows or macOS does, and the audience for this OS is people
        # who just left Windows.
        sed -i '/^insmod play[[:space:]]*$/d; /^play 960 440 /d' boot/grub/config.cfg

        # The black rectangle at the moment of boot.
        #
        # desktop-image belongs to gfxmenu. When the menu exits, gfxmenu stops
        # painting and gfxterm takes over, clears its own rectangle to black and
        # prints GRUB's "Booting `...'" line into it. On the shipped 2 GB ISO
        # that black box is the entire visible boot for twenty seconds while the
        # squashfs loads. Giving gfxterm the same picture the menu was drawing
        # removes it; theme.txt pairs this by handing gfxterm the whole screen
        # rather than an inset box, or the image lands in the wrong place.
        #
        # background.png — the BRANDED art, the same file the menu itself draws.
        #
        # This was terminal.png, a copy with the brand block rendered out,
        # because gfxterm's background_image can only stretch and never crop and
        # the monogram squashes on a 4:3 panel. That reasoning is correct and
        # the conclusion was still wrong, because it optimised the wrong screen.
        # This is not a screen anybody glances at: it is the longest single
        # stretch of the whole boot, ~15-19 s while GRUB reads the initrd, and
        # the unbranded version made the sequence read menu-WITH-mark ->
        # fifteen seconds with NO mark -> Plymouth with the mark BACK. The mark
        # blinking out and returning is a worse artifact than a slightly
        # stretched circle, and it happened on every machine rather than on
        # some.
        #
        # Rendered and looked at under OVMF at each mode the gfxmode preference
        # list above can land on:
        #   1920x1080  exact — the art is authored at this size, and the load
        #              screen becomes byte-identical to the menu's own backdrop
        #   1280x800   ~11% narrow; the circle still reads as a circle
        #   1024x768   ~25% narrow; a visibly oval monogram. This is the third
        #              choice in the list and only reached on firmware that
        #              offers no widescreen mode at all.
        #
        # terminal.png is still generated and still shipped. If a deployment is
        # mostly 4:3 hardware, swapping the filename on the line below is the
        # whole change.
        if ! grep -q gfxterm_background boot/grub/config.cfg; then
            cat >> boot/grub/config.cfg <<'BGCFG'

if [ -e $prefix/themes/dagric/background.png ]; then
    insmod gfxterm_background
    background_image -m stretch $prefix/themes/dagric/background.png
fi
BGCFG
        fi
    fi
fi

# The GRUB theme's title. This is NOT boot/grub/theme.cfg — that file only
# points at the theme — it is theme.txt inside the theme directory, which is
# why the previous sed here silently did nothing for months while the check
# below reported success: it verified the MENU ENTRY text, which did apply.
#
# The title is blanked rather than branded. It renders centred at the top of the
# screen, which is exactly where splash.png already puts the DAGRIC wordmark and
# the tagline, so any title at all prints straight through the logo — the ISO
# in hand renders "Live Boot Menu with GRUB" as a second line of text embossed
# over "DAGRIC". The art already says whose OS this is; the edition is named in
# the menu entries, which is where someone actually looks.
THEMES=$(find boot/grub -name theme.txt 2>/dev/null)
for f in $THEMES; do
    sed -i 's/^\([[:space:]]*title-text:[[:space:]]*\).*/\1""/' "$f"
done

# Verify what was actually CHANGED, not merely something nearby. The old check
# passed on the menu entries alone and so never noticed the title miss.
MISS=""
# Per FILE, not one-of-two. A count with `-ge 1` passes when the BIOS rewrite
# worked and the UEFI one silently did not — and UEFI is the path most machines
# take, so the two ISOs would be indistinguishable at boot exactly where it
# matters most. This is the same defect the isolinux-splash note at the top of
# the file describes: a MISS entry that asserts nothing about the change this
# hook made. The accessible-entry check further down already tests each file on
# its own; this is that rule applied to the label the editions are told apart by.
for f in isolinux/live.cfg boot/grub/grub.cfg; do
    [ -f "$f" ] || continue
    grep -q "$LIVE" "$f" || MISS="$MISS edition-label:$f"
done
if [ -f boot/grub/grub.cfg ]; then
    grep -q "^set timeout=$WAIT" boot/grub/grub.cfg || MISS="$MISS grub-timeout"
fi
if [ -f isolinux/isolinux.cfg ]; then
    grep -qE "^[[:space:]]*timeout[[:space:]]+0[[:space:]]*$" isolinux/isolinux.cfg \
        && MISS="$MISS isolinux-timeout"
fi
for f in $THEMES; do
    grep -qE '^[[:space:]]*title-text:[[:space:]]*""' "$f" || MISS="$MISS theme-title"
done
if [ -n "$ART" ]; then
    [ -f boot/grub/themes/dagric/theme.txt ] || MISS="$MISS grub-theme"
    [ -f isolinux/splash.png ] || MISS="$MISS isolinux-splash"
    if [ -f boot/grub/theme.cfg ]; then
        grep -q 'themes/dagric/theme.txt' boot/grub/theme.cfg || MISS="$MISS theme-cfg"
    fi
    if [ -f boot/grub/config.cfg ]; then
        grep -q '^[[:space:]]*set gfxmode=1920x1080' boot/grub/config.cfg || MISS="$MISS gfxmode"
        grep -q 'gfxterm_background' boot/grub/config.cfg || MISS="$MISS gfxterm-bg"
        grep -q '^play ' boot/grub/config.cfg && MISS="$MISS grub-beep"
    fi
else
    MISS="$MISS boot-art-missing"
fi
if [ -f isolinux/menu.cfg ]; then
    grep -qE '^[[:space:]]*menu title[[:space:]]*$' isolinux/menu.cfg || MISS="$MISS isolinux-title"
fi
if [ -f isolinux/stdmenu.cfg ]; then
    grep -q '^menu resolution 1024 768' isolinux/stdmenu.cfg || MISS="$MISS isolinux-style"
fi
# The accessible entry, checked in every menu file that actually holds live
# entries. A file with no boot=live in it has no entry to have copied.
for f in isolinux/live.cfg boot/grub/grub.cfg boot/grub/config.cfg; do
    [ -f "$f" ] || continue
    grep -q 'boot=live' "$f" || continue
    grep -q 'dagric\.a11y=1' "$f" || MISS="$MISS a11y-entry:$f"
done
# The GRUB theme's panel is a fixed pixel height, so it holds a fixed number of
# rows — five, at the item metrics in theme.txt. A sixth top-level entry is not
# an error and is still reachable with the arrow keys, because GRUB scrolls the
# list to keep the selection visible, but it will not be ON SCREEN when the menu
# first draws, and there is no scrollbar to say so. Whoever adds one should
# raise `height` by 52 AND the progress_bar's `top` by the same 52.
#
# AND THIS GUARD NEVER SAW THE MENU THAT NEEDED IT. It counts entries in the
# ISO's grub.cfg, which has four and always did, so it sat silent and correct
# while the panel was 52px too short somewhere it does not look. The theme is no
# longer only the ISO's: 50-dagric.cfg sets GRUB_THEME, so it draws the
# INSTALLED machine's menu too, and that list is generated by /etc/grub.d and
# never passes through this hook — two entries from 10_linux, Windows from
# 30_os-prober, UEFI Firmware Settings, and the grub-btrfs snapshot submenu
# fifth. That is what raised `height` to 340. Keeping this check is still worth
# it, because it is the only thing watching the ISO side; just do not read a
# quiet build as proof the installed menu fits. Entries inside `if false; then
# ... fi` are the installer block live-build always emits and never renders;
# they do not count.
if [ -f boot/grub/grub.cfg ]; then
    ENTRIES=$(awk '
        /^if false; then/ { skip = 1 }
        skip && /^fi[[:space:]]*$/ { skip = 0; next }
        skip { next }
        /^(menuentry|submenu)[[:space:]]/ { n++ }
        END { print n + 0 }
    ' boot/grub/grub.cfg)
    if [ "$ENTRIES" -gt 5 ]; then
        echo "WARNING: $ENTRIES top-level GRUB entries but the theme panel fits 5 —"
        echo "         raise boot_menu height in usr/share/dagric/boot/grub-theme/theme.txt"
    fi
fi

if [ -z "$MISS" ]; then
    echo "Boot menu branded for the $EDITION edition: \"$LIVE\" (${WAIT}s timeout)"
    echo "Accessible boot entry added: \"$A11Y\" (dagric.a11y=1)"
    echo "GRUB theme installed: boot/grub/themes/dagric (visible countdown, 1080p)"
    echo "BIOS menu styled: isolinux/stdmenu.cfg at 1024x768"
else
    echo "WARNING: boot-menu branding incomplete —$MISS"
fi
