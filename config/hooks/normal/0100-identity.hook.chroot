#!/bin/sh
# Freehold OS — system identity
# Rebrands the installed system while honestly stating the Debian base
# (per Debian's derivative guidelines: own name, ID_LIKE=debian).
set -e

cat > /usr/lib/os-release << 'EOF'
NAME="Freehold OS"
PRETTY_NAME="Freehold OS 1.0 (Foundation)"
ID=freehold
ID_LIKE=debian
VERSION="1.0 (Foundation)"
VERSION_ID="1.0"
VERSION_CODENAME=foundation
DEBIAN_VERSION="13 (trixie)"
HOME_URL="https://example.org/freehold"
SUPPORT_URL="https://example.org/freehold/support"
BUG_REPORT_URL="https://example.org/freehold/bugs"
EOF

# /etc/os-release is normally a symlink to the file above; make sure.
ln -sf ../usr/lib/os-release /etc/os-release

cat > /etc/issue << 'EOF'
Freehold OS 1.0 \n \l

EOF
printf 'Freehold OS 1.0 (Foundation)\n' > /etc/issue.net
