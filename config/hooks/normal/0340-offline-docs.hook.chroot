#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — prove the offline documentation actually works offline.
#
# WHY THIS HOOK EXISTS. The guide, the manual and the welcome page are opened as
# files: dagric-guide, dagric-manual and dagric-welcome all end in
#
#     exec "$b" "file://$PAGE"
#
# so every path inside them resolves against the FILESYSTEM ROOT, not against a
# web server. A leading slash is therefore not "site-absolute" here — it is
# /guide/guide.css, a path that exists on dagric.com and nowhere on this image.
#
# That is not hypothetical. Both shipped guides — the English one and the German
# one — carried href="/guide/guide.css" and src="/guide/guide.js" in the image,
# so the in-OS guide loaded no stylesheet and no JavaScript at all: no sidebar
# search, no checklist that remembers what you ticked, 21 sections of unstyled
# black-on-white. tools/publish-guide.py rewrites the relative paths to absolute
# ones ON THE WAY OUT to the website, and the absolute forms had been written
# back into the source, which is exactly backwards — the web copy is the derived
# one. It shipped that way because nothing checked, and the one reader who hits
# it is the reader with no internet, looking up how to fix the Wi-Fi.
#
# The checks are fatal. An offline guide that does not render offline is not a
# guide, and a language switcher pointing at a directory we did not ship is
# worse than no switcher.
set -e

DOCS=${DAGRIC_DOCS_ROOT:-/usr/share/dagric}
APPS=${DAGRIC_APPLICATIONS_ROOT:-/usr/share/applications}
LOCAL_APPS=${DAGRIC_LOCAL_APPLICATIONS_ROOT:-/usr/local/share/applications}
GUIDE="$DOCS/guide"
fail=0

# --- 1. no path may assume a web server -------------------------------------
#
# href="//host" is protocol-relative and equally wrong offline, but nothing here
# writes one; the grep excludes it so that a future absolute EXTERNAL link is
# reported by its own rule rather than confusing this one.
_abs=$(grep -rn 'href="/\|src="/' "$DOCS" 2>/dev/null | grep -v 'href="//' || true)
if [ -n "$_abs" ]; then
    echo "ERROR: offline documentation contains root-absolute paths. Opened as" >&2
    echo "       file://, these resolve to the filesystem root and load nothing:" >&2
    echo "$_abs" | sed 's|^/usr/share/dagric/|       |' >&2
    echo "       Use relative paths here. tools/publish-guide.py makes them" >&2
    echo "       absolute for the website; the image keeps the relative ones." >&2
    fail=1
fi

# --- 2. every language the switcher offers must exist ------------------------
#
# The bar is written by hand in six files. A typo, or a language added to the
# bar before its directory lands, gives a dead link on the one control whose
# entire job is getting a reader to a language they can read.
#
# THIS LOOP COVERS THE GUIDE ONLY, AND THAT WAS A HOLE. Check 1 above catches
# root-absolute paths anywhere under $DOCS, and this check resolves langbar
# links in the guide — so a page whose ORDINARY relative paths are wrong passed
# both. That is exactly what happened to the welcome page: es/, fr/, it/ and
# pt_BR/ were translated from the English copy, which sits one level HIGHER in
# the tree, so all four kept href="welcome.css" and src="../logo/..." and every
# one of the twelve resolved to nothing. Unstyled page, no logo, dead guide
# link, in four languages, and nothing in the build said a word.
# Check 2b below is the general form: every relative href and src in every
# offline page must resolve from where that page actually sits.
for _page in "$GUIDE/index.html" "$GUIDE"/*/index.html; do
    [ -f "$_page" ] || continue
    _dir=$(dirname "$_page")
    # One href per line, langbar links only, then resolve each against the page.
    sed -n '/<div class="langbar">/,/<\/div>/p' "$_page" \
        | grep -o 'href="[^"]*"' | sed 's/href="//; s/"$//' \
    | while IFS= read -r _href; do
        [ -n "$_href" ] || continue
        case "$_href" in
            http*|"#"*) continue ;;
        esac
        if [ ! -f "$_dir/$_href" ]; then
            echo "ERROR: $_page language switcher points at" >&2
            echo "       $_href, which does not resolve to a file." >&2
            exit 1
        fi
    done || fail=1
done

# --- 2b. every relative href and src in every offline page must resolve -------
#
# The general form of check 2. Anything opened with file:// has no server to
# forgive a wrong path, so a stylesheet one directory off is a page that renders
# as unstyled text — and it renders that way only for the readers who are not
# using English, which is the group least likely to report it.
#
# Fragments are stripped before the test and anchors are NOT resolved here;
# a #target that does not exist is a bad jump, not a blank page, and this check
# is about the blank-page class. http(s) and mailto are external by definition.
for _page in $(find "$DOCS" -name '*.html' -type f 2>/dev/null); do
    _dir=$(dirname "$_page")
    grep -o '\(href\|src\)="[^"]*"' "$_page" 2>/dev/null \
        | sed 's/^[a-z]*="//; s/"$//' \
    | while IFS= read -r _ref; do
        [ -n "$_ref" ] || continue
        case "$_ref" in
            http*|mailto:*|data:*|"#"*|"") continue ;;
        esac
        _target=${_ref%%#*}
        [ -n "$_target" ] || continue
        if [ ! -e "$_dir/$_target" ]; then
            echo "ERROR: $_page references" >&2
            echo "       $_ref" >&2
            echo "       which does not resolve from $_dir." >&2
            echo "       Opened offline this is a missing stylesheet, image or" >&2
            echo "       link. A page translated from a copy at a different" >&2
            echo "       depth in the tree is the usual cause." >&2
            exit 1
        fi
    done || fail=1
done

# --- 2c. the manual's page count must be the number of pages ----------------
#
# The count is written down in eight places and computed in one. manual.js sets
# the counter from the real card total at load, so the LIVE product is always
# right; every other copy is a human typing a number that was true once.
#
# It has already drifted twice. A comment in manual.js records the first: the
# German guide said "95 Seiten" while the manual held 94 and the counter beside
# it displayed 94. The second was caused by ADDING A PAGE — the Check This PC
# page took the real total from 94 to 95, which silently made the German and
# Spanish guides correct and the static fallback, the CSS comments and
# EDITIONS.md wrong, all in the same commit.
#
# The static span is the no-JavaScript fallback, so it is the one a reader with
# scripting off actually sees. Checking it against the file count is one line
# and removes the whole class.
_mpages=$(find "$DOCS/manual" -maxdepth 1 -name '*.html' ! -name 'index.html' | wc -l)
_mcards=$(grep -c '<a class="card"' "$DOCS/manual/index.html" 2>/dev/null || echo 0)
_mstatic=$(grep -o 'id="count"[^>]*>[0-9]* pages<' "$DOCS/manual/index.html" | tr -dc '0-9' | head -1)
if [ "$_mcards" != "$_mpages" ]; then
    echo "ERROR: the manual has $_mpages pages but index.html lists $_mcards cards." >&2
    echo "       A page with no card is unreachable; a card with no page is a" >&2
    echo "       dead link. Add the card, or delete it." >&2
    fail=1
fi
# PER-GROUP COUNTS TOO, BECAUSE CHECKING THE TOTAL IS WHAT LET THIS THROUGH.
#
# The sidebar prints a count beside each of the nine groups. Adding the Check
# This PC page moved "Dagric's own tools" from 19 to 20, the total from 94 to
# 95, and the check written an hour earlier compared only the total — which the
# card list had already updated, so it passed. The nine group counts sum to the
# total, so a single group being wrong is invisible to a total-only check
# UNLESS another group is wrong in the opposite direction, which is exactly the
# case worth catching.
#
# awk walks the file once: it records each sidebar count by group id, then
# counts a.card between one <section id="g-..."> and the next, and prints any
# group where the two disagree.
_gmis=$(gawk '
  match($0, /data-goto="(g-[a-z]+)"/, g) {
      if (match($0, /<span class="count">([0-9]+)<\/span>/, c)) want[g[1]] = c[1]
  }
  match($0, /<section[^>]*id="(g-[a-z]+)"/, s) { cur = s[1] }
  cur && /<a class="card"/ { have[cur]++ }
  END { for (k in want) if (want[k] != have[k]) print "  " k ": sidebar says " want[k] ", " have[k]+0 " cards" }
' "$DOCS/manual/index.html" 2>/dev/null)
if [ -n "$_gmis" ]; then
    echo "ERROR: the manual sidebar's group counts disagree with the cards:" >&2
    echo "$_gmis" >&2
    echo "       Adding or moving a page means moving its group count with it." >&2
    fail=1
fi

if [ -n "$_mstatic" ] && [ "$_mstatic" != "$_mpages" ]; then
    echo "ERROR: the manual has $_mpages pages and its static counter says" >&2
    echo "       $_mstatic. manual.js overwrites this at load, so the wrong" >&2
    echo "       number is shown only to a reader with JavaScript off — which is" >&2
    echo "       the reader the fallback exists for." >&2
    fail=1
fi

# --- 3. the manual's language notice must match the guides we ship -----------
#
# manual.js offers "this manual is English, here is your language's guide" and
# builds that link from its own LANGS table. A guide shipped without a LANGS
# entry gets no notice and no route back; a LANGS entry without a guide gets a
# link to nothing. Both are silent, so the build says it instead.
MJS="$DOCS/manual/manual.js"
if [ -f "$MJS" ]; then
    # `dir: 'xx',` — the directory each entry actually points at, which is not
    # always its key (pt lives in guide/pt_BR/).
    for _d in $(grep -o "dir: '[^']*'" "$MJS" | sed "s/dir: '//; s/'//"); do
        if [ ! -f "$GUIDE/$_d/index.html" ]; then
            echo "ERROR: manual.js offers the guide in '$_d' but" >&2
            echo "       $GUIDE/$_d/index.html is not on the image." >&2
            fail=1
        fi
    done
    for _p in "$GUIDE"/*/index.html; do
        [ -f "$_p" ] || continue
        _d=$(basename "$(dirname "$_p")")
        if ! grep -q "dir: '$_d'" "$MJS"; then
            echo "ERROR: the guide ships in '$_d' but manual.js has no LANGS" >&2
            echo "       entry for it, so a reader in that language opening the" >&2
            echo "       manual is told nothing and offered no way back." >&2
            fail=1
        fi
    done
fi

# --- 4. every visible launcher must have a manual route ---------------------
#
# "Every app" used to mean every CARD the manual author remembered to add.
# That let ten installed launchers ship without a page of their own and gave us
# no warning when a new Dagric tool landed. application-map.tsv is the explicit
# contract between the desktop menu and the offline manual. Alternate launchers
# for one feature may share a page, but silence is no longer allowed.
MMAP="$DOCS/manual/application-map.tsv"
if [ ! -f "$MMAP" ]; then
    echo "ERROR: offline manual launcher map is missing: $MMAP" >&2
    fail=1
else
    _dups=$(awk -F '\t' '!/^#/ && NF { print $1 }' "$MMAP" | sort | uniq -d)
    if [ -n "$_dups" ]; then
        echo "ERROR: duplicate launcher names in $MMAP:" >&2
        echo "$_dups" | sed 's/^/       /' >&2
        fail=1
    fi

    while IFS="$(printf '\t')" read -r _desktop _manual_page; do
        case "$_desktop" in ''|'#'*) continue ;; esac
        if [ ! -f "$DOCS/manual/$_manual_page" ]; then
            echo "ERROR: $_desktop maps to missing manual page $_manual_page" >&2
            fail=1
        fi
    done < "$MMAP"

    for _desktop_path in "$APPS"/*.desktop; do
        [ -f "$_desktop_path" ] || continue
        _desktop=$(basename "$_desktop_path")
        # A same-named /usr/local entry intentionally overrides a package entry
        # (Dagric uses this to hide Debian launchers that are not useful here).
        _effective="$_desktop_path"
        [ -f "$LOCAL_APPS/$_desktop" ] \
            && _effective="$LOCAL_APPS/$_desktop"
        _visible=$(awk -F= '
            BEGIN { inside=0; type="Application"; nodisplay="false"; hidden="false" }
            /^\[Desktop Entry\]$/ { inside=1; next }
            inside && /^\[/ { exit }
            inside && $1 == "Type" { type=tolower($2) }
            inside && $1 == "NoDisplay" { nodisplay=tolower($2) }
            inside && $1 == "Hidden" { hidden=tolower($2) }
            END {
                if (type == "application" && nodisplay != "true" && hidden != "true") print "yes"
            }
        ' "$_effective")
        [ "$_visible" = yes ] || continue
        if ! awk -F '\t' -v d="$_desktop" '!/^#/ && $1 == d { found=1 } END { exit !found }' "$MMAP"; then
            echo "ERROR: visible launcher $_desktop has no offline manual route." >&2
            echo "       Add it to manual/application-map.tsv and document it." >&2
            fail=1
        fi
    done
fi

[ "$fail" -eq 0 ] || exit 1

_n=$(find "$GUIDE" -mindepth 2 -name index.html | wc -l)
_w=$(find "$DOCS/welcome" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
_h=$(find "$DOCS" -name '*.html' -type f 2>/dev/null | wc -l)
echo "offline-docs: guide in $((_n + 1)) languages, welcome page in $((_w + 1)),"
echo "              every switcher target present, manual.js table matches,"
echo "              every visible launcher has a manual route, no root-absolute"
echo "              paths, and all relative refs in $_h pages resolve"
unset _abs _page _dir _href _ref _target _d _p _n _w _h MJS MMAP APPS LOCAL_APPS
unset _dups _desktop _manual_page _desktop_path _effective _visible
