#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — take the executable bit off files that are not programs.
#
# systemd says this into the journal on every boot of every machine:
#
#   Configuration file /etc/systemd/system.conf.d/10-dagric-stop-timeout.conf
#   is marked executable. Please remove executable permission bits.
#   Proceeding anyway.
#
# ...and the same for the journald drop-in, the zramswap drop-in and
# dagric-snapshot-setup.service. Three warnings, every boot, forever.
#
# WHY IT HAPPENS, because the obvious fix is to chmod the files and that does
# nothing. Git has all of them recorded as 100644 — checked, they are correct in
# the repository. The bit is added by the CHECKOUT: this tree is developed on
# Windows, which has no POSIX mode bits, so everything under config/ reads back
# as 0755 through drvfs/9p, and build.ps1 mounts the working tree straight into
# the build container. live-build then copies config/includes.chroot into the
# chroot with `cp -a`, faithfully preserving a permission that was invented by
# the filesystem. Nothing in the repository is wrong and nothing in the
# repository can fix it, which is why this is a build step.
#
# Only extensions that are never executable are touched. /etc has plenty of
# directories where the bit is load-bearing — network/if-up.d, cron.daily,
# init.d, kernel/install.d — and a blanket `chmod -R 0644 /etc` would break
# every one of them silently. A .conf or a .service is data in every case there
# is.
#
# This is cosmetic: systemd says "Proceeding anyway" and means it. It is here
# because a journal that cries wolf on every boot is a journal nobody reads the
# day something real goes wrong, and because a paying owner running
# `journalctl -b` should not be met with three complaints about our own files.
set -e

FIXED=0
# /usr/lib/systemd/system and .../user are here because Dagric ships units there
# too, not only under /etc — dagric-ssh-hostkeys.service was the first, and
# systemd complains about an executable unit wherever it finds it.
#
# Those two subdirectories specifically, NOT /usr/lib/systemd, and the reason is
# the warning at the top of this file. That tree also holds system-generators,
# user-generators, system-sleep and system-shutdown, and every file in them is a
# program that MUST keep its executable bit — chmod 0644 on a generator breaks
# the boot. The name filter below happens to spare them (they carry no
# extension), but relying on that would mean the day someone drops a
# 90-something.conf hook into system-sleep, this hook silently disables it.
# Name the directories that contain unit files and nothing else.
#
# /etc/opensnitchd/rules is in the list because it holds the pre-answered
# firewall rules, and *.json is in the name filter for the same reason. A rule
# file is data that a ROOT daemon reads and enforces; shipping it executable is
# the wrong bit on the wrong file even though opensnitchd does not care.
# /etc/initramfs-tools/conf.d likewise: KEYMAP=y is sourced by mkinitramfs, and
# a sourced fragment has no business being executable either.
for d in /etc/systemd /usr/lib/systemd/system /usr/lib/systemd/user \
         /etc/sysctl.d /etc/sddm.conf.d /etc/udev/rules.d /etc/calamares \
         /etc/opensnitchd /etc/initramfs-tools/conf.d \
         /usr/share/polkit-1/actions; do
    [ -d "$d" ] || continue
    for f in $(find "$d" -type f \
                    \( -name '*.conf' -o -name '*.service' -o -name '*.socket' \
                       -o -name '*.timer'  -o -name '*.target'  -o -name '*.mount' \
                       -o -name '*.path'   -o -name '*.preset'  -o -name '*.rules' \
                       -o -name '*.json'   -o -name '*.policy' \
                       -o -name 'dagric-*' \) \
                    -perm /111 2>/dev/null); do
        chmod 0644 "$f"
        echo "file-modes: 0644 $f"
        FIXED=$((FIXED + 1))
    done
done

# THE OPPOSITE PROBLEM, IN THE ONE PLACE IT IS SILENT.
#
# Everything above REMOVES an executable bit that drvfs invented. /etc/grub.d is
# the inverse case and is deliberately not in the list above: grub-mkconfig runs
# every file in that directory through a `test -x` and SKIPS anything that is not
# executable — no warning, no error, no line in any log, just a boot menu with one
# fewer entry than the tree says it has. 45_dagric_safe is the owner's way back in
# when a driver update leaves them at a black screen, so it losing its bit is
# exactly the failure nobody would notice until the day it was needed. Proven, not
# assumed: chmod 0644 on it and re-running grub-mkconfig produces no entry and
# exits 0.
if [ -f /etc/grub.d/45_dagric_safe ]; then
    chmod 0755 /etc/grub.d/45_dagric_safe
    if [ -x /etc/grub.d/45_dagric_safe ]; then
        echo "file-modes: 0755 /etc/grub.d/45_dagric_safe (safe-graphics boot entry)"
    else
        echo "ERROR: /etc/grub.d/45_dagric_safe is not executable, so grub-mkconfig" >&2
        echo "       will silently emit no safe-graphics entry." >&2
        exit 1
    fi
else
    echo "ERROR: /etc/grub.d/45_dagric_safe is missing from the image." >&2
    exit 1
fi

if [ "$FIXED" -eq 0 ]; then
    # Not a failure. It is what a Linux checkout looks like, and it is what this
    # image should look like once the build host stops handing us 0755.
    echo "file-modes: nothing to fix — no config file arrived executable"
else
    echo "file-modes: cleared the executable bit on $FIXED config files"
fi

# TRANSLATION SOURCES ARE BUILD INPUTS, NOT RUNTIME FILES.
#
# The login theme and the installer slideshow are translated with Qt catalogues,
# and both the .ts sources and the compiled .qm live beside the QML in
# includes.chroot — the .ts because a committed, reviewable source is how this
# project treats every other catalogue (po/*.po sits beside the .mo it builds).
# But only the .qm is read at runtime: SDDM loads translations/<locale>.qm and
# Calamares loads lang/calamares-dagric_<locale>.qm. The XML sources are ~33 KB
# of build input that no installed machine has any use for.
#
# Removed here rather than excluded at the copy, because includes.chroot is the
# single source of truth for what the image contains and a second exclusion list
# in build.sh is one more thing to drift. The .qm are asserted afterwards: a
# cleanup that removed the compiled catalogue instead of the source would put
# the login screen back into English in five languages, silently.
TSGONE=0
for _d in /usr/share/sddm/themes/dagric/translations \
          /etc/calamares/branding/dagric/lang; do
    [ -d "$_d" ] || continue
    for _t in "$_d"/*.ts; do
        [ -f "$_t" ] || continue
        rm -f "$_t"
        TSGONE=$((TSGONE + 1))
    done
    _n=$(ls -1 "$_d"/*.qm 2>/dev/null | wc -l)
    if [ "$_n" -lt 5 ]; then
        echo "ERROR: only $_n compiled catalogues left in $_d (want 5 or more)." >&2
        echo "       The login screen or installer would be English in every" >&2
        echo "       language but one, and nothing else would report it." >&2
        exit 1
    fi
    echo "file-modes: $_d — $_n compiled catalogues kept"
done
# Written as an `if`, not as `[ ... ] && echo`. This hook has no `set -e` today
# so the short-circuit form is harmless — but it is the last statement in the
# file, and the day somebody adds `set -e` at the top (every other hook here has
# it) a build with nothing to remove would abort on a false condition and fail
# for reporting "there was nothing to do".
if [ "$TSGONE" -gt 0 ]; then
    echo "file-modes: removed $TSGONE .ts translation sources from the image"
fi
exit 0
