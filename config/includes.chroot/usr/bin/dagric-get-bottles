#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install Bottles, on request (Pro Windows-app support).
# Bottles (GPL-3.0) runs Windows software on Linux in tidy, per-app
# containers, with a curated database of installers and gaming launchers —
# a much friendlier front-end than raw Wine (which Pro also ships). Installed
# from the already-enabled Flathub as a per-user Flatpak (no root needed).
#
# The `cat << 'EOF'` block this file used to open with is now one gettext()
# call. xgettext cannot see inside a heredoc at all, so left as it was this
# helper would have stayed English while the Hub that launched it turned
# German. The blank line inside the msgid is deliberate: the whole thing is
# ONE translation unit, so a translator can rebuild the paragraph in an order
# that reads naturally in their language instead of sentence by sentence.
. /usr/bin/dagric-i18n.sh

dg_say "$(gettext "Dagric — install Bottles (run Windows apps)

Bottles is a free, open-source app that runs Windows programs and games on
Linux inside self-contained \"bottles\", tuned per app for the best chance of
working. It's the easy way to bring a Windows app across. Installs from Flathub.")"

dg_live_warn
printf '\n%s ' "$(gettext "Install Bottles now? [y/N]")"
read ans
if ! dg_is_yes "$ans"; then
    dg_say "$(gettext "No changes made.")"
    exit 0
fi

flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
if flatpak install --user -y --noninteractive flathub com.usebottles.bottles; then
    echo; dg_say "$(gettext "Bottles installed — launch it from the application launcher.")"
else
    echo; dg_say "$(gettext "Install did not complete. Check your network and try again.")"
fi
