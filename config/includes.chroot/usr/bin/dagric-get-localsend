#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install LocalSend, on request.
# LocalSend (open source) shares files and messages between your devices over
# your local network — like AirDrop, but cross-platform and with no account,
# no cloud, and no internet required. Deeply on-brand for a private OS.
# Installed from the already-enabled Flathub as a per-user Flatpak (no root).
. /usr/bin/dagric-i18n.sh

dg_say "$(gettext "Dagric — install LocalSend (share files, privately)

LocalSend sends files and messages straight between your devices on the same
network — phone, laptop, desktop — with no account, no cloud, and nothing
leaving your network. It's the private alternative to AirDrop. From Flathub.")"

dg_live_warn
printf '\n%s ' "$(gettext "Install LocalSend now? [y/N]")"
read ans
if ! dg_is_yes "$ans"; then
    dg_say "$(gettext "No changes made.")"
    exit 0
fi

flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
if flatpak install --user -y --noninteractive flathub org.localsend.localsend_app; then
    echo
    dg_say "$(gettext "LocalSend installed — launch it from the application launcher.")"
    dg_say "$(gettext "Install it on your phone too (same name) and they'll find each other.")"
else
    echo; dg_say "$(gettext "Install did not complete. Check your network and try again.")"
fi
