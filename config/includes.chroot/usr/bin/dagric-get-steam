#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install Steam, on the owner's request.
# Steam's installer (steam-installer) is in Debian's non-free section and
# carries Valve's Subscriber Agreement, so Dagric never bundles it. This
# installs it only when you ask — the same honest, user-consented pattern as
# the NVIDIA driver and DaVinci Resolve helpers. The 32-bit libraries Steam
# needs (i386 multiarch, Wine32, 32-bit Vulkan) are already in place on Pro,
# so this is a quick download.
. /usr/bin/dagric-i18n.sh

# TRANSLATORS: this paragraph explains a LICENCE position — Dagric does not
# bundle Steam because Valve's licence forbids it. Keep that meaning exact;
# it is the reason the helper exists. "Steam" and "Valve" are product names.
dg_say "$(gettext "Dagric — install Steam

Steam is Valve's proprietary game store and launcher. Dagric doesn't ship it
preinstalled (its licence forbids anyone bundling it), but installing it is one
step. Everything it depends on is already set up on Dagric Pro.

You'll be asked for your administrator password, then Steam downloads and
installs. Afterwards, launch \"Steam\" from the application launcher.")"

printf '\n%s ' "$(gettext "Install Steam now? [y/N]")"
read ans
if ! dg_is_yes "$ans"; then
    dg_say "$(gettext "No changes made.")"
    exit 0
fi

# steam-installer pulls the rest of its i386 deps; multiarch was enabled at
# build time on Pro. Run under pkexec so this works when launched from the GUI.
pkexec sh -c 'dpkg --add-architecture i386 && apt-get update && apt-get install -y steam-installer'
RC=$?
if [ "$RC" -eq 0 ]; then
    echo
    dg_say "$(gettext "Steam installed. Launch it from the application launcher; on first
run it finishes updating itself.")"
else
    echo
    # Single quotes are MANDATORY around an eval_gettext msgid: with double
    # quotes the shell expands $RC before gettext looks the string up, the
    # lookup misses, and the message comes out in English with no warning.
    dg_say "$(eval_gettext 'Steam installation did not complete (exit $RC). You can retry from
the Dagric Hub, or check your network connection.')"
fi
