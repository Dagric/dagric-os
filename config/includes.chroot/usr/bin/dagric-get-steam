#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install Steam, on the owner's request.
# Steam's installer (steam-installer) is in Debian's contrib section. Dagric
# does not redistribute Valve's proprietary client; this helper asks Debian's
# installer to obtain it only when you ask — the same user-consented pattern as
# the NVIDIA driver and DaVinci Resolve helpers. The 32-bit libraries Steam
# needs (i386 multiarch, Wine32, 32-bit Vulkan) are already in place on Pro.
# The same consent step installs Debian's steam-devices rules for advanced
# controller access; those rules are intentionally absent from the base image.
. /usr/bin/dagric-i18n.sh

# TRANSLATORS: keep the distinction between software included in Dagric and a
# user-requested download. "Steam" and "Valve" are third-party product names.
dg_say "$(gettext "Dagric — install Steam

Steam is Valve's proprietary game store and launcher. Dagric does not include
or redistribute the Steam client. If you choose to continue, Debian's installer
will obtain it under Valve's terms. Dagric Pro already includes its open-source
system dependencies.

This also installs Debian's open-source steam-devices access rules for advanced
controller features and /dev/uinput. Debian warns that these rules trade local-
user isolation for functionality and should not be used on a machine with
untrusted local users.

You'll be asked for your administrator password, then Steam downloads and
installs. Afterwards, launch \"Steam\" from the application launcher.")"

dg_live_warn
dg_say "Valve's current Steam Subscriber Agreement:"
printf '%s\n\n' 'https://store.steampowered.com/subscriber_agreement/'
printf '\n%s ' "$(gettext "Install Steam now? [y/N]")"
read ans
if ! dg_is_yes "$ans"; then
    dg_say "$(gettext "No changes made.")"
    exit 0
fi

# THE VULKAN DRIVERS ARE NAMED HERE, and that is not belt-and-braces.
#
# steam-installer's chain reaches mesa-vulkan-drivers only through steam-libs'
# RECOMMENDS, and /etc/apt/apt.conf.d/01dagric-norecommends turns Recommends off
# permanently on every installed Dagric machine. So this command used to finish
# "successfully" on a free machine that had libvulkan1 (the loader) and not one
# single Vulkan ICD — verified in the shipped free image, where /usr/share/vulkan
# does not exist at all.
#
# Proton and DXVK are Vulkan-only. Without an ICD the games do not run slower,
# they do not start: the Steam client opens, looks perfectly healthy, and every
# Windows title fails at launch — which reads as the operating system being
# broken, on the one button index.html tells Steam-only buyers is all they need
# ("Steam with Proton ... install in one click on any edition") and that pro.html
# points them at the free edition to press. This is the project's own
# dropped-Recommends bug class landing on its most-tested feature.
#
# Naming them costs a free machine nothing it was not already promised, and Pro
# keeps its real step-up: everything preinstalled and tuned offline, with
# GameMode, MangoHud, Lutris and 32-bit Wine already there. The :i386 half is
# what DXVK actually loads for 32-bit titles, and it can only be resolved after
# --add-architecture, so it stays in the same shell as the multiarch enable.
#
# Both are also already on the Pro image, where apt will simply report them
# installed and move on.
pkexec sh -c 'dpkg --add-architecture i386 && apt-get update && apt-get install -y steam-installer steam-devices mesa-vulkan-drivers mesa-vulkan-drivers:i386'
RC=$?
if [ "$RC" -eq 0 ]; then
    echo
    dg_say "$(gettext "Steam installed. Launch it from the application launcher; on first
run it finishes updating itself.")"
else
    echo
    # Single quotes are MANDATORY around an eval_gettext msgid: with double
    # quotes the shell expands $RC before gettext looks the string up, the
    # lookup misses, and the message comes out in English with no warning.
    dg_say "$(eval_gettext 'Steam installation did not complete (exit $RC). You can retry from
the Dagric Hub, or check your network connection.')"
fi
