#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — first-login NVIDIA driver offer. Runs once (removes its own
# autostart), only prompts if an NVIDIA GPU is present and no driver is
# installed yet. Turns the CLI `dagric-drivers` into a friendly GUI offer.
. /usr/bin/dagric-i18n.sh

# NOT IN THE LIVE TRIAL. The driver this offers cannot take effect without a
# reboot, and a reboot ends the live session and discards everything it
# installed — so on the USB stick this is a dialog that can only cost and never
# deliver. What it costs is the trial: nvidia-driver plus linux-headers-amd64
# and the DKMS build land in the tmpfs overlay, i.e. in this machine's RAM, on
# the 4 GB hardware Dagric exists to rescue. dg_live_warn's comment names that
# exact failure, and this is the only path that reaches it UNASKED — eight
# seconds into a stranger's first login. Under Secure Boot it is worse still:
# the MOK enrollment would leave the firmware holding a key for a driver that
# stops existing at the next power-off. Same /run/live/medium test dagric-hub
# uses to hide the upgrade row, and the same reasoning: a button that can only
# disappoint. Checked BEFORE the autostart entry is removed, so an installed
# machine still gets the offer at its own first login.
[ -d /run/live/medium ] && exit 0

rm -f "$HOME/.config/autostart/dagric-driver-offer.desktop"
sleep 8   # let the desktop settle before popping a dialog

# WAIT FOR THE SETUP WIZARD TO FINISH. This and dagric-firstrun are both in
# skel's autostart and both fire at login, so on an NVIDIA machine the owner
# used to meet "Set Up Dagric" and then, eight seconds in, have a dialog about
# graphics drivers steal focus on top of it. To someone who has just left
# Windows because their PC kept surprising them, two windows arguing over the
# screen on the very first login is the wrong first impression — and the driver
# question means nothing until they have been told what this machine is.
# Bounded on purpose: if the wizard is still open after five minutes it is
# being read, not stuck, and we ask anyway rather than never asking. The
# autostart entry was already removed above, so a delay can never cost the
# offer entirely.
i=0
while [ "$i" -lt 150 ] && pgrep -f '/usr/bin/dagric-firstrun' >/dev/null 2>&1; do
    i=$((i + 1))
    sleep 2
done

command -v lspci >/dev/null 2>&1 || exit 0
lspci 2>/dev/null | grep -qiE 'vga.*nvidia|3d.*nvidia' || exit 0
dpkg -s nvidia-driver >/dev/null 2>&1 && exit 0

# Translated here, in this process, and passed to the konsole helper below as a
# positional parameter — never pasted into the single-quoted script text, where
# an apostrophe in a French msgstr would end the quoting.
CLOSE=$(gettext "Press Enter to close...")

# TRANSLATORS: 'Finish Setup' is the launcher entry the owner searches for —
# use the same words as the Name= of dagric-setup.desktop in your language.
# 'sudo dagric-drivers' is a command typed verbatim; do not translate it.
if kdialog --title "$(gettext "NVIDIA graphics detected")" --yesno \
"$(gettext "Dagric found an NVIDIA graphics card.

Install the NVIDIA proprietary driver now for the best performance and
battery life?

You can always do this later — search 'Finish Setup' in the launcher, or
run 'sudo dagric-drivers' in a terminal.")" 2>/dev/null; then
    # Route through dagric-drivers so the Secure Boot / MOK-enrollment handling
    # lives in one place (an unsigned NVIDIA module under Secure Boot = black
    # screen). It re-confirms and installs.
    konsole -e sh -c \
'pkexec /usr/bin/dagric-drivers; \
printf "%s" "$1"; read x' sh "$CLOSE" &
fi
