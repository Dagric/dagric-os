#!/bin/sh
# Freehold OS — DaVinci Resolve installation guide.
# Blackmagic's license does not allow anyone to redistribute Resolve,
# so no OS may legally preinstall it. This walks you through the
# official 2-minute download instead. (Kdenlive is preinstalled if you
# want to start editing right now.)
cat << 'EOF'
DaVinci Resolve on Freehold OS
==============================
1. Visit  https://www.blackmagicdesign.com/products/davinciresolve
   (opening it in your browser now if possible...)
2. Click "Free Download", pick the Linux version, and register.
3. Unzip the download, then run the installer:
       cd ~/Downloads
       unzip DaVinci_Resolve_*_Linux.zip
       sudo ./DaVinci_Resolve_*_Linux.run
4. NVIDIA users: run  sudo freehold-drivers  first — Resolve on Linux
   performs best with the proprietary driver.

Why isn't it preinstalled? Blackmagic's license forbids redistribution.
Any OS that bundles it is violating that license — Freehold won't.
EOF
command -v xdg-open >/dev/null 2>&1 && \
    xdg-open "https://www.blackmagicdesign.com/products/davinciresolve" 2>/dev/null || true
