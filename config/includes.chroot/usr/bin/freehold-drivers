#!/bin/sh
# Freehold OS — proprietary driver setup, done honestly.
# Detects an NVIDIA GPU and installs the driver from Debian's own
# non-free repository. Nothing runs without the owner asking for it.
set -e

if [ "$(id -u)" != "0" ]; then
    echo "Run with sudo: sudo freehold-drivers"
    exit 1
fi

echo "Freehold driver check"
echo "---------------------"
if lspci | grep -qi 'vga.*nvidia\|3d.*nvidia'; then
    echo "NVIDIA GPU detected:"
    lspci | grep -i nvidia
    echo ""
    printf "Install the NVIDIA proprietary driver from Debian non-free? [y/N] "
    read -r answer
    case "$answer" in
        y|Y)
            apt-get update
            apt-get install -y nvidia-driver firmware-misc-nonfree
            echo "Done. Reboot to switch to the NVIDIA driver."
            ;;
        *)
            echo "Nothing changed."
            ;;
    esac
else
    echo "No NVIDIA GPU found. AMD and Intel graphics use the built-in"
    echo "open-source drivers — nothing to install."
fi
