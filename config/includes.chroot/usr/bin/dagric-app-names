# ---------------------------------------------------------------------------
# associate <desktop-id> <mimetypes>
#
# Add a MimeType= to a generated override, and make sure its Exec= actually
# takes the file it is being handed.
#
# THE BUG THIS EXISTS FOR, measured on a running install rather than read off
# the tree: a real Dagric ISO is detected as application/x-iso9660-image, and
#
#     xdg-mime query default application/x-iso9660-image   ->  (nothing)
#
# in both a bare shell AND a full KDE session. Nothing on the image claims the
# type: not Ark (it claims application/vnd.efi.iso and x-iso9660-appimage, which
# are different types), not kde-mimeapps.list, not us. So an owner who downloads
# an ISO — this product's own, most likely, to make a stick for a second machine
# or for a friend — double-clicks it and NOTHING HAPPENS. Not an error, not an
# Open With prompt. Nothing. And isoimagewriter, which is installed on both
# editions and which we rename to "USB Writer" fifty lines above precisely
# because writing ISOs to sticks is the job, was unreachable from the file it
# exists to consume: with no MimeType= it does not even appear in Open With, so
# there was no manual route to it either.
#
# WHY THIS IS A FUNCTION AND NOT A HAND-WRITTEN FILE, same reason as rename():
# the override shadows the whole upstream file, so it has to be re-derived from
# whatever upstream currently ships every time apt runs. A hand-written
# .desktop would freeze isoimagewriter's Exec, Icon and 45 translations at the
# day it was written.
#
# Exec gets %f, not %u: isoimagewriter takes a local path ("[File]  ISO file to
# open", from its own --help), and %f is the field code that makes KIO hand over
# a local copy of a remote file rather than a URL the app cannot open. Without a
# field code the spec says the file is not passed at all, so the pin alone would
# have opened an empty USB Writer — which reads as broken more than doing
# nothing did.
associate() {
    _id=$1 _mimes=$2
    _dst="$DST_DIR/$_id.desktop"

    # Not installed, or rename() removed the override: nothing to associate.
    [ -f "$_dst" ] || return 0

    # [Desktop Entry] only, for the same reason rename() is careful about it —
    # a Desktop Action's Exec= must keep its own arguments.
    awk -v m="$_mimes" '
        function flush() { print "MimeType=" m; done = 1 }
        /^\[/ {
            if (inentry && !done) flush()
            inentry = ($0 == "[Desktop Entry]")
            print; next
        }
        # Ours replaces upstreams outright. Two MimeType= lines in one group is
        # undefined by the spec and GLib and KConfig disagree about which wins,
        # which is the same trap the Name[xx] handling above documents.
        inentry && /^MimeType=/ { next }
        inentry && /^Exec=/ {
            if ($0 ~ /%[fFuU]/) print; else print $0 " %f"
            next
        }
        { print }
        END { if (inentry && !done) flush() }
    ' "$_dst" > "$_dst.tmp" && mv -f "$_dst.tmp" "$_dst"
}

# ---------------------------------------------------------------------------
# edition_suffix <desktop-id>
#
# On Pro, shadow one of Dagric's OWN launcher entries with a copy whose every
# Name — the plain one and each translated Name[xx] — carries the " — Pro"
# suffix, so the launcher itself says which edition this machine runs. On free
# (or if the app is gone), remove the override again, under the same marker
# discipline as rename().
#
# Why not sed the file under /usr/share/applications once at build time: these
# entries ship in the dagric-tools package too, so the first `apt upgrade`
# would unpack the unsuffixed copy straight back — the identical decay path
# this file's header documents for the KDE renames. This script already
# re-runs after every dpkg operation, which makes it the one place the suffix
# stays true for the years after the ISO is burned.
#
# The suffix lands on Name[de], Name[fr] and the rest UNCHANGED and
# deliberately untranslated: "Pro" is a product name, the same rule the
# rename tables above follow ("no competitor product names, no translation of
# our own").
edition_suffix() {
    _id=$1
    _src="$SRC_DIR/$_id.desktop"
    _dst="$DST_DIR/$_id.desktop"

    if [ "$EDITION" != "pro" ] || [ ! -f "$_src" ]; then
        if [ -f "$_dst" ] && head -n 1 "$_dst" | grep -qF "$MARK"; then
            rm -f "$_dst"
        fi
        return 0
    fi

    printf '%s\n' "$MARK" > "$_dst.tmp"
    # [Desktop Entry] only — a Desktop Action's own Name= must stay untouched,
    # for the same reason rename() confines itself to that group.
    awk '
        /^\[/ { inentry = ($0 == "[Desktop Entry]") }
        inentry && /^Name(\[[^]]*\])?=/ { print $0 " — Pro"; next }
        { print }
    ' "$_src" >> "$_dst.tmp"
    mv -f "$_dst.tmp" "$_dst"
}

# The two identity surfaces: the wizard the owner meets first, and the Hub
# they live in afterwards. Their window titles carry the same suffix (built
# in dagric-firstrun and dagric-hub respectively), so the launcher entry, the
# taskbar and the open window always agree.
edition_suffix dagric-firstrun
edition_suffix dagric-hub

# Both ISO types, because the two mime databases on this image disagree about
# the same file — xdg-mime calls one Dagric ISO application/x-iso9660-image and
# kmimetypefinder calls it application/vnd.efi.iso. KIO uses the latter, so a
# single-type association tests green from a shell and does nothing when the
# file is double-clicked. The full measurement is in /etc/xdg/mimeapps.list,
# which is also where the defaults are pinned; this only makes "USB Writer"
# offerable for both types so it appears in Open With whoever holds the default.
#
# VERIFIED on a running desktop, because the shell test was not enough:
# `xdg-open dagric-os-1.1-amd64.iso` in a full Plasma session starts
# `/usr/bin/isoimagewriter /home/.../dagric-os-1.1-amd64.iso`, with the path
# actually handed over.
associate org.kde.isoimagewriter "application/x-iso9660-image;application/vnd.efi.iso;"

# MIME associations for the shadowing directory. KDE reads desktop files through
# KSycoca and does not need this, but the GTK apps Pro ships (GIMP, Inkscape)
# resolve "Open With" through GIO, which does.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$DST_DIR" >/dev/null 2>&1 || true
fi

exit 0
