# The rows for one id, as "lang<TAB>Name<TAB>GenericName" lines. Called once
# per rename(), which is a few dozen times per run — a `cat | awk` each time is
# a rounding error next to the awk pass over each .desktop file that follows.
applang_rows() {
    applang_data | awk -F'\t' -v id="$1" '$2 == id { printf "%s\t%s\t%s\n", $1, $3, $4 }'
}

# rename <desktop-id> <Name> <GenericName> <Keywords> [translation-key]
#
# translation-key defaults to the desktop-id. It exists for Okular's per-format
# MIME handlers — okularApplication_pdf, okularApplication_epub and the rest —
# which all take Okular's names and must therefore take Okular's translations
# without needing 12 more rows per language in the table above.
#
# Only the [Desktop Entry] group is rewritten. This matters more than it looks:
# org.kde.spectacle.desktop carries 9 Desktop Actions ("Capture Entire Desktop",
# "Record Screen", ...), systemsettings.desktop 5, konsole 2 and discover 1, each
# with its own Name= line. A plain `sed s/^Name=.*/Name=Screenshot/` would rewrite
# all of them and turn Spectacle's right-click menu into nine identical entries.
#
# Missing GenericName=/Keywords= are inserted at the END OF THE [Desktop Entry]
# GROUP, not at end of file — appending at EOF would drop them inside the last
# Desktop Action group of whichever app grows one later. Ark, Gwenview, Okular,
# Elisa, KCalc and KWalletManager ship no Keywords= at all today, so this path
# is exercised on every build.
rename() {
    _id=$1 _name=$2 _generic=$3 _keys=$4 _trkey=${5:-$1}
    _src="$SRC_DIR/$_id.desktop"
    _dst="$DST_DIR/$_id.desktop"

    # Not installed (a Pro app on a free image, or one the owner removed): drop
    # any override we left behind, or the launcher would keep advertising an app
    # that is no longer there. Only ever removes files we generated.
    if [ ! -f "$_src" ]; then
        if [ -f "$_dst" ] && head -n 1 "$_dst" | grep -qF "$MARK"; then
            rm -f "$_dst"
        fi
        return 0
    fi

    printf '%s\n' "$MARK" > "$_dst.tmp"
    awk -v n="$_name" -v g="$_generic" -v k="$_keys" -v tr="$(applang_rows "$_trkey")" '
        BEGIN {
            # tr is "lang\tName\tGenericName" lines, one per language we have
            # for this app. Empty for an app nobody has translated yet, in
            # which case nothing below fires and the behaviour is exactly what
            # it was before translations existed.
            nl = split(tr, _rows, "\n")
            for (_i = 1; _i <= nl; _i++) {
                if (_rows[_i] == "") continue
                split(_rows[_i], _f, "\t")
                LANG[++nlang] = _f[1]
                TNAME[_f[1]] = _f[2]
                TGEN[_f[1]]  = _f[3]
            }
        }
        # Is this line one of the exact postfixed keys we are about to emit?
        # Exact, not a prefix: emitting Name[pt_BR] must delete the upstream
        # Name[pt_BR] and leave Name[pt] alone, because Name[pt] is still the
        # right answer for an owner in Portugal.
        function ours(line, key,   _i, _p) {
            for (_i = 1; _i <= nlang; _i++) {
                _p = key "[" LANG[_i] "]="
                if (substr(line, 1, length(_p)) == _p) return 1
            }
            return 0
        }
        function flush(   _i, _L) {
            if (!sn) print "Name=" n
            if (!sg) print "GenericName=" g
            if (!sk) print "Keywords=" k
            # Every language at once. This file is written by root from an apt
            # hook and read later by every user on the machine, so "the current
            # language" is not a thing it can know.
            for (_i = 1; _i <= nlang; _i++) {
                _L = LANG[_i]
                print "Name[" _L "]=" TNAME[_L]
                if (TGEN[_L] != "") print "GenericName[" _L "]=" TGEN[_L]
            }
        }
        /^\[/ {
            if (inentry && !flushed) { flush(); flushed = 1 }
            inentry = ($0 == "[Desktop Entry]")
            print; next
        }
        inentry && /^Name=/           { print "Name=" n;        sn = 1; had = 1; next }
        inentry && /^GenericName=/    { print "GenericName=" g; sg = 1; next }
        inentry && /^Keywords=/       { print "Keywords=" k;    sk = 1; next }
        inentry && /^Name\[en/        { next }
        inentry && /^GenericName\[en/ { next }
        inentry && /^Keywords\[en/    { next }
        # The upstream value for a language we are replacing. Dropped so the
        # flush below cannot produce a duplicate key in [Desktop Entry], which
        # the spec leaves undefined and which GLib and KConfig resolve
        # differently — "Dateien" in Kickoff, "Dolphin" in an Open With dialog.
        # Keywords[xx] is deliberately NOT in this list: we emit none, so the
        # upstream one stays, and it was written by a native speaker.
        inentry && ours($0, "Name")        { next }
        inentry && ours($0, "GenericName") { next }
        { print }
        END {
            if (inentry && !flushed) flush()
            if (!had) print "dagric: no Name= in [Desktop Entry] of " FILENAME > "/dev/stderr"
        }
    ' "$_src" >> "$_dst.tmp"

    # Swap in atomically so a launcher reading the directory mid-write never
    # sees a half-file.
    mv -f "$_dst.tmp" "$_dst"
}

# ---------------------------------------------------------------------------
# The names.
#
# Rules these follow:
#   * Name the job, not the product: "Files", not "Dolphin".
#   * Never take a competitor's exact product name. "File Explorer", "Snipping
#     Tool", "Phone Link" and "App Store" are Microsoft/Apple product names and
#     belong in Keywords= as search terms, not in Name= as a claim. "Task
#     Manager" is the one exception — it is plainly descriptive and the
#     recognition win is too large to give up.
#   * No "KDE" in anything user-facing. It leaks today through "KDE Wallet
#     Management Tool" and "KDE Advanced Text Editor"; this audience has never
#     heard of KDE and should not have to.
#   * No "&" in Name= — Qt reads it as a menu accelerator and eats the letter.
#   * Keywords are lowercase and carry the old Windows names and the common
#     misspellings: notepad++, taskmgr, prtscn, "this pc", "windows media player".
#
# NOT renamed, deliberately: Firefox, LibreOffice, GIMP, Blender, Krita,
# Inkscape, OBS, Thunderbird, KeePassXC, Audacity, HandBrake, qBittorrent,
# Darktable. The brand IS what the user already knows and searches for; renaming
# those would trade one confusion for a worse one. Orca is left alone too —
# screen-reader users search for it by name and every accessibility guide on the
# web calls it Orca.

# --- Free edition: the eight names that give the game away, plus the rest of
# --- the everyday set.
rename org.kde.dolphin "Files" "File manager (Dolphin)" \
    "dolphin;explorer;file explorer;windows explorer;my computer;this pc;folder;folders;browse;files;file management;file browsing;samba;network shares;Explorer;Finder;usb;drive;copy;paste;"

rename org.kde.konsole "Terminal" "Command line (Konsole)" \
    "konsole;terminal;console;command prompt;cmd;powershell;dos;shell;bash;sh;zsh;cli;commandline;command-line;script;run;execute;command;"

rename org.kde.gwenview "Photos" "Photo and image viewer (Gwenview)" \
    "gwenview;photos;photo;image;images;picture;pictures;viewer;gallery;jpg;jpeg;png;heic;webp;preview;crop;rotate;"

# "Document Viewer" over "PDF Reader": Okular also opens epub, comics, XPS and
# DjVu, and calling it a PDF reader would misdescribe it the moment someone
# opens an ebook. PDF recognition is carried by GenericName and Keywords, where
# "adobe" and "acrobat" also land.
rename org.kde.okular "Document Viewer" "PDF, ebook and document viewer (Okular)" \
    "okular;pdf;acrobat;adobe;adobe reader;reader;document;documents;ebook;epub;mobi;view;open;print;annotate;highlight;sign;comic;cbz;djvu;xps;"

rename org.kde.ark "Archive Manager" "Open and create zip files (Ark)" \
    "ark;zip;unzip;extract;compress;archive;archives;unpack;7z;7-zip;winzip;winrar;rar;tar;gz;xz;bz2;iso;"

# "Disks", not "KDE Partition Manager". This is the Disk Management console a
# Windows owner already knows, and they will look for it by that name or by
# "format" long before they would guess "partition manager". diskpart is in the
# keywords for the same reason cmd and powershell are in Konsole's.
rename org.kde.partitionmanager "Disks" "Manage drives and partitions (KDE Partition Manager)" \
    "partitionmanager;partition;partitions;disk;disks;drive;drives;format;formatting;disk management;diskmgmt;diskpart;volume;volumes;resize;shrink;extend;usb;flash drive;ntfs;fat32;exfat;ext4;mount;filesystem;"

# "USB Writer" over "ISO Image Writer": the task is making a bootable stick, and
# the words people actually carry are the tools they used to do it on Windows.
# Rufus and BalenaEtcher are in the keywords deliberately — somebody who made
# their Dagric stick with Rufus will search for Rufus when they want to make
# one for a friend.
rename org.kde.isoimagewriter "USB Writer" "Write an ISO to a USB stick (ISO Image Writer)" \
    "isoimagewriter;iso;usb;usb stick;flash drive;bootable;boot;burn;write;image;rufus;balenaetcher;etcher;unetbootin;ventoy;startup disk;installer;live usb;"

rename org.kde.kate "Text Editor" "Notes and code (Kate)" \
    "kate;notepad;notepad++;text;txt;editor;notes;write;wordpad;code;source;programming;programmer;development;developer;"

rename org.kde.elisa "Music" "Music player and library (Elisa)" \
    "elisa;music;songs;song;audio;player;library;playlist;album;mp3;flac;m4a;ogg;itunes;groove;windows media player;wmp;radio;"

rename org.kde.spectacle "Screenshot" "Screenshots and screen recording (Spectacle)" \
    "spectacle;screenshot;snapshot;capture;print;printscreen;prtscn;print screen;snipping;snipping tool;snip;screen capture;record screen;screen recording;grab;"

# "Software Store" not "App Store" (Apple's product name). Upstream also ships
# GenericName[en_GB]=Software Centre, which the en* strip removes.
rename org.kde.discover "Software Store" "Install and remove apps (Discover)" \
    "discover;store;software store;app store;microsoft store;get apps;download apps;software center;software centre;program;software;repository;package;add;install;uninstall;remove;update;apps;applications;games;flatpak;snap;addons;add-ons;firmware;"

