#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — one-time snapshot-recovery setup, run on first boot of an
# INSTALLED system. Only does anything on a btrfs root (recovery is btrfs-only);
# on ext4 installs it disables itself and exits cleanly.
set -e

ROOTFS=$(findmnt -no FSTYPE / 2>/dev/null || echo "")
if [ "$ROOTFS" != "btrfs" ]; then
    echo "Root is $ROOTFS, not btrfs — snapshot recovery not applicable."
    exit 0
fi

# Snapper config for the root subvolume (idempotent).
if ! snapper -c root list >/dev/null 2>&1; then
    # EXIT 1, NOT EXIT 0. This script is ExecStart of
    # dagric-snapshot-setup.service, whose ExecStartPost writes
    # /var/lib/dagric/snapshot-setup-done — and ExecStartPost only runs when
    # ExecStart SUCCEEDED. Exiting 0 here therefore latched the done-marker on
    # a boot where no snapper config was ever created, and the unit's
    # ConditionPathExists=!/var/lib/dagric/snapshot-setup-done then kept it
    # from ever running again. One transient first-boot failure — a still
    # settling btrfs root, a pre-existing /.snapshots, snapper's D-Bus service
    # not up yet — permanently disabled the whole advertised recovery feature:
    # no 80dagric-snapshot apt hook, no baseline snapshot, no GRUB submenu, and
    # no way to self-heal. Failing lets the next boot try again, and leaves the
    # unit visibly red instead of green.
    #
    # The ext4 branch above is the one case where exit 0 is correct: there is
    # nothing to retry there, and the marker should be latched.
    snapper -c root create-config / || { echo "snapper create-config failed" >&2; exit 1; }
fi

# Sensible desktop retention: no noisy hourly timeline, keep the last handful
# of update snapshots.
#
# NUMBER_LIMIT takes a RANGE, not a bare number, once space-aware cleanup is on:
# snapper reads "min-max" and only deletes below the minimum when the space
# limits below demand it. A bare "10" means exactly ten and no space awareness.
snapper -c root set-config \
    TIMELINE_CREATE=no \
    NUMBER_CLEANUP=yes \
    NUMBER_MIN_AGE=1800 \
    NUMBER_LIMIT=4-10 \
    NUMBER_LIMIT_IMPORTANT=2-5 \
    SPACE_LIMIT=0.4 \
    FREE_LIMIT=0.2 2>/dev/null || true

# SPACE_LIMIT AND FREE_LIMIT ARE INERT WITHOUT A QGROUP, and that is the whole
# point of this call. snapper(8) is explicit: keeping snapshot usage under a
# limit requires btrfs quota, and with no qgroup those two settings above are
# decorative. Nothing then stops snapshots filling the disk.
#
# The failure that prevents is not a polite dialog. btrfs ENOSPC turns the root
# filesystem read-only, on a machine whose owner did nothing wrong except keep
# installing updates — and on a school or library machine, nobody is watching
# the free space until the desktop stops working.
#
# The rescan has a real cost on a large filesystem, which is why it runs once
# here at first boot rather than on every update.
snapper -c root setup-quota 2>/dev/null || \
    echo "NOTE: snapper setup-quota failed — snapshot space limits are inactive" >&2

# TURN OFF THE BOOT SNAPSHOT, because it spends the rollback budget on nothing.
#
# Debian's snapper package enables snapper-boot.timer, which takes a snapshot on
# EVERY boot using --cleanup-algorithm number — the same budget the pre/post
# update pairs come out of. A boot snapshot is near-identical to the last
# post-update one and answers no question anybody asks; what it reliably does is
# evict the update snapshot somebody actually needs. Ten boots after a bad
# update, the good state is gone.
#
# Timeline is already off above for the same reason. This removes snapshots
# rather than adding a mechanism, so the risk is the reverse of the usual one.
systemctl disable --now snapper-boot.timer 2>/dev/null || true

# Snapshot the system before and after every apt/dpkg run, so a bad update is
# always recoverable.
#
# --cleanup-algorithm number ON BOTH CREATES IS LOAD-BEARING, and leaving it off
# was a slow way to brick the machine. snapper only ever prunes snapshots tagged
# cleanup=number — that is the ONLY thing NUMBER_LIMIT=4-10, SPACE_LIMIT and
# FREE_LIMIT above act on. A `create` with no --cleanup-algorithm writes an
# untagged snapshot that snapper will keep forever. These pairs are made on
# EVERY apt run and every unattended-upgrade, so untagged they accumulate without
# bound until btrfs hits ENOSPC and turns the root read-only — the exact failure
# the retention block at the top of this file exists to prevent, re-armed. And
# empty-pre-post cleanup does not save it: apt changes files, so the diffs are
# non-empty and those pairs are never "empty".
#
# -c root is the GLOBAL --config (which snapper config to use); the create's own
# --cleanup-algorithm is a separate option, which is why both appear. Written
# long here so the next reader does not mistake it for a duplicate of -c root.
# The baseline at the bottom is deliberately left untagged — it is the permanent
# floor to roll back to.
# STAND DEBIAN'S OWN apt HOOK DOWN FIRST, OR EVERY apt RUN SNAPSHOTS TWICE.
#
# The snapper package ships /etc/apt/apt.conf.d/80snapper, which takes its own
# pre/post pair gated on /etc/snapper/configs/root existing — the config this
# script creates a few lines above. So from the moment setup runs, both hooks
# fire and one apt operation produces FOUR snapshots.
#
# MEASURED on an installed machine after a single Discover install:
#   26 pre  "apt (pre)"   <- Dagric        28 post 26 "apt (post)"
#   27 pre  "apt"         <- Debian        29 post 27 "apt"
#
# That is double the disk cost of the advertised recovery feature, on a machine
# whose whole retention block above exists to stop snapshots eating the disk.
#
# WHY DAGRIC'S HOOK IS THE ONE THAT SURVIVES, rather than deleting ours and
# configuring Debian's: ours guards on the root actually being btrfs, and passes
# --cleanup-algorithm number on BOTH creates. Debian's tags only via its own
# cleanup path and takes a pre snapshot even where btrfs is not in use. The
# long note below explains why an untagged snapshot is a slow way to fill a
# disk.
#
# DISABLE_APT_SNAPSHOT is 80snapper's own documented off switch — it tests
# [ ! x$DISABLE_APT_SNAPSHOT = 'xyes' ] — so this is the supported way to yield,
# not a hack, and it survives snapper being upgraded.
if [ -f /etc/default/snapper ]; then
    if grep -q '^DISABLE_APT_SNAPSHOT=' /etc/default/snapper; then
        sed -i 's/^DISABLE_APT_SNAPSHOT=.*/DISABLE_APT_SNAPSHOT="yes"/' /etc/default/snapper
    else
        echo 'DISABLE_APT_SNAPSHOT="yes"' >> /etc/default/snapper
    fi
fi

# NO ESCAPED QUOTES IN HERE. apt.conf HAS NO BACKSLASH ESCAPE, and the version
# of this file that used \" broke every apt run on every installed machine.
#
# What apt actually did with `--pre-number \"$(cat /run/dagric-snap-pre)\"`,
# read back with `apt-config dump` on an installed system:
#
#   DPkg::Post-Invoke::if%20command%20-v%20snapper%20...%20--pre-number%20\$(cat
#     "/run/dagric-snap-pre)\ >/dev/null 2>&1 || true; rm -f /run/dagric-snap-pre; fi";
#
# The parser ended the string at the quote inside \", turned everything before
# it into a config KEY (hence the %20 for every space), and executed the
# leftover tail as the command. So every apt operation ended with
#
#   sh: 1: Syntax error: ")" unexpected
#   E: Problem executing scripts DPkg::Post-Invoke '/run/dagric-snap-pre)\ ...'
#   E: Sub-process returned an error code
#
# and — quietly, which is worse — the POST snapshot was never taken at all. The
# pre half of the pair worked, so the machine accumulated unpaired pre snapshots
# while the feature this file exists to provide was half absent.
#
# The quotes were never needed: snapper writes a bare snapshot NUMBER to that
# file, so there is no whitespace to protect. Debian's own /etc/apt/apt.conf.d/
# 80snapper avoids the same trap by using backticks. Left unquoted here, which
# needs no escape at all.
#
# FOUND BY RUNNING apt IN THE INSTALLED SYSTEM, not by reading this file — it
# looks perfectly correct as shell, and it is; it is apt.conf that does not
# accept it. Anything added to these two lines must be checked the same way:
#   apt-config dump | grep -i post-invoke
cat > /etc/apt/apt.conf.d/80dagric-snapshot << 'EOF'
DPkg::Pre-Invoke  { "if command -v snapper >/dev/null 2>&1 && findmnt -no FSTYPE / | grep -q btrfs; then snapper -c root create -d 'apt (pre)' -t pre --cleanup-algorithm number -p > /run/dagric-snap-pre 2>/dev/null || true; fi"; };
DPkg::Post-Invoke { "if command -v snapper >/dev/null 2>&1 && [ -s /run/dagric-snap-pre ]; then snapper -c root create -d 'apt (post)' -t post --cleanup-algorithm number --pre-number $(cat /run/dagric-snap-pre) >/dev/null 2>&1 || true; rm -f /run/dagric-snap-pre; fi"; };
EOF

# grub-btrfs daemon: auto-refresh the GRUB snapshot submenu when snapshots
# change. Then generate GRUB now so the menu is populated immediately.
systemctl enable --now grub-btrfsd.service 2>/dev/null || true
if command -v update-grub >/dev/null 2>&1; then
    update-grub 2>/dev/null || true
else
    grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
fi

# A clean baseline to roll back to.
snapper -c root create -d 'Dagric baseline (first boot)' 2>/dev/null || true

echo "Snapshot recovery configured."
