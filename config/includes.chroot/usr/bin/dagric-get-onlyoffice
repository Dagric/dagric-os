#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install ONLYOFFICE Desktop Editors, on request.
# ONLYOFFICE (open source, AGPL) looks and behaves like Microsoft Office —
# ribbon interface, tabs — and has the best .docx/.xlsx/.pptx fidelity in
# open source. For owners who find LibreOffice's layout unfamiliar.
# Installed from Flathub per-user (no root). LibreOffice stays installed.
cat << 'EOF'
Dagric — install ONLYOFFICE (the familiar Office look)

ONLYOFFICE Desktop Editors is an open-source office suite with the ribbon
layout Microsoft Office users already know, and excellent compatibility
with Word/Excel/PowerPoint files. It runs alongside LibreOffice — keep
whichever feels right (or both). From Flathub.
EOF

printf '\nInstall ONLYOFFICE now? [y/N] '
read ans
case "$ans" in y|Y|yes|YES) ;; *) echo "No changes made."; exit 0 ;; esac

flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
if flatpak install --user -y --noninteractive flathub org.onlyoffice.desktopeditors; then
    echo; echo "ONLYOFFICE installed — launch it from the application launcher."
else
    echo; echo "Install did not complete. Check your network and try again."
fi
