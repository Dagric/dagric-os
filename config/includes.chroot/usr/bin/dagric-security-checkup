#!/bin/sh
# Dagric OS — Security Checkup: run a Lynis audit and show the hardening score
# in a friendly dialog. Makes the (otherwise invisible) security posture
# something a non-expert can see and trust.
kdialog --title "Dagric Security Checkup" \
    --passivepopup "Running a security audit — about a minute…" 10 2>/dev/null &

# One pkexec runs BOTH the Lynis audit and the SMART disk-health scan, so the
# owner authenticates once. The ---SMART--- marker splits the two reports.
REPORT=$(pkexec sh -c '
lynis audit system --quick --no-colors 2>/dev/null
echo "---SMART---"
for d in $(lsblk -dno NAME,TYPE 2>/dev/null | awk "\$2==\"disk\"{print \"/dev/\"\$1}"); do
    case "$d" in */zram*|*/loop*|*/sr*) continue ;; esac
    H=$(smartctl -H "$d" 2>/dev/null | grep -iE "overall-health|SMART Health Status" | sed "s/.*: *//")
    [ -n "$H" ] || H="not reported"
    echo "$d: $H"
done' 2>/dev/null || true)
if [ -z "$REPORT" ]; then
    kdialog --title "Dagric Security Checkup" \
        --sorry "The audit could not run (it needs administrator access)." 2>/dev/null
    exit 1
fi

SMART=$(printf '%s\n' "$REPORT" | sed -n '/^---SMART---$/,$p' | sed '1d')
REPORT=$(printf '%s\n' "$REPORT" | sed '/^---SMART---$/,$d')
DISKS_LINE=""
if [ -n "$SMART" ]; then
    if printf '%s\n' "$SMART" | grep -qivE 'PASSED|OK|not reported'; then
        DISKS_LINE="Drive health:  ⚠ A DRIVE IS FAILING — back up now!
$SMART
"
        kdialog --title "Dagric Security Checkup" \
            --error "A disk is reporting SMART failure — it may die soon.

$SMART

Back up your files NOW (Kup is preinstalled), and plan to
replace the drive." 2>/dev/null
    else
        DISKS_LINE="Drive health:  all drives report healthy (SMART)
"
    fi
fi

SCORE=$(printf '%s\n' "$REPORT" | sed -n 's/.*[Hh]ardening index[^0-9]*\([0-9]\{1,3\}\).*/\1/p' | head -1)
[ -n "$SCORE" ] || SCORE="see report"
# grep -c already prints 0 (with exit status 1) when there are no matches, so
# a `|| echo 0` fallback would append a SECOND 0 and render "0\n0". Just take
# grep's count and default only if the whole pipe produced nothing.
WARN=$(printf '%s\n' "$REPORT" | grep -ciE 'warning')
WARN=${WARN:-0}

kdialog --title "Dagric Security Checkup" --msgbox \
"Hardening index:  ${SCORE} / 100
${DISKS_LINE}
Dagric ships hardened by default — AppArmor confinement, a hardened kernel,
a firewall, and silent security updates are all on before you change a thing.
Plasma also watches your drives' SMART health and warns you if one degrades.

Warnings flagged:  ${WARN}
Full report:  /var/log/lynis.log
For details, run  sudo lynis show details  in a terminal." 2>/dev/null
