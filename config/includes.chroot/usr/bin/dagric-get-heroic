#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install Heroic Games Launcher, on request.
# Heroic (GPL-3.0) is an independent open-source launcher supporting Epic
# Games Store, GOG and Amazon Games accounts. It is not an official client of
# those providers and compatibility with their services can change.
# Installed from the already-enabled Flathub as a per-user Flatpak (no root).
. /usr/bin/dagric-i18n.sh

dg_say "$(gettext "Dagric — install Heroic Games Launcher

Heroic is an independent, open-source launcher supporting Epic Games Store,
GOG and Amazon Games accounts. It supports Wine and Proton for compatible
Windows titles and installs from Flathub.

Heroic is not official or endorsed by those providers. Compatibility varies,
and provider, game and optional runtime terms still apply.")"

dg_live_warn
printf '\n%s ' "$(gettext "Install Heroic now? [y/N]")"
read ans
if ! dg_is_yes "$ans"; then
    dg_say "$(gettext "No changes made.")"
    exit 0
fi

flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
if flatpak install --user -y --noninteractive flathub com.heroicgameslauncher.hgl; then
    echo; dg_say "$(gettext "Heroic installed — launch it from the application launcher.")"
else
    echo; dg_say "$(gettext "Install did not complete. Check your network and try again.")"
fi
