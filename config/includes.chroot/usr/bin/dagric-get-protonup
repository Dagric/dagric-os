#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install ProtonUp-Qt, on request.
# ProtonUp-Qt (GPL-3.0) is a GUI for installing and managing GE-Proton / Wine-GE
# compatibility versions for Steam and Lutris. Installed from Flathub as a
# per-user Flatpak. Compatibility tools remain title-specific.
. /usr/bin/dagric-i18n.sh

# TRANSLATORS: "ProtonUp-Qt", "GE-Proton", "Wine-GE", "Steam", "Lutris" and
# "Flathub" are product names — leave them exactly as they are.
dg_say "$(gettext "Dagric — install ProtonUp-Qt

ProtonUp-Qt is a free, open-source app for installing and switching between
GE-Proton and Wine-GE versions for Steam and Lutris — no terminal needed.
It installs from Flathub. Compatibility varies by title and service; GE-Proton
is an independent project and is not affiliated with Valve's Proton project.")"

dg_live_warn
printf '\n%s ' "$(gettext "Install ProtonUp-Qt now? [y/N]")"
read ans
if ! dg_is_yes "$ans"; then
    dg_say "$(gettext "No changes made.")"
    exit 0
fi

flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
if flatpak install --user -y --noninteractive flathub net.davidotek.pupgui2; then
    echo; dg_say "$(gettext "ProtonUp-Qt installed — launch it from the application launcher.")"
else
    echo; dg_say "$(gettext "Install did not complete. Check your network and try again.")"
fi
