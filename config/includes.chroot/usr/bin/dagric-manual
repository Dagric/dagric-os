#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — the manual. Opens the offline handbook in
# /usr/share/dagric/manual: one page per application and per dagric-* tool,
# with what it is, what it replaced on Windows, and how to actually use it.
#
# WHY THIS SCRIPT EXISTS AT ALL, rather than a .desktop pointing straight at
# index.html: the manual has to know which edition it is running on, and the
# HTML cannot find that out for itself. A page loaded over file:// may not read
# /etc/dagric-edition, and there is no server to ask. So this script reads it
# and states the edition in the URL fragment (#e=pro / #e=free); manual.js
# carries that marker onto every internal link from there.
#
# That marker is what makes the Free/Pro decision honest. Every page ships on
# both editions — hiding the Pro ones would leave a free owner believing Dagric
# cannot edit video, which is false — and on the free edition the Pro pages open
# with a plain note saying the software is not installed here. Open the files
# directly from Dolphin instead and there is no marker: the manual then says
# nothing either way, because telling a Pro owner that their installed software
# "is not on this edition" would be worse than staying quiet.
#
# LANGUAGE. The tool speaks the owner's language; the PAGES are still English,
# and that is a staging decision rather than an oversight. The manual is
# ~46,000 words across 95 pages — by far the most expensive surface in the
# product — and a German wizard with an English handbook is a normal, forgivable
# state of affairs, while an English wizard is not.
#
# The mechanism for the pages is already here and costs nothing until it is
# used: ROOT is resolved through the same lang/lang_COUNTRY/English fallback as
# the welcome page, so dropping a translated manual/de/ tree in is all it takes.
# Nothing has to change in this file. That fallback is also what makes po4a's
# -k threshold safe — a page below the translation threshold is simply not
# shipped for that language, and the English one is found instead of a
# half-translated page being shown.
set -e
. /usr/bin/dagric-i18n.sh

ROOT=/usr/share/dagric/manual
# A per-language manual tree if one is installed, English otherwise. Resolved
# once, on index.html, so every page in the session comes from the same tree —
# picking per page would give a half-German, half-English handbook whenever one
# page happened to be missing.
_loc=$(dg_localised "$ROOT" index.html) && ROOT=${_loc%/index.html}
EDITION=$(cat /etc/dagric-edition 2>/dev/null || echo free)
# Clamp it. This value is pasted straight into a URL, and the manual only knows
# two editions — anything else (a truncated file, an experiment, a stray edit)
# becomes "free", which is the reading that under-promises rather than over-.
case "$EDITION" in
    pro) ;;
    *)   EDITION=free ;;
esac

if [ ! -d "$ROOT" ]; then
    dg_say "$(eval_gettext 'The Dagric manual is not installed ($ROOT is missing).')" >&2
    exit 1
fi

usage() {
    # TRANSLATORS: the four indented lines are the command's own syntax and
    # are typed verbatim — "dagric-manual", "--list", "--help" and the example
    # "dolphin" must not be translated. <topic> is a placeholder and may be.
    dg_say "$(gettext "Dagric manual — every application on this computer, offline.

  dagric-manual              open the front page (search from there)
  dagric-manual <topic>      open one page, e.g.  dagric-manual dolphin
  dagric-manual --list       list every topic
  dagric-manual --help       this text

Topics are matched against PAGE NAMES: \"kate\", \"app-kate\" and \"ate\" all reach
the Kate page. Windows names do not work here -- \"notepad\" matches no page
name, so it fails. Search by Windows name in the manual's own search box
instead; that index is what \"notepad finds Kate\" refers to.

Pages live in /usr/share/dagric/manual and need no internet connection.")"
}

# The topic list is derived from the pages themselves, so it can never drift
# out of step with what is actually installed.
list_topics() {
    for f in "$ROOT"/*.html; do
        [ -f "$f" ] || continue
        b=${f##*/}
        b=${b%.html}
        if [ "$b" = index ]; then continue; fi
        # No '$' anchor: git may check these pages out with CRLF endings on a
        # contributor's machine, and a trailing carriage return would then make
        # every description come out blank.
        t=$(sed -n 's|^<title>\(.*\) &mdash; Dagric OS Manual</title>.*|\1|p' "$f" | head -1)
        printf '  %-30s %s\n' "$b" "$t"
    done
}

# Resolve a topic to a filename. Exact names first (so "app-kate" beats a
# substring hit somewhere else), then the two prefixes, then a substring match.
find_page() {
    for cand in "$1" "app-$1" "tool-$1" "tool-dagric-$1" "app-dagric-$1"; do
        if [ -f "$ROOT/$cand.html" ]; then
            printf '%s\n' "$cand.html"
            return 0
        fi
    done
    for f in "$ROOT"/*.html; do
        [ -f "$f" ] || continue
        b=${f##*/}
        case "$b" in
            index.html) continue ;;
            *"$1"*) printf '%s\n' "$b"; return 0 ;;
        esac
    done
    return 1
}

PAGE=index.html
case "${1:-}" in
    "")            : ;;
    -h|--help)     usage; exit 0 ;;
    -l|--list)     list_topics; exit 0 ;;
    -*)            usage >&2; exit 2 ;;
    *)
        # ASKED is a copy of $1 purely so the message below can be translated:
        # eval_gettext interpolates through envsubst, and envsubst only knows
        # environment-variable names — "$1" is not one, so a msgid mentioning
        # it would come out with a literal "$1" in it. The quotes around the
        # name also changed from ' to " for a quoting reason: an eval_gettext
        # msgid has to be single-quoted, and a single-quoted shell string
        # cannot contain an apostrophe.
        ASKED=$1
        # Normalise: lower-case, drop a trailing .html somebody pasted in.
        TOPIC=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
        TOPIC=${TOPIC%.html}
        # Only letters, digits and hyphens are ever page names. Rejecting the
        # rest here means no argument can walk out of $ROOT — no slashes, no
        # dots, nothing to quote wrong later.
        case "$TOPIC" in
            ''|*[!a-z0-9-]*)
                dg_say "$(eval_gettext 'No page called "$ASKED". Try: dagric-manual --list')" >&2
                exit 1 ;;
        esac
        if ! PAGE=$(find_page "$TOPIC"); then
            dg_say "$(eval_gettext 'No page called "$ASKED". Try: dagric-manual --list')" >&2
            exit 1
        fi ;;
esac

URL="file://$ROOT/$PAGE#e=$EDITION"

# ...and the language, when there is a translated page to point at.
#
# The manual itself is deliberately NOT translated — its whole value is that
# the search index knows the ENGLISH Windows names, so typing "notepad" finds
# the Text Editor, and a half-translated index breaks that promise. What manual
# .js does with "l=" is show a short notice, in the owner's language, saying so
# and linking to the translated user guide, which IS complete.
#
# Without this line the notice only appears when the BROWSER's own locale is
# German — so a German owner running an English-only Firefox under LANG=de_DE
# got an English manual with no explanation and no way back to the guide. That
# is the common case on this OS, because Firefox's locale is decided by the
# .xpi language pack, not by LANG.
#
# Only languages that actually have a guide are listed. Advertising a
# translation that is not there is worse than saying nothing.
#
# THAT RULE WAS RIGHT AND THE LIST WENT STALE UNDER IT. When this was written
# German was the only translated guide. Five ship now — guide/de, es, fr, it and
# pt_BR — and manual.js has had complete LANGS entries for all five for as long.
# So a Spanish, French, Italian or Brazilian owner opened the manual, was told
# nothing about why it is in English, and was offered no route to the guide that
# IS in their language. Exactly the defect the comment above describes, in four
# more languages than it was written for.
#
# The key is manual.js's, not the directory name: its entry is `pt` and its dir
# is pt_BR. Bare pt* is deliberately absent — pt_PT has no guide, and the rule
# at the top of this comment still holds.
case "$(dg_lang)" in
    de*)    URL="$URL&l=de" ;;
    es*)    URL="$URL&l=es" ;;
    fr*)    URL="$URL&l=fr" ;;
    it*)    URL="$URL&l=it" ;;
    pt_BR*) URL="$URL&l=pt" ;;
esac

# x-www-browser first — it is Debian's alternatives link to whichever browser
# the machine actually uses, so a Pro owner who switched to Chromium is obeyed.
# Then Firefox, which every edition ships. xdg-open is the last resort rather
# than the first: it hands the URL to whatever claims text/html, and a handler
# that drops the fragment would lose the edition marker without saying so.
for b in x-www-browser firefox firefox-esr xdg-open; do
    if command -v "$b" >/dev/null 2>&1; then
        exec "$b" "$URL"
    fi
done

dg_say "$(eval_gettext 'No browser found. The manual is at $ROOT/$PAGE')" >&2
exit 1
