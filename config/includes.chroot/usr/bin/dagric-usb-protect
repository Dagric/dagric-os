#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS Pro — USB port lockdown (USBGuard), safely.
# USBGuard blocks USB devices that aren't on an allow-list, which defeats
# "BadUSB" attacks and malicious USB drops. Enabled naively it is a foot-gun:
# the shipped policy is empty and the daemon's default is BLOCK, so turning it
# on would instantly deauthorize the owner's own keyboard and mouse with no way
# left to click "allow". This helper does it in the only safe order —
# allow-list what's plugged in FIRST, then start the daemon.
#
# EVERY STRING IN THIS FILE IS TIER-ONE FOR TRANSLATION REVIEW. The dialog
# below is the one that decides whether the owner's keyboard still works after
# they click. A translation that loses "plug in everything you normally use
# before continuing" produces a machine its owner cannot type on.
. /usr/bin/dagric-i18n.sh

TITLE=$(gettext "Dagric USB Protection")

if [ ! -x /usr/sbin/usbguard ] && ! command -v usbguard >/dev/null 2>&1; then
    kdialog --title "$TITLE" --sorry \
        "$(gettext "USB protection is a Dagric Pro feature.")" 2>/dev/null
    exit 1
fi

# Already on? Offer to turn it off.
if systemctl is-active --quiet usbguard.service 2>/dev/null; then
    kdialog --title "$TITLE" --warningyesno \
"$(gettext "USB protection is currently ON — unknown USB devices are blocked.

Turn it OFF and allow all USB devices again?")" 2>/dev/null || exit 0
    if pkexec sh -c 'systemctl disable --now usbguard.service usbguard-dbus.service; systemctl mask usbguard.service usbguard-dbus.service'; then
        kdialog --title "$TITLE" --msgbox \
            "$(gettext "USB protection is off. All USB devices work normally.")" 2>/dev/null
    else
        kdialog --title "$TITLE" --sorry \
            "$(gettext "Could not turn it off (administrator access is required).")" 2>/dev/null
    fi
    exit 0
fi

# TRANSLATORS: the most consequential dialog in the product. "plug in
# everything you normally use before continuing" is a WARNING, not advice —
# a device that is unplugged now really is blocked when it comes back, and
# that can include the owner's keyboard. Do not soften it, and do not drop
# the reassurance that this can be re-run or turned off.
kdialog --title "$TITLE" --yesno \
"$(gettext "Turn ON USB protection?

Dagric will remember every USB device plugged in RIGHT NOW — your
keyboard, mouse, webcam, printer, drives — and allow those. Any
OTHER USB device plugged in later is blocked until you approve it.

IMPORTANT: plug in everything you normally use before continuing.
Anything unplugged now will be blocked when you plug it back in
(you can always re-run this to refresh the list, or turn it off).

Protects against malicious USB devices that pretend to be keyboards.")" 2>/dev/null || exit 0

# Order matters: generate the allow-list from the currently attached devices
# BEFORE the daemon ever starts, so nothing the owner is using gets cut off.
#
# The script handed to pkexec stays a single-quoted LITERAL with no translated
# text in it. That is deliberate: it runs as root, and a msgstr is data from a
# translator. Nothing that came out of a .mo file may ever be pasted into it.
if pkexec sh -c '
set -e
umask 077
# Generate into a staging file on the SAME filesystem, then move it into place.
# Redirecting straight at rules.conf TRUNCATES it before usbguard has produced a
# single byte, so a generate-policy that fails destroys the allow-list that was
# already there — while the failure dialog below promises nothing was changed.
_pol=$(mktemp /etc/usbguard/rules.conf.XXXXXX) || exit 3
if ! usbguard generate-policy > "$_pol"; then
    rm -f "$_pol"
    echo "generate-policy failed — refusing to enable" >&2
    exit 2
fi
# Refuse to arm a daemon with an empty policy — that is the lockout case.
if [ ! -s "$_pol" ]; then
    rm -f "$_pol"
    echo "empty policy — refusing to enable" >&2
    exit 2
fi
mv -f "$_pol" /etc/usbguard/rules.conf
systemctl unmask usbguard.service usbguard-dbus.service
# enable --now writes the enable symlinks BEFORE it starts anything, so a start
# that fails (usbguard-dbus is the likely one) leaves both units UNMASKED and
# ENABLED. pkexec then returns non-zero and the owner is shown the reassuring
# dialog below — but at the NEXT BOOT usbguard starts and enforces the policy,
# which is the keyboard lockout this whole file exists to prevent. Put the units
# back the way 0600-pro-edition.hook.chroot ships them: disabled and masked.
if ! systemctl enable --now usbguard.service usbguard-dbus.service; then
    systemctl disable --now usbguard.service usbguard-dbus.service || true
    systemctl mask usbguard.service usbguard-dbus.service || true
    exit 4
fi
'; then
    kdialog --title "$TITLE" --msgbox \
"$(gettext "USB protection is ON.

Everything currently plugged in is allowed. New USB devices are
blocked until you approve them — re-run this tool any time to
refresh the list or turn protection back off.")" 2>/dev/null
else
    # TRANSLATORS: this is the reassuring failure case — nothing was changed
    # and every USB device still works. Keep "nothing was changed" explicit.
    kdialog --title "$TITLE" --sorry \
"$(gettext "USB protection was NOT enabled — nothing was changed, and all your
USB devices keep working.

(This needs administrator access, and Dagric deliberately refuses to
arm USB blocking without a device allow-list.)")" 2>/dev/null
    exit 1
fi
