#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — Migration Assistant: bring your files and bookmarks over from
# the Windows installation that's still on this PC (or on a plugged-in drive).
# The Windows partition is only ever mounted READ-ONLY — nothing there is
# touched, so the owner can go back any time. Copies never overwrite files
# that already exist in the Linux home (--ignore-existing).
# Free edition: this is the switcher's onboarding moment, so it ships everywhere.
#
# TRANSLATION: every string in this file is TIER ONE. This is the tool that
# touches the owner's Windows partition, and the whole product rests on the
# promise that Windows is only ever READ. A translation that loses "Windows
# keeps its own untouched", or that renders "copied" as "moved", tells a
# frightened Windows 10 refugee that their files are about to be taken away
# from the machine they may still need to boot. Nothing here ships to a
# customer until a native speaker has read it. Negation and modality are where
# machine translation fails, and they are exactly what this file is made of.
. /usr/bin/dagric-i18n.sh

TITLE=$(gettext "Dagric Migration Assistant")
err() { kdialog --title "$TITLE" --sorry "$1" 2>/dev/null; }

# --- 0. Live-session warning: the live home lives in RAM -------------------
if [ -d /run/live/medium ]; then
    kdialog --title "$TITLE" --warningcontinuecancel \
"$(gettext "You are running the LIVE session (from the USB stick).

Anything copied here lands in memory and disappears at shutdown.
Best order: install Dagric first, then run Migration from the Hub.

Continue anyway (e.g. to rescue a few files)?")" 2>/dev/null || exit 0
fi

# --- 1. Find Windows: NTFS partitions that contain \Windows and \Users -----
kdialog --title "$TITLE" --passivepopup \
    "$(gettext "Looking for a Windows installation…")" 6 2>/dev/null &

CAND=/tmp/dagric-migrate-candidates.$$
: > "$CAND"
BITLOCKER=""
MOUNTED_BY_US=""

# lsblk -rp: raw, full paths. Columns: NAME FSTYPE MOUNTPOINT (may be empty).
lsblk -rpno NAME,FSTYPE,MOUNTPOINT 2>/dev/null | while IFS=' ' read -r dev fstype mnt; do
    case "$fstype" in
        BitLocker) echo "$dev" >> "${CAND}.bitlocker" ;;
        ntfs|ntfs3)
            if [ -z "$mnt" ]; then
                # Mount read-only via udisks (polkit handles authorization).
                if udisksctl mount -b "$dev" -o ro >/dev/null 2>&1; then
                    mnt=$(lsblk -rpno MOUNTPOINT "$dev" | head -1)
                    [ -n "$mnt" ] && echo "$dev" >> "${CAND}.mounted"
                fi
            fi
            # NOTE: udisks decodes \xNN escapes for us via lsblk raw output;
            # re-read the mountpoint in decoded form:
            mnt=$(lsblk -pno MOUNTPOINT "$dev" | head -1)
            if [ -n "$mnt" ] && [ -d "$mnt/Windows" ] && [ -d "$mnt/Users" ]; then
                printf '%s\t%s\n' "$dev" "$mnt" >> "$CAND"
            fi
            ;;
    esac
done

[ -f "${CAND}.bitlocker" ] && BITLOCKER=$(cat "${CAND}.bitlocker" 2>/dev/null)
[ -f "${CAND}.mounted" ]   && MOUNTED_BY_US=$(cat "${CAND}.mounted" 2>/dev/null)

cleanup() {
    # Unmount only what we mounted; leave pre-existing mounts alone.
    for d in $MOUNTED_BY_US; do udisksctl unmount -b "$d" >/dev/null 2>&1; done
    rm -f "$CAND" "${CAND}.bitlocker" "${CAND}.mounted"
}
trap cleanup EXIT

if [ ! -s "$CAND" ]; then
    if [ -n "$BITLOCKER" ]; then
        # TRANSLATORS: "Settings > Privacy & security > Device encryption" is
        # a path through the WINDOWS settings app — use the wording Windows
        # itself uses in your language, because that is what the owner will be
        # reading on the other machine. "BitLocker" is a product name.
        # "Nothing on the drive was changed" is a promise; keep it.
        err "$(eval_gettext 'A BitLocker-encrypted drive was found ($BITLOCKER) but Dagric cannot
unlock it without the recovery key.

In Windows: turn off BitLocker (Settings > Privacy & security >
Device encryption), or copy your files to a plain USB drive instead.
Nothing on the drive was changed.')"
    else
        err "$(gettext "No Windows installation was found on this PC's drives.

If a password prompt appeared and was cancelled, Dagric could not open
the Windows drive to look inside — run this again and approve it.

If Windows lives on a drive that isn't plugged in, connect it and
run Migration again from the Dagric Hub. Nothing was changed.")"
    fi
    exit 1
fi

# --- 2. Pick the Windows install (if several) ------------------------------
N=$(wc -l < "$CAND")
if [ "$N" -gt 1 ]; then
    # Built with positional parameters, never `eval`. These labels contain a
    # device path and an NTFS volume label, both attacker-influencable: a drive
    # named  x";rm -rf $HOME;"  would otherwise be EXECUTED when the menu string
    # was eval'd. `set --` passes each label as one argument, verbatim.
    #
    # The translated label goes through eval_gettext, which is still safe for
    # exactly the same reason: eval_gettext does NOT eval. It pipes the msgstr
    # through envsubst, which can only substitute variables the msgid already
    # names, so neither the device path nor a msgstr from a translator can
    # become code. The size is lifted into $sz first because envsubst
    # interpolates variables, not command substitutions.
    set --
    i=0
    while IFS='	' read -r dev mnt; do
        i=$((i+1))
        sz=$(du -sh "$mnt/Users" 2>/dev/null | cut -f1)
        set -- "$@" "$i" "$(eval_gettext '$dev — $sz of user files')"
    done < "$CAND"
    PICK=$(kdialog --title "$TITLE" \
        --menu "$(gettext "Several Windows installations were found. Which one?")" \
        "$@" 2>/dev/null) || exit 0
else
    PICK=1
fi
WINDEV=$(sed -n "${PICK}p" "$CAND" | cut -f1)
WINMNT=$(sed -n "${PICK}p" "$CAND" | cut -f2)

# --- 3. Pick the Windows user profile --------------------------------------
PROFILES=/tmp/dagric-migrate-profiles.$$
find "$WINMNT/Users" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
    | grep -viE '/(Public|Default|Default User|All Users)$' > "$PROFILES"
PN=$(wc -l < "$PROFILES")
if [ "$PN" -eq 0 ]; then
    err "$(eval_gettext 'No user profiles were found in $WINMNT/Users.')"
    rm -f "$PROFILES"; exit 1
elif [ "$PN" -gt 1 ]; then
    # Same reasoning as above, and more pressing: these are Windows USER FOLDER
    # names, which routinely contain spaces and apostrophes ("Dave O'Brien") and
    # can contain shell metacharacters outright.
    set --
    i=0
    while IFS= read -r p; do
        i=$((i+1))
        set -- "$@" "$i" "$(basename "$p")"
    done < "$PROFILES"
    UPICK=$(kdialog --title "$TITLE" \
        --menu "$(gettext "Which Windows user are you?")" \
        "$@" 2>/dev/null) || { rm -f "$PROFILES"; exit 0; }
else
    UPICK=1
fi
WINUSER_DIR=$(sed -n "${UPICK}p" "$PROFILES")
WINUSER=$(basename "$WINUSER_DIR")
rm -f "$PROFILES"

# --- 4. What to bring over --------------------------------------------------
# The tags (docs, desk, pics, …) are what kdialog hands back and pairs_for()
# maps to real Windows directory names, so they are never translated — only
# the labels beside them are. Translating a tag would silently select nothing.
#
# TRANSLATORS: "(Files are COPIED — Windows keeps its own untouched.)" is the
# single most important sentence in this tool. The owner is about to point it
# at a Windows installation they may still need to boot. It must not read as
# "moved", and the reassurance must survive.
CHOICES=$(kdialog --title "$TITLE" --separate-output --checklist \
"$(eval_gettext 'Found Windows user "$WINUSER". What should come over to Dagric?
(Files are COPIED — Windows keeps its own untouched.)')" \
 docs   "$(gettext "Documents")"                        on \
 desk   "$(gettext "Desktop")"                          on \
 pics   "$(gettext "Pictures")"                         on \
 music  "$(gettext "Music")"                            on \
 vids   "$(gettext "Videos")"                           on \
 downl  "$(gettext "Downloads")"                        off \
 marks  "$(gettext "Browser bookmarks (Chrome / Edge / Firefox)")" on \
 tabs   "$(gettext "Browser tabs you had open")"        on \
 pwds   "$(gettext "Saved passwords (Firefox only - Chrome explains why)")" off \
 2>/dev/null) || exit 0
[ -n "$CHOICES" ] || exit 0

# Map choice -> Windows dir name + Linux target. OneDrive-redirected folders
# are merged in as a second source when present.
pairs_for() {
    case "$1" in
        docs)  echo "Documents";; desk) echo "Desktop";; pics) echo "Pictures";;
        music) echo "Music";;     vids) echo "Videos";;  downl) echo "Downloads";;
    esac
}

# WHERE THE FILES LAND, IN THE OWNER'S OWN LANGUAGE.
#
# The Windows names above are the SOURCE and are always English on the Windows
# side. The destination used to reuse them verbatim — mkdir -p "$HOME/Documents"
# — which is right on an English install and wrong on every other one Dagric
# ships. On a German desktop xdg-user-dirs has already created ~/Dokumente,
# ~/Bilder, ~/Musik and ~/Schreibtisch, and those are the paths Dolphin's
# sidebar, the file dialogs, the Pictures folder in the wallpaper picker and
# every application's "save to" default actually point at. Copying into
# ~/Documents there builds a SECOND, parallel set of folders that nothing on the
# system links to, and the owner's migration appears to have half-worked: the
# files are on the disk, and none of the places they look show them.
#
# Dagric ships five languages (de, fr, es, pt_BR, it), so this was wrong for
# four of them.
#
# xdg-user-dir is from xdg-user-dirs, pinned in system.list.chroot for exactly
# this class of question. It prints $HOME for a key it does not recognise, which
# would empty a Windows Pictures folder loose into the home directory — worse
# than the English-name bug — so that answer is rejected and the old behaviour
# used as the fallback.
dest_for() {
    case "$1" in
        docs)  _k=DOCUMENTS ;;
        desk)  _k=DESKTOP   ;;
        pics)  _k=PICTURES  ;;
        music) _k=MUSIC     ;;
        vids)  _k=VIDEOS    ;;
        downl) _k=DOWNLOAD  ;;
        *)     _k="" ;;
    esac
    _p=""
    [ -n "$_k" ] && _p=$(xdg-user-dir "$_k" 2>/dev/null)
    if [ -z "$_p" ] || [ "$_p" = "$HOME" ] || [ "$_p" = "$HOME/" ]; then
        _p="$HOME/$(pairs_for "$1")"
    fi
    printf '%s\n' "$_p"
}

# --- 5. Space check ----------------------------------------------------------
NEED_KB=0
for c in $CHOICES; do
    d=$(pairs_for "$c"); [ -n "$d" ] || continue
    for src in "$WINUSER_DIR/$d" "$WINUSER_DIR/OneDrive/$d"; do
        [ -d "$src" ] || continue
        NEED_KB=$((NEED_KB + $(du -sk "$src" 2>/dev/null | cut -f1)))
    done
done
FREE_KB=$(df -k "$HOME" | awk 'NR==2{print $4}')
if [ "$NEED_KB" -gt "$FREE_KB" ]; then
    # envsubst interpolates VARIABLES, not arithmetic — $((...)) inside a
    # msgid would come out literally — so the two figures are worked out here.
    NEED_GB=$((NEED_KB/1024/1024))
    FREE_GB=$((FREE_KB/1024/1024))
    err "$(eval_gettext 'Not enough space: your selection is $NEED_GB GB but this
disk only has $FREE_GB GB free. Deselect some folders
(Videos are usually the big one) and try again. Nothing was copied.')"
    exit 1
fi

# --- 6. Copy (rsync: resumable, never overwrites existing Linux files) ------
echo
# TRANSLATORS: "read-only; Windows is not modified" is the promise the whole
# tool rests on. It is a statement of fact about what is happening right now —
# keep it, and keep it in the present tense.
dg_say "$(eval_gettext '=== Dagric Migration: copying from Windows user "$WINUSER" ===')"
dg_say "$(eval_gettext '    reading $WINDEV mounted at $WINMNT (read-only; Windows is not modified)')"
echo
SKIPPED=$(gettext "    (some files could not be read — skipped)")
for c in $CHOICES; do
    d=$(pairs_for "$c"); [ -n "$d" ] || continue
    # The owner's real folder for this category — ~/Dokumente on a German
    # desktop, not ~/Documents. See dest_for().
    DEST=$(dest_for "$c")
    for src in "$WINUSER_DIR/$d" "$WINUSER_DIR/OneDrive/$d"; do
        [ -d "$src" ] || continue
        # Left untranslated on purpose: this is "SOURCE -> DESTINATION", two
        # file paths and an arrow. There is no English in it to translate, and
        # a translator cannot improve a path.
        echo "--- $src  ->  $DEST"
        mkdir -p "$DEST"
        rsync -rt --ignore-existing --info=progress2 \
            --exclude 'desktop.ini' --exclude 'Thumbs.db' --exclude '*.lnk' \
            "$src/" "$DEST/" || dg_say "$SKIPPED"
    done
done

# --- 7. Bookmarks -> one HTML file Firefox can import ------------------------
# NOTE: kdialog --separate-output returns the tags NEWLINE-separated, so a
# `case " $CHOICES " in *" marks "*)` test silently never matches (there is a
# newline, not a space, before the tag) and bookmarks would be skipped without
# a word of explanation. Re-split on whitespace instead.
WANT_MARKS=no
for c in $CHOICES; do [ "$c" = marks ] && WANT_MARKS=yes; done
case "$WANT_MARKS" in yes)
    OUT="$HOME/Windows-bookmarks.html"
    python3 - "$WINUSER_DIR" "$OUT" << 'PYEOF'
import json, sqlite3, sys, glob, html, os, shutil, tempfile
prof, out = sys.argv[1], sys.argv[2]
items = []   # (folder, title, url)

def walk_chrome(node, folder):
    if node.get("type") == "url":
        items.append((folder, node.get("name", ""), node.get("url", "")))
    for ch in node.get("children", []):
        walk_chrome(ch, node.get("name", folder))

# Chrome + Edge (every profile, not just Default)
for base, label in ((r"AppData/Local/Google/Chrome/User Data", "Chrome"),
                    (r"AppData/Local/Microsoft/Edge/User Data", "Edge")):
    # glob.escape: prof is /media/<user>/<NTFS label>/Users/<name>, and a label
    # like "Windows [SSD]" is legal on NTFS but is a character class to glob.
    for bm in glob.glob(os.path.join(glob.escape(os.path.join(prof, base)), "*", "Bookmarks")):
        try:
            with open(bm, encoding="utf-8") as f:
                roots = json.load(f).get("roots", {})
            for r in roots.values():
                if isinstance(r, dict):
                    walk_chrome(r, label)
        except Exception:
            pass

# Firefox on Windows (places.sqlite; copy out first — NTFS is mounted ro)
for db in glob.glob(os.path.join(prof, r"AppData/Roaming/Mozilla/Firefox/Profiles", "*", "places.sqlite")):
    try:
        tmp = os.path.join(tempfile.mkdtemp(), "places.sqlite")
        shutil.copy(db, tmp)
        con = sqlite3.connect(tmp)
        for title, url in con.execute(
            "SELECT b.title, p.url FROM moz_bookmarks b JOIN moz_places p ON b.fk=p.id "
            "WHERE b.type=1 AND p.url LIKE 'http%'"):
            items.append(("Firefox", title or url, url))
        con.close()
    except Exception:
        pass

seen, rows = set(), []
for folder, title, url in items:
    if url and url not in seen:
        seen.add(url)
        rows.append((folder, title, url))

with open(out, "w", encoding="utf-8") as f:
    f.write("<!DOCTYPE NETSCAPE-Bookmark-file-1>\n<META HTTP-EQUIV=\"Content-Type\" "
            "CONTENT=\"text/html; charset=UTF-8\">\n<TITLE>Bookmarks</TITLE>\n"
            "<H1>Bookmarks from Windows</H1>\n<DL><p>\n")
    cur = None
    for folder, title, url in sorted(rows):
        if folder != cur:
            if cur is not None:
                f.write("</DL><p>\n")
            f.write("<DT><H3>%s</H3>\n<DL><p>\n" % html.escape(folder))
            cur = folder
        f.write('<DT><A HREF="%s">%s</A>\n' % (html.escape(url, quote=True), html.escape(title)))
    if cur is not None:
        f.write("</DL><p>\n")
    f.write("</DL><p>\n")
print("BOOKMARKS=%d" % len(rows))
PYEOF
    if [ -s "$OUT" ]; then
        echo
        # TRANSLATORS: "Bookmarks > Manage Bookmarks > Import and Backup >
        # Import Bookmarks from HTML" is a path through FIREFOX's own menus.
        # Use the wording Firefox shows in your language, not a literal
        # translation, or the owner will look for a menu item that is not there.
        dg_say "$(eval_gettext 'Bookmarks saved to: $OUT')"
        dg_say "$(gettext "Import them in Firefox:  Bookmarks > Manage Bookmarks >
Import and Backup > Import Bookmarks from HTML.")"
    fi
;; esac

# --- 8. Open tabs and saved passwords ---------------------------------------
WANT_TABS=no; WANT_PWDS=no
for c in $CHOICES; do
    [ "$c" = tabs ] && WANT_TABS=yes
    [ "$c" = pwds ] && WANT_PWDS=yes
done

if [ "$WANT_TABS" = yes ] || [ "$WANT_PWDS" = yes ]; then
    echo
    dg_say "$(gettext "--- browser tabs and logins ---")"
    PRIMARY=""
    if [ "$WANT_PWDS" = yes ]; then
        # A Firefox Primary Password can't be guessed; ask rather than fail.
        if grep -rqs '"encryptedPassword"' \
             "$WINUSER_DIR/AppData/Roaming/Mozilla/Firefox/Profiles" 2>/dev/null; then
            # TRANSLATORS: "Primary Password" is Firefox's own term for the
            # master password — use whatever Firefox calls it in your language.
            PRIMARY=$(kdialog --title "$TITLE" --password \
"$(gettext "If this person set a Primary Password in Firefox, type it so the saved
logins can be unlocked.

Leave it blank if they never set one (most people haven't).")" 2>/dev/null) || PRIMARY=""
        fi
    fi

    # Keep stderr: a failure here must never be reported as "found nothing".
    BROWSER_LOG=$(mktemp -t dagric-migrate-browser.XXXXXX) \
        || BROWSER_LOG="${TMPDIR:-/tmp}/dagric-migrate-browser.$$"

    # THE PASSWORD GOES DOWN A PIPE, NOT INTO argv.
    #
    # This was `... "$HOME" "$PRIMARY"`, which put the owner's Firefox Primary
    # Password into the helper's command line — and /proc/<pid>/cmdline is
    # world-readable on this system (nothing here sets hidepid). Any other user
    # logged into the same machine, and any unprivileged process, could read it
    # out of `ps aux` for as long as the migration ran. That is the worst
    # possible moment for it: the owner is moving their entire saved-password
    # store across, and Pro is sold to schools and libraries where a second user
    # on the machine is the normal case rather than an edge case.
    #
    # printf rather than echo: the password is arbitrary text and echo would
    # interpret backslashes in it. The trailing newline is what the helper's
    # readline() consumes; a blank line means "no primary password", which is
    # the common case and is handled.
    RES=$(printf '%s\n' "$PRIMARY" \
            | python3 /usr/share/dagric/migrate-browser.py "$WINUSER_DIR" "$HOME" \
            2>"$BROWSER_LOG")
    N_TABS=$(printf '%s\n' "$RES" | sed -n 's/^TABS=//p')
    N_PWDS=$(printf '%s\n' "$RES" | sed -n 's/^PASSWORDS=//p')
    PWNOTE=$(printf '%s\n' "$RES" | sed -n 's/^PWNOTE=//p')
    CHROMEISH=$(printf '%s\n' "$RES" | sed -n 's/^CHROMEISH=//p')
    EXPORTED=$(printf '%s\n' "$RES" | sed -n 's/^EXPORTED=//p')
    MIGFAIL=$(printf '%s\n' "$RES" | sed -n 's/^FAILED=//p')
    # No TABS= line at all means the helper died outright rather than reporting.
    #
    # $MIGFAIL is either this sentence or the FAILED= line the Python helper
    # printed. The helper's own text is not translated here — it comes from
    # /usr/share/dagric/migrate-browser.py, which has its own strings; wrapping
    # a value that arrived from another program in gettext() would look up a
    # msgid that is not in the catalogue and change nothing.
    if ! printf '%s\n' "$RES" | grep -q '^TABS='; then
        MIGFAIL=$(gettext "the browser recovery helper did not finish")
    fi
    if [ -n "$MIGFAIL" ]; then
        dg_say "$(eval_gettext 'Some browser data could not be read: $MIGFAIL')"
        [ -s "$BROWSER_LOG" ] && sed 's/^/  /' "$BROWSER_LOG"
    fi
    rm -f "$BROWSER_LOG"

    if [ "$WANT_TABS" = yes ]; then
        if [ "${N_TABS:-0}" -gt 0 ] 2>/dev/null; then
            # eval_ngettext, not eval_gettext: "1 open tabs" is wrong in
            # English and much more wrong in the languages with three or four
            # plural forms. ngettext picks the form from the target language's
            # own Plural-Forms rule in the .po header.
            dg_say "$(eval_ngettext \
                'Recovered $N_TABS open tab -> ~/Windows-open-tabs.html' \
                'Recovered $N_TABS open tabs -> ~/Windows-open-tabs.html' "$N_TABS")"
        elif [ -n "$MIGFAIL" ]; then
            dg_say "$(gettext "No open tabs could be recovered - the session files could not be read.
  A half-written session file (an unclean Windows shutdown) can cause this.")"
        else
            dg_say "$(gettext "No open tabs were found (the browsers may have been closed cleanly).")"
        fi
    fi

    if [ "$WANT_PWDS" = yes ]; then
        if [ "${N_PWDS:-0}" -gt 0 ] 2>/dev/null; then
            dg_say "$(eval_ngettext \
                'Recovered $N_PWDS Firefox login -> ~/Windows-passwords.csv' \
                'Recovered $N_PWDS Firefox logins -> ~/Windows-passwords.csv' "$N_PWDS")"
            # TRANSLATORS: a plain-text file of the owner's passwords now
            # exists on disk. "Import it, then delete it" is an instruction,
            # and PLAIN TEXT must stay emphatic.
            dg_say "$(gettext "  This file is PLAIN TEXT and readable only by you.
  Import it, then delete it.")"
        else
            dg_say "$(gettext "No Firefox logins were recovered.")"
            [ -n "$PWNOTE" ] && echo "  ($PWNOTE)"
        fi
        # Chrome/Edge: be straight about the cryptography.
        if [ "${CHROMEISH:-0}" = 1 ]; then
            if [ -n "$EXPORTED" ]; then
                echo
                dg_say "$(gettext "Found a password file exported from Chrome:")"
                printf '%s\n' "$EXPORTED" | tr '|' '\n' | sed 's/^/  /'
                dg_say "$(gettext "  Copy it to your home folder and import it the same way.")"
            else
                echo
                # TRANSLATORS: the two indented lines are paths through
                # CHROME's and EDGE's settings, on the Windows machine — use
                # the wording those browsers show in your language. The first
                # paragraph explains WHY this cannot work; it is a security
                # property, not an apology, and should not be softened into one.
                dg_say "$(gettext "Chrome / Edge passwords could NOT be read, and no tool can read them here:
they are encrypted with a Windows key tied to that Windows account, which
does not exist on this system. That is a security feature, not a fault.

To bring them over, do this ONCE while still in Windows:
  Chrome : Settings > Autofill and passwords > Google Password Manager
           > Settings > Download file
  Edge   : Settings > Profiles > Passwords > ... > Export passwords
Save the .csv, then run this migration again - it will pick it up.")"
            fi
        fi
    fi
fi

echo
dg_say "$(gettext "=== Migration finished ===")"
# TRANSLATORS: the closing promise of the whole tool — "Windows itself was not
# modified — it was only ever read" is the sentence the owner will remember,
# and the one that decides whether they trust this product. Do not weaken the
# negation. The ▸ chains are menu paths inside FIREFOX; use Firefox's own
# wording in your language. File names (Windows-bookmarks.html,
# Windows-open-tabs.html, Windows-passwords.csv) are literal and must not be
# translated — the owner has to find them on disk.
SUMMARY=$(gettext "Done! Your Windows files are now in your Dagric home folder.

Windows itself was not modified — it was only ever read.

To finish up, in Firefox:
• Bookmarks — Bookmarks ▸ Manage Bookmarks ▸ Import and Backup ▸
  Import Bookmarks from HTML ▸ Windows-bookmarks.html
• Open tabs — import Windows-open-tabs.html the same way; they arrive as a
  bookmark folder you can 'Open All in Tabs'")

if [ "${N_PWDS:-0}" -gt 0 ] 2>/dev/null; then
    # TRANSLATORS: a warning that a plain-text password file is sitting in the
    # owner's home folder. "Delete it once imported" must survive translation.
    SUMMARY="$SUMMARY
$(gettext "• Passwords — Firefox ▸ Passwords ▸ ⋯ ▸ Import from a File ▸
  Windows-passwords.csv   (KeePassXC on Pro can import the same file)

⚠ Windows-passwords.csv is PLAIN TEXT. Delete it once imported.")"
fi

kdialog --title "$TITLE" --msgbox "$SUMMARY" 2>/dev/null
