#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — Migration Assistant: bring your files and bookmarks over from
# the Windows installation that's still on this PC (or on a plugged-in drive).
# The Windows partition is only ever mounted READ-ONLY — nothing there is
# touched, so the owner can go back any time. Copies never overwrite files
# that already exist in the Linux home (--ignore-existing).
# Free edition: this is the switcher's onboarding moment, so it ships everywhere.
#
# TRANSLATION: every string in this file is TIER ONE. This is the tool that
# touches the owner's Windows partition, and the whole product rests on the
# promise that Windows is only ever READ. A translation that loses "Windows
# keeps its own untouched", or that renders "copied" as "moved", tells a
# frightened Windows 10 refugee that their files are about to be taken away
# from the machine they may still need to boot. Nothing here ships to a
# customer until a native speaker has read it. Negation and modality are where
# machine translation fails, and they are exactly what this file is made of.
. /usr/bin/dagric-i18n.sh

TITLE=$(gettext "Dagric Migration Assistant")
err() { kdialog --title "$TITLE" --sorry "$1" 2>/dev/null; }

# --- 0. Live-session warning: the live home lives in RAM -------------------
if [ -d /run/live/medium ]; then
    kdialog --title "$TITLE" --warningcontinuecancel \
"$(gettext "You are running the LIVE session (from the USB stick).

Anything copied here lands in memory and disappears at shutdown.
Best order: install Dagric first, then run Migration from the Hub.

Continue anyway (e.g. to rescue a few files)?")" 2>/dev/null || exit 0
fi

# --- 1. Find Windows: NTFS partitions that contain \Windows and \Users -----
kdialog --title "$TITLE" --passivepopup \
    "$(gettext "Looking for a Windows installation…")" 6 2>/dev/null &

# mktemp, not a name another user can guess. This was
# /tmp/dagric-migrate-candidates.$$ — a path any other logged-in user can
# predict and pre-create, and $CAND is where $WINMNT and $WINUSER_DIR are read
# back out of, so it decides the rsync SOURCE and the argument handed to
# migrate-browser.py. Pro is sold to schools and libraries where a second user
# on the machine is the normal case rather than an edge case (the same reason
# written out at the browser helper further down), and this is the one tool that
# touches the owner's Windows partition. The .bitlocker and .mounted siblings
# are derived from this name and become unguessable along with it.
CAND=$(mktemp -t dagric-migrate-candidates.XXXXXX) || exit 1
: > "$CAND"
BITLOCKER=""
MOUNTED_BY_US=""

# lsblk -rp: raw, full paths. Columns: NAME FSTYPE MOUNTPOINT (may be empty).
lsblk -rpno NAME,FSTYPE,MOUNTPOINT 2>/dev/null | while IFS=' ' read -r dev fstype mnt; do
    case "$fstype" in
        BitLocker) echo "$dev" >> "${CAND}.bitlocker" ;;
        ntfs|ntfs3)
            # A VOLUME SOMETHING ELSE ALREADY MOUNTED IS MOUNTED READ-WRITE.
            # Clicking the Windows drive in Dolphin's Places is the normal thing
            # a switcher does before running this, and udisks mounts it rw. The
            # `-o ro` mount below only ever covered the UNmounted case, so this
            # tool adopted that rw mount and still told the owner — on the
            # "read-only; Windows is not modified" line in section 6, and again
            # in the closing "it was only ever read" dialog — that Windows was
            # never written to. Take it back to read-only before a byte is read.
            # findmnt is queried by DEVICE, not by $mnt: lsblk -rp reports
            # mountpoints with \xNN escapes, so an NTFS label with a space in it
            # would not resolve as a path. If the volume is busy the unmount
            # fails, $mnt stays set and the previous behaviour is kept — no
            # regression there, just no improvement.
            if [ -n "$mnt" ] && \
               ! findmnt -no OPTIONS -S "$dev" 2>/dev/null | grep -q '\(^\|,\)ro\(,\|$\)'; then
                udisksctl unmount -b "$dev" >/dev/null 2>&1 && mnt=""
            fi
            if [ -z "$mnt" ]; then
                # Mount read-only via udisks (polkit handles authorization).
                if udisksctl mount -b "$dev" -o ro >/dev/null 2>&1; then
                    mnt=$(lsblk -rpno MOUNTPOINT "$dev" | head -1)
                    [ -n "$mnt" ] && echo "$dev" >> "${CAND}.mounted"
                fi
            fi
            # NOTE: udisks decodes \xNN escapes for us via lsblk raw output;
            # re-read the mountpoint in decoded form:
            mnt=$(lsblk -pno MOUNTPOINT "$dev" | head -1)
            if [ -n "$mnt" ] && [ -d "$mnt/Windows" ] && [ -d "$mnt/Users" ]; then
                printf '%s\t%s\n' "$dev" "$mnt" >> "$CAND"
            fi
            ;;
    esac
done

[ -f "${CAND}.bitlocker" ] && BITLOCKER=$(cat "${CAND}.bitlocker" 2>/dev/null)
[ -f "${CAND}.mounted" ]   && MOUNTED_BY_US=$(cat "${CAND}.mounted" 2>/dev/null)

# Initialise every temporary path used by cleanup before the EXIT trap exists.
# Each later assignment comes from mktemp; there are no predictable /tmp/$$
# fallbacks for another local account to pre-create as a symlink.
VERI_LOG=""
VERI_SUMMARY=""
VERI_CHECKSUMS=""
VERI_STDOUT=""
VERI_STDERR=""
BROWSER_LOG=""
CONT_LOG=""
STATE_LOG=""

cleanup() {
    # Unmount only what we mounted; leave pre-existing mounts alone.
    for d in $MOUNTED_BY_US; do udisksctl unmount -b "$d" >/dev/null 2>&1; done
    rm -f "$CAND" "${CAND}.bitlocker" "${CAND}.mounted" \
        "$VERI_LOG" "$VERI_SUMMARY" "$VERI_CHECKSUMS" \
        "$VERI_STDOUT" "$VERI_STDERR" "$BROWSER_LOG" "$CONT_LOG" "$STATE_LOG"
}
trap cleanup EXIT

if [ ! -s "$CAND" ]; then
    if [ -n "$BITLOCKER" ]; then
        # TRANSLATORS: "Settings > Privacy & security > Device encryption" is
        # a path through the WINDOWS settings app — use the wording Windows
        # itself uses in your language, because that is what the owner will be
        # reading on the other machine. "BitLocker" is a product name.
        # "Nothing on the drive was changed" is a promise; keep it.
        err "$(eval_gettext 'A BitLocker-encrypted drive was found ($BITLOCKER) but Dagric cannot
unlock it without the recovery key.

In Windows: turn off BitLocker (Settings > Privacy & security >
Device encryption), or copy your files to a plain USB drive instead.
Nothing on the drive was changed.')"
    else
        err "$(gettext "No Windows installation was found on this PC's drives.

If a password prompt appeared and was cancelled, Dagric could not open
the Windows drive to look inside — run this again and approve it.

If Windows lives on a drive that isn't plugged in, connect it and
run Migration again from the Dagric Hub. Nothing was changed.")"
    fi
    exit 1
fi

# --- 2. Pick the Windows install (if several) ------------------------------
N=$(wc -l < "$CAND")
if [ "$N" -gt 1 ]; then
    # Built with positional parameters, never `eval`. These labels contain a
    # device path and an NTFS volume label, both attacker-influencable: a drive
    # named  x";rm -rf $HOME;"  would otherwise be EXECUTED when the menu string
    # was eval'd. `set --` passes each label as one argument, verbatim.
    #
    # The translated label goes through eval_gettext, which is still safe for
    # exactly the same reason: eval_gettext does NOT eval. It pipes the msgstr
    # through envsubst, which can only substitute variables the msgid already
    # names, so neither the device path nor a msgstr from a translator can
    # become code. The size is lifted into $sz first because envsubst
    # interpolates variables, not command substitutions.
    set --
    i=0
    while IFS='	' read -r dev mnt; do
        i=$((i+1))
        sz=$(du -sh "$mnt/Users" 2>/dev/null | cut -f1)
        set -- "$@" "$i" "$(eval_gettext '$dev — $sz of user files')"
    done < "$CAND"
    PICK=$(kdialog --title "$TITLE" \
        --menu "$(gettext "Several Windows installations were found. Which one?")" \
        "$@" 2>/dev/null) || exit 0
else
    PICK=1
fi
WINDEV=$(sed -n "${PICK}p" "$CAND" | cut -f1)
WINMNT=$(sed -n "${PICK}p" "$CAND" | cut -f2)

# --- 3. Pick the Windows user profile --------------------------------------
# mktemp for the same reason as $CAND above: this was
# /tmp/dagric-migrate-profiles.$$, and the redirection on the next line would
# truncate whatever another user had already put at that path. Exiting here is
# safe — the cleanup EXIT trap is already installed, so any drive this run
# mounted is still unmounted.
PROFILES=$(mktemp -t dagric-migrate-profiles.XXXXXX) || exit 1
find "$WINMNT/Users" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
    | grep -viE '/(Public|Default|Default User|All Users)$' > "$PROFILES"
PN=$(wc -l < "$PROFILES")
if [ "$PN" -eq 0 ]; then
    err "$(eval_gettext 'No user profiles were found in $WINMNT/Users.')"
    rm -f "$PROFILES"; exit 1
elif [ "$PN" -gt 1 ]; then
    # Same reasoning as above, and more pressing: these are Windows USER FOLDER
    # names, which routinely contain spaces and apostrophes ("Dave O'Brien") and
    # can contain shell metacharacters outright.
    set --
    i=0
    while IFS= read -r p; do
        i=$((i+1))
        set -- "$@" "$i" "$(basename "$p")"
    done < "$PROFILES"
    UPICK=$(kdialog --title "$TITLE" \
        --menu "$(gettext "Which Windows user are you?")" \
        "$@" 2>/dev/null) || { rm -f "$PROFILES"; exit 0; }
else
    UPICK=1
fi
WINUSER_DIR=$(sed -n "${UPICK}p" "$PROFILES")
WINUSER=$(basename "$WINUSER_DIR")
rm -f "$PROFILES"

# --- 4. What to bring over --------------------------------------------------
# The tags (docs, desk, pics, …) are what kdialog hands back and pairs_for()
# maps to real Windows directory names, so they are never translated — only
# the labels beside them are. Translating a tag would silently select nothing.
#
# TRANSLATORS: "(Files are COPIED — Windows keeps its own untouched.)" is the
# single most important sentence in this tool. The owner is about to point it
# at a Windows installation they may still need to boot. It must not read as
# "moved", and the reassurance must survive.
CHOICES=$(kdialog --title "$TITLE" --separate-output --checklist \
"$(eval_gettext 'Found Windows user "$WINUSER". What should come over to Dagric?
(Files are COPIED — Windows keeps its own untouched.)')" \
 docs   "$(gettext "Documents")"                        on \
 desk   "$(gettext "Desktop")"                          on \
 pics   "$(gettext "Pictures")"                         on \
 music  "$(gettext "Music")"                            on \
 vids   "$(gettext "Videos")"                           on \
 downl  "$(gettext "Downloads")"                        off \
 marks  "$(gettext "Browser bookmarks (Chrome / Brave / Edge / DuckDuckGo / Firefox)")" on \
 tabs   "$(gettext "Browser tabs you had open")"        on \
 pwds   "$(gettext "Saved passwords (Firefox + Chromium CSV export)")" off \
 games  "$(gettext "Gaming continuity (save games, Steam screenshots, game inventory)")" off \
 dev    "$(gettext "Developer continuity (VS Code settings, Git configuration, project inventory)")" off \
 creative "$(gettext "Creative/work profiles (OBS, Blender, Krita, LibreOffice templates, Audacity)")" off \
 mail   "$(gettext "Thunderbird mail and contacts profile — contains personal email")" off \
 fonts  "$(gettext "Personal fonts — confirm you may use their licenses")" off \
2>/dev/null) || exit 0
[ -n "$CHOICES" ] || exit 0

# Optional Windows companion bundle (generated from Dagric-Windows-Companion.ps1):
# reads networks, printers, cloud notes, and extra app inventory not visible
# through NTFS-only parsing. It never contains passwords or browser session data.
COMPANION_PATH=""
if kdialog --title "$TITLE" --yesno \
    "$(gettext "Do you have a Dagric-Windows-Companion.json export? It adds
network names, printers, cloud notes, and app context to your migration report.")" 2>/dev/null; then
    COMPANION_CANDIDATE=$(kdialog --title "$TITLE" --getopenfilename "$HOME" "*.json *.dagric" 2>/dev/null)
    if [ -n "$COMPANION_CANDIDATE" ] && [ -f "$COMPANION_CANDIDATE" ]; then
        COMPANION_PATH="$COMPANION_CANDIDATE"
    fi
fi
[ -z "$COMPANION_PATH" ] && [ -f "$HOME/Dagric-Windows-Companion.json" ] && COMPANION_PATH="$HOME/Dagric-Windows-Companion.json"

# --- 4b. Verification inputs ------------------------------------------------
VERI_LOG=$(mktemp -t dagric-migrate-verification.XXXXXX) || exit 1
VERI_SUMMARY=$(mktemp -t dagric-migrate-verification-json.XXXXXX) || exit 1
VERI_CHECKSUMS=$(mktemp -t dagric-migrate-verification-checksums.XXXXXX) || exit 1
VERI_STDOUT=$(mktemp -t dagric-migrate-verification-out.XXXXXX) || exit 1
VERI_STDERR=$(mktemp -t dagric-migrate-verification-err.XXXXXX) || exit 1
VERIFICATION_JSON="$HOME/Dagric-Migration-Verification.json"
VERIFICATION_HTML="$HOME/Dagric-Migration-Verification.html"
VERI_LIMIT_FILES=180
VERI_SHA_LIMIT=180

# Map choice -> Windows dir name + Linux target. OneDrive-redirected folders
# are merged in as a second source when present.
pairs_for() {
    case "$1" in
        docs)  echo "Documents";; desk) echo "Desktop";; pics) echo "Pictures";;
        music) echo "Music";;     vids) echo "Videos";;  downl) echo "Downloads";;
    esac
}

# WHERE THE FILES LAND, IN THE OWNER'S OWN LANGUAGE.
#
# The Windows names above are the SOURCE and are always English on the Windows
# side. The destination used to reuse them verbatim — mkdir -p "$HOME/Documents"
# — which is right on an English install and wrong on every other one Dagric
# ships. On a German desktop xdg-user-dirs has already created ~/Dokumente,
# ~/Bilder, ~/Musik and ~/Schreibtisch, and those are the paths Dolphin's
# sidebar, the file dialogs, the Pictures folder in the wallpaper picker and
# every application's "save to" default actually point at. Copying into
# ~/Documents there builds a SECOND, parallel set of folders that nothing on the
# system links to, and the owner's migration appears to have half-worked: the
# files are on the disk, and none of the places they look show them.
#
# Dagric ships five languages (de, fr, es, pt_BR, it), so this was wrong for
# four of them.
#
# xdg-user-dir is from xdg-user-dirs, pinned in system.list.chroot for exactly
# this class of question. It prints $HOME for a key it does not recognise, which
# would empty a Windows Pictures folder loose into the home directory — worse
# than the English-name bug — so that answer is rejected and the old behaviour
# used as the fallback.
dest_for() {
    case "$1" in
        docs)  _k=DOCUMENTS ;;
        desk)  _k=DESKTOP   ;;
        pics)  _k=PICTURES  ;;
        music) _k=MUSIC     ;;
        vids)  _k=VIDEOS    ;;
        downl) _k=DOWNLOAD  ;;
        *)     _k="" ;;
    esac
    _p=""
    [ -n "$_k" ] && _p=$(xdg-user-dir "$_k" 2>/dev/null)
    if [ -z "$_p" ] || [ "$_p" = "$HOME" ] || [ "$_p" = "$HOME/" ]; then
        _p="$HOME/$(pairs_for "$1")"
    fi
    printf '%s\n' "$_p"
}

# --- 5. Space check ----------------------------------------------------------
NEED_KB=0
for c in $CHOICES; do
    d=$(pairs_for "$c"); [ -n "$d" ] || continue
    for src in "$WINUSER_DIR/$d" "$WINUSER_DIR/OneDrive/$d"; do
        [ -d "$src" ] || continue
        NEED_KB=$((NEED_KB + $(du -sk "$src" 2>/dev/null | cut -f1)))
    done
done
FREE_KB=$(df -k "$HOME" | awk 'NR==2{print $4}')
if [ "$NEED_KB" -gt "$FREE_KB" ]; then
    # envsubst interpolates VARIABLES, not arithmetic — $((...)) inside a
    # msgid would come out literally — so the two figures are worked out here.
    NEED_GB=$((NEED_KB/1024/1024))
    FREE_GB=$((FREE_KB/1024/1024))
    err "$(eval_gettext 'Not enough space: your selection is $NEED_GB GB but this
disk only has $FREE_GB GB free. Deselect some folders
(Videos are usually the big one) and try again. Nothing was copied.')"
    exit 1
fi

# --- 6. Copy (rsync: resumable, never overwrites existing Linux files) ------
echo
# TRANSLATORS: "read-only; Windows is not modified" is the promise the whole
# tool rests on. It is a statement of fact about what is happening right now —
# keep it, and keep it in the present tense.
dg_say "$(eval_gettext '=== Dagric Migration: copying from Windows user "$WINUSER" ===')"
dg_say "$(eval_gettext '    reading $WINDEV mounted at $WINMNT (read-only; Windows is not modified)')"
echo
SKIPPED=$(gettext "    (some files could not be read — skipped)")

copy_with_stats() {
    c="$1"
    src="$2"
    dest="$3"
    log="$4"
    tmp=""
    status="ok"
    copied=0
    bytes=0
    fail_count=0
    fail_text=""

    mkdir -p "$dest"
    tmp=$(mktemp -t dagric-migrate-rsync.XXXXXX) || return 1
    if ! rsync -rt --ignore-existing --out-format='XFER|%i|%n' --stats \
        --exclude 'desktop.ini' --exclude 'Thumbs.db' --exclude '*.lnk' \
        "$src/" "$dest/" >"$tmp" 2>&1; then
        status="failed"
        COPY_FAILED=yes
    fi

    copied=$(awk -F: '/^Number of files transferred:/{gsub(/[^0-9]/, "", $2); if ($2 != "") print $2; else print 0; exit}' "$tmp")
    bytes=$(awk '/^Total transferred file size:/ {gsub(/[^0-9]/, "", $NF); print $NF; exit}' "$tmp")
    copied="${copied:-0}"
    bytes="${bytes:-0}"
    fail_count=$(awk '/^rsync error|^rsync: / {n++} END {print n+0}' "$tmp")
    if [ "$fail_count" -gt 0 ]; then
        status=failed
        fail_text=$(awk '/^rsync error|^rsync: / {print; if (++i>=6) exit}' "$tmp" | sed 's/^[[:space:]]*//')
        fail_text=$(printf '%s' "$fail_text" | tr '\n' '; ')
        COPY_FAILED=yes
    fi

    echo "copy\t$c\t$src\t$dest\t$copied\t$bytes\t$status\t$fail_text" >> "$log"

    # Checksum manifest for a small, practical sample. This is optional and
    # explicitly bounded to keep migration responsive on large folders.
    if [ -n "$VERI_CHECKSUMS" ] && [ "$copied" -gt 0 ] && [ "$copied" -le "$VERI_SHA_LIMIT" ]; then
        checksum_count=0
        while IFS='|' read -r marker code rel; do
            [ "$marker" = "XFER" ] || continue
            case "$code" in
                ">f"*) : ;;
                *) continue ;;
            esac
            [ "$checksum_count" -ge "$VERI_SHA_LIMIT" ] && break
            rel=${rel#./}
            real="$dest/$rel"
            if [ -f "$real" ] && [ "$checksum_count" -lt "$VERI_SHA_LIMIT" ]; then
                sha=$(sha256sum "$real" 2>/dev/null | awk '{print $1}') || continue
                printf '%s\t%s\t%s\t%s\n' "checksum" "$real" "$sha" "$src" >> "$VERI_CHECKSUMS"
                checksum_count=$((checksum_count + 1))
            fi
        done <<EOF
$(awk -F'|' '/^XFER\\|/ {print $0}' "$tmp")
EOF
        if [ "$checksum_count" -gt 0 ]; then
            # shellcheck disable=SC2013
            sort -u "$VERI_CHECKSUMS" -o "$VERI_CHECKSUMS"
        fi
    fi

    rm -f "$tmp"
    if [ "$status" = ok ]; then
        return 0
    fi
    return 1
}
# Did ANY copy fail? The closing summary used to be built unconditionally from
# "Done! Your Windows files are now in your Dagric home folder.", so a full home
# partition or a read-only destination produced one scrolled-past line here and
# then a modal dialog telling the owner their files had arrived. This flag is
# what lets the last thing they read tell the truth.
COPY_FAILED=
for c in $CHOICES; do
    d=$(pairs_for "$c"); [ -n "$d" ] || continue
    # The owner's real folder for this category — ~/Dokumente on a German
    # desktop, not ~/Documents. See dest_for().
    DEST=$(dest_for "$c")
    for src in "$WINUSER_DIR/$d" "$WINUSER_DIR/OneDrive/$d"; do
        [ -d "$src" ] || continue
        # Left untranslated on purpose: this is "SOURCE -> DESTINATION", two
        # file paths and an arrow. There is no English in it to translate, and
        # a translator cannot improve a path.
        echo "--- $src  ->  $DEST"
        if ! copy_with_stats "$c" "$src" "$DEST" "$VERI_LOG"; then
            COPY_FAILED=yes
            # $SKIPPED is also the wrong description for a full disk, a
            # read-only home or a mkdir that did not take, which is why the
            # failure is now RECORDED as well as printed — see the summary at
            # the end of this script.
            dg_say "$SKIPPED"
        fi
    done
done

# Emit a compact integrity note and render verification artifacts.
    if [ -n "$VERI_LOG" ] && [ -s "$VERI_LOG" ]; then
        VERI_OUT_JSON="$VERIFICATION_JSON"
        VERI_OUT_HTML="$VERIFICATION_HTML"
        python3 /usr/share/dagric/migrate-verification.py \
            "$VERI_LOG" "$HOME" "$WINUSER" "$WINDEV" "$WINMNT" "$CHOICES" \
            "$VERI_OUT_JSON" "$VERI_OUT_HTML" \
            --checksum-file "${HOME}/Dagric-Migration-Verification-checksums.sha256" \
            --companion "$COMPANION_PATH" \
            > "$VERI_STDOUT" 2>"$VERI_STDERR"
        # shellcheck disable=SC2181
        VERI_STATUS=$?
        if [ -s "$VERI_STDOUT" ]; then
            cat "$VERI_STDOUT"
        fi
        if [ -s "$VERI_STDERR" ]; then
            sed 's/^/  /' "$VERI_STDERR"
        fi
        : > "$VERI_STDOUT"
        : > "$VERI_STDERR"
    fi

# --- 7. Bookmarks -> one HTML file Firefox can import ------------------------
# NOTE: kdialog --separate-output returns the tags NEWLINE-separated, so a
# `case " $CHOICES " in *" marks "*)` test silently never matches (there is a
# newline, not a space, before the tag) and bookmarks would be skipped without
# a word of explanation. Re-split on whitespace instead.
WANT_MARKS=no
for c in $CHOICES; do [ "$c" = marks ] && WANT_MARKS=yes; done
case "$WANT_MARKS" in yes)
    OUT="$HOME/Windows-bookmarks.html"
    # STAGED, then moved into place — because the Python below opens its output
    # with mode "w" and writes the NETSCAPE-Bookmark wrapper whether or not it
    # found a single bookmark. Writing straight at $OUT meant a run that read
    # nothing (the wrong Windows user picked from the menu above, a browser
    # folder that could not be read, python3 dying part-way) TRUNCATED the good
    # export an earlier run had made — and the [ -s "$OUT" ] test then saw the
    # empty file's own 200-byte header and printed "Bookmarks saved to:" plus
    # the Firefox import instructions over it. Three of this tool's own dialogs
    # invite the owner to "run Migration again", so a second run is the normal
    # path, not an edge case.
    OUTNEW="$OUT.part"
    rm -f "$OUTNEW"
    BM=$(python3 - "$WINUSER_DIR" "$OUTNEW" << 'PYEOF'
import json, sqlite3, sys, glob, html, os, shutil, tempfile
prof, out = sys.argv[1], sys.argv[2]
items = []   # (folder, title, url)

def walk_chrome(node, folder):
    if node.get("type") == "url":
        items.append((folder, node.get("name", ""), node.get("url", "")))
    for ch in node.get("children", []):
        walk_chrome(ch, node.get("name", folder))

# Chromium-family browser bookmarks (every profile, not just Default)
for base, label in (
        (r"AppData/Local/Google/Chrome/User Data", "Chrome"),
        (r"AppData/Local/Google/Chrome Beta/User Data", "Chrome"),
        (r"AppData/Local/Google/Chrome Dev/User Data", "Chrome"),
        (r"AppData/Local/Google/Chrome SxS/User Data", "Chrome"),
        (r"AppData/Local/Microsoft/Edge/User Data", "Edge"),
        (r"AppData/Local/Microsoft/Edge Beta/User Data", "Edge"),
        (r"AppData/Local/Microsoft/Edge Dev/User Data", "Edge"),
        (r"AppData/Local/Microsoft/Edge SxS/User Data", "Edge"),
        (r"AppData/Local/BraveSoftware/Brave-Browser/User Data", "Brave"),
        (r"AppData/Local/BraveSoftware/Brave-Browser-Beta/User Data", "Brave"),
        (r"AppData/Local/BraveSoftware/Brave-Browser-Dev/User Data", "Brave"),
        (r"AppData/Local/BraveSoftware/Brave-Browser-Nightly/User Data", "Brave"),
        (r"AppData/Local/BraveSoftware/Brave-Browser-Beta-Nightly/User Data", "Brave"),
        (r"AppData/Local/DuckDuckGo/Browser/User Data", "DuckDuckGo")):
    # glob.escape: prof is /media/<user>/<NTFS label>/Users/<name>, and a label
    # like "Windows [SSD]" is legal on NTFS but is a character class to glob.
    for bm in glob.glob(os.path.join(glob.escape(os.path.join(prof, base)), "*", "Bookmarks")):
        try:
            with open(bm, encoding="utf-8") as f:
                roots = json.load(f).get("roots", {})
            for r in roots.values():
                if isinstance(r, dict):
                    walk_chrome(r, label)
        except Exception:
            pass

# Best-effort DuckDuckGo path; export is Chromium-derived but not fully stable.
duck_roots = {
    os.path.join(prof, r"AppData/Local/DuckDuckGo"),
    os.path.join(prof, r"AppData/Local/DuckDuckGo/Browser/User Data"),
}
for base in glob.glob(os.path.join(glob.escape(os.path.join(prof, "AppData/Local")), "*")):
    low = os.path.basename(base).lower()
    if "duck" in low or "ddg" in low:
        duck_roots.add(base)
        duck_roots.add(os.path.join(base, "Browser"))
        duck_roots.add(os.path.join(base, "Browser", "User Data"))
        duck_roots.add(os.path.join(base, "User Data"))
for base in duck_roots:
    for bm in glob.glob(os.path.join(glob.escape(base), "*", "Bookmarks")):
        try:
            with open(bm, encoding="utf-8") as f:
                roots = json.load(f).get("roots", {})
            for r in roots.values():
                if isinstance(r, dict):
                    walk_chrome(r, "DuckDuckGo")
        except Exception:
            pass

# Firefox on Windows (places.sqlite; copy out first — NTFS is mounted ro)
for db in glob.glob(os.path.join(prof, r"AppData/Roaming/Mozilla/Firefox/Profiles", "*", "places.sqlite")):
    try:
        tmp = os.path.join(tempfile.mkdtemp(), "places.sqlite")
        shutil.copy(db, tmp)
        con = sqlite3.connect(tmp)
        for title, url in con.execute(
            "SELECT b.title, p.url FROM moz_bookmarks b JOIN moz_places p ON b.fk=p.id "
            "WHERE b.type=1 AND p.url LIKE 'http%'"):
            items.append(("Firefox", title or url, url))
        con.close()
    except Exception:
        pass

seen, rows = set(), []
for folder, title, url in items:
    if url and url not in seen:
        seen.add(url)
        rows.append((folder, title, url))

with open(out, "w", encoding="utf-8") as f:
    f.write("<!DOCTYPE NETSCAPE-Bookmark-file-1>\n<META HTTP-EQUIV=\"Content-Type\" "
            "CONTENT=\"text/html; charset=UTF-8\">\n<TITLE>Bookmarks</TITLE>\n"
            "<H1>Bookmarks from Windows</H1>\n<DL><p>\n")
    cur = None
    for folder, title, url in sorted(rows):
        if folder != cur:
            if cur is not None:
                f.write("</DL><p>\n")
            f.write("<DT><H3>%s</H3>\n<DL><p>\n" % html.escape(folder))
            cur = folder
        f.write('<DT><A HREF="%s">%s</A>\n' % (html.escape(url, quote=True), html.escape(title)))
    if cur is not None:
        f.write("</DL><p>\n")
    f.write("</DL><p>\n")
print("BOOKMARKS=%d" % len(rows))
PYEOF
)
    # The BOOKMARKS= line is printed only after the file is completely written,
    # so its presence and its count are the one honest signal that the export
    # finished with something in it. `[ -s "$OUT" ]` was not: the wrapper HTML
    # above is written before the Python knows whether it found anything, so an
    # empty export passed that test. A zero count, a missing line (python3 absent
    # or dead part-way) or a move that fails all leave the previous export
    # untouched and say nothing, rather than handing the owner import
    # instructions for a file with no bookmarks in it.
    BM=$(printf '%s\n' "$BM" | sed -n 's/^BOOKMARKS=//p')
    SAVED=no
    if [ "${BM:-0}" -gt 0 ] 2>/dev/null && [ -s "$OUTNEW" ] && mv -f "$OUTNEW" "$OUT"; then
        SAVED=yes
    fi
    rm -f "$OUTNEW"
    if [ "$SAVED" = yes ]; then
        echo
        # TRANSLATORS: "Bookmarks > Manage Bookmarks > Import and Backup >
        # Import Bookmarks from HTML" is a path through FIREFOX's own menus.
        # Use the wording Firefox shows in your language, not a literal
        # translation, or the owner will look for a menu item that is not there.
        dg_say "$(eval_gettext 'Bookmarks saved to: $OUT')"
        dg_say "$(gettext "Import them in Firefox:  Bookmarks > Manage Bookmarks >
Import and Backup > Import Bookmarks from HTML.")"
    fi
;; esac

# --- 8. Open tabs and saved passwords ---------------------------------------
WANT_TABS=no; WANT_PWDS=no
WANT_GAMES=no; WANT_DEV=no; WANT_CREATIVE=no; WANT_MAIL=no; WANT_FONTS=no
for c in $CHOICES; do
    [ "$c" = tabs ] && WANT_TABS=yes
    [ "$c" = pwds ] && WANT_PWDS=yes
    [ "$c" = games ] && WANT_GAMES=yes
    [ "$c" = dev ] && WANT_DEV=yes
    [ "$c" = creative ] && WANT_CREATIVE=yes
    [ "$c" = mail ] && WANT_MAIL=yes
    [ "$c" = fonts ] && WANT_FONTS=yes
done

# Mail profiles and font files are opt-in for a reason: the former can contain
# years of private mail, and the latter may carry licenses that do not travel
# with a machine.  Confirm each meaningful expansion explicitly.
if [ "$WANT_MAIL" = yes ]; then
    kdialog --title "$TITLE" --warningyesno "$(gettext "Thunderbird migration copies local mail, contacts, and account settings into a private Dagric migration folder. It does not decrypt or import passwords, but the copied mail can be personal. Continue?")" 2>/dev/null || WANT_MAIL=no
fi
if [ "$WANT_FONTS" = yes ]; then
    kdialog --title "$TITLE" --warningyesno "$(gettext "Only personal Windows fonts will be copied. You are responsible for confirming that each font license permits use on Dagric. Continue?")" 2>/dev/null || WANT_FONTS=no
fi

# Browser metadata is safe and powers the State Pack, so collect it on every
# run.  The helper receives the exact selected categories below; no password or
# tab store is read unless its corresponding checkbox was chosen.
if :; then
    echo
    dg_say "$(gettext "--- browser tabs and logins ---")"
    PRIMARY=""
    if [ "$WANT_PWDS" = yes ]; then
        # A Firefox Primary Password can't be guessed; ask rather than fail.
        if grep -rqs '"encryptedPassword"' \
             "$WINUSER_DIR/AppData/Roaming/Mozilla/Firefox/Profiles" 2>/dev/null; then
            # TRANSLATORS: "Primary Password" is Firefox's own term for the
            # master password — use whatever Firefox calls it in your language.
            PRIMARY=$(kdialog --title "$TITLE" --password \
"$(gettext "If this person set a Primary Password in Firefox, type it so the saved
logins can be unlocked.

Leave it blank if they never set one (most people haven't).")" 2>/dev/null) || PRIMARY=""
        fi
    fi

    # Keep stderr: a failure here must never be reported as "found nothing".
    BROWSER_LOG=$(mktemp -t dagric-migrate-browser.XXXXXX) || exit 1

    # THE PASSWORD GOES DOWN A PIPE, NOT INTO argv.
    #
    # This was `... "$HOME" "$PRIMARY"`, which put the owner's Firefox Primary
    # Password into the helper's command line — and /proc/<pid>/cmdline is
    # world-readable on this system (nothing here sets hidepid). Any other user
    # logged into the same machine, and any unprivileged process, could read it
    # out of `ps aux` for as long as the migration ran. That is the worst
    # possible moment for it: the owner is moving their entire saved-password
    # store across, and Pro is sold to schools and libraries where a second user
    # on the machine is the normal case rather than an edge case.
    #
    # printf rather than echo: the password is arbitrary text and echo would
    # interpret backslashes in it. The trailing newline is what the helper's
    # readline() consumes; a blank line means "no primary password", which is
    # the common case and is handled.
    BROWSER_FLAGS=""
    [ "$WANT_TABS" = yes ] && BROWSER_FLAGS="$BROWSER_FLAGS --tabs"
    [ "$WANT_PWDS" = yes ] && BROWSER_FLAGS="$BROWSER_FLAGS --passwords"
    RES=$(printf '%s\n' "$PRIMARY" \
            | python3 /usr/share/dagric/migrate-browser.py "$WINUSER_DIR" "$HOME" $BROWSER_FLAGS \
            2>"$BROWSER_LOG")
    N_TABS=$(printf '%s\n' "$RES" | sed -n 's/^TABS=//p')
    N_PWDS=$(printf '%s\n' "$RES" | sed -n 's/^PASSWORDS=//p')
    PWNOTE=$(printf '%s\n' "$RES" | sed -n 's/^PWNOTE=//p')
    CHROMEISH=$(printf '%s\n' "$RES" | sed -n 's/^CHROMEISH=//p')
    EXPORTED=$(printf '%s\n' "$RES" | sed -n 's/^EXPORTED=//p')
    EXPORTED_COUNT=$(printf '%s\n' "$RES" | sed -n 's/^EXPORTED_COUNT=//p')
    MIGFAIL=$(printf '%s\n' "$RES" | sed -n 's/^FAILED=//p')
    # No TABS= line at all means the helper died outright rather than reporting.
    #
    # $MIGFAIL is either this sentence or the FAILED= line the Python helper
    # printed. The helper's own text is not translated here — it comes from
    # /usr/share/dagric/migrate-browser.py, which has its own strings; wrapping
    # a value that arrived from another program in gettext() would look up a
    # msgid that is not in the catalogue and change nothing.
    if ! printf '%s\n' "$RES" | grep -q '^TABS='; then
        MIGFAIL=$(gettext "the browser recovery helper did not finish")
    fi
    if [ -n "$MIGFAIL" ]; then
        dg_say "$(eval_gettext 'Some browser data could not be read: $MIGFAIL')"
        [ -s "$BROWSER_LOG" ] && sed 's/^/  /' "$BROWSER_LOG"
    fi
    rm -f "$BROWSER_LOG"

    if [ "$WANT_TABS" = yes ]; then
        if [ "${N_TABS:-0}" -gt 0 ] 2>/dev/null; then
            # eval_ngettext, not eval_gettext: "1 open tabs" is wrong in
            # English and much more wrong in the languages with three or four
            # plural forms. ngettext picks the form from the target language's
            # own Plural-Forms rule in the .po header.
            dg_say "$(eval_ngettext \
                'Recovered $N_TABS open tab -> ~/Windows-open-tabs.html' \
                'Recovered $N_TABS open tabs -> ~/Windows-open-tabs.html' "$N_TABS")"
        elif [ -n "$MIGFAIL" ]; then
            dg_say "$(gettext "No open tabs could be recovered - the session files could not be read.
  A half-written session file (an unclean Windows shutdown) can cause this.")"
        else
            dg_say "$(gettext "No open tabs were found (the browsers may have been closed cleanly).")"
        fi
    fi

    if [ "$WANT_PWDS" = yes ]; then
        if [ "${N_PWDS:-0}" -gt 0 ] 2>/dev/null; then
            dg_say "$(eval_ngettext \
                'Recovered $N_PWDS saved login -> ~/Windows-passwords.csv' \
                'Recovered $N_PWDS saved logins -> ~/Windows-passwords.csv' "$N_PWDS")"
            # TRANSLATORS: a plain-text file of the owner's passwords now
            # exists on disk. "Import it, then delete it" is an instruction,
            # and PLAIN TEXT must stay emphatic.
            dg_say "$(gettext "  This file is PLAIN TEXT and readable only by you.
  Import it, then delete it.")"
        else
            dg_say "$(gettext "No saved Firefox logins were recovered from the Firefox store.")"
            [ -n "$PWNOTE" ] && echo "  ($PWNOTE)"
        fi

        # Chromium-family passwords: be straight about the cryptography.
        if [ "${CHROMEISH:-0}" = 1 ]; then
            if [ -n "$EXPORTED" ]; then
                echo
                if [ "${EXPORTED_COUNT:-0}" -gt 0 ] 2>/dev/null; then
                    dg_say "$(eval_ngettext \
                        'Found $EXPORTED_COUNT exported Chromium-password CSV file:' \
                        'Found $EXPORTED_COUNT exported Chromium-password CSV files:' "$EXPORTED_COUNT")"
                else
                    dg_say "$(gettext "Found Chromium-family exported password CSV file(s):")"
                fi
                printf '%s\n' "$EXPORTED" | tr '|' '\n' | sed 's/^/  /'
            else
                echo
                # TRANSLATORS: the two indented lines are paths through
                # Chrome/Edge/Brave/DuckDuckGo settings on the Windows machine — use
                # the wording those browsers show in your language. The first
                # paragraph explains WHY this cannot work; it is a security
                # property, not an apology, and should not be softened into one.
                dg_say "$(gettext "Chromium-family passwords could NOT be read here:
they are encrypted with a Windows key tied to that Windows account, which
does not exist on this system. That is a security feature, not a fault.

To bring them over, do this ONCE while still in Windows:
   Chrome / Edge / Brave: Passwords > Export
   DuckDuckGo: Settings > Passwords > Export
Save the .csv, then run this migration again - it will pick it up.")"
            fi
        fi
    fi
fi

# --- 8b. Opt-in continuity profiles and inventory --------------------------
# The helper inventories applications on every migration run. Steam libraries,
# game names, and gaming content are inspected only when the gaming checkbox is
# selected. Gaming copies come only from discovered save, screenshot-media, and
# personal controller-layout leaves; known login, session, token, cookie,
# web-cache, authentication, credential, and private-key paths are filtered.
# The filter is deliberately conservative and the local report records skips.
CONT_ARGS=""
[ "$WANT_GAMES" = yes ] && CONT_ARGS="$CONT_ARGS --copy gaming"
[ "$WANT_DEV" = yes ] && CONT_ARGS="$CONT_ARGS --copy developer"
[ "$WANT_CREATIVE" = yes ] && CONT_ARGS="$CONT_ARGS --copy creative"
[ "$WANT_MAIL" = yes ] && CONT_ARGS="$CONT_ARGS --copy mail"
[ "$WANT_FONTS" = yes ] && CONT_ARGS="$CONT_ARGS --copy fonts"
if [ "$WANT_DEV" = yes ]; then
    if kdialog --title "$TITLE" --yesno "$(gettext "Also copy SSH configuration and known-hosts? Private SSH keys will never be copied.")" 2>/dev/null; then
        CONT_ARGS="$CONT_ARGS --ssh-config"
    fi
fi
CONT_LOG=$(mktemp -t dagric-migrate-continuity.XXXXXX) || exit 1
CONT_RES=$(python3 /usr/share/dagric/migrate-continuity.py "$WINUSER_DIR" "$HOME" $CONT_ARGS 2>"$CONT_LOG")
CONT_REPORT=$(printf '%s\n' "$CONT_RES" | sed -n 's/^CONTINUITY_REPORT=//p')
CONT_ERRORS=$(printf '%s\n' "$CONT_RES" | sed -n 's/^CONTINUITY_ERRORS=//p')
if [ -n "$CONT_REPORT" ]; then
    dg_say "$(gettext "Created the Windows app, Steam, and continuity report.")"
else
    dg_say "$(gettext "Continuity report could not be created; your copied files are still safe.")"
    [ -s "$CONT_LOG" ] && sed 's/^/  /' "$CONT_LOG"
fi
rm -f "$CONT_LOG"

# --- 9. Migration State Pack -------------------------------------------------
# A local summary of the way this Windows account was used: non-secret browser
# preferences, standard folders, shortcuts, and recent-work signals.  This does
# not copy Windows programs, credential stores, cookies, or session tokens.
# It remains useful even if the owner did not ask for browser tabs or passwords.
STATE_LOG=$(mktemp -t dagric-migrate-state.XXXXXX) || exit 1
STATE_RES=$(python3 /usr/share/dagric/migrate-state-pack.py "$WINUSER_DIR" \
    "$HOME/Windows-browser-context.json" "$HOME" 2>"$STATE_LOG")
STATE_PACK=$(printf '%s\n' "$STATE_RES" | sed -n 's/^STATE_PACK=//p')
STATE_SHORTCUTS=$(printf '%s\n' "$STATE_RES" | sed -n 's/^STATE_SHORTCUTS=//p')
STATE_RECENT=$(printf '%s\n' "$STATE_RES" | sed -n 's/^STATE_RECENT=//p')
if [ -z "$STATE_PACK" ]; then
    dg_say "$(gettext "Migration State Pack could not be created; your copied files are still safe.")"
    [ -s "$STATE_LOG" ] && sed 's/^/  /' "$STATE_LOG"
else
    dg_say "$(gettext "Created a local Migration State Pack with your folder, shortcut, browser, and recent-work notes.")"
fi
rm -f "$STATE_LOG"

echo
dg_say "$(gettext "=== Migration finished ===")"
# TRANSLATORS: the closing promise of the whole tool — "Windows itself was not
# modified — it was only ever read" is the sentence the owner will remember,
# and the one that decides whether they trust this product. Do not weaken the
# negation.
SUMMARY=$(gettext "Done! Your Windows files are now in your Dagric home folder.

Windows itself was not modified — it was only ever read.")

# EVERY LINE OF THIS SECTION IS EARNED, AND TWO OF THE THREE WERE NOT.
#
# The bookmarks and open-tabs bullets used to be baked into the paragraph above
# and therefore printed on EVERY run. An owner who ticked only Documents and
# Pictures — leaving the browser boxes alone, which is an ordinary thing to do —
# finished the migration and was told to open Firefox, walk a four-step menu and
# import Windows-bookmarks.html and Windows-open-tabs.html. Neither file was
# ever written. They would reach a file picker showing nothing and conclude the
# migration had failed, on the one screen whose job is to tell them it worked.
#
# The passwords bullet below was already conditional on N_PWDS, so the rule was
# understood; these two were simply missed. Same treatment now, keyed off the
# same signals the per-section messages already use:
#
#   SAVED   set only where the bookmark count was positive AND the staged file
#           was non-empty AND the move into place succeeded. Not `-s "$OUT"`,
#           which an earlier bug proved passes on the wrapper HTML alone.
#   N_TABS  the recovered tab count. The section above already prints
#           "No open tabs could be recovered" on zero, so claiming otherwise
#           down here contradicted a message on the same screen.
#
# The header is built with them: with nothing to import, "To finish up, in
# Firefox:" is an instruction to do nothing.
#
# TRANSLATORS: the ▸ chains are menu paths inside FIREFOX; use Firefox's own
# wording in your language rather than translating literally, or the owner will
# hunt for a menu item that is not there. File names (Windows-bookmarks.html,
# Windows-open-tabs.html, Windows-passwords.csv) are literal and must NOT be
# translated — the owner has to find them on disk.
FIREFOX_STEPS=
if [ "${SAVED:-no}" = yes ]; then
    FIREFOX_STEPS="$FIREFOX_STEPS
$(gettext "• Bookmarks — Bookmarks ▸ Manage Bookmarks ▸ Import and Backup ▸
  Import Bookmarks from HTML ▸ Windows-bookmarks.html")"
fi
if [ "${N_TABS:-0}" -gt 0 ] 2>/dev/null; then
    FIREFOX_STEPS="$FIREFOX_STEPS
$(gettext "• Open tabs — import Windows-open-tabs.html the same way; they arrive as a
  bookmark folder you can 'Open All in Tabs'")"
fi

SUMMARY_DLG=--msgbox
if [ -n "$COPY_FAILED" ]; then
    # TRANSLATORS: shown only when at least one folder did not copy completely.
    # It sits ABOVE the "Done!" paragraph and has to contradict it, so lead with
    # the negation and keep it first. "Do NOT delete anything from Windows" is
    # the whole point of this block: an owner who believes the copy worked may
    # reclaim the Windows partition next. "Windows itself was still only ever
    # read" keeps the product's central promise intact on the failure path — the
    # copy went wrong, the Windows installation did not.
    SUMMARY="$(gettext "⚠ NOT everything was copied.

Some folders did not copy completely — read the messages above, free up disk
space or check the drive, then run Migration again. Do NOT delete anything
from Windows until it has finished cleanly.

Windows itself was still only ever read; nothing there was changed.")

$SUMMARY"
    # And not a plain msgbox either: an owner who is one click away from wiping
    # their Windows partition must not get the icon a clean run would have given.
    SUMMARY_DLG=--error
fi

if [ "${N_PWDS:-0}" -gt 0 ] 2>/dev/null; then
    # TRANSLATORS: a warning that a plain-text password file is sitting in the
    # owner's home folder. "Delete it once imported" must survive translation.
    FIREFOX_STEPS="$FIREFOX_STEPS
$(gettext "• Passwords — open Windows-passwords.csv and import into one place:
  Firefox: Passwords ▸ ⋯ ▸ Import from a File
  Chromium browsers: Settings ▸ Passwords ▸ Import
  Windows-passwords.csv is standard CSV (name, url, username, password)

⚠ Windows-passwords.csv is PLAIN TEXT. Delete it once imported.")"
fi

# Appended LAST so it lands below the failure warning when there is one, and
# only when at least one bullet was earned above.
CONTEXT_FILE="$HOME/Windows-browser-context.json"
if [ -f "$CONTEXT_FILE" ]; then
    FIREFOX_STEPS="$FIREFOX_STEPS
$(gettext "• Continuity profile helper — open Windows-browser-context.json and use it as a checklist
  to restore startup pages, search engine choices, and enabled extensions.")
"
fi
if [ -n "$STATE_PACK" ] && [ -f "$STATE_PACK" ]; then
    FIREFOX_STEPS="$FIREFOX_STEPS
$(gettext "• Restore Migration Notes — run Restore Migration Notes from the launcher (or dagric-restore-assistant)
  to open a safe checklist for browser setup, shortcuts, and recent work patterns.")"
fi
if [ -n "$CONT_REPORT" ] && [ -f "$CONT_REPORT" ]; then
    FIREFOX_STEPS="$FIREFOX_STEPS
$(gettext "• Windows app and continuity report — open Dagric-Continuity-Report.html for reinstall plans,
  Steam inventory, and a record of every selected profile copy.")"
fi

if [ -n "$FIREFOX_STEPS" ]; then
    SUMMARY="$SUMMARY

$(gettext "To finish up:")$FIREFOX_STEPS"
fi

kdialog --title "$TITLE" "$SUMMARY_DLG" "$SUMMARY" 2>/dev/null
