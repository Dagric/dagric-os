#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — "Finish setting up this PC". A friendly checklist for the few
# optional things that can't ship on by default (proprietary graphics drivers,
# HP printer/scanner support). Codecs, VPN, scanners, and firmware updates are
# already installed in the base system, so they're not here.
. /usr/bin/dagric-i18n.sh

# The two konsole windows below run their own `sh -c` script, and the text they
# print has to be translated in THIS process and handed over as a POSITIONAL
# PARAMETER — never pasted into the quoted script text. A msgstr is data written
# by a translator: a French translation containing an apostrophe would close the
# single-quoted script early, and one containing $( ) would be a command
# substitution — running as root, under pkexec, in the HP branch. Passed as $1
# and $2 it is only ever an argument to printf, and nothing can be read out of it.
CLOSE=$(gettext "Press Enter to close...")
HPDONE=$(gettext "HP support installed. Add your printer in System Settings > Printers.")
# There has to be a failure line, because there was no way to say "it didn't
# work": the branch below printed HPDONE unconditionally, so an owner whose apt
# run failed was told HP support was installed and went looking for a printer
# that was never going to appear. Passed positionally like the other two, for
# the reason in the paragraph above.
HPFAIL=$(gettext "HP support could NOT be installed — see the messages above. Check your internet connection and try again from the Hub.")

# The tags ("drivers", "hp", "flathub") are NOT translated — they are the values
# kdialog hands back and the case below matches on. Only the labels are.
CHOICES=$(kdialog --title "$(gettext "Finish setting up Dagric")" --geometry 480x260 \
--separate-output --checklist \
"$(gettext "Pick what to set up — run this again anytime from the Hub:")" \
"drivers"  "$(gettext "NVIDIA graphics driver")"        off \
"hp"       "$(gettext "HP printer and scanner support")" off \
"flathub"  "$(gettext "Enable Flathub in Discover")"     on \
2>/dev/null) || exit 0

[ -n "$CHOICES" ] || exit 0

for c in $CHOICES; do
    case "$c" in
        drivers)
            # Route through dagric-drivers for the NVIDIA-detect + Secure Boot
            # / MOK-enrollment handling (avoids a black screen on SB laptops).
            konsole -e sh -c \
'pkexec /usr/bin/dagric-drivers; \
printf "%s" "$1"; read x' sh "$CLOSE" & ;;
        hp)
            # The success line used to be sequenced with `;`, so it printed
            # whether or not apt had worked. Branch on the actual exit status.
            konsole -e pkexec sh -c \
'if apt-get update && apt-get install -y hplip; then \
  echo; printf "%s\n" "$1"; \
else \
  echo; printf "%s\n" "$3"; \
fi; \
printf "%s" "$2"; read x' sh "$HPDONE" "$CLOSE" "$HPFAIL" & ;;
        flathub)
            flatpak remote-add --if-not-exists flathub \
                https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
            kdialog --passivepopup \
                "$(gettext "Flathub enabled — browse apps in Discover.")" 5 2>/dev/null & ;;
    esac
done
