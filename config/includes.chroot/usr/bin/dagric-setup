#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — "Finish setting up this PC". A friendly checklist for the few
# optional things that can't ship on by default (proprietary graphics drivers,
# HP printer/scanner support). Codecs, VPN, scanners, and firmware updates are
# already installed in the base system, so they're not here.
. /usr/bin/dagric-i18n.sh

# The two konsole windows below run their own `sh -c` script, and the text they
# print has to be translated in THIS process and handed over as a POSITIONAL
# PARAMETER — never pasted into the quoted script text. A msgstr is data written
# by a translator: a French translation containing an apostrophe would close the
# single-quoted script early, and one containing $( ) would be a command
# substitution — running as root, under pkexec, in the HP branch. Passed as $1
# and $2 it is only ever an argument to printf, and nothing can be read out of it.
CLOSE=$(gettext "Press Enter to close...")
HPDONE=$(gettext "HP support installed. Add your printer in System Settings > Printers.")
# There has to be a failure line, because there was no way to say "it didn't
# work": the branch below printed HPDONE unconditionally, so an owner whose apt
# run failed was told HP support was installed and went looking for a printer
# that was never going to appear. Passed positionally like the other two, for
# the reason in the paragraph above.
HPFAIL=$(gettext "HP support could NOT be installed — see the messages above. Check your internet connection and try again from the Hub.")

# The tags ("drivers", "hp", "flathub") are NOT translated — they are the values
# kdialog hands back and the case below matches on. Only the labels are.
CHOICES=$(kdialog --title "$(gettext "Finish setting up Dagric")" --geometry 480x260 \
--separate-output --checklist \
"$(gettext "Pick what to set up — run this again anytime from the Hub:")" \
"drivers"  "$(gettext "NVIDIA graphics driver")"        off \
"hp"       "$(gettext "HP printer and scanner support")" off \
"flathub"  "$(gettext "Enable Flathub in Discover")"     on \
2>/dev/null) || exit 0

[ -n "$CHOICES" ] || exit 0

for c in $CHOICES; do
    case "$c" in
        drivers)
            # Route through dagric-drivers for the NVIDIA-detect + Secure Boot
            # / MOK-enrollment handling (avoids a black screen on SB laptops).
            konsole -e sh -c \
'pkexec /usr/bin/dagric-drivers; \
printf "%s" "$1"; read x' sh "$CLOSE" & ;;
        hp)
            # The success line used to be sequenced with `;`, so it printed
            # whether or not apt had worked. Branch on the actual exit status.
            #
            # DPkg::Lock::Timeout IS NOT TUNING, IT IS THE RACE FIX. Every
            # ticked task in this loop is launched in the background, so an
            # owner who ticks "NVIDIA graphics driver" as well — an NVIDIA
            # machine with an HP all-in-one is an ordinary configuration, and
            # the two boxes sit next to each other — gets two apt transactions
            # at once, because dagric-drivers runs its own apt-get update and
            # install. apt is single-instance, so the loser died immediately on
            # "Could not get lock /var/lib/apt/lists/lock" and printed HPFAIL,
            # which blames an internet connection that was working fine and
            # tells the owner to retry from the Hub — the one thing that cannot
            # help until the other install has finished. The option makes apt
            # WAIT for the lock instead of failing, and it is honoured by apt's
            # generic GetLock(), so it covers the lists lock here and not just
            # the dpkg/frontend one.
            konsole -e pkexec sh -c \
'if apt-get -o DPkg::Lock::Timeout=600 update && apt-get -o DPkg::Lock::Timeout=600 install -y hplip; then \
  echo; printf "%s\n" "$1"; \
else \
  echo; printf "%s\n" "$3"; \
fi; \
printf "%s" "$2"; read x' sh "$HPDONE" "$CLOSE" "$HPFAIL" & ;;
        flathub)
            # BRANCH ON THE ACTUAL EXIT STATUS, for the same reason the HP
            # branch above documents — this was the last of the three that
            # still sequenced its success message unconditionally.
            #
            # remote-add is not a local config edit: it DOWNLOADS the
            # .flatpakrepo file over the network, and run unprivileged it needs
            # a polkit authorisation to touch the system-wide installation. So
            # it fails on no network and on a cancelled password prompt, and
            # `|| true` plus an unconditional popup told the owner the app
            # store was open before sending them to a Discover with nothing new
            # in it — from which the only reasonable conclusion is that the
            # software centre is broken.
            #
            # Not a theoretical path: 0400-flathub.hook.chroot adds the remote
            # at build time but warns "could not add Flathub remote (no network
            # in chroot?) — continuing", so an ISO can genuinely ship without
            # it. That is exactly the machine where this branch does the real
            # work, and exactly the machine where the old line lied. The box is
            # ticked on by default, so every owner runs it.
            if flatpak remote-add --if-not-exists flathub \
                https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null; then
                kdialog --passivepopup \
                    "$(gettext "Flathub enabled — browse apps in Discover.")" 5 2>/dev/null &
            else
                # TRANSLATORS: shown when enabling Flathub did not work. It
                # names BOTH causes on purpose — this cannot tell a network
                # failure from a cancelled password prompt, so it must not
                # diagnose one of them and send the owner off to fix the wrong
                # thing.
                kdialog --passivepopup \
                    "$(gettext "Flathub could NOT be enabled — you may be offline, or the password prompt was cancelled. Try again anytime from the Hub.")" 8 2>/dev/null &
            fi ;;
    esac
done
