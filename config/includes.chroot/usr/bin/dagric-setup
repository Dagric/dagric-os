#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — "Finish setting up this PC". A friendly checklist for the few
# optional things that can't ship on by default (proprietary graphics drivers,
# HP printer/scanner support). Codecs, VPN, scanners, and firmware updates are
# already installed in the base system, so they're not here.
CHOICES=$(kdialog --title "Finish setting up Dagric" --geometry 480x260 \
--separate-output --checklist \
"Pick what to set up — run this again anytime from the Hub:" \
"drivers"  "NVIDIA graphics driver"        off \
"hp"       "HP printer and scanner support" off \
"flathub"  "Enable Flathub in Discover"     on \
2>/dev/null) || exit 0

[ -n "$CHOICES" ] || exit 0

for c in $CHOICES; do
    case "$c" in
        drivers)
            # Route through dagric-drivers for the NVIDIA-detect + Secure Boot
            # / MOK-enrollment handling (avoids a black screen on SB laptops).
            konsole -e sh -c \
'pkexec /usr/bin/dagric-drivers; \
printf "Press Enter to close..."; read x' & ;;
        hp)
            konsole -e pkexec sh -c \
'apt-get update && apt-get install -y hplip; \
echo; echo "HP support installed. Add your printer in System Settings > Printers."; \
printf "Press Enter to close..."; read x' & ;;
        flathub)
            flatpak remote-add --if-not-exists flathub \
                https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
            kdialog --passivepopup "Flathub enabled — browse apps in Discover." 5 2>/dev/null & ;;
    esac
done
