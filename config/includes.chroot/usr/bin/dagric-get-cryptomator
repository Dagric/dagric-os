#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install Cryptomator, on request.
# Cryptomator (open source, GPL) encrypts your files into a vault BEFORE they
# ever reach a cloud folder (Drive, Dropbox, OneDrive, etc.), so the provider
# only ever sees ciphertext. Zero-knowledge, on-brand for a private OS.
# Installed from the already-enabled Flathub as a per-user Flatpak (no root).
. /usr/bin/dagric-i18n.sh

dg_say "$(gettext "Dagric — install Cryptomator (encrypt before the cloud)

Cryptomator creates encrypted vaults that live inside your normal cloud
folders. Your files are encrypted on your machine first, so Google, Dropbox,
or anyone else only ever stores scrambled data. You hold the only key.
From Flathub.")"

printf '\n%s ' "$(gettext "Install Cryptomator now? [y/N]")"
read ans
if ! dg_is_yes "$ans"; then
    dg_say "$(gettext "No changes made.")"
    exit 0
fi

flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
if flatpak install --user -y --noninteractive flathub org.cryptomator.Cryptomator; then
    echo; dg_say "$(gettext "Cryptomator installed — launch it from the application launcher.")"
else
    echo; dg_say "$(gettext "Install did not complete. Check your network and try again.")"
fi
