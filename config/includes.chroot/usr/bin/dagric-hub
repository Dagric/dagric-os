#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — the Hub. One friendly place that gathers every owner tool
# (drivers, setup, security, guide, and the Pro creator/gaming/AI helpers)
# so they're discoverable from the launcher instead of hidden on the CLI.
# Edition-aware: Pro-only tools appear only on Pro. Nothing here changes the
# system without the owner picking it and confirming.
EDITION=$(cat /etc/dagric-edition 2>/dev/null || echo free)

# Build the menu: pairs of "tag" "label". Pro adds creator tools.
set -- \
    setup    "Finish setting up this PC" \
    migrate  "Migrate from Windows — bring your files and bookmarks" \
    looks    "Dagric Looks — change your desktop layout" \
    style    "Dagric Styles — colors, wallpaper, effects in one click" \
    variety  "Rotating wallpapers — install Variety (optional)" \
    drivers  "Graphics drivers — install the NVIDIA driver" \
    security "Security Checkup — score this system's hardening" \
    guide    "Welcome & User Guide"
if [ "$EDITION" = "pro" ]; then
    set -- "$@" \
        vm          "Windows in a window — set up virtual machines" \
        usbprotect  "USB protection — block unknown USB devices" \
        bottles     "Run Windows apps — install Bottles" \
        localsend   "Share files privately — install LocalSend" \
        cryptomator "Encrypt before the cloud — install Cryptomator" \
        upscayl     "AI image upscaler (offline) — install Upscayl" \
        joplin      "Notes that stay yours — install Joplin" \
        onlyoffice  "The familiar Office look — install ONLYOFFICE" \
        steam       "Install Steam (Valve's game store)" \
        heroic      "Install Heroic (Epic / GOG / Amazon games)" \
        protonup    "Install ProtonUp-Qt (manage Proton/Wine versions)" \
        gaming      "Gaming extras — install Proton-GE for Steam" \
        ai          "Local AI — install Ollama (runs on your hardware)" \
        resolve     "DaVinci Resolve — guided install"
fi

CHOICE=$(kdialog --title "Dagric Hub" --icon dagric-logo \
    --menu "Welcome to Dagric. What would you like to do?" "$@" 2>/dev/null) || exit 0
[ -n "$CHOICE" ] || exit 0

# Run a terminal helper in konsole and hold the window open afterwards.
run_term() {
    konsole -e sh -c "$1"' ; echo ; printf "Press Enter to close..." ; read x' &
}

case "$CHOICE" in
    setup)    dagric-setup & ;;
    migrate)  run_term '/usr/bin/dagric-migrate' ;;
    vm)       run_term '/usr/bin/dagric-vm' ;;
    usbprotect) dagric-usb-protect & ;;
    joplin)     run_term '/usr/bin/dagric-get-joplin' ;;
    variety)    run_term '/usr/bin/dagric-get-variety' ;;
    onlyoffice) run_term '/usr/bin/dagric-get-onlyoffice' ;;
    looks)    dagric-looks & ;;
    style)    dagric-style & ;;
    security) dagric-security-checkup & ;;
    guide)    exec firefox file:///usr/share/dagric/welcome/index.html ;;
    drivers)   run_term 'pkexec /usr/bin/dagric-drivers' ;;
    bottles)     run_term '/usr/bin/dagric-get-bottles' ;;
    localsend)   run_term '/usr/bin/dagric-get-localsend' ;;
    cryptomator) run_term '/usr/bin/dagric-get-cryptomator' ;;
    upscayl)     run_term '/usr/bin/dagric-get-upscayl' ;;
    steam)    run_term '/usr/bin/dagric-get-steam' ;;
    heroic)   run_term '/usr/bin/dagric-get-heroic' ;;
    protonup) run_term '/usr/bin/dagric-get-protonup' ;;
    gaming)   run_term '/usr/bin/dagric-gaming' ;;
    ai)       run_term '/usr/bin/dagric-ai' ;;
    resolve)  run_term '/usr/bin/dagric-get-resolve' ;;
esac
