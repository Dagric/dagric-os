#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — the Hub. One friendly place that gathers every owner tool
# (drivers, setup, security, guide, and the Pro creator/gaming/AI helpers)
# so they're discoverable from the launcher instead of hidden on the CLI.
# Edition-aware: Pro-only tools appear only on Pro. Nothing here changes the
# system without the owner picking it and confirming.
. /usr/bin/dagric-i18n.sh

EDITION=$(cat /etc/dagric-edition 2>/dev/null || echo free)

# The live USB, detected the same way dagric-firstrun does it. Used for exactly
# one thing below: the wording of the hardware-check row, which is a decision
# ("should I install this?") before the install and a diagnostic ("why is there
# no Wi-Fi?") afterwards. It is NOT used to hide the row — see below.
LIVE=no
[ -d /run/live/medium ] && LIVE=yes

# The text the konsole helpers print before waiting. It is looked up HERE, in
# this process, and handed to the sub-shell as a positional parameter — never
# pasted into the quoted script text. A msgstr is data written by a translator:
# a French translation containing an apostrophe would close the single-quoted
# script early. As an argument to printf it can only ever be printed.
CLOSE=$(gettext "Press Enter to close...")

# The two lines the upgrade row prints around `dagric-upgrade --check`. They
# were hardcoded English inside that row's quoted script text — the only
# user-visible string in this file that did not go through gettext, so a German
# owner picked a fully translated row and got an English-only terminal. They are
# looked up HERE and handed to the sub-shell positionally for exactly the reason
# given above: a translation must never be pasted into quoted script text.
U_CHECK=$(gettext "Checking whether this machine can move to the next Dagric release.")
# TRANSLATORS: "sudo dagric-upgrade" is a command typed verbatim — do not
# translate it, and keep the two spaces before it.
U_HOWTO=$(gettext "To perform the upgrade when you are ready, run:  sudo dagric-upgrade")

# Build the menu: pairs of "tag" "label", grouped into sections. Rows whose
# tag starts with "_" are section headers — picking one just reopens the Hub.
# Pro appends its own sections below the free ones.
#
# TAGS ARE NEVER TRANSLATED. kdialog hands the tag back and the `case` at the
# bottom matches on it, so a translated tag is a row that silently does
# nothing. Only the labels go through gettext. Every tag added here needs a
# matching case arm; a tag without one is a dead button that looks alive.
#
# The six leading spaces are indentation, not text, so they stay OUTSIDE the
# gettext call — a translator should never be handed a string whose leading
# whitespace is load-bearing.
#
# A few labels are bare product names (Steam, ProtonUp-Qt, DaVinci Resolve).
# Those are deliberately NOT wrapped: a brand is the same word in every
# language, and putting one in the catalogue only invites it to be "improved".

# TRANSLATORS: a section heading in the Dagric Hub menu. The ── dashes are
# decoration that pads the row to a comfortable width; re-cut them to whatever
# length your words need. The row width is not load-bearing.
H_START=$(gettext "──  Get started  ──────────────────")
# TRANSLATORS: section heading — see the note on "Get started". Decoration only.
H_LOOKS=$(gettext "──  Appearance  ───────────────────")
# TRANSLATORS: section heading — see the note on "Get started". Decoration only.
H_SYSTEM=$(gettext "──  System  ───────────────────────")
# TRANSLATORS: section heading — see the note on "Get started". Decoration only.
H_APPS=$(gettext "──  Add more apps  ────────────────")
# TRANSLATORS: section heading — see the note on "Get started". Decoration only.
H_LEARN=$(gettext "──  Learn and get help  ───────────")

# The hardware check reads differently either side of an install, so it says
# something different. Before the install it answers the question that decides
# whether there is a sale at all; after it, the same report is what someone
# pastes into a support request. One label cannot do both honestly.
if [ "$LIVE" = yes ]; then
    # TRANSLATORS: Hub row, live USB only. This is shown BEFORE anything is
    # installed and it is the question the person is actually asking.
    L_HWCHECK=$(gettext "Check this PC — will Dagric work here?")
else
    # TRANSLATORS: Hub row, installed system. Same tool as the live-USB row
    # above, worded as the diagnostic it becomes once Dagric is on the disk.
    L_HWCHECK=$(gettext "Check this PC — Wi-Fi, graphics, disk, Secure Boot")
fi

set -- \
    _start   "$H_START" \
    hwcheck  "      $L_HWCHECK" \
    firstrun "      $(gettext "Set up Dagric (welcome wizard)")" \
    setup    "      $(gettext "Finish setup — drivers, printers")" \
    migrate  "      $(gettext "Migrate from Windows")" \
    _looks   "$H_LOOKS" \
    gallery  "      $(gettext "Appearance gallery")" \
    display  "      $(gettext "Text size and night light")" \
    looks    "      $(gettext "Desktop layout")" \
    style    "      $(gettext "Colors and mood")" \
    variety  "      $(gettext "Rotating wallpapers")" \
    _system  "$H_SYSTEM" \
    drivers  "      $(gettext "NVIDIA driver")" \
    security "      $(gettext "Security Checkup")" \
    access   "      $(gettext "Accessibility — screen reader, keyboard and mouse help")"

# THE UPGRADE ROW IS FOR INSTALLED MACHINES ONLY.
#
# On the live USB there is nothing to upgrade: the session runs from the stick
# and is gone at power-off. Offering it there is a button that can only
# disappoint, and its pre-flight would fail for reasons that read as breakage on
# a system that is working perfectly. Same /run/live/medium test the Hub already
# uses to decide the hardware-check wording above.
#
# Inserted before the Learn section rather than appended, so it stays inside the
# System group where an owner would look for it.
if [ "$LIVE" != yes ]; then
    set -- "$@" upgrade "      $(gettext "Check for a new Dagric version")"
fi

# The route from free to Pro without a reinstall. Free editions only, and not on
# the live stick — an upgrade there would be written to memory and lost at
# shutdown, which is the one place this offer would take money for nothing.
#
# Sits in the System group beside the version check rather than at the top,
# deliberately. A free machine is a finished product and this is not an upsell
# banner; it is where you look when you have already decided.
if [ "$EDITION" != "pro" ] && [ "$LIVE" != yes ]; then
    set -- "$@" topro "      $(gettext "Upgrade to Pro — already bought it?")"
fi

set -- "$@" \
    _learn   "$H_LEARN" \
    userguide "      $(gettext "User guide — your first week")" \
    manual   "      $(gettext "App manual — every program explained")" \
    guide    "      $(gettext "Welcome page — what Dagric promises")" \
    support  "      $(gettext "Get help — contact a human")" \
    _apps    "$H_APPS" \
    steam       "      Steam" \
    heroic      "      $(gettext "Heroic — Epic, GOG, Amazon")" \
    protonup    "      ProtonUp-Qt" \
    gaming      "      $(gettext "Proton-GE for Steam")" \
    bottles     "      $(gettext "Windows apps — Bottles")" \
    onlyoffice  "      $(gettext "Office suite — ONLYOFFICE")" \
    joplin      "      $(gettext "Private notes — Joplin")" \
    localsend   "      $(gettext "Local sharing — LocalSend")" \
    cryptomator "      $(gettext "Cloud encryption — Cryptomator")" \
    upscayl     "      $(gettext "Image upscaler — Upscayl")" \
    resolve     "      DaVinci Resolve" \
    ai          "      $(gettext "Local AI — Ollama")"
# Pro adds only what Pro actually INSTALLS. The line is mechanical, not
# marketing: a helper that just fetches a free app from Flathub, Debian or
# upstream works identically on both editions, so it ships on both. The two
# below are different in kind — dagric-vm enables the KVM/QEMU/virt-manager
# stack and dagric-usb-protect arms USBGuard, and those packages are Pro-only,
# so on free these rows would be buttons that cannot work.
#
# This block used to hold all fourteen helpers. That shipped a free edition
# which DOCUMENTED Steam, Bottles, Heroic and Resolve in its own manual and
# then offered no way to reach any of them — the exact "free feels broken"
# failure the project forbids — while the thing being gated was a script that
# runs `apt install steam`. Steam is free; gating the convenience of installing
# it behind $39 protected no revenue and made the gate look petty. Pro's value
# is that the creator and gaming stacks are already installed and tuned, not
# that free users are forbidden to download things.
if [ "$EDITION" = "pro" ]; then
    set -- "$@" \
        _windows "$(gettext "──  Windows and security  ─────────")" \
        vm          "      $(gettext "Windows in a VM")" \
        usbprotect  "      $(gettext "USB protection")"
fi

# THE HARDWARE CHECK IS ON BOTH THE LIVE USB AND THE INSTALLED SYSTEM, on
# purpose, and that is the less obvious of the two choices — the tool was
# written to be run before an install.
#
# It stays after the install for three reasons. Its launcher entry
# (dagric-hardware-check.desktop) is unconditional, so hiding the row here
# would give the Hub and the application menu two different answers about
# whether the tool exists — the kind of inconsistency that makes a nervous
# owner think something is broken. Its report is the support artifact: "run
# Check This PC and send me the report" is the first thing anyone answering a
# question needs, and it cannot be the first thing they ask for if the tool is
# only on a USB stick the owner has since reformatted. And the single most
# common post-install complaint from this audience — "there is no Wi-Fi" — is
# exactly what the tool diagnoses, naming the missing firmware file and saying
# whether it is on the disc. Only the wording changes; see LIVE above.

# A comfortable initial size; taller on Pro, which has one more section.
# Both numbers are "chrome plus roughly 14px per row" — the ratio these sizes
# have always encoded. Free draws 33 rows and Pro 36, counting the five section
# headings, which occupy a line each even though they cannot be chosen.
# Guessing short only adds a scrollbar; guessing tall only adds whitespace.
# Re-derive it if you add another row.
#
# The width went 440 -> 500 when the labels started being translated. German
# runs roughly 30% longer than English and "Accessibility — screen reader,
# keyboard and mouse help" is the longest row in the file at 56 characters;
# kdialog treats geometry as a hint and honours widget minimums, so 440 would
# not have truncated anything — it would have quietly grown the window past the
# number written here and made this comment a lie.
#
# That row was "…screen reader, magnifier, contrast" until the label was
# corrected: it named two things kcm_access does not contain. The replacement
# is SEVEN CHARACTERS LONGER, so it is still the row this width is sized for
# and 500 still holds. Checked rather than assumed — a relabel that quietly
# became the new longest row would be exactly the way this comment turns into
# the lie it warns about.
# +28 for the "Learn and get help" section: its own heading plus the new
# "Get help — contact a human" row, at the ~14px per row this has always used.
# The three documentation rows MOVED there from "Get started" rather than being
# added, so they are already counted above.
GEOM=500x760
[ "$EDITION" = "pro" ] && GEOM=500x805

CHOICE=$(kdialog --title "Dagric Hub" --icon dagric-logo --geometry "$GEOM" \
    --menu "$(gettext "What would you like to do?")" "$@" 2>/dev/null) || exit 0
[ -n "$CHOICE" ] || exit 0

# Run a terminal helper in konsole and hold the window open afterwards.
#
# Two different "$1"s, and the difference matters. The one in double quotes is
# expanded by THIS shell and becomes the command text. The one inside the
# single quotes survives as literal text into the sub-shell, where it is that
# shell's first positional parameter — i.e. $CLOSE, passed after the `sh`
# placeholder that becomes its $0. The translated string therefore never
# appears in the script text, only in its argument list.
run_term() {
    konsole -e sh -c "$1"' ; echo ; printf "%s" "$1" ; read x' sh "$CLOSE" &
}

case "$CHOICE" in
    _*)       exec /usr/bin/dagric-hub ;;
    hwcheck)  dagric-hardware-check & ;;
    firstrun) dagric-firstrun & ;;
    setup)    dagric-setup & ;;
    migrate)  run_term '/usr/bin/dagric-migrate' ;;
    vm)       run_term '/usr/bin/dagric-vm' ;;
    usbprotect) dagric-usb-protect & ;;
    joplin)     run_term '/usr/bin/dagric-get-joplin' ;;
    variety)    run_term '/usr/bin/dagric-get-variety' ;;
    onlyoffice) run_term '/usr/bin/dagric-get-onlyoffice' ;;
    gallery)  dagric-appearance & ;;
    display)  dagric-display & ;;
    looks)    dagric-looks & ;;
    style)    dagric-style & ;;
    security) dagric-security-checkup & ;;
    # --check only, and in a terminal on purpose. It reports whether this
    # machine could take the next Debian and what would stop it, without
    # changing anything — the actual upgrade is typed deliberately with sudo,
    # because a release upgrade is not a thing to start from a menu click.
    upgrade)  konsole -e sh -c 'printf "%s\n\n" "$1"; sudo /usr/bin/dagric-upgrade --check; printf "\n%s\n" "$2"; echo; printf "%s" "$3"; read x' sh "$U_CHECK" "$U_HOWTO" "$CLOSE" & ;;
    # Run directly rather than with --check: the tool asks for the purchase and
    # confirms before it changes anything, so a second confirmation here would
    # just be a door in front of a door. $CLOSE is passed as a parameter, never
    # pasted into the quoted script — a translator's apostrophe would close the
    # single quote early, which is the reasoning recorded at the top of this file.
    topro)    konsole -e sh -c 'sudo /usr/bin/dagric-upgrade-to-pro; echo; printf "%s" "$1"; read x' sh "$CLOSE" & ;;
    # kcm_access is the one page that gathers the screen reader, the magnifier,
    # sticky/slow/bounce keys and the visible bell. It is reached this way
    # rather than through dagric-accessibility.desktop because that file is
    # written by 0530-accessibility.hook.chroot at build time, and a Hub row
    # should not depend on a hook having run.
    access)   systemsettings kcm_access & ;;
    # THREE different documents, which is why the labels above spell out which
    # is which. They used to read "Welcome guide" and "App manual", while the
    # launcher carried an entry called "Welcome Guide" that opened a third
    # thing — the user guide, which had no Hub row at all.
    #
    #   welcome/  what Dagric is and the promises it makes (one page)
    #   guide/    the first week: updates, printers, Wi-Fi, shortcuts
    #   manual/   95 pages, one per application, searchable by Windows name
    #
    # None is a bare firefox call. Each wrapper picks the owner's language
    # (welcome/de/, guide/de/), and dagric-manual also passes the edition
    # marker through, which is what makes the manual's "not on this edition"
    # notes correct. Hardcoding a path here was how the Hub became the one
    # door that always opened English.
    guide)     exec /usr/bin/dagric-welcome ;;
    userguide) dagric-guide & ;;
    manual)   dagric-manual & ;;
    # The one row that leaves the machine.
    #
    # The audit found that nothing in the operating system reached a person: the
    # support page promises "a human reads every message", and the OS answered
    # with three offline documents and then stopped. An owner whose problem was
    # not in the manual had to remember the website's name from memory — on a
    # computer that may be the reason they cannot get online.
    #
    # So this opens the support page, and it is deliberately the LAST row of the
    # help section rather than the first: the guide and the manual answer most
    # questions offline and instantly, and sending somebody to a web form before
    # they have looked at either is worse service, not better.
    support)  xdg-open "https://dagric.com/support" >/dev/null 2>&1 & ;;
    drivers)   run_term 'pkexec /usr/bin/dagric-drivers' ;;
    bottles)     run_term '/usr/bin/dagric-get-bottles' ;;
    localsend)   run_term '/usr/bin/dagric-get-localsend' ;;
    cryptomator) run_term '/usr/bin/dagric-get-cryptomator' ;;
    upscayl)     run_term '/usr/bin/dagric-get-upscayl' ;;
    steam)    run_term '/usr/bin/dagric-get-steam' ;;
    heroic)   run_term '/usr/bin/dagric-get-heroic' ;;
    protonup) run_term '/usr/bin/dagric-get-protonup' ;;
    gaming)   run_term '/usr/bin/dagric-gaming' ;;
    ai)       run_term '/usr/bin/dagric-ai' ;;
    resolve)  run_term '/usr/bin/dagric-get-resolve' ;;
esac
