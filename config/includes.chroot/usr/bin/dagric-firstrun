# =============================================================== the catalogue
{
    printf '{\n'
    printf '  "edition": "%s",\n'     "$(jesc "$EDITION")"
    printf '  "editionName": "%s",\n' "$(jesc "$EDITION_NAME")"
    printf '  "live": %s,\n'          "$LIVE"
    printf '  "reducedMotion": %s,\n' "$REDUCED_MOTION"
    printf '  "scaleMode": "%s",\n'   "$(jesc "$SCALE_MODE")"
    printf '  "currentScale": %s,\n'  "$(current_scale)"
    printf '  "currentMode": "%s",\n' "$(current_mode)"
    printf '  "currentWall": "%s",\n' "$(jesc "$(current_wall_id)")"
    printf '  "currentAccent": "%s",\n'    "$(jesc "$(current_accent_id)")"
    printf '  "currentAccentHex": "%s",\n' "$(jesc "$(current_accent_hex)")"
    printf '  "hasDisplayTool": %s,\n' "$HAS_DISPLAY_TOOL"
    printf '  "hasWindows": %s,\n'    "$HAS_WINDOWS"
    printf '  "wallpapers": [\n'
    emit_walls
    printf '\n  ],\n'
    printf '  "accents": [\n'
    emit_accents
    printf '\n  ],\n'
    printf '  "layouts": [\n'
    emit_layouts
    printf '\n  ],\n'
    printf '  "strings": {\n'
    emit_strings
    printf '\n  }\n}\n'
} > "$CATALOG"

# =============================================================== run the window
# Same environment as Dagric Appearance, and for the same reasons: console.log()
# from QML lands on stderr so stderr is merged into the pipe; QT_MESSAGE_PATTERN
# strips Qt's "qml: " prefix; QT_LOGGING_RULES makes sure a stray user setting
# cannot silence the protocol; the Basic control style is always present and is
# fully restyled by main.qml, so the wizard looks the same whichever theme is
# being applied underneath it; and QML_XHR_ALLOW_FILE_READ is what lets the
# window read the catalogue at all — without it Qt refuses the local-file
# request and the wizard comes up empty. It applies to this process only, and
# the only local file the window ever asks for is the catalogue just written.
#
# QT_LINUX_ACCESSIBILITY_ALWAYS_ON is the one that is easy to delete by
# accident, because nothing visibly changes when it goes. Qt only builds an
# application's accessible tree if D-Bus org.a11y.Status.IsEnabled was true
# when the process started, or if this variable is set. This wizard AUTOSTARTS
# at first login — before anyone has had a chance to switch a screen reader on,
# and quite possibly before the a11y bus exists at all — so without this line
# it is born mute and stays mute for its whole life, and every accessible name,
# role and announcement in firstrun/main.qml is unreachable. It is set for this
# process only; the session-wide equivalent is deliberately conditional, see
# /usr/lib/systemd/user-environment-generators/60-dagric-accessibility.
QT_MESSAGE_PATTERN='%{message}'
QT_LOGGING_RULES='qml.debug=true'
QT_QUICK_CONTROLS_STYLE=Basic
QML_XHR_ALLOW_FILE_READ=1
QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
export QT_MESSAGE_PATTERN QT_LOGGING_RULES QT_QUICK_CONTROLS_STYLE QML_XHR_ALLOW_FILE_READ
export QT_LINUX_ACCESSIBILITY_ALWAYS_ON

last_wall=
# The downloads step's queue: a comma list of app names and a 0/1 for the Pro
# upgrade, both re-validated here — the window's list is a wish, this file's
# whitelist is the decision.
APPS_QUEUE=
TOPRO=0
DOWNLOADS_RAN=0

# Nothing is launched here to fix the title-bar icon any more, and that is the
# point. Two rounds of work went into a python helper that rewrote the window's
# _NET_WM_ICON from outside after it appeared; it worked, and it was aimed at a
# session almost nobody gets. Both display servers ask KWin the same question
# now and 0540-qml-identity.hook.chroot answers it before the window exists.

# Did the window ever actually open?
#
# The check at the top of this file only catches a MISSING qml6. If qml6 exists
# and then fails at runtime — a Qt module absent from the image, no display to
# connect to, a QML parse error — this pipeline produces no protocol lines, the
# loop below never runs a single iteration, and the script exits 0. The owner
# clicked "Set Up Dagric" and nothing happened at all. Meanwhile fallback_wizard,
# a complete kdialog version of this wizard, sat a hundred lines up unreachable,
# written for exactly this case.
#
# A marker FILE and not a shell variable: the right-hand side of a pipeline runs
# in a subshell, so anything the loop assigns is gone by the time it ends.
#
# A normal run always speaks — main.qml sends DONE on finish and QUIT on close —
# so "no protocol line at all" is a clean signal that the window never came up.
# The one false positive is a wizard force-killed with SIGKILL, which skips the
# QUIT and would then show the kdialog version. That is the right trade: an
# annoyance for somebody who deliberately killed it, against nothing whatsoever
# for somebody whose image cannot run Qt.
QML_SPOKE="${XDG_RUNTIME_DIR:-/tmp}/.dagric-firstrun-spoke.$$"
rm -f "$QML_SPOKE"

"$QML" "$QMLFILE" -- "--catalog=$CATALOG" 2>&1 | while IFS= read -r line; do
    case "$line" in
        *@DAGRIC@*) msg=${line#*@DAGRIC@}; : > "$QML_SPOKE" ;;
        *) continue ;;
    esac
    cmd=${msg%%|*}
    arg=
    case "$msg" in *\|*) arg=${msg#*|} ;; esac
    case "$arg" in *[!A-Za-z0-9._,-]*) arg= ;; esac

    case "$cmd" in
        READY)
            stamp
            ;;
        MODE)
            case "$arg" in light|dark) : ;; *) continue ;; esac
            capture_base
            set_mode "$arg"
            ;;
        ACCENT)
            rgb=$(lookup_accent "$arg")
            [ -n "$rgb" ] || continue
            capture_base
            set_accent "$rgb"
            ;;
        WALL)
            [ -n "$(lookup_wall "$arg")" ] || continue
            capture_base
            set_wall "$arg"
            last_wall=$arg
            ;;
        SCALE)
            case "$arg" in 100|125|150) : ;; *) continue ;; esac
            capture_scale
            set_scale "$arg"
            ;;
        LAYOUT)
            file=$(lookup_layout "$arg")
            [ -n "$file" ] && [ -f "$file" ] || continue
            capture_panels || true
            set_layout "$file"
            ;;
        RUN)
            case "$arg" in migrate|display|hub|guide|manual|welcome|setup) run_helper "$arg" ;; esac
            ;;
        APPS)
            # Stored, not acted on. Validation happens in run_downloads at
            # Finish; an unknown name is simply never emitted into the runner.
            APPS_QUEUE=$arg
            ;;
        TOPRO)
            case "$arg" in 1) TOPRO=1 ;; *) TOPRO=0 ;; esac
            ;;
        UNDO)
            undo_all
            last_wall=
            ;;
        DONE)
            # The one apply that is repeated. The wallpaper lives in
            # plasmashell's in-memory applet config, so a plasmashell restart
            # part-way through the wizard (dagric-brand-launcher does exactly
            # that on a first login) can swallow it. Writing it once more at
            # the end is invisible when it already stuck and rescues it when it
            # did not. The taskbar is deliberately NOT re-applied: rebuilding
            # the panels is visible, and a flicker on the last screen would
            # look like something went wrong.
            [ -n "$last_wall" ] && set_wall "$last_wall"
            notify "$(gettext "Dagric is set up. Everything else lives in the Dagric Hub.")"
            # The queued downloads, now that the fullscreen window is gone and
            # a terminal can actually be seen.
            run_downloads
            DOWNLOADS_RAN=1
            ;;
        QUIT)
            : ;;
    esac
done

# A ticked queue that never ran must not vanish without a witness. This fires
# on every exit that skipped DONE — "I'll do this later", Esc, Alt+F4, a
# crash — because the UI names Finish as the trigger and running installs on
# an exit the owner chose would be worse than dropping them. The notification
# is the honest middle: nothing happened, and here is where the same buttons
# live.
if [ "$DOWNLOADS_RAN" != 1 ] && { [ -n "$APPS_QUEUE" ] || [ "$TOPRO" = 1 ]; }; then
    notify "$(gettext "Setup closed before Finish, so nothing you ticked was installed. Everything is still one click away in the Dagric Hub.")"
fi

if [ ! -e "$QML_SPOKE" ]; then
    # The window never said a word, so it never opened. Give the owner the
    # kdialog wizard rather than the silence they were getting.
    rm -f "$QML_SPOKE"
    fallback_wizard
    exit 0
fi
rm -f "$QML_SPOKE"
