#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — DaVinci Resolve installation guide.
# Dagric has not obtained permission to redistribute Resolve, so it is not
# preinstalled. This opens Blackmagic's official download and current terms.
# Kdenlive is preinstalled if you want to start editing right now.
. /usr/bin/dagric-i18n.sh

# TRANSLATORS: the four indented lines are COMMANDS the owner types verbatim
# into a terminal — cd, unzip, sudo and the file names must not be translated
# or reflowed, or the instructions stop working. The last paragraph is a
# LICENCE statement (Dagric has not obtained redistribution permission and
# does not bundle Resolve); keep that meaning exact. "DaVinci Resolve",
# "Blackmagic", "NVIDIA" and "Dagric" are names.
dg_say "$(gettext "DaVinci Resolve on Dagric OS
==============================
1. Visit  https://www.blackmagicdesign.com/products/davinciresolve
   (opening it in your browser now if possible...)
2. Click \"Free Download\", pick the Linux version, and register.
3. Unzip the download, then run the installer:
       cd ~/Downloads
       unzip DaVinci_Resolve_*_Linux.zip
       sudo ./DaVinci_Resolve_*_Linux.run
4. NVIDIA users: run  sudo dagric-drivers  first — Resolve on Linux
   performs best with the proprietary driver.

Why isn't it preinstalled? Dagric has not obtained permission to redistribute
Resolve. This helper opens Blackmagic's official download and current terms.")"

command -v xdg-open >/dev/null 2>&1 && \
    xdg-open "https://www.blackmagicdesign.com/products/davinciresolve" 2>/dev/null || true
