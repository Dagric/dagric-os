#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — move this machine to the next Debian release, carefully.
#
# WHY THIS EXISTS. Debian has no `do-release-upgrade`. The supported route is a
# document: edit sources.list, apt update, apt upgrade, apt full-upgrade, read
# the release notes, hope. That is a fine instruction for a sysadmin and a
# terrible one for the person this OS is sold to — someone who left Windows
# because it kept asking them to make decisions they had no way to evaluate.
#
# The site now tells buyers security support runs to 2028 with LTS to 2030. That
# promise is only honest if there is a way OFF trixie before it ends, and the
# honest answer today is "reinstall", which for an owner with five years of files
# is not an answer at all.
#
# WHAT THIS IS NOT. It is not magic and it does not pretend a release upgrade is
# risk-free. It is a wrapper that does the things a careful person would do in
# the right order, refuses to start when the machine is not in a state to
# survive it, and leaves a way back.
#
# THE SAFETY MODEL, in order:
#   1. Refuse outright if anything is already broken — half-configured packages,
#      no disk space, on battery, a foreign release already half-applied.
#   2. Take a snapshot FIRST, and refuse to continue if one cannot be taken.
#      snapper + grub-btrfs ship on every edition, so "roll back from the boot
#      menu" is a real escape hatch rather than advice.
#   3. Download everything BEFORE changing anything. A release upgrade
#      interrupted by a dropped connection midway is the classic way to end up
#      with an unbootable machine.
#   4. Rebuild DKMS modules and the initramfs, and SAY SO if a module failed —
#      an NVIDIA module that did not rebuild is a black screen on next boot, and
#      the owner should hear it now while the old kernel still works.
#
# Not run automatically, ever. A release upgrade is a decision.
set -e

# NOT sourcing dagric-i18n.sh, deliberately. This tool defines its own say() and
# uses no gettext, so the include bought nothing — and it actively broke the
# script: `.` is a POSIX SPECIAL BUILTIN, so failing to find the file exits the
# shell immediately and `|| true` does not catch it. The whole tool died at line
# three, printing nothing, on any machine where that file was missing. Silent
# death from a defensive-looking line is the exact shape this codebase keeps
# finding; the fix is to not have the line.
#
# The consequence, stated: this tool is English-only while the rest of Dagric
# speaks five languages. A release upgrade is a rare, deliberate, root-only act
# and the strings here are long and technical; translating them is worth doing,
# but not at the cost of a fragile include.

# The release this image was built against, and the one it moves to. Bump BOTH
# when rebasing Dagric onto a newer Debian, in the same commit as auto/config.
FROM_SUITE="trixie"
TO_SUITE="forky"
FROM_NAME="Debian 13"
TO_NAME="Debian 14"

say() { printf '%s\n' "$*"; }
die() { printf 'STOPPED: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run this as root:  sudo dagric-upgrade"

DRY=no
[ "$1" = "--check" ] && DRY=yes

say "Dagric OS — upgrade from $FROM_NAME to $TO_NAME"
say "==============================================="
say ""

# ---------------------------------------------------------------- pre-flight
# Every one of these is a real way a release upgrade goes wrong, and every one
# is cheaper to catch now than halfway through.
fail=0

# 1. Are we actually on the release we think we are? A machine already part-way
#    through an upgrade, or rebased by hand, must not be pushed further.
if [ -r /etc/debian_version ]; then
    cur=$(cat /etc/debian_version 2>/dev/null)
    case "$cur" in
        13*|"$FROM_SUITE"*) : ;;
        *) say "  ! this machine reports Debian version '$cur', not $FROM_NAME"
           say "    an upgrade from an unexpected state is how machines break"
           fail=1 ;;
    esac
fi

# 1b. IS THE TARGET RELEASE ACTUALLY RELEASED? This is the check that matters
#     most, and the first version of this tool did not have it.
#
#     TO_SUITE is a codename, and a codename exists on the mirror long before it
#     is a stable release — forky has been sitting there as `testing` for the
#     whole of trixie's life. Without this gate, running this tool on the day it
#     shipped would have passed every other check, taken a snapshot, rewritten
#     sources, and moved a non-technical owner's only computer onto Debian
#     TESTING: a rolling suite with no security team behind it, which breaks
#     regularly and by design. That is the worst outcome this tool could produce
#     and it would have looked like a success the whole way.
#
#     The Release file settles it. Debian publishes Suite: stable only once a
#     codename is the released stable. Verified against the live mirror while
#     writing this: trixie is "Suite: stable, Version: 13.6"; forky is
#     "Suite: testing".
#
#     FAILS CLOSED. No network, no fetch tool, or an unreadable Release file all
#     stop the upgrade. Being unable to prove the target is stable is not the
#     same as it being stable, and the cost of guessing wrong here is somebody's
#     computer.
say "  .. checking whether $TO_NAME has been released"
REL_URL="https://deb.debian.org/debian/dists/${TO_SUITE}/Release"
REL=""
if command -v curl >/dev/null 2>&1; then
    REL=$(curl -fsSL --max-time 30 "$REL_URL" 2>/dev/null || true)
elif command -v wget >/dev/null 2>&1; then
    REL=$(wget -qO- --timeout=30 "$REL_URL" 2>/dev/null || true)
fi
if [ -z "$REL" ]; then
    say "  ! could not reach the Debian mirror to check whether $TO_NAME is out"
    say "    (no internet, or no curl/wget). Not upgrading on an assumption."
    fail=1
elif printf '%s\n' "$REL" | grep -qE '^Suite:[[:space:]]*stable[[:space:]]*$'; then
    RELVER=$(printf '%s\n' "$REL" | sed -n 's/^Version:[[:space:]]*//p' | head -1)
    say "  ok  $TO_NAME is released${RELVER:+ (Debian $RELVER)}"
else
    # NOT A FAILURE, AND IT MUST NOT LOOK LIKE ONE.
    #
    # For most of this release's life the honest answer to "is there a new
    # version?" is simply "not yet". Routing that through the pre-flight failure
    # path ended the run with "STOPPED: pre-flight checks did not pass", which
    # is the sentence an owner reads as "something on my computer is broken" —
    # and it would have been the ONLY thing the Hub row ever said for the two
    # years before Debian 14 ships. Nothing is wrong, so nothing should sound
    # wrong. Exit clean and say what is actually true.
    ACTUAL=$(printf '%s\n' "$REL" | sed -n 's/^Suite:[[:space:]]*//p' | head -1)
    say ""
    say "You are on the newest version of Dagric OS."
    say ""
    say "  $FROM_NAME is current and fully supported. $TO_NAME has not been"
    say "  released yet${ACTUAL:+ (Debian is still building it as '$ACTUAL')}."
    say ""
    say "  There is nothing to do and nothing is wrong. Check back after"
    say "  $TO_NAME is released — this tool will offer the upgrade by itself"
    say "  once it is safe to take."
    exit 0
fi

# 2. dpkg must be in a clean state. Upgrading on top of a half-configured
#    package turns one broken package into a broken system.
if dpkg -C 2>/dev/null | grep -q .; then
    say "  ! some packages are half-installed or half-configured"
    say "    fix first:  sudo dpkg --configure -a  &&  sudo apt-get -f install"
    fail=1
else
    say "  ok  package database is consistent"
fi

# 3. Disk space. A full-upgrade downloads and unpacks the whole userland; the
#    classic failure is running out during unpack, with dpkg mid-transaction.
avail_mb=$(df -Pm / | awk 'NR==2{print $4}')
if [ "${avail_mb:-0}" -lt 8000 ]; then
    say "  ! only ${avail_mb} MB free on / — a release upgrade needs several GB"
    say "    free some space first (try:  dagric-security-checkup, or empty Trash)"
    fail=1
else
    say "  ok  ${avail_mb} MB free on /"
fi

# 4. Mains power. Losing power mid-unpack is the single most destructive thing
#    that can happen here, and laptops are most of this audience.
if [ -d /sys/class/power_supply ]; then
    on_ac=unknown
    for ps in /sys/class/power_supply/A*/online /sys/class/power_supply/AC*/online; do
        [ -r "$ps" ] || continue
        [ "$(cat "$ps")" = "1" ] && on_ac=yes || on_ac=no
    done
    if [ "$on_ac" = "no" ]; then
        say "  ! this machine is on battery — plug it in before upgrading"
        fail=1
    elif [ "$on_ac" = "yes" ]; then
        say "  ok  running on mains power"
    fi
fi

# 5. Snapshots. This is the escape hatch; without it there is no way back, and
#    this tool will not proceed blind.
CAN_SNAPSHOT=no
if command -v snapper >/dev/null 2>&1 && \
   findmnt -no FSTYPE / 2>/dev/null | grep -q btrfs && \
   snapper -c root list >/dev/null 2>&1; then
    CAN_SNAPSHOT=yes
    say "  ok  snapshots available — a rollback point can be taken"
else
    say "  ! snapshot rollback is not available on this machine"
    say "    (not a btrfs install, or snapper is not configured)"
    say "    back up your files before continuing — there is no automatic way back"
fi

# 6. Third-party apt sources. These are the most common cause of a broken
#    release upgrade: a repository built for the old release, still enabled,
#    offering packages that conflict with the new one.
say ""
THIRD=""
for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    [ -r "$f" ] || continue
    case "$f" in *dagric*) continue ;; esac
    if grep -qE '^\s*(deb|URIs:)' "$f" 2>/dev/null && \
       ! grep -qiE 'deb\.debian\.org|security\.debian\.org|ftp\.[a-z]+\.debian\.org' "$f" 2>/dev/null; then
        THIRD="$THIRD $f"
    fi
done
if [ -n "$THIRD" ]; then
    say "  ! third-party package sources are enabled:"
    for f in $THIRD; do say "      $f"; done
    say "    These are built for $FROM_NAME and are the most common cause of a"
    say "    failed upgrade. Disable them, upgrade, then re-enable what still"
    say "    has a $TO_NAME version."
    fail=1
else
    say "  ok  only Debian and Dagric package sources are enabled"
fi

say ""
if [ "$fail" -ne 0 ]; then
    die "pre-flight checks did not pass. Nothing has been changed."
fi
say "Pre-flight checks passed."

if [ "$DRY" = yes ]; then
    say ""
    say "--check only; nothing was changed. Run without --check to upgrade."
    exit 0
fi

# ---------------------------------------------------------------- consent
#
# THE CONSENT SCREEN MUST DESCRIBE THIS MACHINE, NOT THE HAPPY PATH.
#
# It used to promise "A snapshot is taken before anything changes" to everyone,
# unconditionally — including ext4 installs, where check 5 has already found
# that no snapshot is possible. The owner then typed UPGRADE on the strength of
# a guarantee of reversibility that did not apply to them, the snapshot block
# below was skipped in silence, and every failure path afterwards told them to
# pick a boot-menu snapshot that had never been taken. A false assurance of
# reversibility attached to an irreversible whole-userland replacement is the
# worst thing this file could have done, and the header at the top of it
# describes the behaviour that was intended: refuse rather than proceed blind.
cat <<EOF

This will move the machine from $FROM_NAME to $TO_NAME. It downloads
everything first, then installs. Expect it to take a while and to need a
reboot at the end.

EOF

if [ "$CAN_SNAPSHOT" = yes ]; then
    cat <<'EOF'
A snapshot is taken before anything changes, so a bad outcome is recoverable
from the boot menu.

EOF
    printf 'Type UPGRADE to continue: '
    read -r ans
    [ "$ans" = "UPGRADE" ] || { say "Nothing changed."; exit 0; }
else
    # A different word on purpose. Typing UPGRADE here would be the same gesture
    # as the safe path, and this is not the same decision.
    cat <<'EOF'
THIS MACHINE HAS NO ROLLBACK.

Snapshots need a btrfs root, and this install does not have one. If the upgrade
goes wrong there is no way to put the machine back the way it is now — not from
the boot menu, not with this tool. Recovering would mean reinstalling and
restoring your files from a backup you made yourself.

Back up anything you cannot lose BEFORE continuing.

EOF
    printf 'Type NO-ROLLBACK to continue anyway, or press Enter to stop: '
    read -r ans
    [ "$ans" = "NO-ROLLBACK" ] || { say "Nothing changed. That was the safe answer."; exit 0; }
fi

# ---------------------------------------------------------------- snapshot
if [ "$CAN_SNAPSHOT" = yes ]; then
    say ""
    say "Taking a rollback snapshot..."
    # NO --cleanup-algorithm, deliberately. Tagging this "number" enters it into
    # the NUMBER_LIMIT budget that dagric-snapshot-setup sets (4-10), so the one
    # snapshot an owner might need weeks later — after a release upgrade quietly
    # broke something — is eligible for automatic deletion by the next few apt
    # runs. The first-boot baseline is left untagged for exactly this reason and
    # says so; a pre-upgrade rollback point deserves the same treatment.
    if snapper -c root create -d "before upgrade to $TO_NAME" \
                              -t single >/dev/null 2>&1; then
        say "  snapshot taken — it is in the boot menu under Dagric snapshots"
        say "  (kept permanently; delete it yourself once you are happy)"
    else
        die "could not take a snapshot, and this tool will not upgrade without one.
    Back up your files and upgrade by hand if you accept the risk."
    fi
fi

# Every recovery message below is built from this, so none of them can offer a
# snapshot to a machine that never took one. The old text said "choose a Dagric
# snapshot from the boot menu" unconditionally — advice that is actively harmful
# on ext4, because it sends a frightened owner hunting for a menu entry that does
# not exist instead of telling them what will actually help.
if [ "$CAN_SNAPSHOT" = yes ]; then
    RECOVER="    Reboot and choose a Dagric snapshot from the boot menu to go back."
else
    RECOVER="    This machine has no snapshots, so there is no automatic way back.
    Your files are untouched by the upgrade itself."
fi

# ---------------------------------------------------------------- sources
say ""
say "Pointing package sources at $TO_NAME..."
BAK="/var/backups/dagric-upgrade-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BAK"
cp -a /etc/apt/sources.list "$BAK/" 2>/dev/null || true
cp -a /etc/apt/sources.list.d "$BAK/" 2>/dev/null || true
say "  previous sources saved in $BAK"

# Only Debian's own suites are rewritten. Dagric's channel is left alone — it is
# a single suite that tracks whatever Dagric is built on, and rewriting it would
# point at a suite that may not exist yet.
for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    [ -w "$f" ] || continue
    case "$f" in *dagric*) continue ;; esac
    sed -i "s/\b${FROM_SUITE}\b/${TO_SUITE}/g" "$f" 2>/dev/null || true
done
say "  sources now point at $TO_SUITE"

# ---------------------------------------------------------------- download
say ""
say "Downloading everything before changing anything..."
say "(this is the slow part; nothing is installed yet, and it is safe to stop here)"
# BOTH of these are guarded, and the restore is a command rather than a hint.
#
# `apt-get update` was bare. Under `set -e` a failed update — a dropped
# connection, an unsigned or expired Release, one 404 index — killed the script
# on that line, so the `|| die` on the NEXT line never ran and the owner saw raw
# apt errors and nothing else. Sources had already been rewritten by then, so
# the machine sat with /etc/apt pointing at the new suite while still running
# the old one. Discover and apt then offer the entire next-release package set
# as ordinary "updates", and the owner's next routine click performs a partial
# release upgrade with none of the staging, snapshotting or DKMS rebuilding
# this tool exists to provide. That is a worse state than never having started.
#
# "restore them from $BAK" was also not an instruction a non-technical owner can
# act on — it names a directory and leaves them to work out that BOTH
# sources.list and the whole sources.list.d directory have to go back.
RESTORE_HINT="Put your old package sources back with this one command:

    sudo cp -a $BAK/sources.list /etc/apt/ && sudo rm -rf /etc/apt/sources.list.d && sudo cp -a $BAK/sources.list.d /etc/apt/ && sudo apt-get update

Your machine is still $FROM_NAME and still works."

apt-get update || die "could not read the new package lists — nothing was installed.

$RESTORE_HINT"
apt-get -y --download-only full-upgrade || die "download failed — nothing was installed.

$RESTORE_HINT"
say "  download complete"

# ---------------------------------------------------------------- install
say ""
say "Installing. Do not power off."
DEBIAN_FRONTEND=noninteractive \
  apt-get -y -o Dpkg::Options::=--force-confdef \
              -o Dpkg::Options::=--force-confold full-upgrade \
  || die "the upgrade did not finish cleanly.
$RECOVER
    Or try:  sudo dpkg --configure -a  &&  sudo apt-get -f install"

apt-get -y --purge autoremove || true

# ---------------------------------------------------------------- rebuild
# PUT THE PRODUCT'S IDENTITY BACK. base-files OWNS /usr/lib/os-release.
#
# 0100-identity.hook.chroot writes Dagric's branding into that file at build
# time, but it is a plain packaged file rather than a conffile — so dpkg
# replaces it during the release upgrade WITHOUT prompting, and says nothing.
# The machine comes back up calling itself "Debian GNU/Linux", with the KDE
# crash handler, About This System, and every "report a bug" link pointing at
# Debian instead of dagric.com, and the logo gone. The owner paid for Dagric and
# an upgrade would quietly hand them stock Debian.
#
# Rewritten here from the same fields the build hook uses, with DEBIAN_VERSION
# following the release we just moved to. Keep this block and
# 0100-identity.hook.chroot in step: if one gains a field, so does the other.
say ""
say "Restoring Dagric branding (the upgrade replaces it with Debian's)..."
NEWDEB=$(sed -n 's/^VERSION_ID="\([0-9]*\)".*/\1/p' /usr/lib/os-release 2>/dev/null | head -1)
cat > /usr/lib/os-release <<EOF
NAME="Dagric OS"
PRETTY_NAME="Dagric OS 1.0 (Foundation)"
ID=dagric
ID_LIKE=debian
VERSION="1.0 (Foundation)"
VERSION_ID="1.0"
VERSION_CODENAME=foundation
DEBIAN_VERSION="${NEWDEB:-14} (${TO_SUITE})"
HOME_URL="https://dagric.com"
SUPPORT_URL="https://dagric.com/support"
BUG_REPORT_URL="https://dagric.com/bugs"
LOGO=dagric-logo
EOF
ln -sf ../usr/lib/os-release /etc/os-release
printf 'Dagric OS 1.0 \\n \\l\n\n' > /etc/issue 2>/dev/null || true
say "  done"

# AND REPOINT AUTOMATIC SECURITY UPDATES, or the block above silently ends them.
#
# 0300-hardening.hook.chroot writes /etc/apt/apt.conf.d/52dagric-unattended with
# the Debian codename hardcoded into all four Origins-Pattern lines, precisely
# because the rebrand above makes ${distro_codename} resolve to "foundation" so
# every stock pattern misses. That file is created by a build hook and owned by
# no package, so dpkg leaves it untouched through the whole full-upgrade — still
# naming $FROM_SUITE, a suite this machine is no longer on. Coverage then drops
# to zero: unattended-upgrade keeps running on its timer, matches nothing, exits
# 0, and never applies another security update, on a product whose central
# promise is silent security updates. The hook's own comment says to bump those
# codenames when rebasing onto a newer Debian; a release upgrade IS that rebase,
# performed here on the owner's machine, and the bump was missing.
#
# Matching "codename=$FROM_SUITE" rather than the bare word is deliberate: it
# rewrites trixie-security and trixie-updates correctly as a side effect, and
# cannot touch anything else in the file.
UU=/etc/apt/apt.conf.d/52dagric-unattended
if [ -w "$UU" ]; then
    sed -i "s/codename=${FROM_SUITE}/codename=${TO_SUITE}/g" "$UU" 2>/dev/null || true
    if grep -q "codename=${TO_SUITE}" "$UU" 2>/dev/null; then
        say "  automatic security updates now follow $TO_SUITE"
    else
        say "  ! could not repoint automatic security updates at $TO_SUITE"
        say "    edit $UU by hand: replace $FROM_SUITE with $TO_SUITE"
    fi
fi

# The two things that decide whether the machine boots and shows a picture.
say ""
say "Rebuilding kernel modules and the boot image..."
DKMS_BAD=""
if command -v dkms >/dev/null 2>&1; then
    dkms autoinstall >/dev/null 2>&1 || true
    # ASK ABOUT THE KERNEL WE ARE ABOUT TO BOOT, not about everything dkms has
    # ever built. `dkms status` prints one line per (module, kernel) pair that
    # has a build state — so when autoinstall fails to build against the NEW
    # kernel, dkms emits NO line for it at all and the old kernel's "installed"
    # line is all that remains. `grep -vi installed` over the whole list then
    # matched nothing, DKMS_BAD stayed empty, and this printed "Upgrade
    # complete" on exactly the case safety-model item 4 above promises to warn
    # about: reboot into the new kernel with no NVIDIA module and a black
    # screen, with the snapshot and old-kernel advice below left unreachable.
    NEWK=$(ls -1 /lib/modules 2>/dev/null | sort -V | tail -1)
    DKMS_BAD=$(dkms status -k "$NEWK" 2>/dev/null | grep -vi 'installed' | head -3)
    if [ -z "$DKMS_BAD" ] && dkms status 2>/dev/null | grep -q . \
       && ! dkms status -k "$NEWK" 2>/dev/null | grep -qi 'installed'; then
        DKMS_BAD="a kernel module is registered but was not built for kernel $NEWK"
    fi
fi
update-initramfs -u -k all >/dev/null 2>&1 || say "  ! initramfs rebuild reported a problem"
if command -v update-grub >/dev/null 2>&1; then
    update-grub >/dev/null 2>&1 || say "  ! GRUB update reported a problem"
fi
say "  done"

# ---------------------------------------------------------------- report
say ""
say "==============================================="
if [ -n "$DKMS_BAD" ]; then
    say "WARNING — a kernel module did not rebuild:"
    printf '%s\n' "$DKMS_BAD" | sed 's/^/    /'
    say ""
    say "If that is the NVIDIA driver, the screen may come up on the open-source"
    say "driver after reboot, or not at all. Re-run  sudo dagric-drivers  once"
    say "you are back on the desktop."
    if [ "$CAN_SNAPSHOT" = yes ]; then
        say "If the screen stays black, reboot and pick a Dagric snapshot from the"
        say "boot menu — the machine as it was is still there."
    else
        say "If the screen stays black, boot the previous kernel from the GRUB"
        say "Advanced options menu, which still has the old modules."
    fi
else
    say "Upgrade complete. Reboot when ready:  sudo reboot"
fi
say ""
if [ "$CAN_SNAPSHOT" = yes ]; then
    say "If anything is wrong after the reboot, the snapshot taken before this"
    say "upgrade is in the boot menu under Dagric snapshots."
else
    say "This machine had no snapshots, so there is no automatic way back. If"
    say "something is wrong, the previous kernel is still in the GRUB Advanced"
    say "options menu, and support is at https://dagric.com/support."
fi
