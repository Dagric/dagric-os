#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — gaming compatibility upgrades, on request.
# Installs the community Proton-GE build (extra codecs, game fixes that
# land weeks before upstream) into Steam's compatibility tools folder.
set -e
. /usr/bin/dagric-i18n.sh

# TRANSLATORS: "wine setup.exe" and "dagric-get-steam" are commands typed
# verbatim. Wine, winetricks, gamemode, mangohud, Vulkan, Proton, Proton-GE,
# Steam and GloriousEggroll are product names — leave them all as they are.
dg_say "$(gettext "Dagric gaming setup
=====================
Already preinstalled on Dagric Pro:
  * Wine + winetricks       run Windows apps:  wine setup.exe
  * gamemode + mangohud     performance governor + FPS overlay
  * 32-bit Vulkan           ready for Proton's Windows games

Steam itself is NEVER bundled (it is proprietary) — install it any time
with one click from the Dagric Hub, or run:  dagric-get-steam

This helper adds Proton-GE (GloriousEggroll's community Proton with
extra media codecs and game-specific fixes) for a Steam you've installed.")"
dg_live_warn
# THESE TWO USED TO BE `exit`, AND THAT PUT THE GAMEMODE OFFER OUT OF REACH.
#
# The only place in the entire product that offers to add the owner to the
# "gamemode" group is at the bottom of this file, and both of these paths left
# before ever reaching it. So /etc/gamemode.ini's renice=10 — the thing that
# actually makes GameMode do something — stayed inert for anyone who plays
# through Lutris, Heroic, Bottles or plain Wine, all of which Pro ships. To be
# offered the group at all you had to own Steam, have launched it once, AND then
# say yes to a Proton-GE download you may have had no interest in.
#
# A flag rather than moving the block, deliberately. Moving it would mean
# rewording "One more thing:", which changes the msgid, which silently drops
# that string back to English in all five shipped languages — a mistake already
# made twice in this tree. The Proton-GE work is skipped exactly as before and
# every message is untouched; the run simply continues instead of ending.
#
# The failure exits further down (download failed, archive damaged) are left as
# they are: those are genuine errors, and stopping is the right answer there.
DO_PROTON=yes

printf '%s ' "$(gettext "Download the latest Proton-GE from GitHub? [y/N]")"
read -r answer
if ! dg_is_yes "$answer"; then
    dg_say "$(gettext "Nothing changed.")"
    DO_PROTON=no
fi

# Use the real Steam data dir, not ~/.steam/root (a symlink Steam creates
# on first launch — mkdir'ing it there can collide with Steam's own setup).
DEST="$HOME/.local/share/Steam/compatibilitytools.d"
if [ "$DO_PROTON" = yes ] && [ ! -d "$HOME/.local/share/Steam" ]; then
    dg_say "$(gettext "Steam data dir not found. Launch Steam once first, then re-run this.")"
    DO_PROTON=no
fi

if [ "$DO_PROTON" = yes ]; then
mkdir -p "$DEST"
URL=$(curl -fsSL https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest \
      | grep browser_download_url | grep '\.tar\.gz"' | head -1 | cut -d '"' -f 4)
if [ -z "$URL" ]; then
    dg_say "$(gettext "Could not find the latest release (offline?). Try again later.")"
    exit 1
fi
dg_say "$(eval_gettext 'Downloading: $URL')"

# Download, verify, stage, and only then move it in. This was
# `curl -fL "$URL" | tar xz -C "$DEST"`, which is wrong three times over:
#   * tar extracts as the bytes arrive, so a connection that drops at 80% left a
#     HALF-WRITTEN GE-Proton directory sitting in Steam's compatibilitytools.d.
#     Steam lists that as an installed Proton version, and it fails the moment a
#     game selects it — with nothing to suggest the download was the cause.
#   * the pipeline reports tar's exit status, not curl's, so a failed download
#     could still look like a success.
#   * the "Installed to ..." line below printed unconditionally either way.
TMP=$(mktemp) || exit 1
if ! curl -fL "$URL" -o "$TMP"; then
    rm -f "$TMP"
    dg_say "$(gettext "Download failed — nothing was installed. Check your connection and try again.")"
    exit 1
fi

# Unpack into a staging directory first, so a truncated or corrupt archive never
# reaches the folder Steam reads.
STAGE=$(mktemp -d) || { rm -f "$TMP"; exit 1; }
if ! tar xzf "$TMP" -C "$STAGE"; then
    rm -rf "$TMP" "$STAGE"
    dg_say "$(gettext "The download was damaged and could not be unpacked — nothing was installed.")"
    exit 1
fi
rm -f "$TMP"
mv "$STAGE"/* "$DEST"/ || {
    rm -rf "$STAGE"
    dg_say "$(gettext "Could not move the unpacked files into Steam's folder — nothing was installed.")"
    exit 1
}
rm -rf "$STAGE"

echo ""
dg_say "$(eval_gettext 'Installed to $DEST')"
# TRANSLATORS: "Settings", "Compatibility" and "Properties" are Steam's own
# menu labels — use the words Steam shows in your language, if you know them.
dg_say "$(gettext "In Steam: Settings > Compatibility > enable, then pick the GE-Proton
version per game under Properties > Compatibility.")"
fi
# ^ closes `if [ "$DO_PROTON" = yes ]`. The block above is deliberately NOT
# re-indented: it is unchanged, working code, and shifting forty lines sideways
# would bury a one-line behavioural change in a diff nobody can read.

# GameMode's renice does nothing unless the owner is in the "gamemode" group.
#
# Debian ships the daemon and creates the group, and adds nobody to it — so
# /etc/gamemode.ini's renice=10 is inert on a stock Pro image and GameMode
# quietly achieves little beyond inhibiting the screensaver. That is a feature
# named on the Pro page that the buyer cannot observe.
#
# Offered HERE rather than done at build time on purpose. Adding a user to a
# group that grants scheduling privileges is a real change to their machine, and
# this is the moment they have already said yes to gaming — so it is a question
# with context rather than something that happened to them silently. Declining
# leaves everything else working; only the priority boost is skipped.
if command -v gamemoded >/dev/null 2>&1 && getent group gamemode >/dev/null 2>&1; then
    if id -nG "$(id -un)" 2>/dev/null | tr ' ' '\n' | grep -qx gamemode; then
        :
    else
        echo ""
        dg_say "$(gettext "One more thing: GameMode can give a running game priority over
everything else, which smooths out stutter on slower machines. That needs your
account added to the \"gamemode\" group, and it takes effect at your next login.")"
        printf '%s ' "$(gettext "Add your account to the gamemode group? [y/N]")"
        read -r gm_answer
        if dg_is_yes "$gm_answer"; then
            if pkexec /usr/sbin/usermod -aG gamemode "$(id -un)"; then
                dg_say "$(gettext "Done — log out and back in for it to take effect.")"
            else
                dg_say "$(gettext "Could not change the group (administrator access is required). Games still run; only the priority boost is skipped.")"
            fi
        else
            dg_say "$(gettext "Left as it is. Games still run normally.")"
        fi
    fi
fi
