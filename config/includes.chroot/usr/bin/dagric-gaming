#!/bin/sh
# Dagric OS — gaming compatibility upgrades, on request.
# Installs the community Proton-GE build (extra codecs, game fixes that
# land weeks before upstream) into Steam's compatibility tools folder.
set -e

cat << 'EOF'
Dagric gaming setup
=====================
Already preinstalled on Dagric Pro:
  * Wine + winetricks       run Windows apps:  wine setup.exe
  * Steam                   Valve Proton for your game library
  * gamemode + mangohud     performance governor + FPS overlay

This helper adds Proton-GE (GloriousEggroll's community Proton with
extra media codecs and game-specific fixes).
EOF
printf "Download the latest Proton-GE from GitHub? [y/N] "
read -r answer
case "$answer" in y|Y) ;; *) echo "Nothing changed."; exit 0 ;; esac

DEST="$HOME/.steam/root/compatibilitytools.d"
mkdir -p "$DEST"
URL=$(curl -fsSL https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest \
      | grep browser_download_url | grep '\.tar\.gz"' | head -1 | cut -d '"' -f 4)
if [ -z "$URL" ]; then
    echo "Could not find the latest release (offline?). Try again later."
    exit 1
fi
echo "Downloading: $URL"
curl -fL "$URL" | tar xz -C "$DEST"
echo ""
echo "Installed to $DEST"
echo "In Steam: Settings > Compatibility > enable, then pick the GE-Proton"
echo "version per game under Properties > Compatibility."
