#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — "Dagric Looks": pick your desktop layout, one click.
# Reshapes the Plasma panels through Plasma's OWN scripting engine
# (evaluateScript over D-Bus) — the robust, version-safe way, never by
# hand-editing the applet config. Each layout also re-brands the launcher
# button with the Dagric logo so branding survives a switch.
#
# EXTENSIBLE BY DESIGN, exactly like Dagric Styles. Layouts are plain
# key=value files, not code baked into this script, read from:
#
#   /usr/share/dagric/looks/          shipped with Dagric
#   /etc/dagric/looks/                added by the administrator
#   ~/.local/share/dagric/looks/      added by you, no root needed
#
# Copy a shipped .look file, change its SCRIPT line (Plasma scripting API,
# on one line), and it appears in this menu next time.
#
# Edition: Pro-only layouts carry EDITION=pro. On the free edition those
# files are REMOVED AT BUILD TIME, not merely hidden.
#
# Language: a layout's NAME and DESCRIPTION are data, so xgettext cannot see
# them here — tools/i18n-extract.sh reads the .look files themselves and puts
# them in the .pot. That means a layout an administrator drops into
# /etc/dagric/looks is shown exactly as written, which is right: we have no
# translation for a string we have never seen.
. /usr/bin/dagric-i18n.sh

# "Dagric Looks" is the tool's own name and stays in English everywhere, the
# same way Dagric, Dagric Hub and Dagric Styles do.
TITLE="Dagric Looks"

EDITION=$(cat /etc/dagric-edition 2>/dev/null || echo free)
LOOK_DIRS="/usr/share/dagric/looks /etc/dagric/looks ${XDG_DATA_HOME:-$HOME/.local/share}/dagric/looks"

# Every layout starts from a clean slate; the launcher is re-branded inside
# each layout's own script so the D logo survives the rebuild.
CLEAR='var ps=panels(); for(var i=0;i<ps.length;i++){ps[i].remove();}'

# --print-reply is not decoration. Without it dbus-send hands the message to the
# bus and exits 0 without ever looking at the answer, so this function reported
# success even when plasmashell was not on the session bus at all. With it,
# dbus-send waits for the reply and exits non-zero on a D-Bus error — which is
# exactly what plasmashell sends back when a layout SCRIPT throws. That exit
# status is the only evidence the caller has that anything happened, so it has
# to be real before the caller below can test it.
#
# No --reply-timeout: the D-Bus default is already generous, and a shorter one
# would report failure on the slow 2012-2018 machines this product targets while
# the panels were still being built.
apply() {
    dbus-send --session --print-reply --type=method_call --dest=org.kde.plasmashell \
        /PlasmaShell org.kde.PlasmaShell.evaluateScript "string:$1" >/dev/null 2>&1
}

lkey() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -1; }

TMPLIST=$(mktemp) || exit 1
# PAIRED TRAPS, NOT ONE COMBINED TRAP. The old form was
#     trap 'rm -rf "$WORK"' EXIT INT TERM
# and it deleted the state and then KEPT RUNNING. A trap handler that returns
# does not end the script in dash: the shell resumes at the next statement with
# $TMPLIST already gone. Verified empirically, not assumed.
# So a logout, a session-manager reap or any TERM in the middle of a preview
# left this running against files it had just erased. Cleanup belongs on EXIT,
# which fires once no matter how the script ends; the signal traps exist only to
# make the script actually stop. dagric-display and dagric-hardware-check
# already do it this way.
trap 'rm -f "$TMPLIST" "$TMPLIST.n"' EXIT
trap 'exit 130' INT TERM HUP

for dir in $LOOK_DIRS; do
    [ -d "$dir" ] || continue
    for f in "$dir"/*.look; do
        [ -f "$f" ] || continue
        id=$(basename "$f" .look)
        need=$(lkey "$f" EDITION)
        # Belt and braces: the files are stripped from free images at build
        # time, but honour the flag at runtime too.
        if [ "$need" = "pro" ] && [ "$EDITION" != "pro" ]; then continue; fi
        [ -n "$(lkey "$f" SCRIPT)" ] || continue
        name=$(lkey "$f" NAME); [ -n "$name" ] || name="$id"
        name=$(dg_tr "$name")
        desc=$(dg_tr "$(lkey "$f" DESCRIPTION)")
        sort=$(lkey "$f" SORT); [ -n "$sort" ] || sort=50
        label="$name"
        [ -n "$desc" ] && label="$name  —  $desc"
        [ "$need" = "pro" ] && label="$label (Pro)"
        grep -vF "	$id	" "$TMPLIST" > "$TMPLIST.n" 2>/dev/null || true
        mv -f "$TMPLIST.n" "$TMPLIST" 2>/dev/null || true
        printf '%s\t%s\t%s\t%s\t%s\n' "$sort" "$id" "$label" "$f" "$name" >> "$TMPLIST"
    done
done

if [ ! -s "$TMPLIST" ]; then
    kdialog --title "$TITLE" --sorry \
        "$(gettext "No layouts are installed. Reinstall the dagric-branding package to restore them.")" 2>/dev/null
    exit 1
fi

set --
OLDIFS=$IFS; IFS='
'
for line in $(sort -n -k1,1 "$TMPLIST"); do
    IFS='	' read -r _ id label _ <<EOF
$line
EOF
    set -- "$@" "$id" "$label"
done
IFS=$OLDIFS

CHOICE=$(kdialog --title "$TITLE" --icon dagric-logo --geometry 520x320 \
    --menu "$(gettext "Pick a layout — switch back anytime:")" "$@" 2>/dev/null) || exit 0
[ -n "$CHOICE" ] || exit 0

ROW=$(grep -F "	$CHOICE	" "$TMPLIST" | head -1)
FILE=$(printf '%s\n' "$ROW" | cut -f4)
[ -n "$FILE" ] || exit 0
SCRIPT=$(lkey "$FILE" SCRIPT)
[ -n "$SCRIPT" ] || exit 0

# The status of that call is the only evidence anything happened, and it used to
# be thrown away — the popup below fired unconditionally. plasmashell not
# running, a crash of exactly the kind the 2012-2018 hardware this product
# targets produces, made every row in this menu a no-op that announced success.
# That is the worst possible moment for it: the manual sends people here to
# REPAIR a panel they broke, so the owner is already looking at a damaged
# desktop when it tells them a new one was built.
#
# plasmashell answers a script error with a D-Bus error reply, so a SCRIPT that
# throws is caught here too — and that case is worse, because $CLEAR has already
# removed every panel by the time the throw happens. Hence the second sentence,
# which tells the owner what to do about the empty desktop in front of them.
if ! apply "$CLEAR $SCRIPT"; then
    kdialog --title "$TITLE" --sorry \
        "$(gettext "The layout could not be applied — the desktop did not answer. If the panels are missing now, log out and back in, then try again.")" 2>/dev/null
    exit 1
fi

# Report the layout's display NAME, not its internal tag: the popup used to
# say "Layout applied: focus" when the menu row the owner clicked read
# "Focus — one clean panel at the bottom".
NAME=$(printf '%s\n' "$ROW" | cut -f5)
[ -n "$NAME" ] || NAME=$CHOICE

# eval_gettext, and its msgid in SINGLE quotes: double quotes would expand
# $NAME before the lookup and the popup would silently come out in English.
kdialog --title "$TITLE" \
    --passivepopup "$(eval_gettext 'Layout applied: $NAME')" 4 2>/dev/null
