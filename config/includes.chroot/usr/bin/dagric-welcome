#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — open the welcome page.
#
# THIS IS NO LONGER THE FIRST-RUN EXPERIENCE. dagric-firstrun is: a real setup
# wizard that sets the colours, the wallpaper, the text size and the taskbar,
# and offers to fetch the owner's files off the Windows partition. A browser
# tab cannot do any of that, and to somebody arriving from Windows 10 it has
# exactly the shape of the OEM landing page they have been trained to close.
#
# The page is KEPT, and it is worth keeping: it is the short, readable account
# of what Dagric is and the promises it makes. The wizard's last screen links
# straight here, the Hub's "Welcome guide" opens it, and so does this command.
#
# The autostart line below stays for one reason only. Owners who installed
# before the wizard existed still have dagric-welcome.desktop sitting in their
# own ~/.config/autostart (skel is copied at account creation, so an update
# cannot reach it). Dropping the removal here would mean the welcome page
# reopened on EVERY login for exactly those people. New accounts never have
# that file, so this is a no-op for them.
rm -f "$HOME/.config/autostart/dagric-welcome.desktop"

# The welcome page ships per language as welcome/<lang>/index.html, so open the
# owner's copy rather than the English one. dg_localised falls back through
# de_AT -> de -> English, which means a language nobody has translated lands on
# a real page instead of a 404 — and this line does not have to change when a
# language is added.
. /usr/bin/dagric-i18n.sh
PAGE=$(dg_localised /usr/share/dagric/welcome index.html) || {
    dg_say "$(gettext "The Dagric welcome page is not installed.")" >&2
    exit 1
}
# NOT a bare `firefox`. Debian ships firefox-esr, whose binary is
# /usr/bin/firefox-esr; there is no /usr/bin/firefox on this image. This line
# therefore died as "firefox: not found", and on the Hub's `guide)` row it does
# so after an `exec` — the Hub window disappears and nothing opens, which reads
# as a crash. dagric-firstrun's last screen (`welcome) /usr/bin/dagric-welcome &`)
# backgrounds it instead, so there the error went nowhere at all.
#
# Same chain and same order as dagric-manual and dagric-guide: x-www-browser
# first, because it is Debian's alternatives link and an owner who switched
# browsers should be obeyed; then Firefox under either name; xdg-open last, as a
# resort rather than a first choice.
for b in x-www-browser firefox firefox-esr xdg-open; do
    if command -v "$b" >/dev/null 2>&1; then
        exec "$b" "file://$PAGE"
    fi
done
dg_say "$(eval_gettext 'No browser found. The page is at $PAGE')" >&2
exit 1
