def escape(value):
    return html.escape(str(value), quote=True)


def source_badge(source_key):
    return f'<span class="pill store-source store-source-{source_key}">{escape(source_key.title())}</span>'


def recommended_badge():
    return '<span class="pill store-recommended">RECOMMENDED</span>'


def parse_report(path: Path):
    if not path or not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

    apps = data.get("apps") if isinstance(data, dict) else None
    if not isinstance(apps, list):
        return None

    candidates = defaultdict(set)
    for row in apps:
        if not isinstance(row, dict):
            continue
        plan = row.get("dagric_plan") or {}
        if not isinstance(plan, dict):
            continue
        match = (plan.get("match") or "").strip()
        if not match or match == "No automatic replacement":
            continue
        app_name = (row.get("name") or "(unnamed)").strip()
        if app_name:
            candidates[match].add(app_name)

    return {
        "source_path": str(path),
        "entries": [{"match": match, "seen": sorted(values), "plan": WINDOWS_REPLACEMENTS.get(match)}
                    for match, values in candidates.items()]
    }


def recommendation_cards():
    cards = []
    for section in CATALOG:
        items = sorted(section["items"], key=lambda item: (not item.get("recommended", False), item.get("name", "")))
        card_html = [
            "<div class=\"store-grid\">",
        ]
        for item in items:
            recommended = item.get("recommended", False)
            source_badge_html = source_badge(item["source_key"])
            tags = f"{source_badge_html}"
            if recommended:
                tags = f"{tags} {recommended_badge()}"
            card_html.append(
                f"""
                <article class=\"card store-card\">
                  <div class=\"card-top\">
                    <span class=\"card-name\">{escape(item['name'])}</span>
                    {tags}
                  </div>
                  <p class=\"card-desc\">{escape(item['summary'])}</p>
                  <p class=\"store-install\"><strong>Install:</strong> <code>{escape(item['install_hint'])}</code></p>
                </article>
                """.strip()
            )
        card_html.append("</div>")
        cards.append((section["id"], section["title"], "\n".join(card_html)))
    return cards


def windows_replacements_section(report):
    if not report or not report.get("entries"):
        return (
            "<section><h2>Windows replacements</h2>"
            "<p>No continuity plan found yet. Run Migration Assistant and include the "
            "Windows continuity option, then rerun <code>dagric-store</code>.</p></section>"
        )

    rows = [
        "<section><h2>Windows replacements</h2>",
        f"<p class=\"groupdesc\">Using migration report <strong>{escape(report['source_path'])}</strong> to propose Dagric equivalents.</p>",
        "<div class=\"store-replacements\">",
    ]

    for entry in report["entries"]:
        plan = entry.get("plan")
        windows_apps = ", ".join(entry.get("seen", []))
        if not plan:
            continue
        rows.append(
            """
            <article class="card store-replacement-card">
              <div class="card-top">
                <span class="card-name">{windows} \u2192 {replacement}</span>
                {source}
              </div>
              <p class="card-desc">From your Windows setup: {seen}</p>
              <p class="card-desc">{summary}</p>
              <p class="store-install"><strong>Install:</strong> <code>{command}</code></p>
            </article>
            """.format(
                windows=escape(entry.get("match", "Windows app")),
                replacement=escape(plan.get("name", "Dagric replacement")),
                seen=escape(windows_apps),
                source=source_badge(plan.get("source_key", "dagric")),
                summary=escape(plan.get("summary", "")),
                command=escape(plan.get("install_hint", "See package options in your preferred source.")),
            ).strip()
        )

    rows.append("</div></section>")
    return "\n".join(rows)


def build_html(report):
    sections = []
    for section_id, title, cards in recommendation_cards():
        sections.append(
            f"<section id=\"{escape(section_id)}\"><h2>{escape(title)}</h2>" +
            cards + "</section>"
        )

    replacements = windows_replacements_section(report)

    return f"""<!DOCTYPE html>
<html lang=\"en\">
<head>
  <meta charset=\"utf-8\">
  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
  <title>Dagric Picks</title>
  <link rel=\"stylesheet\" href=\"/usr/share/dagric/manual/manual.css\">
</head>
<body>
  <div class=\"shell\">
    <main class=\"content\" id=\"main\" tabindex=\"-1\">
      <header class=\"hero\">
        <div class=\"eyebrow\">Software</div>
        <h1>Dagric Picks</h1>
        <p class=\"sub\">A curated guide to useful software and safe installation routes.</p>
      </header>

      <div class=\"store-intro\">
        <p>Source labels are explicit: <span class=\"pill store-source store-source-debian\">Debian</span>,
        <span class=\"pill store-source store-source-flathub\">Flathub</span>,
        <span class=\"pill store-source store-source-dagric\">Dagric</span>.</p>
        <p>Trusted / recommended rows are shown first in every section.</p>
        <p><strong>Third-party boundary:</strong> optional game services and clients
        are governed by their providers. Dagric does not bundle Steam, GOG GALAXY,
        Epic Games Launcher or Amazon Games, does not guarantee game compatibility,
        and is not affiliated with or endorsed by those providers.</p>
      </div>

      {sections}
      {replacements}
    </main>
  </div>
</body>
</html>"""


def open_in_browser(path: Path):
    for prog in ("xdg-open", "gio"):
        if shutil.which(prog):
            try:
                command = [prog, "open", str(path)] if prog == "gio" else [prog, str(path)]
                subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except Exception:
                pass
    print("Open this file with your browser:", path)
    return False


def find_default_report():
    candidates = [
        HOME / "Dagric-Continuity-Report.json",
        HOME / "Dagric-Continuity-Report.html",
    ]
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return None


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--report", help="optional path to Dagric-Continuity-Report.json")
    parser.add_argument("--no-open", action="store_true", help="write only; do not open browser")
    args = parser.parse_args()

    report_path = Path(args.report) if args.report else find_default_report()
    report_data = None
    if report_path:
        # Prefer the machine-readable report even when the user points at the
        # companion HTML file. This keeps the store useful from file managers.
        json_path = report_path if report_path.suffix.lower() == ".json" else report_path.with_suffix(".json")
        report_data = parse_report(json_path)
        if report_data is None and report_path.suffix.lower() == ".json":
            report_data = parse_report(report_path)

    CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    html = build_html(report_data)
    write_private_text(OUTPUT_FILE, html)

    if args.no_open:
        print(str(OUTPUT_FILE))
        return

    open_in_browser(OUTPUT_FILE)


if __name__ == "__main__":
    main()
