#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — turn this free machine into a Pro one, in place.
#
# WHY THIS EXISTS. Somebody installs the free edition, uses it for a month,
# decides the creator suite is worth $39, and buys Pro. Before this, the honest
# answer was "download the Pro ISO and reinstall" — which for an owner with a
# month of files, settings and installed applications is not an answer. It is
# also the single worst moment to ask someone to reinstall: they have just paid.
#
# WHAT PRO ACTUALLY IS, because that decides what this has to do. Four things,
# and only the third needs a licence to obtain:
#
#   1. 83 packages, every one of them from Debian main. A free owner could
#      apt-get install all of them today and nobody would stop them. That is not
#      a hole — the site says plainly that Pro buys curation, convenience,
#      integration and support, not exclusivity over free software.
#   2. The service policy. Pro ships docker, libvirt, usbguard, sshd and
#      opensnitch INSTALLED AND DISABLED, so nothing listens or intercepts until
#      the owner opts in. apt does not do that; installing docker.io starts
#      dockerd. Replicating this is the least visible and most important thing
#      here — an upgraded machine that quietly starts running daemons is not the
#      product the Pro ISO is.
#   3. Four Plasma layouts and three colour styles. These are DELETED from the
#      free image at build time rather than hidden behind a flag, because a flag
#      is one line of text to edit. They are the only part that has to be
#      fetched, and the only part the licence gates.
#   4. /etc/dagric-edition and the os-release VARIANT, which is what the Hub,
#      the launcher entries and the appearance gallery read to decide what to
#      show.
#
# WHAT THIS IS NOT. It does not pretend to be a reinstall. A machine upgraded
# this way and a machine installed from the Pro ISO end up equivalent, but they
# get there differently, and the differences that remain are listed at the end
# rather than glossed over.
#
# THE SAFETY MODEL, borrowed wholesale from dagric-upgrade because it was right
# there and it is the same class of operation:
#   1. Refuse when the machine is not in a state to survive it.
#   2. Snapshot FIRST and say plainly when a snapshot is impossible.
#   3. Verify the purchase BEFORE touching anything, so a wrong licence costs
#      nothing.
#   4. Download everything before installing anything.
#   5. Never leave the edition marker flipped if the install did not finish —
#      a machine that CLAIMS to be Pro without the packages is worse than one
#      that is honestly still free.
set -e

. /usr/bin/dagric-i18n.sh

GATE="https://dagric-gate.dagric.workers.dev"
EDITION_FILE=/etc/dagric-edition
LOOKS=/usr/share/dagric/looks
STYLES=/usr/share/dagric/styles
THUMBS=/usr/share/dagric/appearance/thumbs
APPS=/usr/share/applications

say() { printf '%s\n' "$*"; }
# The format string stays a literal and the translation arrives as an argument.
# dagric-i18n.sh states the rule and the reason: a msgstr that becomes a printf
# FORMAT hands a translator — or a community .po from a stranger — control of
# the conversion specifiers.
die() { printf '%s %s\n' "$(gettext "STOPPED:")" "$*" >&2; exit 1; }

# rule — underline a translated heading to the length of the TRANSLATION.
# "Your Pro purchase" is 17 characters and "Ihr Pro-Kauf" is 12, so a fixed
# 17-dash rule sits under a German heading trailing five dashes into space.
# sed counts characters rather than bytes in a UTF-8 locale, which is what makes
# this right for the accented languages rather than only for English.
rule() { printf '%s' "$1" | sed 's/./-/g'; }

[ "$(id -u)" -eq 0 ] || die "$(gettext "run this as root:  sudo dagric-upgrade-to-pro")"

DRY=no
[ "$1" = "--check" ] && DRY=yes

say "$(gettext "Dagric OS — upgrade this machine to Pro")"
say "======================================="
say ""

# ------------------------------------------------------------------ pre-flight
CUR=free
[ -r "$EDITION_FILE" ] && CUR=$(cat "$EDITION_FILE" 2>/dev/null)
if [ "$CUR" = "pro" ]; then
    say "$(gettext "This machine is already running Dagric OS Pro.")"
    say "$(gettext "Nothing to do.")"
    exit 0
fi

fail=0

# A live session has nowhere to put any of this. Everything below would land in
# the tmpfs overlay and vanish at shutdown, and the owner would have paid and
# apparently received nothing.
if [ -d /run/live/medium ]; then
    say "$(gettext "This is the live USB session, not an installed system.")"
    say ""
    say "$(gettext "An upgrade here would be written to memory and lost at shutdown.")"
    say "$(gettext "Install Dagric first, then run this on the installed machine.")"
    exit 1
fi

# apt in a broken state is the commonest reason a long install dies halfway.
#
# THE FIRST VERSION OF THIS CHECK COULD NOT DETECT THE THING IT CHECKS FOR. It
# read
#     if ! dpkg --audit | grep -q '^$' && [ -n "$(dpkg --audit)" ]
# and dpkg's real report is multi-line WITH a blank line in it:
#     The following packages are only half configured.
#
#      some-package
# so grep -q '^$' matched, the ! flipped it to false, and a genuinely broken
# machine passed straight through into an 83-package install — which is the
# exact state this guard exists to refuse. Measured against simulated dpkg
# output, not reasoned about: the old form reported "clean", the new one
# reports "broken".
#
# dpkg --audit prints nothing at all when there is nothing wrong, so "is the
# output empty" is the whole test and anything cleverer is a way to be wrong.
if [ -n "$(dpkg --audit 2>/dev/null)" ]; then
    say "$(gettext "ERROR: some packages on this machine are half-configured.")"
    # The seven-space indent is the CALLER's layout, not the translator's
    # problem: leading whitespace inside a msgid is invisible in a .po editor
    # and is the first thing a well-meaning translator trims.
    say "       $(gettext "Run  sudo dpkg --configure -a  first, then try again.")"
    fail=1
fi

# 83 packages plus their dependencies. The number is deliberately generous:
# running out of disk midway through an apt transaction is how a machine ends up
# needing the rollback this tool works hard to provide.
FREE_KB=$(df -Pk / 2>/dev/null | awk 'NR==2{print $4}')
NEED_KB=$((6 * 1024 * 1024))
# Computed ONCE into a plain variable, because eval_gettext expands variables
# and cannot do arithmetic: $((FREE_KB / 1024 / 1024)) inside a msgid would
# reach the owner as that literal text. The :-0 also covers a df that printed
# nothing, which the two bare expansions here used to assume could not happen.
FREE_GB=$(( ${FREE_KB:-0} / 1024 / 1024 ))
if [ -n "$FREE_KB" ] && [ "$FREE_KB" -lt "$NEED_KB" ]; then
    say "$(gettext "ERROR: not enough free disk space.")"
    say "       $(eval_gettext 'Pro needs about 6 GB free; this machine has $FREE_GB GB.')"
    fail=1
fi

# On battery, an interrupted apt transaction is a real risk and a plugged-in
# machine is thirty seconds away.
#
# THE MAINS ADAPTER IS NOT ALWAYS CALLED "AC". The kernel names the ACPI power
# supply after the firmware's device id, so it is AC on many machines but ACAD
# on Acer, ADP0/ADP1 on Dell and several others, and AC0 elsewhere. The old test
# read /sys/class/power_supply/AC/online alone: on any of those laptops the path
# does not exist, [ -r ... ] is false, and the guard passes silently — the one
# outcome it exists to prevent, on the path an owner reaches minutes after
# paying, where an interrupted 6 GB transaction leaves a half-configured dpkg
# state.
#
# Scanned rather than enumerated, because the next vendor id is not knowable
# from here. type=Mains is the kernel's own classification and is what
# distinguishes an adapter from the battery itself, so this cannot be fooled by
# a discharging battery's own `online` file. Only a supply that positively
# reports Mains and 0 counts as "on battery"; a machine with no mains supply at
# all is a desktop and is left alone, exactly as before.
on_battery=no
for ps in /sys/class/power_supply/*; do
    [ -r "$ps/type" ] && [ -r "$ps/online" ] || continue
    [ "$(cat "$ps/type" 2>/dev/null)" = "Mains" ] || continue
    if [ "$(cat "$ps/online" 2>/dev/null)" = "1" ]; then
        on_battery=no
        break
    fi
    on_battery=yes
done
if [ "$on_battery" = yes ]; then
    say "$(gettext "ERROR: this machine is running on battery.")"
    say "       $(gettext "Plug it in first — this installs several gigabytes.")"
    fail=1
fi

command -v curl >/dev/null 2>&1 || { say "$(gettext "ERROR: curl is missing.")"; fail=1; }

[ "$fail" -eq 0 ] || die "$(gettext "fix the above and run this again. Nothing was changed.")"

say "$(eval_gettext 'This machine: Dagric OS $CUR')"
say "$(eval_gettext 'Free disk:    $FREE_GB GB')"
say ""

# ------------------------------------------------------------------ the licence
# Asked for and verified BEFORE anything is touched. A wrong or mistyped licence
# should cost the owner nothing but the retyping.
_h=$(gettext "Your Pro purchase")
say "$_h"
say "$(rule "$_h")"
say "$(gettext "Open the download page from your purchase email. Its address ends in")"
say "  ?session_id=cs_...."
say "$(gettext "Paste that cs_... value here (it is not a password and not secret).")"
say ""
# printf '%s', never printf "$(...)": the translation is an ARGUMENT, so a
# msgstr containing a % can never become a conversion specifier. The trailing
# space survives — command substitution strips trailing NEWLINES, not spaces.
printf '%s' "$(gettext "Purchase session: ")"
read -r SID

case "$SID" in
    *session_id=*) SID=${SID##*session_id=}; SID=${SID%%&*} ;;
esac
case "$SID" in
    cs_*) : ;;
    *) die "$(gettext "that does not look like a purchase session. It starts with cs_ and
        appears in the address of your download page. Nothing was changed.")" ;;
esac

say ""
say "$(gettext "Checking the purchase...")"
# HEAD, not GET: this asks the gate the same question the download does, without
# pulling a 4 GB ISO to find out. The gate answers 200 for a paid session and
# 403 for anything else.
#
# NO -f HERE, AND THAT IS THE WHOLE POINT OF THIS CALL. `curl -f` exits non-zero
# on an HTTP error, so with it the 403 that means "we checked, and that session
# has not paid" arrived at the `||` branch as 000 and got reported as "could not
# reach the licence check, try again in a minute" — telling someone with a
# mistyped session id to keep retrying a check that was working perfectly.
# Measured against the live gate: -f gives 000, without it gives 403.
#
# Without -f, curl still returns 000 for a genuine connection failure and
# nothing else, which is exactly the distinction this needs. The assets fetch
# further down DOES keep -f, because there the desired behaviour is the
# opposite: fail, and write no file, on any non-200.
HTTP=$(curl -sS -o /dev/null -w '%{http_code}' -I --max-time 30 \
       "$GATE/?session_id=$SID" 2>/dev/null) || HTTP=000

case "$HTTP" in
    200)
        say "  $(gettext "Confirmed. Thank you.")" ;;
    403)
        die "$(gettext "that purchase session was not recognised as paid. If you have just
        bought Pro, give it a minute and try again — and if it keeps failing,
        dagric.com/support can look it up. Nothing was changed.")" ;;
    400)
        # The local check above only tests the cs_ prefix; the gate also requires
        # at least eight more characters. A code pasted short — which is what
        # happens when a line wraps in an email — passes here and fails there,
        # and it is a typo rather than a fault worth sending to support.
        die "$(gettext "that session code looks incomplete. Copy the whole cs_... value
        from the address bar of your download page — it is long, and it is easy
        to miss the end of it. Nothing was changed.")" ;;
    000|503)
        die "$(gettext "could not reach the licence check just now. Your purchase is fine;
        this is our end or your connection. Try again in a minute. Nothing was
        changed.")" ;;
    *)
        # eval_gettext and therefore SINGLE quotes: in double quotes the shell
        # would expand $HTTP before gettext saw the string, the lookup would
        # miss, and this line alone would come out in English with no warning.
        die "$(eval_gettext 'the licence check answered $HTTP, which it should not. Please send
        that number to dagric.com/support. Nothing was changed.')" ;;
esac
say ""

if [ "$DRY" = yes ]; then
    say "$(gettext "--check: the purchase is valid and this machine can be upgraded.")"
    say "$(gettext "Run without --check to do it.")"
    exit 0
fi

# ------------------------------------------------------------------ consent
CAN_SNAPSHOT=no
if command -v snapper >/dev/null 2>&1 && \
   [ "$(findmnt -no FSTYPE / 2>/dev/null)" = "btrfs" ] && \
   snapper -c root list >/dev/null 2>&1; then
    CAN_SNAPSHOT=yes
fi

# WAS A `cat <<'EOF'` HEREDOC, which is a wall of untranslatable text: xgettext
# cannot see into one, so every word of the consent screen — the screen where
# somebody agrees to an 83-package install — was English on a product sold in
# six languages. One msgid per bullet rather than one for the block, so a
# reworded bullet does not invalidate the other three in five catalogues.
_h=$(gettext "What this will do")
say "$_h"
say "$(rule "$_h")"
say "$(gettext "  * install the Pro applications — the creator suite, the gaming stack, the
    virtualisation tools, the backup tools and the rest (about 83 packages)")"
say "$(gettext "  * install them the way the Pro ISO does: Docker, virtual machines, USB
    protection and remote login are all set up but left OFF until you switch
    them on. The one exception is OpenSnitch, the application firewall, which
    is switched ON — the same as the Pro ISO, because a firewall nobody turned
    on protects nobody. It blocks nothing on its own; it asks you the first
    time a program reaches the internet. Dagric's own background services —
    the clock, updates, printing, the software centre — are answered for you
    in advance, so the questions you get are about programs you chose.")"
say "$(gettext "  * add the four extra desktop layouts and three extra colour styles")"
say "$(gettext "  * mark this machine as Pro, so the Hub and the appearance gallery show
    everything you have paid for")"
say ""
say "$(gettext "Your files, your settings, your installed applications and your wallpaper are
not touched.")"
say ""
say "$(gettext "This downloads several gigabytes and takes a while on a slow connection.")"
say ""

# THE WORD THE OWNER TYPES IS TRANSLATED, AND ENGLISH IS ALWAYS STILL ACCEPTED.
#
# This is the same rule dg_is_yes states in dagric-i18n.sh, and it exists for
# the same reason: translating the PROMPT without translating the ANSWER is a
# bug, not a nicety. A German owner told "Geben Sie UPGRADE ein" who types the
# German word gets "Nothing changed" and no explanation — on the paid path,
# minutes after being charged $39.
#
# The reverse failure is worse and is why both are accepted. If only the
# translation were compared, one wrong or missing msgstr would leave a paying
# customer unable to type ANY word that works, locked out of the thing they
# just bought by a catalogue bug. Accepting the English word as well means a
# broken translation can only ever add an answer, never take one away.
#
# TRANSLATORS: a word the owner must TYPE EXACTLY to confirm. Short, UPPERCASE,
# one word, no spaces. Use ASCII LETTERS ONLY — no accents, no umlauts, no
# cedillas: this is typed at a bare terminal prompt on whatever keyboard layout
# the machine happens to have, and a character the owner cannot produce turns a
# speed bump into a wall. Write it the way your language transliterates into
# ASCII (German ue for u-umlaut, and so on). Make it a word your language
# actually uses for "upgrade" — a speed bump nobody can read is also a wall.
# The English UPGRADE keeps working whatever you put here.
UPGRADE_WORD=$(gettext "UPGRADE")
# TRANSLATORS: as above, ASCII letters only. Deliberately a DIFFERENT word from
# the one above, because it is a different and more serious decision — typing
# the same thing for both would make them feel like one.
NOROLLBACK_WORD=$(gettext "NO-ROLLBACK")

if [ "$CAN_SNAPSHOT" = yes ]; then
    say "$(gettext "A snapshot is taken first, so this is recoverable from the boot menu.")"
    say ""
    printf '%s' "$(eval_gettext 'Type $UPGRADE_WORD to continue: ')"
    read -r ans
    # `if` with two explicit compares rather than a case: a case PATTERN would
    # treat a translated word as a glob, and [ ] compares the bytes.
    if [ "$ans" != "$UPGRADE_WORD" ] && [ "$ans" != "UPGRADE" ]; then
        say "$(gettext "Nothing changed.")"
        exit 0
    fi
else
    say "$(gettext "THIS MACHINE HAS NO ROLLBACK.")"
    say ""
    # The command is set off with double spaces, not backticks. The backticks
    # this line used to carry were harmless inside a quoted heredoc and become
    # COMMAND SUBSTITUTION the moment the text moves into "$(gettext "...")" —
    # `sudo apt-get -f install` would have run, as root, while merely printing
    # a warning. Double spaces are also what the dpkg --audit message above
    # already uses for a command.
    say "$(gettext "Snapshots need a btrfs root and this install does not have one. Nothing here
deletes your files, and the worst realistic outcome is a half-installed set of
applications you can finish with  sudo apt-get -f install  — but there is no
one-click way back.")"
    say ""
    printf '%s' "$(eval_gettext 'Type $NOROLLBACK_WORD to continue anyway, or press Enter to stop: ')"
    read -r ans
    if [ "$ans" != "$NOROLLBACK_WORD" ] && [ "$ans" != "NO-ROLLBACK" ]; then
        say "$(gettext "Nothing changed. That was the safe answer.")"
        exit 0
    fi
fi

# ------------------------------------------------------------------ snapshot
if [ "$CAN_SNAPSHOT" = yes ]; then
    say ""
    say "$(gettext "Taking a rollback snapshot...")"
    # The snapshot DESCRIPTION stays English on purpose. It is an identifier
    # shown by snapper and in the boot menu, it is matched by eye during a
    # rescue, and a machine whose language was changed after the upgrade must
    # still show the same string it was created with.
    if snapper -c root create -d "before upgrade to Dagric OS Pro" 2>/dev/null; then
        say "  $(gettext "done.")"
    else
        die "$(gettext "the snapshot failed, so this stopped before changing anything.
        That is deliberate: the rollback was the reason it was safe to proceed.")"
    fi
fi

# ------------------------------------------------------------------ the assets
# Fetched BEFORE apt runs. These are the only licence-gated part, they are small,
# and finding out the gate is unreachable after a twenty-minute install would be
# the worst possible ordering.
WORK=$(mktemp -d /tmp/dagric-pro.XXXXXX) || die "$(gettext "cannot create a working directory.")"
trap 'rm -rf "$WORK"' EXIT
trap 'exit 130' INT TERM HUP

say ""
say "$(gettext "Fetching the Pro layouts and styles...")"
# THIS IS THE ONE PART THE LICENCE GATES, AND THE ONE PART THAT CANNOT BE
# OBTAINED LATER.
#
# A failed fetch used to be a warning: the run carried on, installed the 83
# packages, and wrote 'pro' to the marker anyway. After that the pre-flight at
# the top of this file refuses every future run with "This machine is already
# running Dagric OS Pro. Nothing to do.", and the Hub drops the row that
# launches it — so the layouts and styles could never arrive, on a machine now
# advertising itself as Pro. The printed advice to re-run was the single action
# guaranteed not to work, and recovery meant hand-editing /etc/dagric-edition
# back to free, which nothing told anyone.
#
# So: retry, and if the gate is genuinely unreachable, STOP. That is exactly why
# this fetch sits ahead of apt — nothing is installed, nothing is marked, and
# the machine is bit for bit as it was. Cheap to abandon, honest to repeat.
ASSETS_OK=no
n=1
while [ "$n" -le 3 ]; do
    if curl -fsS --max-time 120 -o "$WORK/assets.tar.gz" \
            "$GATE/assets?session_id=$SID" 2>/dev/null &&
       tar -tzf "$WORK/assets.tar.gz" >/dev/null 2>&1; then
        ASSETS_OK=yes
        say "  $(gettext "done.")"
        break
    fi
    rm -f "$WORK/assets.tar.gz"
    if [ "$n" -lt 3 ]; then
        say "  $(gettext "that attempt did not work; trying again in a few seconds...")"
        sleep 5
    fi
    n=$((n + 1))
done

if [ "$ASSETS_OK" != yes ]; then
    die "$(gettext "the extra desktop layouts and colour styles could not be downloaded,
        and they are the one part of Pro that has to come from us rather than
        from Debian. NOTHING has been installed and nothing on this machine has
        been changed, so there is nothing half-finished to clean up. Your
        purchase is fine. Run this again when the connection is steady — and if
        it keeps failing, dagric.com/support can look it up.")"
fi

# ------------------------------------------------------------------ packages
# The list is embedded rather than fetched. It is not secret — every name is in
# Debian main — and a machine that cannot reach a list server is exactly the
# machine that should still be able to finish an upgrade it has paid for.
PRO_PACKAGES="audacity bat bleachbit blender borgbackup build-essential chromium
darktable default-jre-headless distrobox dnsmasq-base docker-cli docker-compose
docker.io fcitx5-chinese-addons filelight flatseal fonts-noto-cjk frei0r-plugins gamemode gimp git
goverlay gvfs-backends handbrake inkscape kaccounts-providers kdeconnect kdenlive
keepassxc kio-gdrive krita krita-l10n libreoffice libreoffice-java-common
libvirt-clients libvirt-daemon-system lutris mangohud mesa-vulkan-drivers nala
obs-plugins obs-studio opensnitch opensnitch-ebpf-modules openssh-client
openssh-server ovmf
papirus-icon-theme passt podman python3-lxml python3-numpy python3-opensnitch-ui
python3-pip python3-scour python3-venv qbittorrent qemu-system-x86 qemu-utils
qml6-module-qtwebengine rclone signon-ui-qt signon-ui-service slirp4netns swtpm
swtpm-tools syncthing thunderbird thunderbird-l10n-de thunderbird-l10n-es-es
thunderbird-l10n-fr thunderbird-l10n-it thunderbird-l10n-pt-br timeshift usbguard
usbguard-notifier virt-manager virt-viewer vorta vulkan-tools wine wine-binfmt
winetricks zoxide"

say ""
say "$(gettext "Reading package lists...")"
apt-get update >/dev/null 2>&1 || \
    die "$(gettext "could not read the package lists. Check the network and try again.
    Nothing was installed.")"

# DOWNLOAD FIRST, INSTALL SECOND. A transaction interrupted by a dropped
# connection halfway through unpacking is the classic way to end up with a
# machine in a state its owner cannot reason about.
say "$(gettext "Downloading (this is the long part)...")"
# shellcheck disable=SC2086
DEBIAN_FRONTEND=noninteractive apt-get -y -d install $PRO_PACKAGES || \
    die "$(gettext "the download did not finish, so nothing was installed. This is usually
    the connection. Run this again — apt keeps what it already fetched.")"

say "$(gettext "Installing...")"
# --no-install-recommends matches the ISO exactly. Without it an upgraded
# machine ends up with a different package set from an installed-from-Pro one,
# and every future audit of "what does Pro contain" has two answers.
# THE RESULT IS RECORDED, NOT ACTED ON YET, and that ordering is the entire
# point of this block. apt is not atomic. dpkg configures packages in order, and
# every package configured BEFORE the failing one has already run its postinst —
# docker.io's starts dockerd, openssh-server's starts sshd, libvirt-daemon-
# system's starts libvirtd and builds virbr0, usbguard's starts the blocking
# daemon.
#
# This used to `exit 1` right here, ahead of the policy block below. A failed
# install therefore left a machine that had been quiet an hour earlier running a
# root container daemon with ip_forward=1, sshd listening on 22, a NAT bridge,
# and usbguard with Debian's empty rules.conf and ImplicitPolicyTarget=block —
# which 0600-pro-edition.hook.chroot:71 documents as deauthorizing every USB
# device so that "the owner's keyboard and mouse go dead". On their only
# computer, minutes after paying, with nothing on screen mentioning any of it.
#
# So the policy is applied to whatever DID get installed, and only then is the
# failure reported.
# shellcheck disable=SC2086
INSTALL_OK=yes
DEBIAN_FRONTEND=noninteractive apt-get -y --no-install-recommends \
    install $PRO_PACKAGES || INSTALL_OK=no

# ------------------------------------------------------------------ 32-bit
# WINE IS THE HEADLINE PRO FEATURE AND WITHOUT THIS IT IS HALF A FEATURE.
# 0600-pro-edition.hook.chroot:39-41 enables i386 multiarch and installs
# wine32:i386 and mesa-vulkan-drivers:i386. Classic Windows .exe installers are
# overwhelmingly 32-bit, and DXVK/Proton needs 32-bit Vulkan, so an upgraded
# machine without this runs 64-bit Wine only — it looks installed and fails on
# the first real .exe, while an ISO-installed Pro machine works.
#
# Non-fatal, and worded the same way the hook words it: 64-bit Wine is still
# useful, and a machine that cannot reach the i386 archive should still finish
# the rest of the upgrade it paid for.
if [ "$INSTALL_OK" = yes ]; then
    say ""
    say "$(gettext "Adding 32-bit support for Windows applications and games...")"
    if dpkg --add-architecture i386 && apt-get update >/dev/null 2>&1; then
        if DEBIAN_FRONTEND=noninteractive apt-get -y --no-install-recommends \
             install wine32:i386 mesa-vulkan-drivers:i386 >/dev/null 2>&1; then
            say "  $(gettext "done.")"
        else
            say "  $(gettext "note: 32-bit Wine and Vulkan did not install. Wine still works
        for 64-bit Windows programs; older installers may not run.")"
        fi
    else
        say "  $(gettext "note: could not enable 32-bit support. Wine still works for 64-bit
        Windows programs; older installers may not run.")"
    fi
fi

# ------------------------------------------------------------------ the policy
# THE PART APT CANNOT DO. Installing docker.io starts dockerd; installing
# usbguard starts usbguard. The Pro ISO ships every one of these OFF, and
# 0600-pro-edition.hook.chroot verifies it at build time. An upgraded machine
# must land in the same place or "Pro" means two different things.
say ""
say "$(gettext "Setting the opt-in policy (everything installed, nothing switched on)...")"

# THE LIBVIRT LIST IS COPIED FROM 0600-pro-edition.hook.chroot:135-137, WHICH
# TOOK IT FROM A REAL BUILD LOG. This named three units of the eight the
# postinst enables. A still-enabled .socket starts its service on first
# connection, so libvirtd-admin.socket would socket-activate the very daemon the
# line above had just disabled, and virtlogd would run at every boot. The hook's
# own comment calls that out: "Disabling virtlogd.service while leaving one of
# its sockets enabled is the same half-measure in a different package." Any unit
# added there has to be added here in the same commit.
for unit in docker.service docker.socket \
            libvirtd.service libvirtd.socket libvirtd-ro.socket \
            libvirtd-admin.socket \
            virtlogd.service virtlogd.socket virtlogd-admin.socket \
            libvirt-guests.service \
            ssh.service ssh.socket; do
    systemctl disable "$unit" >/dev/null 2>&1 || true
    systemctl stop "$unit" >/dev/null 2>&1 || true
done

# The hardened sshd drop-in the Pro ISO ships (0600:23-30). That hook is the
# ONLY thing that writes it — there is no sshd_config anywhere under
# config/includes.chroot — so without this an upgraded machine that later
# switches SSH on from the Hub starts at stock Debian defaults
# (PermitRootLogin prohibit-password, MaxAuthTries 6, X11Forwarding yes) while
# an ISO-installed Pro machine starts locked down. Two machines both sold as
# Pro, and the weaker one is the one nobody wrote down.
if [ -d /etc/ssh ]; then
    mkdir -p /etc/ssh/sshd_config.d
    cat > /etc/ssh/sshd_config.d/50-dagric.conf <<'SSHEOF'
# Dagric OS hardened SSH defaults (only apply if the owner enables sshd).
PermitRootLogin no
MaxAuthTries 3
X11Forwarding no
# For a keys-only posture, also set: PasswordAuthentication no
SSHEOF
    chmod 0644 /etc/ssh/sshd_config.d/50-dagric.conf
fi

# usbguard is masked as well as disabled: its own package enables
# usbguard-dbus.service, which declares Requires=usbguard.service and would pull
# it back up. dagric-usb-protect is the switch-on path.
for unit in usbguard.service usbguard-dbus.service; do
    systemctl disable "$unit" >/dev/null 2>&1 || true
    systemctl stop "$unit" >/dev/null 2>&1 || true
    systemctl mask "$unit" >/dev/null 2>&1 || true
done
systemctl --global disable usbguard-notifier.service >/dev/null 2>&1 || true

# libvirt's default NAT network autostarts and puts a bridge on the machine
# before the owner has asked for a virtual machine.
rm -f /etc/libvirt/qemu/networks/autostart/default.xml 2>/dev/null || true

# KDE Connect needs ports open to pair with a phone. 0600:59 does this at build
# time with firewall-offline-cmd, which REFUSES to run while firewalld is
# active — on a booted machine it has to be firewall-cmd --permanent plus a
# reload. Without it, phone pairing silently never works on an upgraded machine
# and works on a Pro-ISO one, while the manual describes the ISO behaviour.
if command -v firewall-cmd >/dev/null 2>&1; then
    if firewall-cmd --permanent --zone=home --add-service=kdeconnect >/dev/null 2>&1; then
        firewall-cmd --reload >/dev/null 2>&1 || true
    else
        say "  $(gettext "note: could not open the KDE Connect ports. Phone pairing may need
        the firewall adjusting by hand; everything else is unaffected.")"
    fi
fi

# opensnitch is the exception and is ON, because a firewall nobody switched on
# protects nobody. This matches the Pro ISO.
systemctl enable opensnitch.service >/dev/null 2>&1 || true

say "  $(gettext "done.")"

# NOW the failure may be reported — after the machine has been put into the
# state it was promised, not before it.
if [ "$INSTALL_OK" = no ]; then
    say ""
    say "$(gettext "ERROR: the install did not finish cleanly.")"
    say ""
    say "$(gettext "This machine is still marked as free ON PURPOSE — one that claims to be
Pro without the applications is harder to fix than one that is honestly
still free.")"
    say ""
    say "$(gettext "Whatever DID install has been set to the Pro edition's opt-in policy, so
nothing that arrived is running: no Docker daemon, no remote login, no
USB blocking, no virtual-machine services.")"
    say ""
    say "$(gettext "Try:  sudo apt-get -f install   then run this again.")"
    exit 1
fi

# ------------------------------------------------------------------ assets in
if [ "$ASSETS_OK" = yes ]; then
    say ""
    say "$(gettext "Adding the Pro layouts and styles...")"
    mkdir -p "$WORK/x"
    if tar -xzf "$WORK/assets.tar.gz" -C "$WORK/x" 2>/dev/null; then
        mkdir -p "$LOOKS" "$STYLES" "$THUMBS"
        for f in "$WORK"/x/looks/*.look;   do [ -e "$f" ] && cp -f "$f" "$LOOKS/";  done
        for f in "$WORK"/x/styles/*.style; do [ -e "$f" ] && cp -f "$f" "$STYLES/"; done
        for f in "$WORK"/x/thumbs/*.png;   do [ -e "$f" ] && cp -f "$f" "$THUMBS/"; done
        for f in "$WORK"/x/applications/*.desktop; do [ -e "$f" ] && cp -f "$f" "$APPS/"; done
        say "  $(gettext "done.")"
    else
        # NOT a warning. An unpack that fails here is past apt, so continuing
        # would write the marker and recreate exactly the trap the retry loop
        # above was added to remove: a machine calling itself Pro that can never
        # receive the one thing the licence gates. Stopping short of the marker
        # leaves the tool able to finish the job on a second run.
        die "$(gettext "the layouts and styles arrived but would not unpack — usually that
        is disk space. The applications ARE installed and set to the Pro opt-in
        policy, but this machine has deliberately not been marked as Pro yet, so
        running this tool again will finish the job.")"
    fi
fi

# ------------------------------------------------------------------ the marker
# LAST, and only after everything above worked. This is the line that makes the
# Hub, the launcher and the gallery behave as Pro, and setting it early would
# have meant a failed run leaving a machine that advertises what it does not
# have.
say ""
say "$(gettext "Marking this machine as Pro...")"
printf 'pro\n' > "$EDITION_FILE"

# os-release is base-files' file and a point release will overwrite it, so a
# diversion has to be in place for this write to survive one.
#
# 0100-identity.hook.chroot now adds that diversion at build time, and
# dagric-upgrade adds it on machines older than that change. Neither reaches a
# machine that installed from an early ISO and then upgrades to Pro without
# ever running a release upgrade — which is precisely the machine standing here
# — so it is added on this path too. Idempotent: the guard makes a second
# diversion impossible, and --no-rename is what dpkg-divert itself recommends
# for a file belonging to an Essential package.
if ! dpkg-divert --list /usr/lib/os-release 2>/dev/null | grep -q os-release; then
    dpkg-divert --local --no-rename \
        --divert /usr/lib/os-release.debian --add /usr/lib/os-release >/dev/null 2>&1 || true
fi
if [ -w /usr/lib/os-release ]; then
    sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Dagric OS Pro 1.0 (Foundation)"/' /usr/lib/os-release 2>/dev/null || true
    grep -q '^VARIANT_ID=pro' /usr/lib/os-release 2>/dev/null || \
        printf 'VARIANT="Pro"\nVARIANT_ID=pro\n' >> /usr/lib/os-release
fi

# The launcher reads .desktop files from /usr/local/share/applications, which
# dagric-app-names regenerates. Pro adds entries, so it has to run again or the
# new tools have no launcher entry until the next apt operation happens to
# trigger it.
if command -v dagric-app-names >/dev/null 2>&1; then
    dagric-app-names >/dev/null 2>&1 || true
fi
update-desktop-database >/dev/null 2>&1 || true

say "  $(gettext "done.")"

# ------------------------------------------------------------------ report
# The last two heredocs. Same reason as the consent screen: this is the closing
# word of a paid transaction and it was English on a product sold in six
# languages. The two-column status block keeps its own layout rather than being
# translated as a block, so a longer translated label cannot shear the columns.
say ""
say "$(gettext "Done — this is a Dagric OS Pro machine.")"
say ""
say "  $(gettext "Log out and back in to see it. The Hub will show the Pro tools, and the
  appearance gallery will show the extra layouts and styles.")"
say ""
say "$(gettext "Everything the Pro edition installs is here, and everything that can listen or
intercept is OFF until you turn it on:")"
say ""
say "  $(gettext "Docker, virtual machines, USB protection and remote login")  $(gettext "installed, off")"
say "  $(gettext "OpenSnitch application firewall")  $(gettext "installed, on")"
say ""
say "$(gettext "Turn any of them on from the Dagric Hub.")"
say ""
say "$(gettext "Two honest differences from a machine installed from the Pro ISO:")"
say ""
say "$(gettext "  * The Pro ISO ships CJK fonts and a few defaults chosen at install time. Those
    are here too, but your existing settings were kept rather than replaced —
    which is the point of upgrading rather than reinstalling.")"
say "$(gettext "  * Your snapshot history starts before this upgrade, not at a fresh install.")"
say ""
say "$(gettext "Thank you for buying Pro.")"
