#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — brand the application-launcher button with the Dagric logo on
# first login. DEFENSIVE: only touches the launcher icon, never the panel
# layout. Self-healing — it waits for plasmashell to write its applet config
# and, if the launcher can't be found this session, leaves its autostart entry
# in place so the next login tries again instead of silently giving up.
#
# ORDERING MATTERS: plasmashell keeps applet config in memory and flushes it to
# disk when it exits. So we must QUIT plasmashell BEFORE writing the icon key —
# otherwise its exit-flush clobbers our change and the button reverts to the
# stock kickoff icon. Sequence: locate applet -> quit shell -> write -> relaunch.
AUTOSTART="$HOME/.config/autostart/dagric-brand-launcher.desktop"
CFG="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"

command -v kwriteconfig6 >/dev/null 2>&1 || exit 0
command -v gawk >/dev/null 2>&1 || exit 0

# WAIT FOR THE SETUP WIZARD TO FINISH BEFORE TEARING THE DESKTOP DOWN.
#
# Four things autostart at first login and two of them are this and
# dagric-firstrun. The sequence below quits plasmashell and relaunches it, so
# the taskbar, the desktop icons and the wallpaper all vanish and come back —
# seconds into the very first login, while the wizard is on screen telling a
# nervous owner that "the desktop behind this window changes as you go". It
# does change, but not like that. To someone who has just installed an
# operating system for the first time, the whole desktop disappearing reads as
# a crash they caused.
#
# There is a second cost: dagric-firstrun's set_layout calls wait_plasma, and
# if the owner picks a taskbar layout during the gap that call fails and the
# click is silently dropped.
#
# The wait is dagric-driver-offer's, copied rather than invented — same
# 150 x 2s ceiling. What happens WHEN IT RUNS OUT is deliberately different
# here, and a boot test is what showed why.
#
# driver-offer asks a question when it gives up waiting; asking late is still
# asking. This script tears the desktop down, so giving up and proceeding is the
# exact harm the wait exists to prevent, just delayed by five minutes. Booted,
# with the wizard left open on step 1, that is precisely what happened: at the
# five-minute mark plasmashell was restarted underneath the wizard. Nothing
# broke — the taskbar and the wizard both survived — but an owner reading the
# five screens carefully is the owner most likely to still be there, and is
# exactly who this was written for.
#
# So a wizard that is STILL running means: not this session. Exit and leave the
# autostart entry alone, so the next login does it with nothing on screen. That
# is the same self-healing choice this file already makes when the launcher
# applet cannot be found (see below) and for the same stated reason — better a
# delayed brand than a disruptive one. The cost is that a slow owner's launcher
# carries the stock icon until their second login, which nobody will notice; the
# cost of the alternative is the desktop vanishing while they read.
i=0
while [ "$i" -lt 150 ] && pgrep -f '/usr/bin/dagric-firstrun' >/dev/null 2>&1; do
    i=$((i + 1))
    sleep 2
done
if pgrep -f '/usr/bin/dagric-firstrun' >/dev/null 2>&1; then
    exit 0
fi

# Wait up to ~60s for plasmashell to write its applet config AND for it to
# contain a kickoff/kicker launcher applet. plasmashell writes this file
# lazily after the session settles, so a fixed short sleep races against it.
find_applet() {
    [ -f "$CFG" ] || return 1
    gawk '
      match($0, /^\[Containments\]\[([0-9]+)\]\[Applets\]\[([0-9]+)\]$/, a) { n=a[1]; m=a[2] }
      /^plugin=org\.kde\.plasma\.kickoff$/ || /^plugin=org\.kde\.plasma\.kicker$/ { print n" "m; exit }
    ' "$CFG" 2>/dev/null
}

N=""; M=""
i=0
while [ "$i" -lt 60 ]; do
    IDX=$(find_applet)
    if [ -n "$IDX" ]; then
        set -- $IDX
        N="$1"; M="$2"
        break
    fi
    i=$((i + 1))
    sleep 1
done

# Launcher not found this session — keep the autostart entry so the next login
# retries. Better a delayed brand than a permanent silent no-op.
[ -n "$N" ] && [ -n "$M" ] || exit 0

# THE FAVOURITES THE LAUNCHER OPENS ON, seeded here for the same reason the
# icon is: this is the one place that reliably runs once, on a real session,
# with plasmashell stopped so the write cannot be flushed away.
#
# WHY NOT IN THE .look FILES. They do carry it too, and that is correct for the
# path where somebody PICKS a layout — but a .look SCRIPT only runs at the
# moment a layout is applied. Booted and confirmed: with no layout chosen, the
# desktop comes up on Plasma's stock Breeze panel, there is no seeded appletsrc
# in /etc/skel and no hook applies a layout at build time. So the default path
# through the wizard — skip the layout step — never ran that script, and the
# launcher kept KDE's own five defaults. This covers that path.
#
# COMMA-SEPARATED HERE, AN ARRAY THERE, and both are right. favorites is a
# StringList: in the config FILE a list is comma-separated text, which is what
# kwriteconfig6 writes; through Plasma's JS scripting API the same key needs a
# real array. Passing a comma-joined string to the scripting API is what made
# the first attempt at this a silent no-op for a whole build cycle.
#
# preferred://browser rather than firefox-esr.desktop is upstream's own idiom,
# documented in the applet's config schema: it follows whatever the owner sets
# as their browser instead of pinning the one we happened to ship.
FAVS='dagric-hub.desktop,preferred://browser,systemsettings.desktop,org.kde.dolphin.desktop,org.kde.discover.desktop'

# Already done (e.g. a prior login succeeded)? Then just retire and stop.
#
# BOTH keys are checked, not just the icon. An installed machine that branded
# its launcher before this file learned about favourites would otherwise have
# retired the autostart entry already, and would never get them — the upgrade
# case is exactly the one an icon-only guard would silently skip.
CUR=$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
  --group Containments --group "$N" --group Applets --group "$M" \
  --group Configuration --group General --key icon 2>/dev/null)
CURFAV=$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
  --group Containments --group "$N" --group Applets --group "$M" \
  --group Configuration --group General --key favorites 2>/dev/null)
case "$CURFAV" in
    dagric-hub.desktop*) FAVDONE=yes ;;
    *)                   FAVDONE=no  ;;
esac
if [ "$CUR" = "dagric-logo" ] && [ "$FAVDONE" = yes ]; then
    rm -f "$AUTOSTART"
    exit 0
fi

# 1) Stop plasmashell FIRST so it flushes its in-memory config and stops
#    writing to the appletsrc — otherwise its exit-flush overwrites our change.
if command -v kquitapp6 >/dev/null 2>&1; then
    kquitapp6 plasmashell 2>/dev/null || true
fi
# Wait for the process to actually exit (up to ~8s) so the file is quiescent.
j=0
while [ "$j" -lt 8 ] && pgrep -x plasmashell >/dev/null 2>&1; do
    j=$((j + 1)); sleep 1
done
pgrep -x plasmashell >/dev/null 2>&1 && { kill "$(pgrep -x plasmashell)" 2>/dev/null; sleep 1; }

# 2) Now the file is ours to edit safely.
kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
  --group Containments --group "$N" --group Applets --group "$M" \
  --group Configuration --group General --key icon dagric-logo 2>/dev/null

# Favourites are seeded ONLY when the owner has not chosen their own — and
# "has not chosen" is TWO states, not one. That distinction is the whole reason
# the first version of this did nothing.
#
#   absent   the key is not in the file at all and the applet is falling back
#            to its built-in default
#   default  plasmashell has MATERIALISED that same built-in default into the
#            file, so the key is present and non-empty and still represents no
#            decision by anybody
#
# A bare `[ -z "$CURFAV" ]` treats the second as the owner's considered choice
# and refuses to touch it. Booted with exactly that guard and the launcher kept
# KDE's five, which is the symptom either state produces — the display cannot
# tell them apart, so the code must handle both.
#
# The comparison value is READ FROM THE APPLET'S OWN SCHEMA rather than
# hardcoded, so a future Plasma that ships a different default still matches and
# this keeps working instead of quietly reverting to "leave it alone forever".
KICKOFF_XML=/usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml
STOCK=$(gawk '
  /<entry name="favorites"/ { inentry = 1 }
  inentry && match($0, /<default>(.*)<\/default>/, d) { print d[1]; exit }
' "$KICKOFF_XML" 2>/dev/null)

UNTOUCHED=no
[ -z "$CURFAV" ] && UNTOUCHED=yes
[ -n "$STOCK" ] && [ "$CURFAV" = "$STOCK" ] && UNTOUCHED=yes

# A LINE IN THE JOURNAL SAYING WHAT WAS DECIDED AND WHY.
#
# Four attempts at this shipped and four came back looking identical from the
# outside, because every failure mode here — wrong key, wrong type, script
# never runs, guard declines — produces the same screen: KDE's five favourites.
# The screen cannot distinguish them and neither could I. One log line can.
# `journalctl --user -t dagric-brand-launcher` now answers it in a second, on a
# real machine, without a rebuild.
logger -t dagric-brand-launcher \
  "favourites: existing=[${CURFAV:-<absent>}] untouched=$UNTOUCHED" 2>/dev/null || true

if [ "$UNTOUCHED" = yes ]; then
    kwriteconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
      --group Containments --group "$N" --group Applets --group "$M" \
      --group Configuration --group General --key favorites "$FAVS" 2>/dev/null
fi

# 3) Relaunch plasmashell — it reads the freshly branded config on start.
if command -v kstart >/dev/null 2>&1; then
    ( kstart plasmashell >/dev/null 2>&1 & ) 2>/dev/null
else
    ( plasmashell >/dev/null 2>&1 & )
fi

# Confirm the write actually stuck before retiring the autostart; if it didn't,
# leave the autostart so the next login tries again.
sleep 2
VERIFY=$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
  --group Containments --group "$N" --group Applets --group "$M" \
  --group Configuration --group General --key icon 2>/dev/null)
VFAV=$(kreadconfig6 --file plasma-org.kde.plasma.desktop-appletsrc \
  --group Containments --group "$N" --group Applets --group "$M" \
  --group Configuration --group General --key favorites 2>/dev/null)
# Retire only when the icon stuck AND favourites are either ours or the owner's
# own choice. Retiring on the icon alone would strand the favourites write on
# any session where it did not take, which is the failure this file's whole
# self-healing design exists to avoid.
case "$VFAV" in
    dagric-hub.desktop*) FAVOK=yes ;;
    '')                  FAVOK=no  ;;
    *)                   FAVOK=yes ;;
esac
[ "$VERIFY" = "dagric-logo" ] && [ "$FAVOK" = yes ] && rm -f "$AUTOSTART"
