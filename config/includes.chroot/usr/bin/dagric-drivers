#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — proprietary driver setup, done honestly.
# Detects an NVIDIA GPU and installs the driver from Debian's own
# non-free repository. Nothing runs without the owner asking for it.
#
# This runs as root, under sudo or pkexec. Both keep LANG/LC_* from the calling
# session — polkit's env whitelist includes the locale variables — so the owner
# still reads this in their own language after authenticating.
set -e
. /usr/bin/dagric-i18n.sh

if [ "$(id -u)" != "0" ]; then
    # TRANSLATORS: "sudo dagric-drivers" is a command typed verbatim.
    dg_say "$(gettext "Run with sudo: sudo dagric-drivers")"
    exit 1
fi

dg_say "$(gettext "Dagric driver check")"
echo "---------------------"
if lspci | grep -qi 'vga.*nvidia\|3d.*nvidia'; then
    dg_say "$(gettext "NVIDIA GPU detected:")"
    lspci | grep -i nvidia
    echo ""
    dg_live_warn
    # "from the system's non-free repository", not "from Debian non-free". The
    # meaning a consent prompt has to carry is that this driver is PROPRIETARY
    # and comes from the separate repository kept for such things — which this
    # says, in words that do not assume the owner knows what Debian is. It is
    # not a euphemism: the non-free repository is exactly where it comes from,
    # and /licenses on the site names Debian as the upstream in full.
    printf '%s ' "$(gettext "Install NVIDIA's proprietary driver from the system's non-free repository? [y/N]")"
    read -r answer
    if dg_is_yes "$answer"; then
            # Secure Boot check UP FRONT: an unsigned DKMS module won't load
            # under enforcing Secure Boot, which strands the user at a black
            # screen after reboot. Detect it so we can walk them through MOK
            # enrollment instead of letting it fail silently.
            SB="disabled"
            if command -v mokutil >/dev/null 2>&1; then
                mokutil --sb-state 2>/dev/null | grep -qi "enabled" && SB="enabled"
            fi
            if [ "$SB" = "enabled" ]; then
                echo ""
                # TRANSLATORS: this warns that skipping the enrollment step
                # leaves the machine at a BLACK SCREEN after reboot. Keep that
                # consequence explicit — it is the whole point of the notice.
                dg_say "$(gettext "NOTE: Secure Boot is ON. The NVIDIA driver builds a kernel
module that must be signed and enrolled, or it won't load
(black screen). Dagric will set up the signing key and ask
you to enroll it — you'll finish that at the next reboot.")"
                echo ""
            fi

            # linux-headers-amd64 IS NAMED HERE OR THE DRIVER NEVER BUILDS.
            #
            # nvidia-driver pulls nvidia-kernel-dkms, which pulls dkms, and dkms
            # only RECOMMENDS the kernel headers. Dagric ships
            # /etc/apt/apt.conf.d/01dagric-norecommends, whose own comment says
            # it "applies forever on installed systems, not just at ISO build
            # time" — so on the owner's machine this apt-get would install dkms
            # with nothing to compile against.
            #
            # The failure is silent in the worst way. DKMS reports the missing
            # headers as a warning inside a postinst, apt still exits 0, this
            # script prints "Done. Reboot to switch to the NVIDIA driver", and
            # the module simply is not there after the reboot. On a Secure Boot
            # machine that is indistinguishable from the signing problem the
            # block above exists to solve, which is a genuinely miserable thing
            # to debug.
            #
            # The metapackage rather than a version: it tracks whichever kernel
            # is installed, so this keeps working across kernel upgrades instead
            # of pinning headers that stop matching after the first one.
            # GUARDED. This was bare, and under `set -e` a failed update — no
            # connection, an expired Release, one 404 index — killed the script
            # on this line with raw apt output as the only explanation, which is
            # the failure mode every other message in this file is written to
            # avoid.
            apt-get update || {
                dg_say "$(gettext "Could not reach the package servers.

Nothing was changed — try again when you are back online.")"
                exit 1
            }

            # WHICH nvidia-driver? THE CARD DECIDES, NOT THIS SCRIPT.
            #
            # This installed the plain `nvidia-driver` metapackage on every
            # machine. That is the CURRENT branch, and it dropped support for
            # Kepler (GeForce 600/700, 2012-2014) and everything older. Those are
            # squarely inside the 2012-2018 hardware window this OS is sold to
            # rescue, so the owners most likely to need a driver helper were the
            # ones it could not help: apt installs a driver that refuses to bind
            # the card, X falls back, and nothing says why.
            #
            # nvidia-detect reads the PCI ID and names the right metapackage —
            # nvidia-driver, nvidia-tesla-470-driver, nvidia-legacy-390xx-driver
            # and so on.
            #
            # Parsed by matching the PACKAGE NAME PATTERN rather than the
            # sentence around it. The obvious approach — awk -F': ' on "It is
            # recommended to install the" — assumes a colon and a single line,
            # and nvidia-detect prints the package on its own following line with
            # no colon at all, so that returns empty and silently falls back.
            # Matching ^nvidia-.*driver$ across the whole output cannot be broken
            # by upstream rewording.
            # nvidia-detect is fetched HERE rather than shipped in the ISO. It
            # lives in non-free and exists only to answer this one question, and
            # by this line the owner has already said yes to proprietary NVIDIA
            # drivers — so it costs the image nothing and arrives exactly when
            # consent has been given. Failure is not fatal; the fallback below
            # handles it.
            apt-get install -y nvidia-detect >/dev/null 2>&1 || true

            NVPKG=""
            if command -v nvidia-detect >/dev/null 2>&1; then
                NVPKG=$(nvidia-detect 2>/dev/null \
                        | grep -oE '\bnvidia-([a-z]+-)?[0-9]*x*x*-?driver\b|\bnvidia-driver\b' \
                        | head -1)
            fi
            # NO SILENT FALLBACK TO THE CURRENT BRANCH. This used to default to
            # plain `nvidia-driver` whenever detection was unavailable or
            # inconclusive, and that is the most damaging thing it could do.
            #
            # Installing nvidia-driver BLACKLISTS nouveau. On a card the current
            # branch dropped — Kepler and older, which is precisely the
            # 2012-2014 hardware this OS exists to rescue — the proprietary
            # module then refuses to bind and the open-source driver that was
            # working has been disabled underneath it. The result is a black
            # screen on a machine that displayed a desktop five minutes ago,
            # reached by a helper the owner ran to IMPROVE their graphics.
            #
            # Not installing anything leaves nouveau working. A machine that
            # still boots is always the better failure.
            if [ -z "$NVPKG" ]; then
                dg_say "$(gettext "Could not work out which NVIDIA driver this card needs.

Nothing has been installed, and your screen keeps working on the open-source
driver it is using now. Installing the wrong branch would disable that driver
and could leave you with a black screen, so this stops instead of guessing.

Check your connection and try again — or report the card at
https://dagric.com/support and we will tell you which driver it takes.")"
                exit 1
            fi
            echo "nvidia-detect recommends: $NVPKG" >&2

            # A wrong or unavailable package name must not abort the script
            # under set -e with raw apt output as the only explanation.
            if ! apt-get install -y linux-headers-amd64 "$NVPKG" firmware-misc-nonfree; then
                # PUT THE MACHINE BACK BEFORE SPEAKING, AND DO NOT CLAIM
                # "Nothing was changed" — it was not true.
                #
                # apt-get returns non-zero for a whole family of mid-transaction
                # failures: a postinst that fails after unpack, a DKMS build
                # error, the disk filling during unpack. In every one of those
                # the nvidia-*-kernel-common package is already unpacked and
                # configured, so its nouveau blacklist under /etc/modprobe.d is
                # live and the initramfs trigger has run. The old text promised
                # the open-source driver still worked at the exact moment it had
                # just been switched off, and exited without cleaning up, so
                # nothing later undid it either. It also diagnosed a connection
                # problem for failures that have nothing to do with the network.
                for _b in /etc/modprobe.d/nvidia-blacklists-nouveau.conf \
                          /etc/modprobe.d/nvidia-*-blacklists-nouveau.conf; do
                    [ -e "$_b" ] || continue
                    mv "$_b" "$_b.dagric-disabled" 2>/dev/null || true
                done
                update-initramfs -u >/dev/null 2>&1 || true
                dg_say "$(gettext "The driver did not install.

The open-source driver has been left switched on, so your screen keeps working.
If you were offline, try again when you are back online; otherwise report the
card at https://dagric.com/support and we will tell you which driver it takes.")"
                exit 1
            fi

            # Say so if the module did not actually get built, rather than
            # letting the reboot be the thing that finds out.
            if command -v dkms >/dev/null 2>&1; then
                if ! dkms status 2>/dev/null | grep -qi 'nvidia.*installed'; then
                    # MAKE THE PROMISE TRUE BEFORE MAKING IT.
                    #
                    # This branch is reached only when the install SUCCEEDED, so
                    # nvidia-*-kernel-common is configured, its nouveau
                    # blacklist under /etc/modprobe.d is live and the initramfs
                    # trigger has baked it in — and the branch's own module did
                    # not build. The old text told the owner to reboot into a
                    # machine with no KMS driver at all, said the open-source
                    # driver would keep the screen working at the moment the
                    # packages had switched it off, and then told them to re-run
                    # this helper from a desktop that was not coming back. That
                    # is the black screen the no-silent-fallback comment above
                    # exists to prevent, on the one path where the failure is
                    # already known. Undo the blacklist instead.
                    for _b in /etc/modprobe.d/nvidia-blacklists-nouveau.conf \
                              /etc/modprobe.d/nvidia-*-blacklists-nouveau.conf; do
                        [ -e "$_b" ] || continue
                        mv "$_b" "$_b.dagric-disabled" 2>/dev/null || true
                    done
                    update-initramfs -u >/dev/null 2>&1 || true
                    dg_say "$(gettext "WARNING: the NVIDIA kernel module did not finish building.
The open-source driver has been switched back on, so the screen still works
after a reboot. Re-run this helper afterwards and it will report what went
wrong.")"
                fi
            fi

            if [ "$SB" = "enabled" ]; then
                # Enroll the Machine Owner Key so the DKMS-built module is
                # trusted. This prompts for a one-time password you re-enter in
                # the blue "MOK Manager" screen at the next boot.
                if command -v update-secureboot-policy >/dev/null 2>&1; then
                    update-secureboot-policy --enroll-key 2>/dev/null || true
                fi
                echo ""
                # TRANSLATORS: 'MOK Management', 'Enroll MOK' and 'Continue' are
                # the literal words on the blue firmware screen at the next
                # boot. That screen is ENGLISH ONLY and cannot be translated, so
                # these three must stay in English or the owner will hunt for a
                # button that is not there. Everything around them should be
                # translated.
                dg_say "$(gettext "IMPORTANT — finish Secure Boot enrollment:
  1. Reboot now.
  2. At the blue 'MOK Management' screen, choose
     'Enroll MOK' -> 'Continue' and enter the password
     you were just asked for.
  3. The system boots into the NVIDIA driver.
If you skip this, the driver won't load and you'll fall
back to the open-source driver. You can re-run this anytime.")"
            else
                dg_say "$(gettext "Done. Reboot to switch to the NVIDIA driver.")"
            fi
    else
            dg_say "$(gettext "Nothing changed.")"
    fi
else
    dg_say "$(gettext "No NVIDIA GPU found. AMD and Intel graphics use the built-in
open-source drivers — nothing to install.")"
fi
