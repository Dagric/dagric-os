#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Dagric OS — "Family Limits": screen time and bedtime for a child's account.
#
# WHY DAGRIC WRITES ITS OWN FACE FOR THIS. The engine is timekpr-next, which is
# good: its daemon tracks sessions through logind, so it is correct on Wayland,
# which most of the alternatives are not. What it cannot do is speak to this
# product's owners — it ships translations for Italian and Latvian ONLY, and
# Dagric ships six languages. Putting its GTK3 admin window in front of a German,
# French, Spanish or Brazilian parent would hand them an English dialog for the
# one feature they are most likely to get wrong, which is exactly the defect
# 465dc7b was written to fix for Qt's own strings. So: their daemon, our window.
#
# THE SPLIT, and it is the same one the first-run wizard uses. This script is the
# only thing that decides anything; /usr/share/dagric/family/main.qml is the view
# and cannot execute a program. The privileged write is a third piece,
# /usr/lib/dagric/family-apply, reached through pkexec — so the thing that edits
# a root daemon's config is a small script that validates every argument, not a
# QML file and not this one.
#
#   this script   writes a catalogue (JSON) and passes it as --catalog=PATH
#   the window    prints  @DAGRIC@<COMMAND>|<argument>  as the parent clicks
#   this script   validates, then calls pkexec family-apply
#
# WHY IT IS ON THE FREE EDITION. A Brazilian school or family on the free edition
# has to be able to comply with the law that made this feature urgent, and pt_BR
# is one of the six languages Dagric already ships. Gating legal compliance
# behind $39 in the market that legislated it does not meet the requirement it
# was justified by. The Family Pack sells Pro on several machines; it does not
# sell this.
set -eu

. /usr/bin/dagric-i18n.sh

QMLDIR=/usr/share/dagric/family
QMLFILE=$QMLDIR/main.qml
APPLY=/usr/lib/dagric/family-apply
CONFDIR=/var/lib/timekpr/config
TITLE=$(gettext "Family Limits")

note() { kdialog --title "$TITLE" --passivepopup "$1" 7 >/dev/null 2>&1 & }
fail() { kdialog --title "$TITLE" --sorry "$1" >/dev/null 2>&1 || printf '%s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- can we run?
# The engine is a package, not a promise. Say so plainly rather than opening a
# window whose Save button cannot work.
[ -x /usr/bin/timekprd ] || fail "$(gettext "The screen-time service is not installed on this computer.")"
[ -d "$CONFDIR" ] || fail "$(gettext "The screen-time service has not finished setting itself up yet.
Restart the computer and try again.")"
[ -r "$QMLFILE" ] || fail "$(gettext "Part of this program is missing from the computer.")"

# timekpr writes a per-user config the first time its daemon sees an account. On
# a machine where a child has never logged in there is nothing to edit yet, and
# that is worth saying in words rather than showing an empty list.
command -v qml6 >/dev/null 2>&1 || fail "$(gettext "The window system component this needs is missing.")"

# ------------------------------------------------------------- who is on here
# Ordinary human accounts only. uid >= 1000 and < 60000 is the Debian range for
# people; anything else is a service account and has no screen time.
#
# THE ADMIN COUNT IS THE SAFETY PROPERTY. A parental-controls feature that locks
# out the last administrator is not a bug report, it is a refund — the owner
# cannot undo it, because undoing it needs the account they just locked. The
# window greys those rows out and family-apply refuses them again on the
# privileged side, because a GUI is a convenience and the boundary is where the
# check has to be.
ADMINS=$(getent group sudo 2>/dev/null | cut -d: -f4 | tr ',' ' ')
n_admins=0
for a in $ADMINS; do getent passwd "$a" >/dev/null 2>&1 && n_admins=$((n_admins + 1)); done

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# ============================================================ the window's words
#
# THE WINDOW'S VOCABULARY, TRANSLATED HERE RATHER THAN IN QML — the same
# arrangement dagric-firstrun uses, and for the same reason it wrote down: the
# Qt-native answer (qsTr plus lupdate/lrelease and a .qm per language) would put
# a second translation system beside the gettext one that already works, and
# translators would then maintain .po AND .ts.
#
# main.qml shipped using qsTr() with none of that machinery behind it: no .qm
# anywhere in the image, no QTranslator, no lrelease in the build. So the whole
# window rendered in English for the five translated languages — in the one
# feature whose own header says it exists BECAUSE timekpr's GUI is not
# translated into them. Declared here, xgettext finds these with no new tooling
# and they ride to the window inside the catalogue it already reads.
#
# THIS LIST IS THE WINDOW'S VOCABULARY AND MUST MATCH IT EXACTLY. A line here
# that main.qml never asks for is a translation nobody reads; a string in
# main.qml missing from here appears in English inside an otherwise translated
# window. tools/i18n-family.py checks the pairing in both directions.
#
# The KEY is the English sentence, so the fallback for anything missing is
# correct English rather than an identifier.
emit_strings() {
    _first=1
    while IFS= read -r _s; do
        [ -n "$_s" ] || continue
        [ "$_first" = 1 ] || printf ',\n'
        _first=0
        printf '    "%s": "%s"' "$(json_escape "$_s")" "$(json_escape "$(gettext "$_s")")"
    done <<'STRINGS'
Family Limits
Set how long someone can use this computer each day, and the hours when it locks itself. Their files and their account are not touched.
Person:
Person to set limits for
This is the only administrator account on this computer. Limits cannot be set on it, because there would be no way back in. Create a second administrator account first.
This person has not signed in yet, so there is nothing to change. Ask them to sign in once, then come back.
Limit this person's screen time
Time allowed each day
Time allowed each day: %1
Bedtime: none — the computer never locks by the clock
The computer locks from %1 to %2
From
until
Bedtime starts at
Bedtime ends at
Set both to the same hour for no bedtime at all.
When the time is up:
Lock the screen — nothing is closed, nothing is lost
Sign out — closes everything that is open
Remove all limits
Lets this person use the computer at any time, for as long as they like
Close
Save
Save these limits for %1
%1 minutes
1 hour
%1 hours
%1 h %2 min
STRINGS
}

CATALOG=$(mktemp -t dagric-family.XXXXXX) || fail "$(gettext "Could not start.")"
# The catalogue can name every account on the machine, so it is readable only by
# the person who opened the window.
chmod 0600 "$CATALOG"
cleanup() { rm -f "$CATALOG"; }
trap cleanup EXIT INT TERM

{
    printf '{\n  "people": [\n'
    first=1
    getent passwd | while IFS=: read -r u _x uid _gid gecos home shell; do
        case "$uid" in ''|*[!0-9]*) continue ;; esac
        [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
        [ -d "$home" ] || continue
        case "$shell" in */nologin|*/false) continue ;; esac

        conf="$CONFDIR/timekpr.$u.conf"
        # No config yet means timekpr's daemon has not seen this account log in.
        [ -f "$conf" ] && known=true || known=false

        # Read the current state back so the window opens showing what is
        # actually set, not a blank form. LIMITS_PER_WEEKDAYS is seven values;
        # the first is representative because this tool writes them all alike.
        mins=0; bedfrom=0; bedto=0; lock=lock
        if [ "$known" = true ]; then
            secs=$(awk -F= '/^LIMITS_PER_WEEKDAYS/{split($2,a,";"); gsub(/ /,"",a[1]); print a[1]; exit}' "$conf" 2>/dev/null)
            case "$secs" in ''|*[!0-9]*) secs=86400 ;; esac
            mins=$((secs / 60))
            # Bedtime is the gap in ALLOWED_HOURS_1. A full 24 means none set.
            hrs=$(awk -F= '/^ALLOWED_HOURS_1/{print $2; exit}' "$conf" 2>/dev/null | tr -d ' ')
            n_hrs=$(printf '%s' "$hrs" | tr ';' '\n' | grep -c '[0-9]' || true)
            if [ "${n_hrs:-24}" -lt 24 ]; then
                # A BEDTIME WRAPS MIDNIGHT, WHICH IS WHY THIS IS NOT "the first
                # missing hour". The first version scanned upward from 0 and took
                # the first hour that was not allowed. For the normal setting —
                # 21:00 to 07:00 — the blocked hours are 21,22,23,0,1,...,6, so
                # that scan answered 0, and the window reopened showing "locks
                # from 00:00 to 07:00". A parent who then pressed Save would have
                # had their real 21:00 bedtime silently rewritten to midnight.
                # Caught by saving 21-to-7 and reading it back, not by reading
                # the code.
                #
                # The boundaries are what matter, not the first gap: bedtime
                # STARTS at the blocked hour whose previous hour is allowed, and
                # ENDS at the allowed hour whose previous hour is blocked. That
                # is correct whether or not the run crosses midnight, and this
                # tool only ever writes one contiguous run.
                bedfrom=$(awk -v h="$hrs" 'BEGIN{
                    n=split(h,a,";"); for(j=1;j<=n;j++) al[a[j]+0]=1
                    for(i=0;i<24;i++){ p=(i+23)%24; if(!al[i] && al[p]){ print i; exit } } }')
                bedto=$(awk -v h="$hrs" 'BEGIN{
                    n=split(h,a,";"); for(j=1;j<=n;j++) al[a[j]+0]=1
                    for(i=0;i<24;i++){ p=(i+23)%24; if(al[i] && !al[p]){ print i; exit } } }')
                : "${bedfrom:=0}" "${bedto:=0}"
            fi
            lock=$(awk -F= '/^LOCKOUT_TYPE/{gsub(/ /,"",$2); print $2; exit}' "$conf" 2>/dev/null)
            case "$lock" in lock|terminate) ;; *) lock=lock ;; esac
        fi

        # Is this person an administrator, and are they the only one?
        isadmin=false; protected=false
        if id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx sudo; then
            isadmin=true
            [ "$n_admins" -le 1 ] && protected=true
        fi

        real=$(printf '%s' "$gecos" | cut -d, -f1)
        [ -n "$real" ] || real=$u

        [ "$first" = 1 ] || printf ',\n'
        first=0
        printf '    {"user":"%s","name":"%s","admin":%s,"protected":%s,' \
            "$(json_escape "$u")" "$(json_escape "$real")" "$isadmin" "$protected"
        printf '"known":%s,"minutes":%s,"bedFrom":%s,"bedTo":%s,"lockout":"%s"}' \
            "$known" "$mins" "${bedfrom:-0}" "${bedto:-0}" "$lock"
    done
    printf '\n  ],\n'
    printf '  "strings": {\n'
    emit_strings
    printf '\n  }\n}\n'
} > "$CATALOG"

# A machine with no ordinary accounts other than a lone administrator has
# nothing this window can usefully offer.
if ! grep -q '"user"' "$CATALOG"; then
    fail "$(gettext "There are no other accounts on this computer yet.

Create an account for the person you want to set limits for first, in
System Settings, then come back.")"
fi

# ---------------------------------------------------------------- the window
# Same argv[0] trick as the wizard: Qt takes WM_CLASS from basename(argv[0]), so
# launched as plain qml6 this window matches no .desktop file and gets a generic
# icon and title in the task switcher.
RUNNER=/usr/lib/dagric/wm/dagric-family
[ -x "$RUNNER" ] || RUNNER=$(command -v qml6)

# THE WINDOW CANNOT READ ITS OWN CATALOGUE WITHOUT THIS.
#
# main.qml loads the catalogue with XMLHttpRequest against a file:// URL, and
# Qt 6 refuses local-file reads unless this is set:
#
#   XMLHttpRequest: Using GET on a local file is disabled by default.
#   Set QML_XHR_ALLOW_FILE_READ to 1 to enable this feature.
#
# It is a WARNING on stderr, not an error, and the window opens perfectly —
# with an empty person list and every control disabled. So the failure looks
# exactly like "this computer has no other accounts", which is a real state
# this tool reports on purpose, and the two are indistinguishable on screen.
# Found by rendering the panel under Xvfb and reading Qt's output; no amount of
# looking at the QML would have shown it.
#
# Scoped to this one exec rather than exported globally: it relaxes a sandbox
# rule, and it should apply to the process that needs it and nothing else.
QML_XHR_ALLOW_FILE_READ=1 \
"$RUNNER" "$QMLFILE" -- "--catalog=$CATALOG" 2>&1 | while IFS= read -r line; do
    case "$line" in
        "@DAGRIC@"*) ;;
        *) continue ;;                       # ordinary Qt chatter, not an order
    esac
    payload=${line#@DAGRIC@}
    cmd=${payload%%|*}
    arg=${payload#*|}

    case "$cmd" in
        SET)
            # user;minutes;bedfrom;bedto;lockout — every field re-checked here
            # and AGAIN inside family-apply, which is the actual boundary.
            u=$(printf '%s' "$arg" | cut -d';' -f1)
            m=$(printf '%s' "$arg" | cut -d';' -f2)
            bf=$(printf '%s' "$arg" | cut -d';' -f3)
            bt=$(printf '%s' "$arg" | cut -d';' -f4)
            lk=$(printf '%s' "$arg" | cut -d';' -f5)
            case "$m$bf$bt" in *[!0-9]*) continue ;; esac
            case "$lk" in lock|terminate) ;; *) continue ;; esac
            if pkexec "$APPLY" set "$u" "$m" "$bf" "$bt" "$lk" >/dev/null 2>&1; then
                note "$(eval_gettext 'Limits saved for $u.')"
            else
                note "$(gettext "Those limits were not saved. Nothing on this computer has changed.")"
            fi
            ;;
        REMOVE)
            u=$arg
            if pkexec "$APPLY" remove "$u" >/dev/null 2>&1; then
                note "$(eval_gettext 'Limits removed for $u.')"
            else
                note "$(gettext "The limits were not removed. Nothing on this computer has changed.")"
            fi
            ;;
    esac
done
