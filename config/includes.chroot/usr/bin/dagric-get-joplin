#!/bin/sh
# SPDX-FileCopyrightText: 2026 DGR Operations <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — install Joplin, on request.
# Joplin (open source, MIT) is a notes + to-do app that stores everything
# LOCALLY in open Markdown — no account, no forced cloud, works offline.
# End-to-end-encrypted sync is optional and self-hostable. The private
# alternative to OneNote/Notion. Installed from Flathub per-user (no root).
cat << 'EOF'
Dagric — install Joplin (notes that stay yours)

Joplin keeps notes, notebooks, and to-dos in plain Markdown on YOUR disk.
No account required, works fully offline, and if you ever want sync it's
end-to-end encrypted — to a folder, Syncthing, or your own server.
The private alternative to OneNote and Notion. From Flathub.
EOF

printf '\nInstall Joplin now? [y/N] '
read ans
case "$ans" in y|Y|yes|YES) ;; *) echo "No changes made."; exit 0 ;; esac

flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
if flatpak install --user -y --noninteractive flathub net.cozic.joplin_desktop; then
    echo; echo "Joplin installed — launch it from the application launcher."
else
    echo; echo "Install did not complete. Check your network and try again."
fi
