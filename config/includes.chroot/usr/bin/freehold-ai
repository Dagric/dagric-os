#!/bin/sh
# Freehold OS — privacy-first local AI, on your terms.
# Installs Ollama (local LLM runner — models run on YOUR hardware,
# nothing leaves the machine) from the official installer, only when
# the owner asks for it.
set -e
cat << 'EOF'
Freehold local AI setup
=======================
This installs Ollama, a local large-language-model runner:
  * models run entirely on this computer (GPU-accelerated when available)
  * works offline; nothing is sent anywhere
  * remove anytime:  sudo rm -f /usr/local/bin/ollama

EOF
printf "Install Ollama from https://ollama.com? [y/N] "
read -r answer
case "$answer" in
    y|Y)
        curl -fsSL https://ollama.com/install.sh | sh
        echo ""
        echo "Done. Try:  ollama run llama3.2"
        ;;
    *)
        echo "Nothing changed."
        ;;
esac
