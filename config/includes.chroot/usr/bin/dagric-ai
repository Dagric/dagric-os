#!/bin/sh
# SPDX-FileCopyrightText: 2026 IMPRESSIONSDIRECT360 LLC <repo@dagric.com>
# SPDX-License-Identifier: GPL-3.0-or-later
# Dagric OS — privacy-first local AI, installed from a reviewed release.
set -eu
. /usr/bin/dagric-i18n.sh

RELEASE=/usr/lib/dagric/ollama-release
[ -r "$RELEASE" ] || {
    dg_say "$(gettext "The reviewed Ollama release information is missing. Nothing was changed.")"
    exit 1
}
# shellcheck disable=SC1091
. "$RELEASE"

dg_say "$(gettext "Dagric local AI setup
=======================
This installs Ollama, a local large-language-model runner:
  * models run entirely on this computer (GPU-accelerated when available)
  * prompts and inference stay on this computer after a model is downloaded
  * installation and the first run need internet access to fetch Ollama and a model

What it changes on this machine:
  * installs the ollama binary and adds a system user for it
  * enables a restricted background service that starts at boot and listens
    only on this computer (127.0.0.1 port 11434)
  * downloaded models land in /usr/share/ollama and can be several GB each

To remove it completely:
  sudo systemctl disable --now ollama
  sudo rm -f /usr/local/bin/ollama /etc/systemd/system/ollama.service
  sudo rm -rf /usr/local/lib/ollama /usr/share/ollama
  sudo userdel ollama
")"
dg_live_warn

case "${1:-}" in
    -h|--help) exit 0 ;;
esac

case "$(uname -m)" in
    x86_64|amd64) ;;
    *)
        dg_say "$(gettext "This reviewed Ollama package is for 64-bit Intel/AMD computers. Nothing was changed.")"
        exit 1
        ;;
esac

printf '%s ' "$(eval_gettext 'Download and install reviewed Ollama $OLLAMA_VERSION (about 1.4 GB)? [y/N]')"
read -r answer
if ! dg_is_yes "$answer"; then
    dg_say "$(gettext "Nothing changed.")"
    exit 0
fi

WORK=$(mktemp -d "${TMPDIR:-/tmp}/dagric-ollama.XXXXXX") || exit 1
ARCHIVE=$WORK/ollama.tar.zst
trap 'rm -rf -- "$WORK"' EXIT HUP INT TERM
umask 077

if ! curl --proto '=https' --tlsv1.2 --fail --location --show-error \
        --output "$ARCHIVE" "$OLLAMA_URL"; then
    dg_say "$(gettext "Could not download the reviewed Ollama release. Nothing was changed; check your connection and try again.")"
    exit 1
fi

ACTUAL_SIZE=$(wc -c < "$ARCHIVE" | tr -d '[:space:]')
ACTUAL_SHA256=$(sha256sum "$ARCHIVE" | cut -d' ' -f1)
if [ "$ACTUAL_SIZE" != "$OLLAMA_SIZE" ] || [ "$ACTUAL_SHA256" != "$OLLAMA_SHA256" ]; then
    dg_say "$(gettext "The Ollama download did not match Dagric's reviewed release. Nothing was installed.")"
    exit 1
fi

dg_say "$(eval_gettext 'The download matches Dagric'"'"'s reviewed release ($OLLAMA_SHA256). Administrator approval is required for installation.')"

if ! pkexec /usr/lib/dagric/install-ollama "$ARCHIVE"; then
    dg_say "$(gettext "Ollama was not installed. Any previous working installation was restored.")"
    exit 1
fi

OLLAMA_LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/dagric"
OLLAMA_LOG="$OLLAMA_LOGDIR/ollama-install.log"
if mkdir -p "$OLLAMA_LOGDIR" 2>/dev/null &&
   printf '%s  %s  sha256=%s\n' \
       "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$OLLAMA_VERSION" "$OLLAMA_SHA256" \
       >> "$OLLAMA_LOG" 2>/dev/null; then
    chmod 0600 "$OLLAMA_LOG" 2>/dev/null || true
else
    printf 'dagric-ai: could not write %s\n' "$OLLAMA_LOG" >&2
fi

echo ""
dg_say "$(gettext "Done. Try:  ollama run llama3.2")"
