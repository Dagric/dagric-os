#
# Dagric OS — bootloader configuration during a Calamares install.
#
# THIS REPLACES calamares-settings-debian's OWN COPY OF THIS FILE, AND IT IS
# REPLACED BECAUSE THE ORIGINAL MAKES EVERY OFFLINE INSTALL FAIL.
#
# ---------------------------------------------------------------------------
# WHAT WENT WRONG
# ---------------------------------------------------------------------------
# Observed on a UEFI erase-disk install of dagric-os-1.0-amd64.iso in the test/
# harness. Partitioning succeeded completely — GPT written, 300 MiB FAT32 ESP,
# 19.71 GiB btrfs root labelled "Dagric" — and then the install died with:
#
#     Installation Failed
#     Command /usr/share/calamares/helpers/calamares-bootloader-config
#     finished with exit code 2.
#     Output: Running bootloader-config...
#             * Installing grub-efi (uefi)...
#             Reading package lists...  Building dependency tree...
#
# Debian's version of this script runs, inside the target:
#
#     apt-get -y install grub-efi        (UEFI)
#     apt-get -y install grub-pc         (BIOS)
#     apt-get -y install cryptsetup-initramfs cryptsetup keyutils   (encrypted)
#
# and this ISO has NO PACKAGE ARCHIVE ON IT. Verified by mounting the shipped
# image: there is no pool/ and no dists/ — only EFI, boot, efi.img, isolinux and
# live. calamares-sources-media adds /run/live/medium as an apt source, and that
# source is therefore EMPTY. So those apt calls can only ever succeed over the
# INTERNET, and a machine installing without a working network — which is the
# normal case for someone who has just wiped Windows and has no Wi-Fi driver
# configured yet — fails at the last step, after the disk has already been
# repartitioned. That is the worst possible place to fail.
#
# ---------------------------------------------------------------------------
# WHY SKIPPING THE apt CALLS IS CORRECT, NOT A WORKAROUND
# ---------------------------------------------------------------------------
# Every package those three commands ask for is ALREADY on the image, and the
# target filesystem is a copy of the image. Read out of the shipped
# live/filesystem.packages (1619 packages):
#
#     grub-common, grub2-common          grub-install and update-grub
#     grub-efi-amd64-bin / -signed        the x86_64-efi target
#     grub-pc-bin                         the i386-pc target
#     shim-signed, shim-helpers-amd64-signed, efibootmgr   Secure Boot
#     cryptsetup, cryptsetup-bin, cryptsetup-initramfs, keyutils   LUKS
#
# config/package-lists/installer.list.chroot puts them there deliberately, and
# its comment explains why the metapackages are NOT used: grub-pc and
# grub-efi-amd64 conflict with each other, so the underlying pieces are
# installed instead and both firmware paths stay available on one image. Asking
# apt for the `grub-efi` metapackage therefore requests the one thing the tree
# deliberately does not have, to obtain capabilities it already has.
#
# So: check for what is actually needed, and only reach for the network if
# something is genuinely absent. On a normal Dagric install nothing is, and the
# install completes with no network at all.
#
# DO NOT "fix" this instead by adding grub-efi to installer.list.chroot. That
# is the change installer.list.chroot warns against — the metapackage conflicts
# with grub-pc-bin and would cost the BIOS install path to buy the UEFI one.
# ---------------------------------------------------------------------------

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

if [ -z "$CHROOT" ] || [ ! -d "$CHROOT" ]; then
    echo "ERROR: could not locate the Calamares target root." >&2
    exit 1
fi

# have <package> — is it already installed in the TARGET?
# dpkg-query exits non-zero for unknown packages, and prints the status for
# known ones; "install ok installed" is the only state that counts.
have() {
    chroot "$CHROOT" dpkg-query -W -f='${Status}' "$1" 2>/dev/null \
        | grep -q "install ok installed"
}

# ensure <package>... — install only what is missing, and say what happened.
# A failure here is only fatal if the package really was absent, because that
# is the only case where the install cannot proceed.
ensure() {
    _missing=""
    for _p in "$@"; do
        have "$_p" || _missing="$_missing $_p"
    done
    if [ -z "$_missing" ]; then
        echo "   already present:$(printf ' %s' "$@")"
        return 0
    fi
    echo "   missing:$_missing — trying apt (this needs a network connection)"
    if DEBIAN_FRONTEND=noninteractive chroot "$CHROOT" apt-get -y install $_missing; then
        return 0
    fi
    echo "ERROR: could not install:$_missing" >&2
    echo "       The install medium carries no package archive, so this step" >&2
    echo "       needs the internet. Connect this machine to a network and run" >&2
    echo "       the installer again." >&2
    return 1
}

# Full-disk encryption: set the initramfs permissions snippet, then make sure
# the LUKS tooling is there. The initramfs is regenerated later in the install,
# so only the snippet is written here.
# `grep "$CHROOT" " "` passed TWO arguments — a pattern and a filename that was
# a single space — so grep never searched the mount table at all, it tried to
# open a file called " " and printed
#     grep: : No such file or directory
# into the installer's error dialog on every single install. The substitution
# then yielded the empty string, the test never matched, and the encrypted-disk
# branch below was DEAD CODE: an owner who ticked "Encrypt system" got no
# UMASK=0077 initramfs snippet and no cryptsetup check.
if [ "$(mount | grep " $CHROOT " | cut -c -16)" = "/dev/mapper/luks" ]; then
    echo "Configuring full-disk encryption..."
    echo "UMASK=0077" > "$CHROOT"/etc/initramfs-tools/conf.d/initramfs-permissions
    ensure cryptsetup cryptsetup-initramfs keyutils || exit 1
fi

echo "Running bootloader-config..."

if [ -d /sys/firmware/efi/efivars ]; then
    echo " * UEFI firmware detected — checking the EFI bootloader..."
    # grub2-common carries grub-install and update-grub; the -bin package
    # carries the x86_64-efi target modules; efibootmgr writes the NVRAM entry.
    # shim-signed and grub-efi-amd64-signed are what make Secure Boot work and
    # are checked separately so a missing one is named rather than guessed at.
    ensure grub2-common grub-efi-amd64-bin efibootmgr || exit 1
    if have shim-signed && have grub-efi-amd64-signed; then
        echo "   Secure Boot: signed shim and GRUB present"
    else
        echo "   NOTE: shim-signed or grub-efi-amd64-signed is absent — this" \
             "install will not boot with Secure Boot enabled."
    fi
else
    echo " * BIOS firmware detected — checking the legacy bootloader..."
    ensure grub2-common grub-pc-bin || exit 1
fi

# ---------------------------------------------------------------------------
# NOTHING BELOW TOUCHES GRUB'S CONFIG, AND THAT IS THE FIX.
#
# THIS SCRIPT USED TO END BY EDITING /etc/default/grub AND RUNNING update-grub,
# AND THAT MADE EVERY INSTALL FAIL — on both firmware paths, so the product
# could not be installed at all. Reproduced on a BIOS erase-disk install of the
# freshly built free ISO:
#
#     sed: can't read /tmp/calamares-root-rd5lbeq4/etc/default/grub:
#          No such file or directory
#     /usr/sbin/grub-mkconfig: 274: cannot create /boot/grub/grub.cfg.new:
#          Directory nonexistent
#     ERROR: update-grub failed in the target system.
#     Installation Failed
#
# The cause is the module order in calamares-settings-debian's settings.conf,
# which this script does not get to choose:
#
#     - bootloader-config   <- THIS SCRIPT
#     - grubcfg             <- the module that CREATES /etc/default/grub
#     - bootloader          <- the module that runs grub-install, creating
#                              /boot/grub, and then regenerates grub.cfg
#
# So both files this script needed were still two modules away from existing.
# Measured in the shipped squashfs and not inferred: /etc/default/grub is absent
# from the image (only /etc/default/grub.d/50-dagric.cfg is there) and /boot
# holds just the kernel, initrd, config and System.map — no grub directory.
#
# Running update-grub here was never necessary either. The `bootloader` module
# installs GRUB and regenerates the config itself, after both prerequisites
# exist. Removing the call is not a workaround; it is deleting work that was
# duplicated in the wrong order.
#
# THE os-prober SETTING MOVED RATHER THAN DISAPPEARED. Dual boot is a promise
# the homepage and the FAQ both make, so it still has to be set — it now lives
# in /etc/default/grub.d/50-dagric.cfg, which ships on the image, is copied to
# the target by unpackfs long before any of these modules run, and is sourced by
# grub-mkconfig after /etc/default/grub. No sed, no ordering assumption, and it
# applies to the live system and every future update-grub as well.
#
# WHAT THIS SCRIPT IS STILL FOR: checking that the GRUB pieces are actually in
# the target and only reaching for the network when one is genuinely missing.
# That is the offline-install fix described at the top, and it stays.
# ---------------------------------------------------------------------------

echo "bootloader-config: done"
