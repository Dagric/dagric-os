ForegroundVisited=225,160,255

[General]
ColorScheme=DagricHighContrast
Name=Dagric High Contrast
shadeSortColumn=true

[KDE]
# Breeze uses this 0-10 knob to decide how strongly to shade frames, separators
# and sunken areas. Breeze's own schemes sit at 4. At maximum, the outline
# around every button and text field is drawn as hard as Breeze can draw it,
# which is the difference between "I can see there is a box here" and not.
contrast=10

[WM]
# The active window's titlebar inverts to black-on-white. A low-vision user
# often cannot tell which window has focus from a colour shift alone; a
# full tonal flip is legible from across the room.
activeBackground=255,255,255
activeBlend=255,255,255
activeForeground=0,0,0
inactiveBackground=0,0,0
inactiveBlend=0,0,0
inactiveForeground=180,180,180
