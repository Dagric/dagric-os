# SPDX-License-Identifier: LGPL-2.0-or-later
#
# Dagric High Contrast. Structure and key names derived from KDE's
# BreezeLight.colors (LGPL-2.0-or-later); every colour value is new.
# SPDX-FileCopyrightText: Andrew Lake <jamboarder@gmail.com>
# SPDX-FileCopyrightText: Marco Martin <notmart@gmail.com>
# SPDX-FileCopyrightText: Nate Graham <nate@kde.org>
# SPDX-FileCopyrightText: Noah Davis <noahadvs@gmail.com>
#
# WHY THIS FILE EXISTS: Debian 13 ships no high-contrast Plasma colour scheme
# at all. `apt-file search '/usr/share/color-schemes/.*\.colors'` across the
# whole trixie archive returns Breeze (Classic/Dark/Light), Oxygen, Krita's
# private set and Arc — none of them high contrast. The only Breeze High
# Contrast in the archive is bundled privately inside labplot-data, and it is
# not actually high contrast: its [Colors:Button] ForegroundInactive measures
# 2.43:1 and its [Colors:Tooltip] ForegroundNeutral 1.07:1. Copying it would
# have shipped the word "high contrast" without the thing.
#
# So this scheme was authored and MEASURED, not eyeballed. Every Foreground*
# and Decoration* value is checked against BOTH BackgroundNormal and
# BackgroundAlternate of its own group using the WCAG 2.x relative-luminance
# formula. 160 pairs; the worst is 7.22:1 ([Colors:Selection]
# ForegroundInactive on BackgroundAlternate). WCAG 1.4.6 "Contrast (Enhanced)"
# asks 7:1, so the whole scheme clears AAA with room to spare — which is the
# point of a high-contrast scheme, as opposed to the 4.5:1 that ordinary AA
# text needs.
#
# 0530-accessibility.hook.chroot re-measures this file at build time and fails
# the build if any pair drops below 7:1. Edit the colours freely; the gate will
# tell you if you have quietly broken the promise in the name.
#
# The layout is deliberate, not just "dark":
#  - Every surface is pure black. Not near-black: a high-contrast user has
#    turned this on because near-black was not enough.
#  - BackgroundAlternate is 20,20,20 — just enough to see row striping,
#    not enough to cost a whole contrast grade.
#  - Selection inverts to white-on-black -> black-on-white, the way Windows
#    High Contrast does it. Nothing else on screen looks like that, so the
#    selected item is unmistakable even to someone who cannot resolve colour.
#  - DecorationFocus is 255,215,0 (gold) everywhere. WCAG 1.4.11 wants 3:1 for
#    the visual indication of a component's state; gold on black is 14.97:1,
#    and it is the one hue in the scheme that appears nowhere else, so "which
#    control has the keyboard" is answerable at a glance.

[ColorEffects:Disabled]
Color=0,0,0
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=false
Color=112,111,110
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=20,20,20
BackgroundNormal=0,0,0
DecorationFocus=255,215,0
DecorationHover=255,215,0
ForegroundActive=255,215,0
ForegroundInactive=180,180,180
ForegroundLink=128,190,255
ForegroundNegative=255,130,130
ForegroundNeutral=255,200,60
ForegroundNormal=255,255,255
ForegroundPositive=90,235,120
ForegroundVisited=225,160,255

