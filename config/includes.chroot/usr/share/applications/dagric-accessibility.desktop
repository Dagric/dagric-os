[Desktop Entry]
Type=Application
Name=Accessibility
GenericName=Make the computer easier to use
# SLOW KEYS IS DELIBERATELY NOT LISTED HERE, and putting it back is a defect.
# kaccess still draws the switch, but kwin 4:6.3.6-1 ships no SlowKeysPlugin and
# the older path (kaccess -> XkbSetControls) reaches XWayland clients only, while
# Dagric's session is Wayland: the box ticks and nothing changes. The reasoning
# is in /etc/skel/.config/kaccessrc, and site/accessibility.html publishes the
# same feature as "Does Not Support" for 508 502.4(B). It stays in Keywords=,
# which is a search index — somebody looking for it should still land on this
# panel — and out of Comment=, which is a promise. Mouse keys replaces it: that
# one has a KWin plugin and actually works.
Comment=Screen reader, magnifier, high contrast, sticky keys, bounce keys, mouse keys
Exec=systemsettings kcm_access
Icon=preferences-desktop-accessibility
Terminal=false
Categories=Settings;DesktopSettings;Accessibility;
Keywords=accessibility;a11y;ease of access;accessible;disability;disabled;impaired;screen reader;narrator;magnifier;magnify;zoom;enlarge;high contrast;contrast;colour blind;color blind;colorblind;sticky keys;slow keys;bounce keys;filter keys;mouse keys;visible bell;flash screen;deaf;hard of hearing;blind;low vision;large cursor;big pointer;
StartupNotify=true

