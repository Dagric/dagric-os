[Desktop Entry]
Type=Application
Name=USB Protection
GenericName=Block unknown USB devices
Comment=Turn USB device protection on or off, so an unknown USB stick cannot act on this PC behind your back
Exec=dagric-usb-protect
Icon=dagric-logo
Terminal=false
Categories=System;Security;Settings;
Keywords=usb;usbguard;badusb;protection;block;lockdown;port;ports;device;devices;stick;drive;security;
X-Dagric-Edition=pro

