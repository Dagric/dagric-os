[Desktop Entry]
Type=Application
Name=Install Heroic Games Launcher
GenericName=Epic, GOG and Amazon accounts
Comment=Install the independent open-source Heroic launcher for Epic Games Store, GOG and Amazon Games accounts
Exec=konsole -e sh -c '/usr/bin/dagric-get-heroic ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-get-heroic
Terminal=false
Categories=Game;
Keywords=heroic;epic;epic games;epic games store;gog;amazon games;games;gaming;launcher;store;install;

