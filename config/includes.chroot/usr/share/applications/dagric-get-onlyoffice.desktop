[Desktop Entry]
Type=Application
Name=Install ONLYOFFICE
GenericName=Office suite that matches Microsoft formatting
Comment=Install ONLYOFFICE, an office suite that opens Word, Excel and PowerPoint files with very close layout fidelity
Exec=konsole -e sh -c '/usr/bin/dagric-get-onlyoffice ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-logo
Terminal=false
Categories=Office;
Keywords=onlyoffice;office;word;excel;powerpoint;docx;xlsx;pptx;documents;spreadsheet;presentation;microsoft;install;
