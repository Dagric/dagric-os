[Desktop Entry]
Type=Application
Name=Rotating Wallpapers (Variety)
GenericName=Automatic wallpaper changer
Comment=Install Variety to change your wallpaper on a schedule (optional, not preinstalled)
Exec=konsole -e sh -c '/usr/bin/dagric-get-variety ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-logo
Terminal=false
Categories=Settings;DesktopSettings;Utility;
Keywords=variety;wallpaper;background;rotate;slideshow;changer;

