[Desktop Entry]
Type=Application
Name=Install Local AI
GenericName=Run AI models on this PC (Ollama)
Comment=Install Ollama; after a model download, prompts and inference stay on this PC
Exec=konsole -e sh -c '/usr/bin/dagric-ai ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-ai
Terminal=false
Categories=Utility;Development;
