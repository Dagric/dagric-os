[Desktop Entry]
Type=Application
Name=Screen Reader
GenericName=Reads the screen aloud (Orca)
Comment=Read the screen aloud. Press Meta+Alt+S to turn it on or off at any time.
Exec=orca
Icon=preferences-desktop-accessibility
Terminal=false
Categories=Utility;Accessibility;
