[Desktop Entry]
Type=Application
Name=Dagric Blueprint
GenericName=Reproducible system configuration
Comment=Preview the applications and safe settings needed to rebuild this computer
Exec=konsole -e sh -c '/usr/bin/dagric-blueprint show; printf "\nPress Enter to close..."; read x'
Icon=dagric-blueprint
Terminal=false
Categories=System;Utility;
Keywords=blueprint;reinstall;rebuild;applications;settings;recovery;export;

