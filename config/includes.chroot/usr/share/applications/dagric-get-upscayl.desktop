[Desktop Entry]
Type=Application
Name=Install Upscayl
GenericName=Enlarge photos with AI
Comment=Install Upscayl to enlarge and sharpen photos using AI, entirely on this computer
Exec=konsole -e sh -c '/usr/bin/dagric-get-upscayl ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-get-upscayl
Terminal=false
Categories=Graphics;
Keywords=upscayl;upscale;enlarge;resize;ai;photo;image;sharpen;enhance;resolution;install;

