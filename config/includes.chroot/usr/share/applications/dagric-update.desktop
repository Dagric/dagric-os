[Desktop Entry]
Type=Application
Name=Dagric Update
GenericName=Keep Dagric current
Comment=Safely install signed Dagric and system updates without reinstalling
Exec=dagric-update --gui
Icon=system-software-update
Terminal=false
StartupNotify=true
Categories=System;Settings;
Keywords=update;upgrade;latest;new version;system;security;packages;

