[Desktop Entry]
Type=Application
Name=Dagric Support Mode
GenericName=Privacy-safe system report
Comment=Preview a hardware, recovery and Dagric change report without personal data
Exec=konsole -e sh -c '/usr/bin/dagric-support preview; printf "\nPress Enter to close..."; read x'
Icon=dagric-support
Terminal=false
Categories=System;Utility;
Keywords=support;diagnostics;hardware;passport;history;recovery;privacy;report;

