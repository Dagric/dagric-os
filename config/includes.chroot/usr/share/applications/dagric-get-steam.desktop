[Desktop Entry]
Type=Application
Name=Install Steam
GenericName=Valve's game store
Comment=Install Steam from Debian's installer under Valve's terms; the client is not included with Dagric
Exec=konsole -e sh -c '/usr/bin/dagric-get-steam ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-get-steam
Terminal=false
Categories=Game;
Keywords=steam;valve;games;gaming;store;launcher;proton;library;install;

