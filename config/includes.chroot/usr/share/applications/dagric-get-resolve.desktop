[Desktop Entry]
Type=Application
Name=Install DaVinci Resolve
GenericName=Professional video editor
Comment=Guided install of DaVinci Resolve, Blackmagic's professional video editor. Never bundled — downloaded from Blackmagic with your consent.
Exec=konsole -e sh -c '/usr/bin/dagric-get-resolve ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-logo
Terminal=false
Categories=AudioVideo;Video;
Keywords=davinci;resolve;video;editor;editing;premiere;vegas;movie maker;color;grading;blackmagic;install;

