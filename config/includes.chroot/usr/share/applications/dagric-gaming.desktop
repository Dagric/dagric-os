[Desktop Entry]
Type=Application
Name=Gaming Setup
GenericName=Proton-GE for Steam
Comment=Add the community Proton-GE build to Steam for better game compatibility
Exec=konsole -e sh -c '/usr/bin/dagric-gaming ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-logo
Terminal=false
Categories=Game;System;
Keywords=steam;proton;proton-ge;wine;gaming;game;compatibility;performance;gamemode;mangohud;
X-Dagric-Edition=pro

