[Desktop Entry]
Type=Application
Name=Install ProtonUp-Qt
GenericName=Manage Proton and Wine versions
Comment=Install ProtonUp-Qt to manage GE-Proton and Wine builds; compatibility varies by title
Exec=konsole -e sh -c '/usr/bin/dagric-get-protonup ; echo ; printf "Press Enter to close..." ; read x'
Icon=dagric-get-protonup
Terminal=false
Categories=Game;Settings;
Keywords=protonup;proton;ge-proton;proton-ge;glorious eggroll;wine;steam;lutris;compatibility;games;install;

