[SddmGreeterTheme]
Name=Dagric
Description=The Dagric OS login screen
Author=DGR Operations
Copyright=(c) 2026 DGR Operations
License=GPL-3.0-or-later
Website=https://dagric.com
Type=sddm-theme
Version=1.0
MainScript=Main.qml
ConfigFile=theme.conf
Screenshot=preview.png
Theme-Id=dagric

# The two lines below are load-bearing and are the reason most third-party SDDM
# themes show a black screen on Plasma 6.
#
# QtVersion is how the sddm daemon picks the greeter binary: it resolves
# "sddm-greeter-qt<QtVersion>". Debian 13 ships only /usr/bin/sddm-greeter-qt6.
# Set this to 5, or leave it out and let the default apply, and the daemon logs
# "The theme at <path> requires missing sddm-greeter-qt5. Using fallback theme."
# and starts its built-in greeter instead of this one — no Dagric branding, and
# nothing on screen to explain why.
#
# Theme-API=2.0 is what says this theme expects the modern greeter contract:
# the sddm, userModel, sessionModel, keyboard and config context objects that
# Main.qml reads. Both keys were copied from the shipped sddm-theme-breeze
# metadata, which is the reference implementation on this exact SDDM version.
Theme-API=2.0
QtVersion=6

# The separate job named in the note that used to sit here is now done, so the
# note is replaced by the thing it was waiting for.
#
# Every visible string in Main.qml is wrapped in qsTr(), and translations/ holds
# a compiled catalogue per language. This key is what points SDDM at them.
#
# HOW SDDM READS THIS, from the 0.21 source rather than from documentation:
#
#   ThemeMetadata.cpp reads SddmGreeterTheme/TranslationsDirectory and DEFAULTS
#   IT TO "." — so leaving this key out does not disable translation, it points
#   the greeter at the theme's own root. Naming the subdirectory is therefore
#   not optional decoration; it is the difference between the catalogues being
#   found and being ignored.
#
#   GreeterApp.cpp::setThemePath() then does, verbatim:
#       m_theme_translator->load(QLocale::system(), QString(), QString(),
#                                "<themePath>/<TranslationsDirectory>/")
#   An empty filename and empty prefix mean QTranslator looks for the locale's
#   own name plus ".qm" in that directory — de.qm, es.qm, fr.qm, it.qm and
#   pt_BR.qm. Verified by compiling that exact call against Qt 6.8 and printing
#   QTranslator::filePath() under each of the six locales, rather than trusting
#   the documented search order: de_DE picks de.qm, pt_BR picks pt_BR.qm, and
#   en_US and C match nothing and fall through to the English in Main.qml.
#
#   setThemePath() runs before the StartupEvent that builds the QQuickView, so
#   the translator is installed BEFORE Main.qml is parsed. No retranslate() call
#   is needed and none is available here.
#
#   QLocale::system() is the greeter's own locale, and the greeter runs as the
#   unprivileged `sddm` user, not as the owner. It gets a language because
#   /etc/pam.d/sddm-greeter ends with
#       session required pam_env.so envfile=/etc/default/locale
#   which is the file Calamares' locale module writes at install time. A machine
#   whose /etc/default/locale is empty gets the English above, which is correct.
#
# Breeze declares this same key and ships no such directory: it translates
# through ki18n instead, which needs org.kde.* QML imports this theme refuses to
# take on (see the top of Main.qml). That is why the mechanism here is Qt's own.
TranslationsDirectory=translations
