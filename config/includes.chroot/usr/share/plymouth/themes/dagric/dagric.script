# Dagric OS boot splash — plymouth "script" plugin.
# Deep navy ground, D mark riding slightly above centre with an eased
# fade-in and a quiet breathing pulse, a hairline progress indicator,
# and the LUKS passphrase prompt beneath the mark.

Window.SetBackgroundTopColor(0.055, 0.094, 0.149);   # #0e1826
Window.SetBackgroundBottomColor(0.020, 0.031, 0.051); # #05080d

# ---- Logo: horizontally centred, riding at 38% of the height ----
logo.image = Image("logo.png");
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() * 0.38 - logo.image.GetHeight() / 2;
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(logo.x, logo.y, 10);
logo.sprite.SetOpacity(0);

# Anchor line for the progress hairline / passphrase prompt.
anchor_y = logo.y + logo.image.GetHeight() + 44;

# ---- Hairline progress indicator ----
bar.width = Window.GetWidth() / 5;
if (bar.width > 300)
    bar.width = 300;
bar.height = 2;
bar.x = Window.GetWidth() / 2 - bar.width / 2;
bar.y = anchor_y;

bar.bg.sprite = Sprite();
bar.fg.sprite = Sprite();
state.show_bar = 0;
if (Plymouth.GetMode() == "boot") {
    state.show_bar = 1;
    bar.bg.image = Image.Text("█", 0.13, 0.19, 0.26);   # slate track
    bar.bg.sprite.SetImage(bar.bg.image.Scale(bar.width, bar.height));
    bar.bg.sprite.SetPosition(bar.x, bar.y, 5);
    bar.bg.sprite.SetOpacity(0);
    bar.fg.image = Image.Text("█", 0.247, 0.663, 0.961); # #3fa9f5 fill
}

fun progress_callback(duration, progress) {
    if (state.show_bar == 1) {
        fill = Math.Int(bar.width * progress);
        if (fill < 1)
            fill = 1;
        bar.fg.sprite.SetImage(bar.fg.image.Scale(fill, bar.height));
        bar.fg.sprite.SetPosition(bar.x, bar.y, 6);
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- Eased fade-in plus a slow, subtle breathing pulse ----
state.tick = 0;
state.fade = 0;
state.prompt_active = 0;

fun refresh_callback() {
    state.tick++;
    f = state.tick / 60;                 # ~1.2 s fade-in at 50 fps
    if (f > 1)
        f = 1;
    f = f * f * (3 - 2 * f);             # smoothstep ease
    state.fade = f;
    breath = 0.95 + 0.05 * Math.Sin(state.tick / 40);
    logo.sprite.SetOpacity(f * breath);
    if (state.prompt_active == 1) {
        bar.bg.sprite.SetOpacity(0);
        bar.fg.sprite.SetOpacity(0);
    } else {
        bar.bg.sprite.SetOpacity(0.85 * f);
        bar.fg.sprite.SetOpacity(f);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- Disk-encryption passphrase prompt (below the mark) ----
prompt_sprite = Sprite();
fun display_password_callback(prompt, bullets) {
    state.prompt_active = 1;
    bullet_str = "";
    for (i = 0; i < bullets; i++)
        bullet_str += "• ";
    if (prompt == "")
        prompt = "Enter passphrase";
    text.image = Image.Text(prompt + "   " + bullet_str, 0.90, 0.93, 0.96);
    prompt_sprite.SetImage(text.image);
    prompt_sprite.SetPosition(Window.GetWidth() / 2 - text.image.GetWidth() / 2,
                              anchor_y - text.image.GetHeight() / 2, 12);
    prompt_sprite.SetOpacity(1);
}

fun display_normal_callback() {
    state.prompt_active = 0;
    prompt_sprite.SetOpacity(0);
}

# ---- Status messages: one muted line near the bottom ----
msg_sprite = Sprite();
fun message_callback(message) {
    msg.image = Image.Text(message, 0.43, 0.51, 0.60);
    msg_sprite.SetImage(msg.image);
    msg_sprite.SetPosition(Window.GetWidth() / 2 - msg.image.GetWidth() / 2,
                           Window.GetHeight() * 0.92 - msg.image.GetHeight(), 4);
    msg_sprite.SetOpacity(1);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetMessageFunction(message_callback);
