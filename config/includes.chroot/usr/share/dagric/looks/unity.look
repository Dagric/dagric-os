# Dagric layout file. Copy to ~/.local/share/dagric/looks/ and edit;
# it appears in Dagric Looks next time. SCRIPT is Plasma's own
# scripting API (one line). Panels are cleared automatically first.
NAME=Unity
DESCRIPTION=a side dock, with every window's menu moved to the top bar
SORT=60
EDITION=pro
SCRIPT=var s=new Panel; s.location="left"; s.height=Math.round(gridUnit*3.2); var k=s.addWidget("org.kde.plasma.kickoff"); k.currentConfigGroup=["General"]; k.writeConfig("icon","dagric-logo"); k.writeConfig("favorites","dagric-hub.desktop,org.kde.discover.desktop,org.kde.dolphin.desktop,systemsettings.desktop,firefox-esr.desktop"); s.addWidget("org.kde.plasma.icontasks"); var t=new Panel; t.location="top"; t.height=Math.round(gridUnit*1.5); t.addWidget("org.kde.plasma.appmenu"); t.addWidget("org.kde.plasma.panelspacer"); t.addWidget("org.kde.plasma.systemtray"); t.addWidget("org.kde.plasma.digitalclock");
