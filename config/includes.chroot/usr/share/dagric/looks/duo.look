# Dagric layout file. Copy to ~/.local/share/dagric/looks/ and edit;
# it appears in Dagric Looks next time. SCRIPT is Plasma's own
# scripting API (one line). Panels are cleared automatically first.
NAME=Duo
DESCRIPTION=two panels, top and bottom, for power users
SORT=70
EDITION=pro
SCRIPT=var t=new Panel; t.location="top"; t.height=Math.round(gridUnit*1.6); var k=t.addWidget("org.kde.plasma.kickoff"); k.currentConfigGroup=["General"]; k.writeConfig("icon","dagric-logo"); k.writeConfig("favorites",["dagric-hub.desktop","preferred://browser","systemsettings.desktop","org.kde.dolphin.desktop","org.kde.discover.desktop"]); t.addWidget("org.kde.plasma.appmenu"); t.addWidget("org.kde.plasma.panelspacer"); t.addWidget("org.kde.plasma.systemtray"); t.addWidget("org.kde.plasma.digitalclock"); var b=new Panel; b.location="bottom"; b.height=Math.round(gridUnit*2.2); b.addWidget("org.kde.plasma.pager"); b.addWidget("org.kde.plasma.taskmanager"); b.addWidget("org.kde.plasma.showdesktop");
