# Dagric layout file. Copy to ~/.local/share/dagric/looks/ and edit;
# it appears in Dagric Looks next time. SCRIPT is Plasma's own
# scripting API (one line). Panels are cleared automatically first.
NAME=Centered
DESCRIPTION=a centered taskbar, clean and modern
SORT=30
SCRIPT=var p=new Panel; p.location="bottom"; p.height=48; p.floating=true; p.lengthMode="fill"; p.opacity="adaptive"; var k=p.addWidget("org.kde.plasma.kickoff"); k.currentConfigGroup=["General"]; k.writeConfig("icon","dagric-logo"); k.writeConfig("favorites",["dagric-hub.desktop","dagric-desktop-settings.desktop","preferred://browser","org.kde.dolphin.desktop","org.kde.discover.desktop"]); p.addWidget("org.kde.plasma.panelspacer"); var tasks=p.addWidget("org.kde.plasma.icontasks"); tasks.currentConfigGroup=["General"]; tasks.writeConfig("launchers",["applications:org.kde.dolphin.desktop","preferred://browser","applications:dagric-hub.desktop","applications:dagric-desktop-settings.desktop"]); p.addWidget("org.kde.plasma.panelspacer"); p.addWidget("org.kde.plasma.systemtray"); p.addWidget("org.kde.plasma.digitalclock");
