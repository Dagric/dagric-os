# Dagric layout file. Copy to ~/.local/share/dagric/looks/ and edit;
# it appears in Dagric Looks next time. SCRIPT is Plasma's own
# scripting API (one line). Panels are cleared automatically first.
NAME=Eleven
DESCRIPTION=a centered taskbar, clean and modern
SORT=30
SCRIPT=var p=new Panel; p.location="bottom"; p.height=Math.round(gridUnit*2.4); var k=p.addWidget("org.kde.plasma.kickoff"); k.currentConfigGroup=["General"]; k.writeConfig("icon","dagric-logo"); k.writeConfig("favorites",["dagric-hub.desktop","preferred://browser","systemsettings.desktop","org.kde.dolphin.desktop","org.kde.discover.desktop"]); p.addWidget("org.kde.plasma.panelspacer"); p.addWidget("org.kde.plasma.icontasks"); p.addWidget("org.kde.plasma.panelspacer"); p.addWidget("org.kde.plasma.systemtray"); p.addWidget("org.kde.plasma.digitalclock");
