#!/bin/sh
# Dagric OS live session: put "Check This PC" on the desktop, next to
# "Install Dagric OS".
#
# WHY THIS IS THE PLACEMENT THAT MATTERS. dagric-hardware-check answers the one
# question the live USB otherwise leaves hanging — will the Wi-Fi work, is the
# disk BitLocker'd, is this machine even 64-bit UEFI — and it is worth nothing
# if it is found AFTER the install. The application menu is not good enough:
# somebody evaluating an unfamiliar OS for ten minutes clicks what is on the
# screen. The installer icon is already there, and the whole point is that this
# should be the thing you click FIRST.
#
# Live-only, on purpose. live-config never runs on an installed system, so this
# does not litter the desktop of a machine somebody has actually installed —
# there the tool stays in the launcher and in the Hub, where a support request
# can send them.
#
# The .desktop is copied rather than symlinked because KDE marks a desktop
# launcher trusted by writing to the file, and a symlink into /usr/share would
# either fail (read-only medium) or scribble on the system copy.
Dagric_hwcheck_icon ()
{
    # BOTH icons are placed here, and the installer one is not ours.
    #
    # Debian ships /etc/xdg/autostart/calamares-desktop-icon.desktop, which runs
    # add-calamares-desktop-icon at login to drop "Install Dagric OS" on the
    # desktop. On this image it does not happen. Verified by installing from the
    # live session in a VM and then opening ~/Desktop in the file manager:
    # "1 file (2.4 KiB)", and that one file is ours.
    #
    # So a live USB — the entire point of which is try-then-install — offered no
    # way to install. The entry is still in the application menu, but somebody
    # evaluating an unfamiliar OS for ten minutes clicks what is on the screen,
    # and what was on the screen was a hardware checker and nothing else.
    #
    # Rather than diagnose why a Plasma 6 session is not honouring an
    # X-KDE-autostart-phase=1 entry, this uses the mechanism that demonstrably
    # DOES work — the one that put our own icon there — for both. live-config
    # runs before the session, so neither icon depends on autostart firing.
    # Debian's autostart is left alone: if it does run, it writes the same file
    # to the same path and the result is identical.
    SRC=/usr/share/applications/dagric-hardware-check.desktop
    INST=/usr/share/applications/calamares-install-debian.desktop
    [ -f "$SRC" ] || [ -f "$INST" ] || return 0

    for H in /home/*; do
        [ -d "$H" ] || continue
        U=$(basename "$H")
        # Honour the localised Desktop folder name if xdg-user-dirs has already
        # written one (Schreibtisch, Bureau, Escritorio); fall back to Desktop,
        # which is what Plasma creates when it has nothing else to go on.
        D=$H/Desktop
        if [ -r "$H/.config/user-dirs.dirs" ]; then
            X=$(sed -n 's/^XDG_DESKTOP_DIR="\(.*\)"$/\1/p' "$H/.config/user-dirs.dirs" | head -1)
            case "$X" in
                '$HOME'/*) D=$H/${X#\$HOME/} ;;
                /*)        D=$X ;;
            esac
        fi
        mkdir -p "$D" || continue

        # 0755 on both: Plasma refuses to run a desktop launcher that is not
        # executable and shows it as a text file instead, which looks broken.
        for pair in "$SRC:dagric-hardware-check.desktop" \
                    "$INST:calamares-install-debian.desktop"; do
            s=${pair%%:*}; n=${pair#*:}
            [ -f "$s" ] || continue
            cp "$s" "$D/$n" || continue
            chmod 0755 "$D/$n"
            chown "$U:$U" "$D/$n" 2>/dev/null || true
        done
        chown "$U:$U" "$D" 2>/dev/null || true
    done
}
Dagric_hwcheck_icon
