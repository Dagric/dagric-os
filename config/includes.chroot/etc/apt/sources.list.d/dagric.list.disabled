# Dagric OS update channel — factory enrollment (currently disabled).
#
# When repo.dagric.com is live, rename this file to dagric.list, ship the
# repo public key at /usr/share/keyrings/dagric.gpg, and every machine
# receives dagric-* configuration updates through normal apt updates.
#
# deb [signed-by=/usr/share/keyrings/dagric.gpg] https://repo.dagric.com/ ./
